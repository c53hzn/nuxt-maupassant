[{"data":1,"prerenderedAt":250},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-covid19-vaccine-review":118,"surround-covid19-vaccine-review":239},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":220,"description":221,"extension":222,"meta":223,"navigation":96,"path":230,"seo":231,"slug":232,"stem":233,"tags":234,"__hash__":238},"blog\u002Fblog\u002F2021-03-28-covid19-vaccine-review.md","新冠疫苗测评",{"type":122,"value":123,"toc":214},"minimark",[124,128,132,135,138,141,144,147,150,153,156,159,162,165,168,171,178,181,184,187,190,193,196,199,202,205,208,211],[125,126,127],"h2",{"id":127},"打疫苗",[129,130,131],"p",{},"终于打了疫苗了。",[129,133,134],{},"本来打什么疫苗都无所谓，但是鉴于当前的一些情况，感觉还是科兴的会好一些。",[129,136,137],{},"话说科兴的疫苗怎么都叫“x尔来福”，这种命名方式有一种特别的喜感。",[129,139,140],{},"为了不影响工作，我还特意预约了周六，打工人就是如此卑微。",[129,142,143],{},"预约的地点是一个体育馆，我带着身份证和打印的预约记录就出门了。",[129,145,146],{},"到了地方之后，在馆外找到自己预约的时间段的队伍，在队尾排好。",[129,148,149],{},"前面大概每隔 5 分钟从队首放一批人进去，我等了 3 批，也不算久。",[129,151,152],{},"进了场地之后有人核对身份证和预约信息，然后在等待区域的座位上坐好，没一会就有工作人员指引我去临时搭建的打针小隔间外面等候，里面的人打完了之后我就进去了。",[129,154,155],{},"医生会再次核对姓名和登记信息，然后问有没有过敏或是慢性病之类的。",[129,157,158],{},"其实我有鼻炎和湿疹，不过医生看着我撸起袖子的胳膊，说没问题。",[129,160,161],{},"然后就打了，总共用时 1 秒钟，感觉跟被蚊子咬了差不多，打完之后医生给我贴了块圆形的创可贴，就打发我走了。",[129,163,164],{},"以前抽血的时候需要用棉签按半天，时间短了还是会出血，所以我对于这次这么快就可以不用理针眼感到非常吃惊。",[129,166,167],{},"不过这是好事啊，于是我赶紧拿着医生打印的接种记录从小隔间出来，去接种后的等待区坐了 30 分钟，然后离开，出门的时候会有工作人员给你纪念品：一个贴纸和一包口罩。",[129,169,170],{},"贴纸长这样：",[129,172,173],{},[174,175],"img",{"alt":176,"src":177},"sticker","\u002Fimg\u002Fblog\u002F2021-03-28\u002F001.jpg",[125,179,180],{"id":180},"头痛",[129,182,183],{},"这时候就开始头痛了。",[129,185,186],{},"走的时候是隐隐约约的头疼，到家的时候就已经是太阳穴突突的疼了，而且只是右边太阳穴，跟我平时经期头痛的疼法一模一样。",[129,188,189],{},"可是时间不对啊，那该不会是打疫苗引发的吧？",[129,191,192],{},"平时头疼我可以吃布洛芬，可是这次不知道吃还是不吃比较好，最终决定不吃，还是采用最古老的办法：湿毛巾冷敷。",[129,194,195],{},"敷上冷毛巾之后感觉好一些了，但是头疼的感觉还是久久不散。",[129,197,198],{},"头疼的时候吃不下东西，还是直接睡觉吧，这样就感觉不到痛，也不会感觉饿了。",[125,200,201],{"id":201},"回过劲儿来",[129,203,204],{},"额头上敷着毛巾连续睡了 12 个小时之后，已经是第二天了。",[129,206,207],{},"我醒了，头不疼了，肚子也饿了，能吃得下东西了。",[129,209,210],{},"至于网上别人说的什么胳膊疼、酸胀之类的，我完全没有。",[129,212,213],{},"接下来就是等 28 天之后再去打第二针啦~",{"title":215,"searchDepth":34,"depth":34,"links":216},"",[217,218,219],{"id":127,"depth":34,"text":127},{"id":180,"depth":34,"text":180},{"id":201,"depth":34,"text":201},[26],"打了科兴的克尔来福新冠疫苗，昏睡了半天。","md",{"date":224,"language":225,"keywords":226,"comments":96},"2021-03-28","中文",[227,228,229],"Corona Virus","vaccine","side effect","\u002Fblog\u002F2021-03-28-covid19-vaccine-review",{"title":120,"description":221},"covid19-vaccine-review","blog\u002F2021-03-28-covid19-vaccine-review",[6,235,236,237],"COVID-19","疫苗","副作用","q6eQ81-vI3x7Dh8WNNe6stHTOib-qLAyx4u7pw0IknY",[240,245],{"title":241,"path":242,"stem":243,"children":-1,"slug":244},"如何制作中英双语的面包屑导航","\u002Fblog\u002F2021-03-24-nuxt-breadcrumbs-bilingual","blog\u002F2021-03-24-nuxt-breadcrumbs-bilingual","nuxt-breadcrumbs-bilingual",{"title":246,"path":247,"stem":248,"children":-1,"slug":249},"那些一听到就会泪流满面的音乐","\u002Fblog\u002F2021-03-28-music-that-makes-you-cry","blog\u002F2021-03-28-music-that-makes-you-cry","music-that-makes-you-cry",1794547929452]