[{"data":1,"prerenderedAt":242},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-li-yundi":118,"surround-li-yundi":231},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":214,"description":215,"extension":216,"meta":217,"navigation":96,"path":223,"seo":224,"slug":225,"stem":226,"tags":227,"__hash__":230},"blog\u002Fblog\u002F2021-10-30-li-yundi.md","如何评价李云迪",{"type":122,"value":123,"toc":207},"minimark",[124,128,138,141,144,147,150,153,156,159,162,165,168,171,175,178,186,189,192,195,198,201,204],[125,126,127],"h2",{"id":127},"新闻回顾",[129,130,131],"p",{},[132,133,137],"a",{"href":134,"rel":135},"https:\u002F\u002Fwww.sohu.com\u002Fa\u002F496739226_121032394",[136],"nofollow","李云迪嫖娼被抓，还是二进宫，王力宏终于沉冤得雪，评论区像过年",[129,139,140],{},"简而言之，就是“钢琴王子”李云迪因嫖娼被抓了，而且还是今年第二次因为相同原因被抓。",[129,142,143],{},"嫖娼是轻罪，拘留15天就能放出来了，不过今天他应该还没出来。",[129,145,146],{},"最近他一直在参加湖南卫视的综艺节目《披荆斩棘的哥哥》，出事之后节目后期连夜打马赛克，让他享受了一把霍尊的待遇。",[129,148,149],{},"话说霍尊是在《哥哥》正式播出之前出的事，让节目提前上了一把热搜，而李云迪在节目最后一期之前出事，又让节目上了热搜。现在他俩都身败名裂了，也不知道是他们毁了节目，还是节目毁了他们。",[125,151,152],{"id":152},"李云迪其人",[129,154,155],{},"我第一次听说李云迪，是在初中的英语课文里，他是钢琴大赛获奖的天之骄子，少年得志，才华横溢。",[129,157,158],{},"我也喜欢听钢琴曲，在这件事发生之前，他弹的《月光奏鸣曲》一直是我睡前听的曲目首选，但是现在看到他的名字就会想到奇怪的东西。",[129,160,161],{},"2013年春晚上刘谦的魔术出现了“找力宏”这个梗，我对刘谦的解释一直是半信半疑的，但是现在确定了，这事是李云迪单机卖腐，挺搞笑的。",[129,163,164],{},"上周他出事之后，我陆续看到微博上有一些近几年看过他的音乐会的博主发博称，李云迪近几年弹钢琴都很敷衍，有的地方磕磕巴巴的，很显然是没有好好练习。",[129,166,167],{},"于是我想起了之前看到的《哥哥》节目的片段，几位哥哥在激烈讨论，李云迪在后面弹钢琴伴奏，微博上大家看得很欢乐。",[129,169,170],{},"李在里面弹的是李斯特的《钟》，但是不像我通常听到的那么行云流水，当然了，这不是公演，没啥好挑的，但应该也能算是个苗头。",[125,172,174],{"id":173},"嫖娼也能洗","嫖娼也能洗？",[129,176,177],{},"微博上为李云迪洗地的通常有两种声音，一种认为嫖娼是“小事”，大艺术家怎么能被“小事”所累；一种认为是有人陷害他，李云迪没有嫖娼。",[129,179,180,181,185],{},"在Youtube上为李云迪洗地的通常有两种声音，一种认为嫖娼是“小事”，大艺术家怎么能被“小事”所累；一种认为是",[182,183,184],"em",{},"共产党","陷害他，李云迪没有嫖娼。",[129,187,188],{},"总之就是前一种认为李做了，后一种认为李没做。",[129,190,191],{},"希望这四拨人在一起打一架。",[125,193,194],{"id":194},"公众人物的社会责任",[129,196,197],{},"嫖娼在中国大陆和港澳台地区都是违法行为，之前看到有人说什么澳大利亚合法，法国只需要罚款之类的，我觉得如果有想去的可以努力移民哈，也许你以前工作学习没有动力，现在这不是有了吗？",[129,199,200],{},"但是，公众人物的道德底线可以跟一般人一样吗？一辈子也没嫖过的一般人也大有人在，那就是说，这些公众人物的底线比一般人还低了，这也是能接受的吗？",[129,202,203],{},"我反正不行。",[129,205,206],{},"全文完~",{"title":208,"searchDepth":34,"depth":34,"links":209},"",[210,211,212,213],{"id":127,"depth":34,"text":127},{"id":152,"depth":34,"text":152},{"id":173,"depth":34,"text":174},{"id":194,"depth":34,"text":194},[21],"李云迪第二次因嫖娼被抓，热门综艺惨遭二次伤害，这个社会还有救吗？","md",{"date":218,"language":219,"keywords":220,"comments":96},"2021-10-30","中文",[221,222],"嫖娼","公众人物","\u002Fblog\u002F2021-10-30-li-yundi",{"title":120,"description":215},"li-yundi","blog\u002F2021-10-30-li-yundi",[228,229],"李云迪","钢琴","8q2WBCj92HtoOkyGehJF-t7OGj4dPMfb5J5K9zBXAOk",[232,237],{"title":233,"path":234,"stem":235,"children":-1,"slug":236},"意识流不是这么用的——《天目危机》剧评","\u002Fblog\u002F2021-09-21-tv-review-pandoras-box","blog\u002F2021-09-21-tv-review-pandoras-box","tv-review-pandoras-box",{"title":238,"path":239,"stem":240,"children":-1,"slug":241},"《暗杀风暴》定档12月10日，影版暗黑者又将带来什么新故事？","\u002Fblog\u002F2021-11-16-movie-death-notice","blog\u002F2021-11-16-movie-death-notice","movie-death-notice",1794547929252]