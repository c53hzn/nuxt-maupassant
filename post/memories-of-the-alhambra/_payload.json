[{"data":1,"prerenderedAt":189},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-memories-of-the-alhambra":118,"surround-memories-of-the-alhambra":178},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":164,"description":165,"extension":166,"meta":167,"navigation":96,"path":170,"seo":171,"slug":172,"stem":173,"tags":174,"__hash__":177},"blog\u002Fblog\u002F2018-12-10-memories-of-the-alhambra.md","阿尔罕布拉宫的回忆",{"type":122,"value":123,"toc":161},"minimark",[124,128,131,134,137,140,143,146,149,152,155,158],[125,126,127],"p",{},"今天把韩剧《阿尔罕布拉宫的回忆》追到第四集了，在剧中听到一首吉他曲，之后通过男主的秘书的描述得知它的名字，原来就是用来点题的《阿尔罕布拉宫的回忆》。",[125,129,130],{},"剧中听得不是很清楚，但我隐约觉得有些耳熟，于是在QQ音乐上找来专门听一听。",[125,132,133],{},"这一听可不得了，我立刻就震惊.jpg了，因为这是一首让我记了十年却一直没有找到曲名的曲子。",[125,135,136],{},"那应该是一个暑假，中央台音乐频道有段时间在放一个叫《“漫”游古典》的节目，每期时长大约一小时，节目中会用各种画风的动画配上各种古典音乐，每天下午首播，第二天上午重播。",[125,138,139],{},"有一天下午的节目中，大约是《土耳其进行曲》的后面，我听到了让我记了十年的乐声。",[125,141,142],{},"那是一首用一种拨弦乐器演奏的乐曲，乐声细密而连绵不断，沉静又平和，像是在回忆一些温暖而平常的小事，带着些许哀而不伤的情绪，配上画面中斜进屋里的夕阳和晃动的风景，让人整个心都沉醉了。",[125,144,145],{},"当天下午听了一遍，没有记住它叫什么名字，第二天上午又听了一遍，可还是错过了曲名，后来我想在央视网上找这个节目回看，却发现央视没有把它放上网。",[125,147,148],{},"然后就到了今天。",[125,150,151],{},"韩剧《阿尔罕布拉宫的回忆》第三集，男主在女主弟弟创造的游戏世界里看到了以女主为原型、同样是也是朴信惠饰演的NPC。",[125,153,154],{},"她身着西班牙风的套裙，头上披了一条红色纱巾，用古典吉他弹着这首曲子，像所有不期而遇的爱情一样美丽又震撼人心，当男主在小酒馆里见到她时，脸上的表情就跟我第一次听到的时候一样。",[125,156,157],{},"以前我听不出来这曲子是用什么乐器演奏的，时间一久连主旋律也哼不出来了，于是就再没办法知道它叫什么了。",[125,159,160],{},"今天真是机缘巧合，了了一个心结，今晚睡前就决定听它啦～",{"title":162,"searchDepth":34,"depth":34,"links":163},"",[],[9],"十年前偶然在音乐节目里听过一首曲子，这么久都没有再听到过，没想到在韩剧里听到了，而且它还是这部韩剧的标题。这个世界实在是太奇妙了","md",{"date":168,"language":169,"comments":96},"2018-12-10","中文","\u002Fblog\u002F2018-12-10-memories-of-the-alhambra",{"title":120,"description":165},"memories-of-the-alhambra","blog\u002F2018-12-10-memories-of-the-alhambra",[175,176],"音乐","韩剧","Uc6JaxtH9FXjEwsIUlHK-6Hgj6k9Ma-urHIgc4G5efg",[179,184],{"title":180,"path":181,"stem":182,"children":-1,"slug":183},"我最喜欢的PC游戏——扫雷","\u002Fblog\u002F2018-11-18-minesweeper","blog\u002F2018-11-18-minesweeper","minesweeper",{"title":185,"path":186,"stem":187,"children":-1,"slug":188},"韩剧观后感之《阿尔罕布拉宫的回忆》和《死也很好》","\u002Fblog\u002F2018-12-21-memories-of-the-alhambra-n-feel-good-to-die","blog\u002F2018-12-21-memories-of-the-alhambra-n-feel-good-to-die","memories-of-the-alhambra-n-feel-good-to-die",1794550657614]