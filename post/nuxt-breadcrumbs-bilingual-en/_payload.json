,{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":1618,"description":1619,"extension":1620,"meta":1621,"navigation":96,"path":1627,"seo":1628,"slug":1629,"stem":1630,"tags":1631,"__hash__":1633},"blog\u002Fblog\u002F2021-04-06-nuxt-breadcrumbs-bilingual-en.md","Create Bilingual Breadcrumbs component for Nuxt",{"type":122,"value":123,"toc":1607},"minimark",[124,129,139,142,145,149,152,328,332,339,346,359,377,383,386,1107,1110,1114,1125,1130,1144,1149,1236,1242,1265,1273,1277,1283,1327,1331,1338,1359,1587,1590,1594,1597,1600,1603],[125,126,128],"h2",{"id":127},"preface","Preface",[130,131,132,133,138],"p",{},"(This is a translation of my original article ",[134,135,137],"a",{"href":136},"\u002Fpost\u002Fnuxt-breadcrumbs-bilingual","如何制作中英双语的面包屑导航",")",[130,140,141],{},"Some time ago I noticed that some websites have this \"Breadcrumb Navigation\", I searched for relevant data and decided that my website needs to have one too.",[130,143,144],{},"At first I only made an English version that splits page paths and generate breadcrumb elements that have the same name as their path. Then I read an article about how the author set up his breadcrumb navigation, he was using WordPress, but the idea is just as useful to me, so I started to create this biligual breadcrumb component.",[125,146,148],{"id":147},"html-template","HTML Template",[130,150,151],{},"The HTML part is super simple, just like this:",[153,154,159],"pre",{"className":155,"code":156,"language":157,"meta":158,"style":158},"language-html shiki shiki-themes github-light github-dark","\u003Cdiv class=\"breadcrumbs\"> \n  \u003Cspan v-for=\"(path, pathIndex) in paths\" :key=\"pathIndex\"> \n    \u003Ca v-if=\"pathIndex \u003C paths.length-1\" :href=\"path.href\"> \n      {{path.text}} \n    \u003C\u002Fa> \n    \u003Cspan v-else> \n      {{path.isMapped?path.text:thisPage}}\n    \u003C\u002Fspan> \n    \u003Cspan v-if=\"pathIndex \u003C paths.length-1\">\u002F\u003C\u002Fspan> \n  \u003C\u002Fspan> \n\u003C\u002Fdiv>\n","html","",[160,161,162,188,213,244,249,259,270,275,284,308,317],"code",{"__ignoreMap":158},[163,164,166,170,174,178,181,185],"span",{"class":165,"line":16},"line",[163,167,169],{"class":168},"sVt8B","\u003C",[163,171,173],{"class":172},"s9eBZ","div",[163,175,177],{"class":176},"sScJk"," class",[163,179,180],{"class":168},"=",[163,182,184],{"class":183},"sZZnC","\"breadcrumbs\"",[163,186,187],{"class":168},"> \n",[163,189,190,193,195,198,200,203,206,208,211],{"class":165,"line":34},[163,191,192],{"class":168},"  \u003C",[163,194,163],{"class":172},[163,196,197],{"class":176}," v-for",[163,199,180],{"class":168},[163,201,202],{"class":183},"\"(path, pathIndex) in paths\"",[163,204,205],{"class":176}," :key",[163,207,180],{"class":168},[163,209,210],{"class":183},"\"pathIndex\"",[163,212,187],{"class":168},[163,214,215,218,220,223,225,228,231,234,237,239,242],{"class":165,"line":19},[163,216,217],{"class":168},"    \u003C",[163,219,134],{"class":172},[163,221,222],{"class":176}," v-if",[163,224,180],{"class":168},[163,226,227],{"class":183},"\"pathIndex ",[163,229,169],{"class":230},"s7hpK",[163,232,233],{"class":183}," paths.length-1\"",[163,235,236],{"class":176}," :href",[163,238,180],{"class":168},[163,240,241],{"class":183},"\"path.href\"",[163,243,187],{"class":168},[163,245,246],{"class":165,"line":7},[163,247,248],{"class":168},"      {{path.text}} \n",[163,250,252,255,257],{"class":165,"line":251},5,[163,253,254],{"class":168},"    \u003C\u002F",[163,256,134],{"class":172},[163,258,187],{"class":168},[163,260,261,263,265,268],{"class":165,"line":24},[163,262,217],{"class":168},[163,264,163],{"class":172},[163,266,267],{"class":176}," v-else",[163,269,187],{"class":168},[163,271,272],{"class":165,"line":39},[163,273,274],{"class":168},"      {{path.isMapped?path.text:thisPage}}\n",[163,276,278,280,282],{"class":165,"line":277},8,[163,279,254],{"class":168},[163,281,163],{"class":172},[163,283,187],{"class":168},[163,285,287,289,291,293,295,297,299,301,304,306],{"class":165,"line":286},9,[163,288,217],{"class":168},[163,290,163],{"class":172},[163,292,222],{"class":176},[163,294,180],{"class":168},[163,296,227],{"class":183},[163,298,169],{"class":230},[163,300,233],{"class":183},[163,302,303],{"class":168},">\u002F\u003C\u002F",[163,305,163],{"class":172},[163,307,187],{"class":168},[163,309,310,313,315],{"class":165,"line":95},[163,311,312],{"class":168},"  \u003C\u002F",[163,314,163],{"class":172},[163,316,187],{"class":168},[163,318,320,323,325],{"class":165,"line":319},11,[163,321,322],{"class":168},"\u003C\u002F",[163,324,173],{"class":172},[163,326,327],{"class":168},">\n",[125,329,331],{"id":330},"javascript-part","JavaScript Part",[130,333,334,335,338],{},"Then here comes the important part, to retrieve page paths and render to ",[160,336,337],{},"Breadcrumbs"," component.",[130,340,341,342,345],{},"And the key point is to set a rule that can map path links and their Chinese\u002FEnglish names based on website structure in advance, then use the language state stored in ",[160,343,344],{},"Vuex store"," to switch between the two languages.",[130,347,348,349,351,352,355,356,358],{},"At first I added a single ",[160,350,45],{}," file that contains all UI texts, including the Chinese\u002FEnglish mapping rules, in ",[160,353,354],{},"content"," folder, so that the website can retrieve texts using ",[160,357,354],{}," module, and I can manage all UI texts in one place, without having to go to specific component\u002Flayout\u002Fpage file to modify.",[130,360,361,362,365,366,369,370,373,374,376],{},"Then I found that you cannot load data using ",[160,363,364],{},"asyncData"," method in a component, you have to wait until ",[160,367,368],{},"Vue"," instance is ",[160,371,372],{},"created"," before you load data from ",[160,375,354],{}," module. But in this way, the breadcrumbs navigation will appear about 0.5 second later than the main content. It really seems not good.",[130,378,379,380,382],{},"So I have to hardcode the mapping rule in the component, if I want to add more path names and links, I have to go to this ",[160,381,337],{}," component and modify directly in it.",[130,384,385],{},"The result is as follows:",[153,387,391],{"className":388,"code":389,"language":390,"meta":158,"style":158},"language-js shiki shiki-themes github-light github-dark","export default {\n  name:'breadcrumbs',\n  data(){\n    var that = this;\n    var map_en = {\n      \"\u002F\": \"Home\",\n      \"\u002Fresume\": \"Resume\",\n      \"\u002Fportfolio\": \"Portfolio\",\n      \"\u002Fblog\": \"Blog\",\n      \"\u002Fblog\u002Ftag\": \"Tag\",\n      \"\u002Fblog\u002Flanguage\": \"Language\",\n      \"\u002Fstore\": \"Store\"\n    };\n    var map_zh = {\n      \"\u002F\": \"首页\",\n      \"\u002Fresume\": \"简历\",\n      \"\u002Fportfolio\": \"作品集\",\n      \"\u002Fblog\": \"博客\",\n      \"\u002Fblog\u002Ftag\": \"标签\",\n      \"\u002Fblog\u002Flanguage\": \"语言\",\n      \"\u002Fstore\": \"网店\"\n    }\n    var paths = that.$route.path.split(\"\u002F\");\n    var paths_en = [];\n    var paths_zh = [];\n    var tempPath = \"\";\n    for (let i = 0; i \u003C paths.length; i++) {\n      if (i == 0) {\n        tempPath = \"\u002F\";\n      } else if (i == 1) {\n        tempPath = \"\u002F\" + paths[i];\n      } else {\n        tempPath += \"\u002F\" + paths[i];\n      }\n      let obj_en = {\n        href: tempPath,\n        text: map_en[tempPath]?map_en[tempPath]:decodeURI(paths[i]),\n        isMapped: !!map_en[tempPath]\n      };\n      let obj_zh = {\n        href: tempPath,\n        text: map_zh[tempPath]?map_zh[tempPath]:decodeURI(paths[i]),\n        isMapped: !!map_zh[tempPath]\n      };\n      paths_en.push(obj_en);\n      paths_zh.push(obj_zh);\n    }\n    return{\n      paths_en,\n      paths_zh\n    }\n  },\n  computed: {\n    thisPage() {\n      return this.$store.state.lang.val==\"Chi\"?\"本页\":\"This page\";\n    },\n    paths() {\n      return this.$store.state.lang.val==\"Chi\"?this.paths_zh:this.paths_en;\n    }\n  }\n}\n","js",[160,392,393,405,416,424,441,452,465,477,489,501,513,525,536,542,553,565,577,589,601,613,625,635,641,666,678,690,705,745,761,774,794,809,818,832,838,851,857,878,890,896,908,913,930,940,945,957,968,973,982,988,994,999,1005,1011,1020,1048,1054,1062,1090,1095,1101],{"__ignoreMap":158},[163,394,395,399,402],{"class":165,"line":16},[163,396,398],{"class":397},"szBVR","export",[163,400,401],{"class":397}," default",[163,403,404],{"class":168}," {\n",[163,406,407,410,413],{"class":165,"line":34},[163,408,409],{"class":168},"  name:",[163,411,412],{"class":183},"'breadcrumbs'",[163,414,415],{"class":168},",\n",[163,417,418,421],{"class":165,"line":19},[163,419,420],{"class":176},"  data",[163,422,423],{"class":168},"(){\n",[163,425,426,429,432,434,438],{"class":165,"line":7},[163,427,428],{"class":397},"    var",[163,430,431],{"class":168}," that ",[163,433,180],{"class":397},[163,435,437],{"class":436},"sj4cs"," this",[163,439,440],{"class":168},";\n",[163,442,443,445,448,450],{"class":165,"line":251},[163,444,428],{"class":397},[163,446,447],{"class":168}," map_en ",[163,449,180],{"class":397},[163,451,404],{"class":168},[163,453,454,457,460,463],{"class":165,"line":24},[163,455,456],{"class":183},"      \"\u002F\"",[163,458,459],{"class":168},": ",[163,461,462],{"class":183},"\"Home\"",[163,464,415],{"class":168},[163,466,467,470,472,475],{"class":165,"line":39},[163,468,469],{"class":183},"      \"\u002Fresume\"",[163,471,459],{"class":168},[163,473,474],{"class":183},"\"Resume\"",[163,476,415],{"class":168},[163,478,479,482,484,487],{"class":165,"line":277},[