age":78,"comments":15},"2020-04-05","nuxt-blog-static-website-en",[217,836,338,1003],"Static Blog",[642],{"title":1006,"description":1007,"meta":1008,"slug":1010,"tags":1011,"categories":1012},"专门安利一下《端脑》","安利一个朱元冰主演的科幻悬疑剧《端脑》",{"date":1009,"language":11,"comments":15},"2020-02-13","tv-drama-die-now",[427],[34],{"title":1014,"description":1015,"meta":1016,"slug":1018,"tags":1019,"categories":1020},"关于疫病的记忆","2020年啊，不要再考验我了",{"date":1017,"language":11,"comments":15},"2020-02-01","memories-about-pandemics",[664],[206],{"title":1022,"description":1023,"meta":1024,"slug":1027,"tags":1028,"categories":1030},"2019年的小总结","我的2019年过得还算充实，看了很多剧，追了很多星，做了很多事，还学了很多东西，要继续保持。",{"date":1025,"language":11,"keywords":1026,"comments":15},"2020-01-31",[217],"summary-of-my-life-in-2019",[338,1029,186,274],"Nodemailer",[47,206,34],[1032,1040,1050,1059,1068,1077,1086,1095],{"title":1033,"description":1034,"meta":1035,"slug":1037,"tags":1038,"categories":1039},"在Excel中用vlookup公式灵活查找数字或文本类型关键字","VLOOKUP公式里的查找值必须和被查找区域的首列关键字为相同类型，否则会返回“#N\u002FA”，如果查找值是引用过来的，类型不同，此时可以强行转换类型，即可使VLOOKUP公式生效",{"date":1036,"language":11,"comments":15},"2019-12-28","why-vlookup-cannot-return-value",[274,275],[47],{"title":1041,"description":1042,"meta":1043,"slug":1047,"tags":1048,"categories":1049},"沙雕小说沙雕剧，拆我CP虐我心——《少年江湖物语》观后感","最近配套看完了另一部剧《少年江湖物语》和它的原著《如何错误地套路一个魔教教主》，导演为了过审竟然拆CP？Exo me？",{"date":1044,"language":11,"keywords":1045,"comments":15},"2019-08-17",[1046],"耽美剧","the-birth-of-the-drama-king",[427],[34],{"title":1051,"description":1052,"meta":1053,"slug":1055,"tags":1056,"categories":1058},"记忆中的食堂菜","吃了一口南瓜之后，我仿佛立刻回到了第一次被炒南瓜支配的那一天。",{"date":1054,"language":11,"comments":15},"2019-08-13","campus-canteen-memories",[1057,943],"食堂",[206],{"title":1060,"description":1061,"meta":1062,"slug":1064,"tags":1065,"categories":1067},"60天，指定幸存者","学者当上内阁长官，不谙官场的他惨被革职，却因此幸存成为代理总统。在重重的危机之下，他能带领国家走出困境吗？",{"date":1063,"language":11,"comments":15},"2019-07-08","designated-survivor",[1066,470],"政治剧",[34],{"title":1069,"description":1070,"meta":1071,"slug":1073,"tags":1074,"categories":1076},"校园霸凌团体F4的纯情恋爱物语——宝冢《流星花园》观后感","F4明明是校园霸凌团体，可是人们遗忘了霸道总裁做的那些足够进监狱的过分行为，只记住了甜甜的恋爱，这样好像哪里不太对？",{"date":1072,"language":11,"comments":15},"2019-06-29","boys-over-flowers",[1075,21,108],"宝塚",[34],{"title":1078,"description":1079,"meta":1080,"slug":1082,"tags":1083,"categories":1085},"人生初の宝塚歌劇鑑賞－－藤原鎌足の話を見ました","宝塚の星組が出演した『鎌足−夢のまほろば、大和（やまと）し美（うるわ）し−』を見ました。生中継でしたけど、十分楽しかったです。",{"date":1081,"language":569,"comments":15},"2019-05-25","takarazuka-musical-jp",[1075,21,1084],"レビュー",[34],{"title":1087,"description":1088,"meta":1089,"slug":1092,"tags":1093,"categories":1094},"如何减轻Nuxt打包生成的代码量","Nuxt默认会将所有vue文件使用的模块打包进最后的网站文件，所以最好不要在博客页渲染Markdown",{"date":1090,"language":11,"keywords":1091,"comments":15},"2019-05-18",[217],"lighten-nuxt-website",[973,338],[47],{"title":1096,"description":1097,"meta":1098,"slug":1101,"tags":1102,"categories":1104},"如何使用Nuxt建立个人博客","重构了一下博客，从Jekyll迁移到了Nuxt。方法是先用Node API 来解析 Markdown 文件，然后 Nuxt+Axios 获取 API 返回的文章内容并生成静态页面。",{"date":1099,"language":11,"keywords":1100,"comments":15},"2019-05-05",[217],"nuxt-blog-static-website",[973,836,338,1103],"静态博客",[47],[1106,1114,1122,1130,1143,1153],{"title":1107,"description":1108,"meta":1109,"slug":1111,"tags":1112,"categories":1113},"韩剧观后感之《阿尔罕布拉宫的回忆》和《死也很好》","看了十几年的韩剧，还是走不出套路",{"date":1110,"language":11,"comments":15},"2018-12-21","memories-of-the-alhambra-n-feel-good-to-die",[470],[34],{"title":1115,"description":1116,"meta":1117,"slug":1119,"tags":1120,"categories":1121},"阿尔罕布拉宫的回忆","十年前偶然在音乐节目里听过一首曲子，这么久都没有再听到过，没想到在韩剧里听到了，而且它还是这部韩剧的标题。这个世界实在是太奇妙了",{"date":1118,"language":11,"comments":15},"2018-12-10","memories-of-the-alhambra",[287,470],[34],{"title":1123,"description":1124,"meta":1125,"slug":1127,"tags":1128,"categories":1129},"我最喜欢的PC游戏——扫雷","我之前用原生JavaScript、jQuery、微信小程序写过3个版本的扫雷游戏，当我体验过类似Vue的微信小程序之后，学习Vue好像是自然而然的事，于是我终于用Vue写出了最让我满意的一个版本的扫雷~",{"date":1126,"language":11,"comments":15},"2018-11-18","minesweeper",[973,217,339],[47],{"titl