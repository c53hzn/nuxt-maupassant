:102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":690,"description":691,"extension":692,"meta":693,"navigation":96,"path":699,"seo":700,"slug":701,"stem":702,"tags":703,"__hash__":707},"blog\u002Fblog\u002F2022-01-02-async-data-in-component.md","如何在Nuxt组件里使用async data",{"type":122,"value":123,"toc":685},"minimark",[124,128,132,135,139,160,176,196,213,237,248,252,255,672,675,678,681],[125,126,127],"h2",{"id":127},"新年好",[129,130,131],"p",{},"大家新年好~",[129,133,134],{},"本来想着写点什么2021总结之类的，但是还没想好写啥，那就先来一篇技术类的吧。",[125,136,138],{"id":137},"组件内不能用async-data","组件内不能用async data",[129,140,141,142,148,149,153,154,159],{},"最近按照一个Hexo的网站主题Maupassant仿写了一个Nuxt的网站主题，原主题在这",[143,144,145],"a",{"href":145,"rel":146},"https:\u002F\u002Fgithub.com\u002Ftufu9441\u002Fmaupassant-hexo",[147],"nofollow","，我写的主题在这",[143,150,151],{"href":151,"rel":152},"https:\u002F\u002Fgithub.com\u002Fc53hzn\u002Fnuxt-maupassant",[147],"，页面范例 ",[143,155,158],{"href":156,"rel":157},"https:\u002F\u002Fwww.houzhenni.com\u002Fnuxt-maupassant\u002F",[147],"Nuxt-Maupassant | Jenny的小站","。",[129,161,162,163,167,168,171,172,175],{},"原主题的侧边栏分成了三个部分，文章分类、最近文章和友情链接，那么最理想的写法应该是写成 ",[164,165,166],"code",{},"components"," ，然后放在 ",[164,169,170],{},"layouts"," 里，这样 ",[164,173,174],{},"pages"," 文件里也不需要重复引用了。",[129,177,178,179,182,183,186,187,190,191,195],{},"此时有一个麻烦的地方是，Nuxt组件里面不能直接用 ",[164,180,181],{},"async data"," 方法加载数据，那么只能先在 ",[164,184,185],{},"data"," 里面留出位置，然后等 ",[164,188,189],{},"mounted"," 之后再往里面填数据，就跟我之前写的面包屑组件一样，参考我之前写的文章 ",[143,192,194],{"href":193},"\u002Fpost\u002Fnuxt-breadcrumbs-bilingual","如何制作中英双语的面包屑导航"," 。",[129,197,198,199,201,202,205,206,209,210,212],{},"那么问题来了， ",[164,200,189],{}," 里面不能用 ",[164,203,204],{},"async await"," ，那就只能回归 ",[164,207,208],{},"promise"," ，但是由于需要加载两个以上的数据，要么写成嵌套，要么写成链式，但是两个我都不喜欢，最好能有个迂回的方式，还是用 ",[164,211,204],{}," 最好。",[129,214,215,216,219,220,222,223,226,227,232,233,236],{},"找了一圈之后还真的找到了，",[164,217,218],{},"github"," 上有人提了个不能在组件内使用 ",[164,221,181],{}," 的 ",[164,224,225],{},"issue"," ，于是有好心人指路官方教程里的一篇 ",[143,228,231],{"href":229,"rel":230},"https:\u002F\u002Fnuxtjs.org\u002Fdocs\u002Ffeatures\u002Fdata-fetching\u002F",[147],"Data Fetching"," ，只要是 ",[164,234,235],{},"Nuxt 2.12+"," 以上的版本就能用。",[129,238,239,240,243,244,247],{},"这个也很重要，于是我赶紧看了一下 ",[164,241,242],{},"package.json"," ，我用的是 ",[164,245,246],{},"Nuxt 2.12.2"," ，那真是太好了，不用升级，也不用做什么特殊设定，那就开始整吧。",[125,249,251],{"id":250},"添加async-fetch方法并在mounted之后调用","添加async fetch方法并在mounted之后调用",[129,253,254],{},"代码如下：",[256,257,262],"pre",{"className":258,"code":259,"language":260,"meta":261,"style":261},"language-js shiki shiki-themes github-light github-dark","export default {\n    name: 'Aside',\n    data() {\n        return {\n            latestBlog: [],\n            categories: [],\n            friendSites: [\n                {\n                  href: \"https:\u002F\u002Fwww.baidu.com\",\n                  text: \"百度\"\n                },\n                {\n                  href: \"https:\u002F\u002Fwww.google.com\",\n                  text: \"谷歌\"\n                },\n                {\n                  href: \"https:\u002F\u002Fwww.bing.com\",\n                  text: \"必应\"\n                },\n                {\n                  href: \"https:\u002F\u002Fwww.qq.com\",\n                  text: \"腾讯\"\n                },\n            ]\n        };\n    },\n    async fetch() {\n        var that = this;\n        \u002F\u002FgetLatest5和getCategories是两个utils方法，这个不重要\n        var latestBlog = await getLatest5(that.$nuxt.context.$content);\n        var categories = await getCategories(that.$nuxt.context.$content);\n        \u002F\u002F把获取到的数据填入data的两个空位里\n        that.latestBlog = latestBlog;\n        that.categories = categories;\n    },\n    methods: {\n        getAside() {\n            this.$fetch();\n        }\n    },\n    mounted: function() {\n        var that = this;\n        that.$nextTick(() => {\n            that.getAside();\n        });\n    }\n}\n","js","",[164,263,264,279,291,300,307,313,318,323,329,340,348,354,359,369,376,381,386,396,404,409,414,424,432,437,442,448,454,465,484,491,509,526,532,543,554,559,565,573,588,594,599,613,626,643,654,660,666],{"__ignoreMap":261},[265,266,268,272,275],"span",{"class":267,"line":16},"line",[265,269,271],{"class":270},"szBVR","export",[265,273,274],{"class":270}," default",[265,276,278],{"class":277},"sVt8B"," {\n",[265,280,281,284,288],{"class":267,"line":34},[265,282,283],{"class":277},"    name: ",[265,285,287],{"class":286},"sZZnC","'Aside'",[265,289,290],{"class":277},",\n",[265,292,293,297],{"class":267,"line":19},[265,294,296],{"class":295},"sScJk","    data",[265,298,299],{"class":277},"() {\n",[265,301,302,305],{"class":267,"line":7},[265,303,304],{"class":270},"        return",[265,306,278],{"class":277},[265,308,310],{"class":267,"line":309},5,[265,311,312],{"class":277},"            latestBlog: [],\n",[265,314,315],{"class":267,"line":24},[265,316,317],{"class":277},"            categories: [],\n",[265,319,320],{"class":267,"line":39},[265,321,322],{"class":277},"            friendSites: [\n",[265,324,326],{"class":267,"line":325},8,[265,327,328],{"class":277},"                {\n",[265,330,332,335,338],{"class":267,"line":331},9,[265,333,334],{"class":277},"                  href: ",[265,336,337],{"class":286},"\"https:\u002F\u002Fwww.baidu.com\"",[265,339,290],{"class":277},[265,341,342,345],{"class":267,"line":95},[265,343,344],{"class":277},"                  text: ",[265,346,347],{"class":286},"\"百度\"\n",[265,349,351],{"class":267,"line":350},11,[265,352,353],{"class":277},"                },\n",[265,355,357],{"class":267,"line":356},12,[26