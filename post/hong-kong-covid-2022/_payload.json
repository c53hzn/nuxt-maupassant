[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-hong-kong-covid-2022":118,"surround-hong-kong-covid-2022":191},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":173,"description":174,"extension":175,"meta":176,"navigation":96,"path":183,"seo":184,"slug":185,"stem":186,"tags":187,"__hash__":190},"blog\u002Fblog\u002F2022-02-20-hong-kong-covid-2022.md","2022香港疫情又起",{"type":122,"value":123,"toc":170},"minimark",[124,128,131,134,137,140,143,146,149,152,155,158,161,164,167],[125,126,127],"p",{},"今天香港降温到10度以下了，是最高温度在10度以下，这已经很冷了，再加上刮风下雨，体感温度更冷了。",[125,129,130],{},"两个星期前也有一次降温，那次只是最低气温降到了10度，于是我买了个取暖器。这真是今年买的最划算的电器了，328港币，赶着苏宁电器收工前5分钟买完回家，立刻就用上了。",[125,132,133],{},"当时我还没想到接下来两个星期它的用处是如此之大，因为香港的第五波疫情突然大爆发，我们又开始在家上班，于是差不多每天大部分时间都开着，我终于不需要在家也穿两层羽绒服了。过去8年我怎么没想到买取暖器呢？",[125,135,136],{},"在单日确诊人数到300的时候，我已经感觉不妙，第二天就确诊600了。",[125,138,139],{},"那个“棋盘放米”的故事大家都听过，指数级增长是很可怕的。后来果然确诊突破1千，接着突破2千，然后缓慢到3千，现在6千。",[125,141,142],{},"两周前我的小区被要求强制检疫，我测了一次核酸，第二天傍晚收到检测结果的短信，是阴性。",[125,144,145],{},"但是随着需要检测的人数增加，出结果的速度也变慢了。这两天看大家发的各种内容，发现现在要收到检测结果都至少需要等3天，也有很多人5天才收到结果，那现在这个确诊人数至少滞后了3天吧？",[125,147,148],{},"虽然上次测核酸的结果是阴性，但是到我完全在家办公之前，还是有去过公司，也去过超市，谁知道会不会有事。",[125,150,151],{},"在家里呆着上班还好，但是一旦闲下来，就开始觉得浑身不对劲，然后就开始量体温，不管量多少次都是没发烧，但就是觉得哪儿哪儿都不舒服。",[125,153,154],{},"以前我是不舍得叫外卖的，最多是到店自取，这样可以省下20块钱的送餐费用。",[125,156,157],{},"但是现在实在是需要人家送上门了，于是就一次买两人份的饭菜，分两餐吃完。但是还想要别的东西就不行了。",[125,159,160],{},"其他食品、饮料、生活用品没有办法找人代购并送上门，淘宝买很不划算，而且需要时间送货，我不打算这样买，就只能等眼下的存货用完，再出门自己买了。",[125,162,163],{},"一个多星期没见的同事确诊了，小伙只能自己先居家隔离，不知道啥时候能被收治。",[125,165,166],{},"惨啊。",[125,168,169],{},"全文完。",{"title":171,"searchDepth":34,"depth":34,"links":172},"",[],[26],"客户问我某问题啥时候能解决，我说不好，要是问香港疫情啥时候结束我还能说两句，我觉得2022年不太可能。","md",{"date":177,"language":178,"keywords":179,"comments":96},"2022-02-20","中文",[180,181,182],"在家办公","WFH","确诊","\u002Fblog\u002F2022-02-20-hong-kong-covid-2022",{"title":120,"description":174},"hong-kong-covid-2022","blog\u002F2022-02-20-hong-kong-covid-2022",[188,189],"香港","新冠疫情","OT7PuxnLZLYmlIzY5QTs8szdR44BUTMgE_8mqft80ZU",[192,197],{"title":193,"path":194,"stem":195,"children":-1,"slug":196},"研究了一下《银魂》的茂茂将军，感叹一下无常的人生","\u002Fblog\u002F2022-01-25-gintama-shigeshige-and-tokugawa-iemochi","blog\u002F2022-01-25-gintama-shigeshige-and-tokugawa-iemochi","gintama-shigeshige-and-tokugawa-iemochi",{"title":198,"path":199,"stem":200,"children":-1,"slug":201},"推荐6首《银魂》的片头片尾主题曲","\u002Fblog\u002F2022-04-02-gintama-op-ed-recommendations","blog\u002F2022-04-02-gintama-op-ed-recommendations","gintama-op-ed-recommendations",1794550656875]