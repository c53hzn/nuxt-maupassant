[{"data":1,"prerenderedAt":576},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-hongkong-income-tax":118,"surround-hongkong-income-tax":565},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":547,"description":548,"extension":549,"meta":550,"navigation":96,"path":557,"seo":558,"slug":559,"stem":560,"tags":561,"__hash__":564},"blog\u002Fblog\u002F2021-09-07-hongkong-income-tax.md","如何在香港交税",{"type":122,"value":123,"toc":534},"minimark",[124,128,132,135,138,141,152,161,170,174,179,182,188,194,201,206,209,334,337,340,345,352,355,358,361,365,368,375,377,380,383,388,391,394,397,400,403,407,410,413,416,423,426,435,438,441,443,446,449,453,456,462,471,474,477,480,484,487,490,493,499,502,505,508,516,519,522,525,528,531],[125,126,127],"h2",{"id":127},"香港怎么交税",[129,130,131],"p",{},"Disclaimer: 本文仅讨论薪俸税，即香港的个人所得税，金额计算也仅根据我的个人理解。感谢阅读，仅供参考。",[129,133,134],{},"在香港工作，自然要交香港的税。",[129,136,137],{},"内地交个税是每个月公司直接帮你从工资里扣了交给税务局，但是香港是纳税人自己负责交。",[129,139,140],{},"当一个财政年，也就是前一年的4月1日至本年的3月31日结束后，税务局(Inland Revenue Department)会分批寄出报税表给纳税人，纳税人填写本财政年度内的全部收入并寄回给税务局。之后税务局会开始帮你计算，再过3到4个月，有时候可能过半年才算好。税务局会寄一个缴税单给纳税人，纳税人可按缴税单指示，一次性或者分两次缴清。",[129,142,143,144,151],{},"要看香港的税种介绍，可以到税务局的 ",[145,146,150],"a",{"href":147,"rel":148},"https:\u002F\u002Fwww.ird.gov.hk\u002F",[149],"nofollow","官网"," 看一看，我不多说，说了也不一定对。",[129,153,154,155,160],{},"关于内地居民在港工作的交税安排，可以参考国家税务总局的 ",[145,156,159],{"href":157,"rel":158},"http:\u002F\u002Fwww.chinatax.gov.cn\u002Fn810341\u002Fn810770\u002Fc1153751\u002F5131982\u002Ffiles\u002Fc16acf1d56e54289b6f81842f199f6d8.pdf",[149],"内地和香港特别行政区关于对所得避免双重征税和防止偷漏税的安排"," 。",[129,162,163,164,169],{},"我只在香港工作，只拿香港公司的工资，目前跟我自己有关的只有香港的 ",[145,165,168],{"href":166,"rel":167},"https:\u002F\u002Fwww.gov.hk\u002Ftc\u002Fresidents\u002Ftaxes\u002Ftaxfiling\u002Ftaxrates\u002Fsalariesrates.htm",[149],"薪俸税"," (Salaries Tax)。",[125,171,173],{"id":172},"上班族税款计算salaries-tax-calculation","上班族税款计算(Salaries Tax Calculation)",[175,176,178],"h3",{"id":177},"本年度税款income-tax-for-the-year-of-assessment","本年度税款(Income Tax for the Year of Assessment)",[129,180,181],{},"假设我是一个工时996，月薪17k的洗碗工，过年奖金5k来算，一年总收入为：",[129,183,184],{},[185,186,187],"code",{},"17,000*12 + 5,000 = 209,000 HKD",[129,189,190,191],{},"扣除强积金之后，到手的实际收入为 ",[185,192,193],{},"209,000*95% = 198,550 HKD",[129,195,196,197,200],{},"最近几年的年收入起征点(基本免税额 Basic Allowance)都是 ",[185,198,199],{},"132,000 HKD","，由于除了强积金之外没有其他减免事项(Tax Allowances)，那么应税收入(Taxable Income)就是",[129,202,203],{},[185,204,205],{},"198,550 - 132,000 = 66,550 HKD",[129,207,208],{},"2021年薪俸税阶梯税率(Progressive Rate)",[210,211,212,231],"table",{},[213,214,215],"thead",{},[216,217,218,222,225,228],"tr",{},[219,220,221],"th",{},"层级",[219,223,224],{},"收入$",[219,226,227],{},"稅率",[219,229,230],{},"稅款$",[232,233,234,249,262,274,286,298,310,322],"tbody",{},[216,235,236,240,243,246],{},[237,238,239],"td",{},"首",[237,241,242],{},"50,000",[237,244,245],{},"2%",[237,247,248],{},"1,000",[216,250,251,254,256,259],{},[237,252,253],{},"另",[237,255,242],{},[237,257,258],{},"6%",[237,260,261],{},"3,000",[216,263,264,266,269,271],{},[237,265],{},[237,267,268],{},"100,000",[237,270],{},[237,272,273],{},"4,000",[216,275,276,278,280,283],{},[237,277,253],{},[237,279,242],{},[237,281,282],{},"10%",[237,284,285],{},"5,000",[216,287,288,290,293,295],{},[237,289],{},[237,291,292],{},"150,000",[237,294],{},[237,296,297],{},"9,000",[216,299,300,302,304,307],{},[237,301,253],{},[237,303,242],{},[237,305,306],{},"14%",[237,308,309],{},"7,000",[216,311,312,314,317,319],{},[237,313],{},[237,315,316],{},"200,000",[237,318],{},[237,320,321],{},"16,000",[216,323,324,327,329,332],{},[237,325,326],{},"余额",[237,328],{},[237,330,331],{},"17%",[237,333],{},[129,335,336],{},"(高收入人士另有计算方法，请咨询专业人员)",[129,338,339],{},"所以就是第一个50k的应税收入要交2%，剩下的16,550要交6%，合计为",[129,341,342],{},[185,343,344],{},"50,000*2% + 16,550*6% = 1,993 HKD",[129,346,347,348,351],{},"那么这里的 ",[185,349,350],{},"1,993 HKD"," 就是本年度的应缴税款了，但是是不是直接交 1,993 HKD 就完事了呢？",[129,353,354],{},"不是哦，政府会对本年度的应缴税款有宽免，2021年的宽免程度是100%（上限10k），也就是说，针对2020到2021年度的实际收入的征税，税款金额在1万以下的，全都免了。",[129,356,357],{},"那么是不是今年一分钱都不用交了呢？",[129,359,360],{},"不是哦！",[175,362,364],{"id":363},"下年度暂缴税provision-tax","下年度暂缴税(Provision Tax)",[129,366,367],{},"当我们算出针对2020到2021年度的实际收入的税款之后，政府会认为你下一年还会保持这个收入状况，所以要针对2021到2022年度的预计收入征收一个和本年度等额的暂缴税，也就是 1,993 HKD 。",[129,369,370,371,374],{},"那么结合本年度的税款，合计为 ",[185,372,373],{},"0 + 1,993 = 1,993 HKD"," ，我们要交的税是不是 1,993 HKD 呢？",[129,376,360],{},[129,378,379],{},"2020年的时候，曾经针对2020到2021年度的预计收入交过暂缴税。",[129,381,382],{},"假设2020年底我这个洗碗工有加薪，2020到2021年度的收入高于2019到2020年度，去年的暂缴税不够扣，我们就算它是 1,883 HKD 好了，中间有个差价，再来算一算。",[129,384,385],{},[185,386,387],{},"1,993 - 1,883 = 100 HKD",[129,389,390],{},"好了，这就是我们2021年要交的钱了。",[129,392,393],{},"但是前面算了这么久，又是 1,993 ，又是 1,883 的，为什么最后却只要交 100 块呢？",[129,395,396],{},"那是因为去年交的钱是记在你的账上，用来抵扣今年产生的税款，但是今年的税款已经被全额宽免了，所以就用来抵扣暂缴税。但是你涨工资了，今年的暂缴税金额也涨了，去年交的暂缴税的金额不足，所以你要补交 100 块。",[129,398,399],{},"虽然你只交了 100 块，但是现在你在政府那里的暂缴税余额是 1,993 HKD，等到下一年再用来抵扣对实际收入的征税。",[129,401,402],{},"你明白了吗？",[125,404,406],{"id":405},"如何报税file-tax-return","如何报税(File Tax Return)",[129,408,409],{},"当你开始工作以后，每年的4月，公司会帮你统计前一年4月1日到这一年3月31日期间给你的工资，给你一个工资单，同时提交到税务局，然后税务局就知道要给你发信了。",[129,411,412],{},"假设你中间换过工作，则这些公司会分别给你出工资单，你需要在报税表上全都写明。",[129,414,415],{},"我在过去几年的5月到8月期间都收到过报税单，它是用一个很大的绿色信封装着，长下面这样。",[129,417,418],{},[419,420],"img",{"alt":421,"src":422},"Tax Return","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F132364098-cd6eab2b-baca-410e-918b-84482b44d41f.jpeg",[129,424,425],{},"这是2017年的回归20周年纪念版哦~",[129,427,428,429,434],{},"至于里面的报税表，由于我都交上去了，现在手里没有空表，大家就看看税务局的 ",[145,430,433],{"href":431,"rel":432},"https:\u002F\u002Fwww.ird.gov.hk\u002Fchi\u002Fpdf\u002Find_ctrc_demo.pdf",[149],"报税表样本"," 吧。",[129,436,437],{},"大的绿信封里除了报税表之外还附有一个小的绿信封，用来寄回填好的报税表。这个是要贴邮票的！",[129,439,440],{},"那么如果我不寄回报税表，是不是税务局就没法计税了？",[129,442,360],{},[129,444,445],{},"据说，如果你没有在限期内寄回报税表，税务局就会直接按照各个公司提交到税务局的金额给你计算应税收入，而由于你没有主动申报免税事项，所以就只能有一个基本免税额，然后应税金额就会很大，税款也会很多，那多不好啊。",[129,447,448],{},"所以，我们收到绿色大信封之后就要好好填写，并在限期内寄回税务局。",[125,450,452],{"id":451},"如何缴税pay-tax-bill","如何缴税(Pay Tax Bill)",[129,454,455],{},"报税表提交后，通常隔3个月才会收到缴税单(Demand Note)，它是装在一个白色的普通尺寸的信封里。",[129,457,458],{},[419,459],{"alt":460,"src":461},"Tax bill","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F132364179-f3bc3fbd-a981-4406-ab2c-b8459fba8592.jpeg",[129,463,464,465,470],{},"而缴税单的样本是 ",[145,466,469],{"href":467,"rel":468},"https:\u002F\u002Fwww.ird.gov.hk\u002Fchs\u002Fpdf\u002Firc6401c.pdf",[149],"这样的","。",[129,472,473],{},"里面会帮你列明各个事项，计算应税收入，用阶梯税率算出税款，然后得出暂缴税的金额，减掉政府的宽免，再减去前一年的暂缴税，得出最后的金额。",[129,475,476],{},"你可以一次性缴清，或者按要求分两次缴清。付款方式有很多，我试过用信用卡和储蓄卡的网上银行缴付，最近还试过用 FPS(转数快) 扫二维码支付，总之有很多种办法。",[129,478,479],{},"当然，前提是你真的需要交钱。",[125,481,483],{"id":482},"退税tax-refund","退税(Tax Refund)",[129,485,486],{},"前面说了，如果前一年的暂缴税不足以抵扣今年的实际收入征税和暂缴税，你要补钱。",[129,488,489],{},"可是如果你像我一样很不幸，这一年的收入下降了，去年的暂缴税比今年的实际收入征税和暂缴税还多了，这时候就会发生退税。",[129,491,492],{},"税务局照样会出缴税单给你，只不过里面会写明计算过程，告诉你不用交钱，政府反而还要给你退钱，并附上一张支票，长这样。",[129,494,495],{},[419,496],{"alt":497,"src":498},"Tax Refund","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F132334827-9915ccf5-2d0e-4e17-91fc-0631d5134ad3.jpeg",[129,500,501],{},"拿到支票以后，可以在支票背面写上自己的银行账号和联络信息，然后去银行存到自己账上。",[129,503,504],{},"需要注意的是，周六银行柜台不收支票，你可以自己写好信息，投入支票存款箱就行了，最多两个工作日到账。",[125,506,507],{"id":507},"搬家后要通知税务局",[129,509,510,511,160],{},"由于需要收取纸质的报税表和缴税单，我们必须让税务局及时知道我们的住址变更，具体方式可以参考税务局的 ",[145,512,515],{"href":513,"rel":514},"https:\u002F\u002Fwww.ird.gov.hk\u002Fchi\u002Ftax\u002Find_nca.htm",[149],"官方说明",[129,517,518],{},"如果因为没能及时收到报税表和缴税单而延误交税，可能要负法律责任，我听说有人因此收过律师信。",[125,520,521],{"id":521},"尾声",[129,523,524],{},"写完这么多，我快不认识这个“税”字了。。。",[129,526,527],{},"富兰克林曾经说过：“这个世界上唯有死亡和税收不可避免。”",[129,529,530],{},"死亡有点难了解，我们还是先了解一下税收吧！",[129,532,533],{},"全文完。",{"title":535,"searchDepth":34,"depth":34,"links":536},"",[537,538,542,543,544,545,546],{"id":127,"depth":34,"text":127},{"id":172,"depth":34,"text":173,"children":539},[540,541],{"id":177,"depth":19,"text":178},{"id":363,"depth":19,"text":364},{"id":405,"depth":34,"text":406},{"id":451,"depth":34,"text":452},{"id":482,"depth":34,"text":483},{"id":507,"depth":34,"text":507},{"id":521,"depth":34,"text":521},[26],"在香港工作的内地居民如何交税？薪俸税、暂缴税、退税又是怎么回事？","md",{"date":551,"language":552,"keywords":553,"comments":96},"2021-09-07","中文",[554,555,556],"Income tax","Salaries Tax","Inland Revenue","\u002Fblog\u002F2021-09-07-hongkong-income-tax",{"title":120,"description":548},"hongkong-income-tax","blog\u002F2021-09-07-hongkong-income-tax",[562,563,168],"香港","个税","yjO881EVZfLHuwmH7S7eQzYisaoUU4l8Nu7haX89J_s",[566,571],{"title":567,"path":568,"stem":569,"children":-1,"slug":570},"握不住的正义——《恶魔法官》剧评","\u002Fblog\u002F2021-08-23-devil-judge","blog\u002F2021-08-23-devil-judge","devil-judge",{"title":572,"path":573,"stem":574,"children":-1,"slug":575},"Hong Kong Income Tax for Non-local Employees","\u002Fblog\u002F2021-09-14-hongkong-income-tax-en","blog\u002F2021-09-14-hongkong-income-tax-en","hongkong-income-tax-en",1794550657003]