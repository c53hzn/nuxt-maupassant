[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-campus-canteen-memories":118,"surround-campus-canteen-memories":193},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":179,"description":180,"extension":181,"meta":182,"navigation":96,"path":185,"seo":186,"slug":187,"stem":188,"tags":189,"__hash__":192},"blog\u002Fblog\u002F2019-08-13-campus-canteen-memories.md","记忆中的食堂菜",{"type":122,"value":123,"toc":176},"minimark",[124,128,131,134,137,140,143,146,149,152,155,158,161,164,167,170,173],[125,126,127],"p",{},"刚才吃了一个炒菜，餐厅很神奇地把南瓜加进来了。",[125,129,130],{},"吃了一口之后，我仿佛立刻回到了第一次被炒南瓜支配的那一天。",[125,132,133],{},"话说那是十年前，我去到一个崭新的城市上大学，从来没吃过食堂的我在校园卡充值机上充好值，兴冲冲地去排队买饭了。",[125,135,136],{},"记得那是一道南瓜炒南瓜，对，我校食堂喜欢用蔬菜炒自己，这种通常比较便宜，可能是5毛钱一份。",[125,138,139],{},"一直以来我都只吃过烀南瓜，从来没有吃过炒的，这算是打开了新世界的大门了。",[125,141,142],{},"我吃了一口之后，心中不禁感叹，原来这就是传说中的食堂菜啊，真是如传说中的一样难吃。",[125,144,145],{},"后来才觉得，这可能是食堂为了不让我们对食堂菜抱有太多希望，故意先把好吃的都藏起来，让我们以后慢慢发现。",[125,147,148],{},"在蔬菜炒自己的这个菜系里，排在最底层的是青菜炒青菜，只要2毛钱。食堂同时还有个不成文的规矩，如果是女生打饭，只给3毛钱的白饭，而如果是男生，则给5毛钱的白饭。所以如果女生打了3毛的饭，再加2毛的青菜，则一顿饭只需要5毛钱。",[125,150,151],{},"我是女生，如果不提前说的话，打饭的食堂员工就会默认给我3毛的饭，但是我通常要吃5毛的才能吃饱。打饭时提前要求的话，就能有5毛的饭，否则就会给我3毛的。",[125,153,154],{},"每次被默认给了3毛的饭之后，我都会腹诽一句“看不起我是吧”，然后再要2毛的饭。",[125,156,157],{},"其实这样反而会拿到比5毛还多的饭，后来我自己琢磨出规律了，就故意等食堂员工给我打了3毛的饭之后再要2毛的。",[125,159,160],{},"在蔬菜炒自己的菜系中，排在顶端的是茄子炒茄子和丝瓜炒丝瓜，竟然要3块钱。要知道有些荤素搭配的菜也不过才2块，而茄子和丝瓜竟能独占3块，而且你还抢不到！",[125,162,163],{},"然后就到了纯荤菜类，大家首选一定是4块钱的红烧肉，可是想要抢到红烧肉的话，必须中午一下课就往食堂赶，而且要全速奔跑冲进去，才能在已经排了很长的红烧肉队列找到自己的位置。",[125,165,166],{},"如果你是慢慢悠悠走进去的话，对不起，即使排到你，红烧肉也是已经没有了的。",[125,168,169],{},"由于红烧肉的竞争太过激烈，而我又不喜欢为了一口吃的跑来跑去，所以大学四年内吃红烧肉的次数竟是屈指可数。",[125,171,172],{},"跑题了，说回炒南瓜。",[125,174,175],{},"大学毕业之后，我竟再也没有吃到过炒南瓜了。",{"title":177,"searchDepth":34,"depth":34,"links":178},"",[],[26],"吃了一口南瓜之后，我仿佛立刻回到了第一次被炒南瓜支配的那一天。","md",{"date":183,"language":184,"comments":96},"2019-08-13","中文","\u002Fblog\u002F2019-08-13-campus-canteen-memories",{"title":120,"description":180},"campus-canteen-memories","blog\u002F2019-08-13-campus-canteen-memories",[190,191],"食堂","大学","5hXgoAMQO4FeUfJXRuuO13WQAjrL3FQ2DOlBk3Ixdgg",[194,199],{"title":195,"path":196,"stem":197,"children":-1,"slug":198},"60天，指定幸存者","\u002Fblog\u002F2019-07-08-designated-survivor","blog\u002F2019-07-08-designated-survivor","designated-survivor",{"title":200,"path":201,"stem":202,"children":-1,"slug":203},"沙雕小说沙雕剧，拆我CP虐我心——《少年江湖物语》观后感","\u002Fblog\u002F2019-08-17-the-birth-of-the-drama-king","blog\u002F2019-08-17-the-birth-of-the-drama-king","the-birth-of-the-drama-king",1794501664178]