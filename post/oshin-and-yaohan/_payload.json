[{"data":1,"prerenderedAt":263},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-oshin-and-yaohan":118,"surround-oshin-and-yaohan":254},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":116,"body":120,"categories":239,"description":240,"extension":241,"meta":242,"navigation":96,"path":248,"seo":249,"slug":117,"stem":250,"tags":251,"__hash__":253},"blog\u002Fblog\u002F2023-03-14-oshin-and-yaohan.md",{"type":121,"value":122,"toc":230},"minimark",[123,127,131,134,137,140,143,146,149,152,155,158,161,164,167,170,173,176,179,182,185,188,192,195,198,201,204,208,211,214,217,220,224,227],[124,125,126],"h2",{"id":126},"我手疼",[128,129,130],"p",{},"右手疼了一个星期了，每当大拇指屈伸的时候，手腕内侧的一条筋就钻心地痛，无法发力。",[128,132,133],{},"但是这居然不影响上班，因为敲键盘、按鼠标的时候不用屈伸大拇指，我也不怎么需要写字，所以竟然也能完成工作。",[128,135,136],{},"而且神奇的是，经过一天的辛劳，晚上回去的时候能感觉到疼痛有所缓解，但是睡一晚又开始疼。",[128,138,139],{},"也许又是睡姿问题？上次左上臂内侧疼痛，医生说是拉伤，过了几天自己好了，这次希望也能快点好吧。",[128,141,142],{},"如果我不是坐办公室的，而是做体力劳动，经常要动手的话，恐怕就做不了了。",[128,144,145],{},"于是想到了以前看过的日剧《阿信》。",[124,147,148],{"id":148},"日剧阿信",[128,150,151],{},"这是一部日本八十年代的电视剧，我中学的时候在湖南台看过重播的《阿信》，当时我妈妈特别高兴，因为这是她小时候看过的。",[128,153,154],{},"勤劳的阿信在美发屋给顾客做发型，她设计出的发型又新颖又好看，顾客都很喜欢，她也因此赚到了钱，这都靠她灵巧的一双手。",[128,156,157],{},"后来她的右手不幸受伤，再也无法灵活操作美发工具，只好离开了这一行。",[128,159,160],{},"这不就是现在的我吗？",[124,162,163],{"id":163},"香港八佰伴",[128,165,166],{},"因为想到了阿信，顺手就查了一下她的角色原型，也就是日本八佰伴百货的创始人和田加津。",[128,168,169],{},"然后发现八佰伴破产前在香港开过几家分店，其中一家在九龙的黄埔花园。",[128,171,172],{},"我曾经因为工作原因，经常去黄埔花园，那里有一个船形建筑十分醒目，算是一个地标。",[128,174,175],{},"我心想，该不会是那里吧？",[128,177,178],{},"于是再搜索一下，发现真的就是那里。",[128,180,181],{},"八佰伴在八十年代后期开始在香港发展，1993年的时候和田加津去世了，而4年后八佰伴竟然就破产了。",[128,183,184],{},"然后我就想到了这两天的硅谷银行破产事件，真是令人唏嘘啊。",[128,186,187],{},"全文完。",[124,189,191],{"id":190},"_2023-04-03更新还没好","2023-04-03更新：还没好",[128,193,194],{},"4月份了，更新一下情况，手还在疼，不知道什么时候能好。",[128,196,197],{},"右手可以拖动十几斤的重物，可以拿起装满水的杯子，但是无法提起装满水的热水壶。",[128,199,200],{},"最近在重温《基本演绎法》，看到贝尔中枪，抢救时发生血栓，导致右手丧失部分机能，我突然觉得我是不是也是这样，睡觉的时候压到了右手，导致右手因为缺血而变成这样的呢？",[128,202,203],{},"希望赶紧好起来 T_T",[124,205,207],{"id":206},"_2023-04-11更新好像是腱鞘炎","2023-04-11更新：好像是腱鞘炎",[128,209,210],{},"右手的手腕疼了一个多月了，手腕内侧大拇指连着的筋特别疼，晚上严重，白天减轻，握拳向外压时有痛感。",[128,212,213],{},"我一直觉得是肌肉拉伤，希望它自己好起来，最近也确实有减轻的趋势，所以我没有特别找资料。",[128,215,216],{},"然后精彩的来了，昨天刷小红书的时候它给我推送治疗腱鞘炎的贴子，我的症状全中，终于破案了。",[128,218,219],{},"小红书不光监听我说话，还会智能分析病症，这也太神奇了。",[124,221,223],{"id":222},"_2023-07-05更新能拿起水壶了","2023-07-05更新：能拿起水壶了",[128,225,226],{},"现在右手可以拿起装满水的水壶了，之前如果像这样在垂直方向上持续发力，整个手腕就会剧烈、持续地感到痛楚，现在好不容易不会这么疼了。",[128,228,229],{},"但是右手向内转的时候还是会感到疼，如果摆出弹钢琴的姿势也会疼，写字写撇的时候不疼，写捺的时候疼，不过现在疼痛减轻了。",{"title":231,"searchDepth":34,"depth":34,"links":232},"",[233,234,235,236,237,238],{"id":126,"depth":34,"text":126},{"id":148,"depth":34,"text":148},{"id":163,"depth":34,"text":163},{"id":190,"depth":34,"text":191},{"id":206,"depth":34,"text":207},{"id":222,"depth":34,"text":223},[6],"命运坎坷的阿信，和我竟然有不止一个关联点。","md",{"date":243,"language":244,"keywords":245,"comments":96},"2023-03-14","中文",[246,247],"和田加津","和田一夫","\u002Fblog\u002F2023-03-14-oshin-and-yaohan",{"title":116,"description":240},"blog\u002F2023-03-14-oshin-and-yaohan",[252,148],"腱鞘炎","WOTDs9TdbO8OercAiSdPF6h1tG6ROfxcNimtO0DS9CQ",[255,260],{"title":256,"path":257,"stem":258,"children":-1,"slug":259},"Mad Men 6x08, it's your job, it's also gaslighting at workplace","\u002Fblog\u002F2023-03-09-gaslighting-at-workplace","blog\u002F2023-03-09-gaslighting-at-workplace","gaslighting-at-workplace",{"title":113,"path":261,"stem":262,"children":-1,"slug":114},"\u002Fblog\u002F2023-03-16-sherlock-holmes-and-h-h-holmes","blog\u002F2023-03-16-sherlock-holmes-and-h-h-holmes",1794550655080]