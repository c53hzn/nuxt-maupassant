[{"data":1,"prerenderedAt":192},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-stand-with-rowling":118,"surround-stand-with-rowling":181},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":167,"description":168,"extension":169,"meta":170,"navigation":96,"path":173,"seo":174,"slug":175,"stem":176,"tags":177,"__hash__":180},"blog\u002Fblog\u002F2020-06-13-stand-with-rowling.md","女性失权，从名字始——罗琳事件有感",{"type":122,"value":123,"toc":164},"minimark",[124,128,131,134,137,140,143,146,149,152,155,158,161],[125,126,127],"p",{},"今天我是一个“来月经的愤怒的人”，我来说一下我的愤怒。",[125,129,130],{},"当我知道有的人在看到“来月经的人”这样的表述时不会愤怒，我真的非常惊讶。",[125,132,133],{},"你寒门出身却成绩优异，或者家境优越却不怕苦不怕累，做事手脚麻利或者慢条斯理，性格外向奔放或者内敛含蓄，别人全都不关心，人家只关心你会不会来月经，会不会“每个月总有几天”不能完成工作学习任务，会不会突然跑去结婚生孩子。",[125,135,136],{},"就是不关心你自己是谁。",[125,138,139],{},"那些反对所谓的“TERF”的人，有的人想通过贬低哈利波特来贬低罗琳，说“我睡觉的时候也能写出来”，而另一方面，喜欢哈利波特又想在此次事件中反对罗琳的则宣布将罗琳剥夺作者的名号。",[125,141,142],{},"但是罗琳的名字早就被你们剥夺过了，不记得了吗？有几个人知道她叫Joanne？",[125,144,145],{},"因为Joanne这个名字会让人联想到一个“来月经的人”，出版社就让她用字母缩写JK来出版，然后果然书卖得很好。",[125,147,148],{},"看到这条新闻的时候我还小，当时首先是觉得惊讶，为什么作者是女性名字会影响卖书？接着我感受到了愤怒，就像现在一样，就因为她是“来月经的人”，她的作品都不能署自己的名字？",[125,150,151],{},"不能和特殊人群共情，确实不符合罗琳一直以来的儿童读物作者的形象，但是这就罪大恶极了吗？需要你们在剥夺过她的名字之后，再来剥夺一次？",[125,153,154],{},"我又想起看《平常心》时感到的不适了，主角们要寻求支持的时候第一时间找了一位坐在轮椅上的女性，为什么？她自己还没有得到足够的帮助，为什么需要她“站”出来帮他们维权？",[125,156,157],{},"她帮了，成就了一个故事。要是她没有能力帮，或者没那么情愿帮呢？",[125,159,160],{},"对女性提出过高的道德要求，让女性违背本心支持别人，这绝不是正常的社会里应该出现的事情。",[125,162,163],{},"言尽于此。",{"title":165,"searchDepth":34,"depth":34,"links":166},"",[],[21],"被群起而攻之的罗琳，真的罪大恶极吗？","md",{"date":171,"language":172,"comments":96},"2020-06-13","中文","\u002Fblog\u002F2020-06-13-stand-with-rowling",{"title":120,"description":168},"stand-with-rowling","blog\u002F2020-06-13-stand-with-rowling",[178,179],"女权","哈利·波特","UpxTPszoMrUdWtWTVwyRumWdUGGzysvvYFOq36a-3cY",[182,187],{"title":183,"path":184,"stem":185,"children":-1,"slug":186},"论室友关系","\u002Fblog\u002F2020-06-07-roommate-relationship","blog\u002F2020-06-07-roommate-relationship","roommate-relationship",{"title":188,"path":189,"stem":190,"children":-1,"slug":191},"Deprived of rights, starting with her name","\u002Fblog\u002F2020-07-12-stand-with-rowling-en","blog\u002F2020-07-12-stand-with-rowling-en","stand-with-rowling-en",1794501664065]