[{"data":1,"prerenderedAt":179},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-memories-about-pandemics":118,"surround-memories-about-pandemics":168},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":155,"description":156,"extension":157,"meta":158,"navigation":96,"path":161,"seo":162,"slug":163,"stem":164,"tags":165,"__hash__":167},"blog\u002Fblog\u002F2020-02-01-memories-about-pandemics.md","关于疫病的记忆",{"type":122,"value":123,"toc":152},"minimark",[124,128,131,134,137,140,143,146,149],[125,126,127],"p",{},"今天是2月1号，距离2019年才刚过去一个月，可是感觉已经像是过了半年之久，尤其是最近10天，1天就像是一个星期那么长。",[125,129,130],{},"17年前我还是个对世界一无所知的小学生，每天烦恼的是“天气太冷，手又拿不动笔该怎么办”，或者“szy这个傻x又欺负我了，我是该拿脚踹他还是拿书敲他呢”这种令人头疼却无法解决的问题，所以当我知道不用去上学的时候，我的内心是愉快的，甚至是雀跃的。",[125,132,133],{},"不用上学的一个月里，我一步也没有出过门，专心在家看动漫。感谢互联网，让我足不出户也能看到别国的文化作品，也让我走上了学日语的不归路。如果不是因为现在是要上班的年纪，我还可以再来一个月不出门。",[125,135,136],{},"然而这次我生病了。喉咙肿痛，声音嘶哑，伴随着咳嗽和发烧。",[125,138,139],{},"虽然今年完全没有接近过湖北省，但是心里还是有点发怵。然而还是抱着侥幸心理，自己吃药抗病。",[125,141,142],{},"然后就到了今天，终于是不发烧了，喉咙症状也没那么严重了，如果没有呼吸冷空气也不会咳嗽了。但要是就这样回去，不管在什么交通工具上估计都得吓着旁人。",[125,144,145],{},"可是不能不回去啊，人类之所以是人类，就是因为要工作。",[125,147,148],{},"在微博上看到曾经的客户因为强迫员工按时开工而享受了万转和全网群嘲的待遇，以及浙江某日确诊人数暴涨是因为有企业开会，30个人里感染了11个，我的心情有点复杂。",[125,150,151],{},"希望今年能顺利吧。",{"title":153,"searchDepth":34,"depth":34,"links":154},"",[],[26],"2020年啊，不要再考验我了","md",{"date":159,"language":160,"comments":96},"2020-02-01","中文","\u002Fblog\u002F2020-02-01-memories-about-pandemics",{"title":120,"description":156},"memories-about-pandemics","blog\u002F2020-02-01-memories-about-pandemics",[166],"COVID-19","EZ4e_E_B9Vte1qr0E6B_ceNiiOakJc8cH2LTGcPXSQM",[169,174],{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"2019年的小总结","\u002Fblog\u002F2020-01-31-summary-of-my-life-in-2019","blog\u002F2020-01-31-summary-of-my-life-in-2019","summary-of-my-life-in-2019",{"title":175,"path":176,"stem":177,"children":-1,"slug":178},"专门安利一下《端脑》","\u002Fblog\u002F2020-02-13-tv-drama-die-now","blog\u002F2020-02-13-tv-drama-die-now","tv-drama-die-now",1794547929778]