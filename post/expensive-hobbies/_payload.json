[{"data":1,"prerenderedAt":237},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-expensive-hobbies":118,"surround-expensive-hobbies":226},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":210,"description":211,"extension":212,"meta":213,"navigation":96,"path":219,"seo":220,"slug":221,"stem":222,"tags":223,"__hash__":225},"blog\u002Fblog\u002F2022-01-21-expensive-hobbies.md","培养一个不要钱的爱好吧",{"type":122,"value":123,"toc":204},"minimark",[124,128,132,135,138,141,144,147,150,153,156,159,162,165,168,188,195,198,201],[125,126,127],"h2",{"id":127},"学画画吗",[129,130,131],"p",{},"之前看了一个月的JoJo，已经追平了，然后开始补《银魂》，现在也看了二十多集了。",[129,133,134],{},"然后就产生了想画画的冲动，在横线本上画了几个喜欢的角色的大头，又画了几个名场面。",[129,136,137],{},"由于没有什么功底，如果不看着画面临摹就没法画，而且也只能画没有光影关系的线条简笔画。虽然算是能画出来，可是自己总是觉得不太满意。",[129,139,140],{},"然后就是手机拍照加修图，曝光调高75，对比度拉满，这样背景就纯白了，再手动涂抹清除笔记本的横线，还有因为手抖而不小心画出的线条或是为了标位置而轻点的虚线，这样一来图片就干净很多了。",[129,142,143],{},"手机真的很好用啊，可惜就是太费手指了，于是产生了买数码绘图板的想法。",[129,145,146],{},"研究了一下才发现，原来绘图板还分为两种。",[129,148,149],{},"一种是像个大号的电脑触摸板，可以用触控笔在上面画画，但是因为板子本身并不显示图像，绘图者必须手眼分离，一边看电脑屏幕，一边对应屏幕上的光标来摸索着画。另一种可以显示图像，看起来跟平板电脑差不多。",[129,151,152],{},"第一种比较便宜，价格低至两三百，缺点前面说过了。第二种比较贵，要几千块，可是为什么不直接买个平板电脑呢？加个触控笔就可以直接画了。",[129,154,155],{},"而且板子必须连电脑用，画画需要使用PS、Sai等软件。于是难题又来了，我的破电脑不知道能不能正常运行板子的驱动程序，而PS这样的软件只要用一会，系统内存就不够用了，需要关闭PS再重启才能继续用。",[129,157,158],{},"这么一分析，我应该是和板子无缘了，还是继续用本子画吧。",[125,160,161],{"id":161},"还是学外语和编程吧",[129,163,164],{},"在我所有的人兴趣爱好里面，外语和编程对设备的要求没有这么高，所以才能坚持这么久，想想真是伤心啊。",[129,166,167],{},"不管学什么语，左不过就是多听多模仿，然后记在脑子里，或者找个网络单词本记一下，而不用记在电脑里，可以算是零成本了。",[129,169,170,171,175,176,179,180,183,184,187],{},"而编程，倒也不是完全没有要求。我的电脑执行一次 ",[172,173,174],"code",{},"npm install"," 需要半小时，而 ",[172,177,178],{},"nuxt"," 项目执行 ",[172,181,182],{},"npm run dev"," 或者 ",[172,185,186],{},"npm run generate"," 都需要至少10分钟，所以效率上会打一些折扣，但也不是不行。",[129,189,190,191,194],{},"在Github开放免费账号使用自动部署服务 ",[172,192,193],{},"Actions"," 之前，我得在自己电脑里完成整个修改和部署流程，即使是一个小的修改都需要半小时。如果在等待的时间里分神去做别的，可能没法及时做下一个步骤，又拖慢了时间。",[129,196,197],{},"有了Actions之后，改好代码，push上去，等2分钟就部署好了，真是感谢Github。",[125,199,200],{"id":200},"我有一个梦想",[129,202,203],{},"人类生生不息，贫穷依然不止，我啥时候才能脱贫致富呢？",{"title":205,"searchDepth":34,"depth":34,"links":206},"",[207,208,209],{"id":127,"depth":34,"text":127},{"id":161,"depth":34,"text":161},{"id":200,"depth":34,"text":200},[26],"买板子这么贵啊，那我不学画画了。","md",{"date":214,"language":215,"keywords":216,"comments":96},"2022-01-21","中文",[217,218],"画画","板绘","\u002Fblog\u002F2022-01-21-expensive-hobbies",{"title":120,"description":211},"expensive-hobbies","blog\u002F2022-01-21-expensive-hobbies",[224],"吐槽","01oi-Sx5EUTuXf3_GsnZMdh2Pp_hW_GMhEKbiC6NbIA",[227,232],{"title":228,"path":229,"stem":230,"children":-1,"slug":231},"如何在Nuxt组件里使用async data","\u002Fblog\u002F2022-01-02-async-data-in-component","blog\u002F2022-01-02-async-data-in-component","async-data-in-component",{"title":233,"path":234,"stem":235,"children":-1,"slug":236},"研究了一下《银魂》的茂茂将军，感叹一下无常的人生","\u002Fblog\u002F2022-01-25-gintama-shigeshige-and-tokugawa-iemochi","blog\u002F2022-01-25-gintama-shigeshige-and-tokugawa-iemochi","gintama-shigeshige-and-tokugawa-iemochi",1794550656884]