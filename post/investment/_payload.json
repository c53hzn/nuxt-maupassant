[{"data":1,"prerenderedAt":249},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-investment":118,"surround-investment":238},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":221,"description":222,"extension":223,"meta":224,"navigation":96,"path":231,"seo":232,"slug":233,"stem":234,"tags":235,"__hash__":237},"blog\u002Fblog\u002F2022-06-25-investment.md","投什么资，不要投资",{"type":122,"value":123,"toc":214},"minimark",[124,128,132,138,141,154,157,160,163,166,169,172,175,178,181,184,187,190,193,196,199,202,205,208,211],[125,126,127],"h2",{"id":127},"投资心得",[129,130,131],"p",{},"工作有几年了，我也有了一些投资心得，那就是：",[129,133,134],{},[135,136,137],"strong",{},"不要投资！",[129,139,140],{},"股票我是没有涉足，但是基金、保险都有买过，再加上强积金，最终结果如下：",[142,143,144,148,151],"ul",{},[145,146,147],"li",{},"基金：亏损。",[145,149,150],{},"保险：5年后的现金价值为70港币。",[145,152,153],{},"强积金：亏损。",[129,155,156],{},"也就是说，如果我把钱好好地放在卡里，就算只有活期的零点几分钱的利息，好歹余额不会出现负增长。",[125,158,159],{"id":159},"基金和强积金",[129,161,162],{},"基金这个东西，真的让人呵呵。",[129,164,165],{},"支付宝上本来有一个“稳健理财”的专区，每一个项目还写了需要买多久，看起来好像是定期存款，其实那都是基金，不是保本的，亏了也只能等它自己涨起来。",[129,167,168],{},"而强积金其实本质上就是政府要求你必须买的一个定投，所以和基金其实没什么分别，但是即使亏损了，你也不能不供款。",[129,170,171],{},"换工作的时候需要重新买强积金，所以我前后买过汇丰银行和宏利的。",[129,173,174],{},"汇丰银行的报表乱七八糟，我一直没看懂我是赚了还是亏了。",[129,176,177],{},"后来换到宏利之后，算是研究出来要看哪里了，搞清楚了上年总供款额、新增供款额、本年收益（亏损）、账户价值总额，好歹能知道我现在是亏了多少钱。",[129,179,180],{},"然后再回看往年的，才发现差不多是一年赚，一年亏，再赚一年，再亏一年，如此循环。",[129,182,183],{},"那这个强积金买了有什么意思呢？还不如都买定期存款，存三十多年的话，利息应该也很可观吧？",[125,185,186],{"id":186},"保险",[129,188,189],{},"内地在港留学的学生，毕业之后有很多都做了保险，据说是10个卖保险的里面，6个是保诚，3个是AIA，还有1个是其他家的。",[129,191,192],{},"买保险的时候，太多的术语攻击我的大脑，我只能过滤出我理解的东西，我知道要有重疾险，然后有个长远的收益，其他的都很模糊。",[129,194,195],{},"然后就这么供款5年之后，我终于学会看保险账户的年报了，发现我的账户现金价值只有70港币。",[129,197,198],{},"也就是说如果我现在退保，之前供的好几万就都打水漂了。",[129,200,201],{},"那么什么时候才不算打水漂呢？再供款20年，现金价值就和供款总额相等啦。如果再继续往后等，账户就会升值啦。",[129,203,204],{},"所以说，储蓄型保险确实有点不划算，但是没办法，只能指望它的重疾保障了。",[125,206,207],{"id":207},"结语",[129,209,210],{},"你不理财，财不理你。你一理财，财就离开你。",[129,212,213],{},"我的建议是：不要理财！",{"title":215,"searchDepth":34,"depth":34,"links":216},"",[217,218,219,220],{"id":127,"depth":34,"text":127},{"id":159,"depth":34,"text":159},{"id":186,"depth":34,"text":186},{"id":207,"depth":34,"text":207},[26],"强积金和保险都是坑。","md",{"date":225,"language":226,"keywords":227,"comments":96},"2022-06-25","中文",[228,229,230],"MPF","宏利","保诚","\u002Fblog\u002F2022-06-25-investment",{"title":120,"description":222},"investment","blog\u002F2022-06-25-investment",[236,186],"强积金","HtSFkYJf6Khgt2gBeAtiLZVOsVidG6UNRRtQegZi6gM",[239,244],{"title":240,"path":241,"stem":242,"children":-1,"slug":243},"leetCode第1题Two Sum的JS解法","\u002Fblog\u002F2022-06-24-leetcode-01-two-sum-javascript-solution","blog\u002F2022-06-24-leetcode-01-two-sum-javascript-solution","leetcode-01-two-sum-javascript-solution",{"title":245,"path":246,"stem":247,"children":-1,"slug":248},"2022年过去了","\u002Fblog\u002F2023-01-06-life-in-2022","blog\u002F2023-01-06-life-in-2022","life-in-2022",1794550656777]