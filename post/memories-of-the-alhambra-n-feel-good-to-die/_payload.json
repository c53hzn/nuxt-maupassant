[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-memories-of-the-alhambra-n-feel-good-to-die":118,"surround-memories-of-the-alhambra-n-feel-good-to-die":195},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":182,"description":183,"extension":184,"meta":185,"navigation":96,"path":188,"seo":189,"slug":190,"stem":191,"tags":192,"__hash__":194},"blog\u002Fblog\u002F2018-12-21-memories-of-the-alhambra-n-feel-good-to-die.md","韩剧观后感之《阿尔罕布拉宫的回忆》和《死也很好》",{"type":122,"value":123,"toc":177},"minimark",[124,128,132,135,138,141,144,147,150,153,156,159,162,165,168,171,174],[125,126,127],"p",{},"最近同时追了两个剧，《阿尔罕布拉宫的回忆》和《死也很好》。一个是超现实主义的爱情剧，一个是魔幻现实主义的职场剧，前者用玄彬和朴信惠的美貌征服了我，后者则是用社畜的悲惨日常牵动了我的心。",[129,130,131],"h2",{"id":131},"阿尔罕布拉宫的回忆",[125,133,134],{},"上一篇日志里说了下《阿》剧，《阿尔罕布拉宫的回忆》本是一首吉他曲的曲名，编剧让曲子描写的地方成为故事的发生地，用异国情调和游戏元素吸引猎奇的观众，再用男主和劈腿了的前妻、男主和闹离婚的二婚妻子、男主和抢了自己前妻的旧友、男主和偏心自己而苛待儿子的旧友父亲之间的关系来发展剧情，这么多的元素加在一起，当然就有人追看了啊。",[125,136,137],{},"至于女主，倒真的像是NPC一样，只是负责触发剧情，让男主的故事可以继续下去，“少女家长”的人设说到底也只是个噱头而已。",[125,139,140],{},"刚开始看的时候，以为这剧的题材是超写实VR游戏，看到后面却发现，游戏只是一个引子，这剧讲的是一个看似成功却无比孤独的男人与沉重的过去做斗争，而美丽的少女会来解救他的故事，还是很传统的韩剧嘛。",[125,142,143],{},"如果要问我为什么要继续看下去，可能还是为了男女主的美貌吧。",[129,145,146],{"id":146},"死也很好",[125,148,149],{},"第二个在追的剧是《死也很好》。",[125,151,152],{},"这个名字意思怪怪的，尤其是在中文语境下，凡是带了“死”字的，念起来总有一种惊悚的感觉。比如讲述师生情的电影《死亡诗社》，乍一看名字还以为是什么cult集会呢。",[125,154,155],{},"“死也很好”是原剧名《죽어도 좋아》的直译，它还有个译名叫“我的老板每天死一次”，这个名字是从主要剧情中提取出来的，因为男主，也就是女主的上司，确实是“每天死一次”。",[125,157,158],{},"但是这两个名字我都不太满意，总觉得意思上差了点什么，措辞上也不够雅观。",[125,160,161],{},"男主是个毒舌上司，他从来不照顾别人的心情，不管什么都是“有话直说”，导致所有人都对他心有不满。",[125,163,164],{},"终于有一天，之前离职的女下属在生死之间产生的怨念将他关进了一个“土拨鼠日”，只要有人对他的憎恶上升到了诅咒他去死，他就会以各种离奇的方式死去，然后这一天就会重新开始。",[125,166,167],{},"这时候他的另一位女下属成为了拯救他的关键，如果她能够点出上司的过分之处，化解大家对他的怨恨，那么这一天他就不会死了。",[125,169,170],{},"尼玛，这不还是美少女拯救孤独大叔的故事吗！",[125,172,173],{},"再往前回想，《巴黎恋人》是这个套路，《对不起，我爱你》还是这个套路，《鬼怪》那就更是了。",[125,175,176],{},"美少女们，你们够了！",{"title":178,"searchDepth":34,"depth":34,"links":179},"",[180,181],{"id":131,"depth":34,"text":131},{"id":146,"depth":34,"text":146},[9],"看了十几年的韩剧，还是走不出套路","md",{"date":186,"language":187,"comments":96},"2018-12-21","中文","\u002Fblog\u002F2018-12-21-memories-of-the-alhambra-n-feel-good-to-die",{"title":120,"description":183},"memories-of-the-alhambra-n-feel-good-to-die","blog\u002F2018-12-21-memories-of-the-alhambra-n-feel-good-to-die",[193],"韩剧","2muoLKms9ZAsmNF7g53sRmjIm9U8PC7M2qeDd-0gJxw",[196,200],{"title":131,"path":197,"stem":198,"children":-1,"slug":199},"\u002Fblog\u002F2018-12-10-memories-of-the-alhambra","blog\u002F2018-12-10-memories-of-the-alhambra","memories-of-the-alhambra",{"title":201,"path":202,"stem":203,"children":-1,"slug":204},"如何使用Nuxt建立个人博客","\u002Fblog\u002F2019-05-05-nuxt-blog-static-website","blog\u002F2019-05-05-nuxt-blog-static-website","nuxt-blog-static-website",1794501664223]