[{"data":1,"prerenderedAt":235},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-gender-equality-in-liu-cixin-world":118,"surround-gender-equality-in-liu-cixin-world":224},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":207,"description":208,"extension":209,"meta":210,"navigation":96,"path":216,"seo":217,"slug":218,"stem":219,"tags":220,"__hash__":223},"blog\u002Fblog\u002F2023-01-30-gender-equality-in-liu-cixin-world.md","刘慈欣的世界是男女平等的吗？——看流浪地球和三体有感",{"type":122,"value":123,"toc":200},"minimark",[124,128,132,135,138,141,144,147,150,153,156,159,162,166,169,172,175,178,181,184,187,190,194,197],[125,126,127],"h2",{"id":127},"杨冬妈妈",[129,130,131],"p",{},"看到微博上都在说《流浪地球2》，讨论韩朵朵、郝晓晞、图丫丫、丫丫妈妈等人算不算是背景板，我不禁想到了前不久开始看《三体》电视剧的时候观察到的情况。",[129,133,134],{},"有男子看完汪淼拜访叶文洁之后，在小红书上发贴问大家“杨冬妈妈”是个什么角色，为什么他问原著党老婆的时候，老婆笑而不语。",[129,136,137],{},"于是评论区也都笑而不语，不停地重复他说的“杨冬妈妈”这个词，很快这就成了一个新梗。",[129,139,140],{},"我虽然没有看过原著，但是我以前看别人提到过叶文洁和“不要回答”，所以我知道她。而这样一个重要的角色，是不可能用“某某妈妈”这个身份来概括的。",[129,142,143],{},"她是遭受过苦难的科学家，是绝望过后又抱有希望的人类，是邪恶团体的领导者，是重要信息的传递者。",[129,145,146],{},"她是叶文洁，她不仅仅是“某某妈妈”，她有自己的故事。",[125,148,149],{"id":149},"刘妻和图女",[129,151,152],{},"再来看《球》，已经有人提过“朵朵”、“丫丫”这样可可爱爱的叠字名会削弱她们自身的形象，更别提“丫丫妈妈”这样没有名字的角色了。",[129,154,155],{},"广泛意义上的文艺作品中，男性角色很少只作为“某某爸爸”来存在，而女性角色则经常只是面目模糊的“某某妈妈”、“某某女儿”。",[129,157,158],{},"即使像《球》这样想要塑造多种类型的女性角色的作品，也很难做到多维度的描写。",[129,160,161],{},"韩、郝、图三人分别是被追求者、被教育者、被拯救者（微博ID“蒹葭照月”），她们的存在是与男性角色绑定在一起的，不是背景板又是什么呢？",[125,163,165],{"id":164},"女孩不爱听巴赫","女孩不爱听巴赫？",[129,167,168],{},"再说《三体》。",[129,170,171],{},"虽然叶文洁的形象很立体，但是总体来说《三体》关于女性的描写也还是不太行。",[129,173,174],{},"当我听到汪淼说“女孩不可能对巴赫感兴趣”的时候赶紧关掉了屏幕，免得一气之下产生经济损失。",[129,176,177],{},"叶文洁对汪淼说，她曾经告诉杨冬，居里夫人根本没有进入顶尖科研圈，她的成功只是源于勤奋和执着，没有她，那些工作别人也会完成。",[129,179,180],{},"看到这里的时候我反而是有点蒙，不是生气也不是难过，而是不理解：这句话对剧情有什么推动作用吗？对角色的塑造有什么帮助吗？",[129,182,183],{},"既然谁都可以完成，那为什么居里夫人以前的科学家们一个都没有完成？",[129,185,186],{},"矮化一个著名的女科学家，对刘慈欣到底有什么好处呢？",[129,188,189],{},"于是我又想起了以前看到的新闻，说是《三体》海外出版的时候，翻译人员对书中一千多处含有性别歧视的内容进行了改写。这两天我甚至看到了一些原文和译文的对比，发现译文简直是在写原创情节，译者真是辛苦了。",[125,191,193],{"id":192},"科幻世界的性别平等从现在开始","科幻世界的性别平等，从现在开始",[129,195,196],{},"从《球1》到《球2》，我国的科幻大片才开始起步，那么科幻世界里的性别平等也应该要起步了。",[129,198,199],{},"我不知道刘慈欣喜不喜欢巴赫，反正我是喜欢的。",{"title":201,"searchDepth":34,"depth":34,"links":202},"",[203,204,205,206],{"id":127,"depth":34,"text":127},{"id":149,"depth":34,"text":149},{"id":164,"depth":34,"text":165},{"id":192,"depth":34,"text":193},[9],"没有人会把叶文洁叫作“杨冬妈妈”，因为叶文洁就是叶文洁，她有自己的故事。我不知道刘慈欣喜不喜欢巴赫，反正我是喜欢的。","md",{"date":211,"language":212,"keywords":213,"comments":96},"2023-01-30","中文",[214,215],"刘慈欣","科幻","\u002Fblog\u002F2023-01-30-gender-equality-in-liu-cixin-world",{"title":120,"description":208},"gender-equality-in-liu-cixin-world","blog\u002F2023-01-30-gender-equality-in-liu-cixin-world",[221,222],"流浪地球2","三体","U9-nWHpipQnQAVMvlw0bZC0CofSkRSPtZFQ4PwnrZ-o",[225,230],{"title":226,"path":227,"stem":228,"children":-1,"slug":229},"The school for good and evil--Is it possible to tell good and evil by beauty and ugliness?","\u002Fblog\u002F2023-01-18-school-for-good-and-evil-en","blog\u002F2023-01-18-school-for-good-and-evil-en","school-for-good-and-evil-en",{"title":231,"path":232,"stem":233,"children":-1,"slug":234},"如何优化谷歌和必应的识图搜索结果","\u002Fblog\u002F2023-02-15-search-with-img-on-google-bing","blog\u002F2023-02-15-search-with-img-on-google-bing","search-with-img-on-google-bing",1794547928002]