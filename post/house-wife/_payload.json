[{"data":1,"prerenderedAt":219},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-house-wife":118,"surround-house-wife":208},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":193,"description":194,"extension":195,"meta":196,"navigation":96,"path":201,"seo":202,"slug":203,"stem":204,"tags":205,"__hash__":207},"blog\u002Fblog\u002F2023-03-06-house-wife.md","关于“全职主妇”",{"type":122,"value":123,"toc":187},"minimark",[124,129,133,136,139,142,145,148,151,158,161,166,169,172,175,178,181,184],[125,126,128],"h2",{"id":127},"资助8年的女生做家庭主妇事件","“资助8年的女生做家庭主妇”事件",[130,131,132],"p",{},"3月4日，小红书上有人发帖说自己资助了8年的女孩做了全职主妇，引发热议。",[130,134,135],{},"资助者自己生活也不富裕，收入两千多的时候愿意拿出一千块来资助，而且这一助就是8年。",[130,137,138],{},"有的网友说什么，不能因为给了钱就左右别人的人生，也有人说资助者看到受助者现在家境阔绰，所以嫉妒她。",[130,140,141],{},"第一种网友真是高风亮节，不如你去资助吧。",[130,143,144],{},"第二种网友真的应该出去买个猪脑子装进脑壳，因为现在他的脑壳里是空的，竟然想出这么恶毒的话来糟蹋资助者的好意。",[125,146,147],{"id":147},"主妇的自述",[130,149,150],{},"网上常见的主妇描述大致分两种：",[152,153,154],"ol",{},[155,156,157],"li",{},"主妇很辛苦",[130,159,160],{},"主妇在家务和育儿上花了这么多心思，为社会培养了接班人，对这个社会贡献巨大却不被承认，你们这是歧视我。",[152,162,163],{"start":34},[155,164,165],{},"主妇很幸福",[130,167,168],{},"主妇只需要做家务和育儿，不用出去工作，可以买包做美甲，还有时间培养爱好，你们都在嫉妒我。",[130,170,171],{},"第一种总是希望外人认可她们的辛劳，肯定她们的贡献，得到两句安慰的话之后转身继续给老公洗衣做饭。",[130,173,174],{},"但你要是真的说做主妇是辛苦又得不到回报的，让大家不要做主妇，她们话锋一转，开始说自己有老公养，不用工作，用第二种主妇的生活来打肿脸充胖子，说主妇很幸福。但是你要是仔细看她的主页，会发现全都是抱怨老公和孩子的话，一天忙够24小时，这个“不用工作”的好处在哪里呢？",[130,176,177],{},"第二种总是希望外人认可她们的幸福，最好可以小小地嫉妒一下。但是如果有人提起好逸恶劳的问题，她们就拿第一种主妇的经历来给自己贴金，说自己也有贡献云云。",[130,179,180],{},"真是无懈可击呢。",[125,182,183],{"id":183},"我的看法",[130,185,186],{},"我讲不出什么大道理，但唯一能确定的是，等啥时候男人都抢着当主夫了，我才会赞成女人做主妇。",{"title":188,"searchDepth":34,"depth":34,"links":189},"",[190,191,192],{"id":127,"depth":34,"text":128},{"id":147,"depth":34,"text":147},{"id":183,"depth":34,"text":183},[21],"资助8年的女孩做全职主妇，你什么想法？啥时候男人都抢着当主夫了，我就赞成女人做主妇。","md",{"date":197,"language":198,"keywords":199,"comments":96},"2023-03-06","中文",[200],"女权","\u002Fblog\u002F2023-03-06-house-wife",{"title":120,"description":194},"house-wife","blog\u002F2023-03-06-house-wife",[206],"家庭主妇","TPAsMdZMjVMPKoL93zA1tI2ExYUl0pf0g4-BKr2OVpQ",[209,214],{"title":210,"path":211,"stem":212,"children":-1,"slug":213},"Notion的使用心得和遇到的问题","\u002Fblog\u002F2023-02-22-notion","blog\u002F2023-02-22-notion","notion",{"title":215,"path":216,"stem":217,"children":-1,"slug":218},"Notion is powerful, but I still got problems","\u002Fblog\u002F2023-03-08-notion-en","blog\u002F2023-03-08-notion-en","notion-en",1794550655368]