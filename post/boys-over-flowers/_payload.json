[{"data":1,"prerenderedAt":279},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-boys-over-flowers":118,"surround-boys-over-flowers":268},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":254,"description":255,"extension":256,"meta":257,"navigation":96,"path":260,"seo":261,"slug":262,"stem":263,"tags":264,"__hash__":267},"blog\u002Fblog\u002F2019-06-29-boys-over-flowers.md","校园霸凌团体F4的纯情恋爱物语——宝冢《流星花园》观后感",{"type":122,"value":123,"toc":242},"minimark",[124,129,133,136,139,142,145,148,151,154,157,160,163,166,169,172,175,178,182,185,188,191,194,197,200,203,206,209,212,215,220,223,227,230,233,236,239],[125,126,128],"h2",{"id":127},"校园恋爱vs校园霸凌","校园恋爱VS校园霸凌",[130,131,132],"p",{},"第二次看宝冢音乐剧就是大家耳熟能详的校园故事《流星花园》，原文名称是『花より男子』，本来是讲述校园恋爱的少女漫画，但是我却忍不住想到串联整个故事却总是被大家遗忘的主题——校园霸凌。",[130,134,135],{},"F4是Flower 4的简称，也就是道明寺司、花泽类、美作玲、西门总二郎四个人的小团体的名字。他们财大气粗，有权有势，凡是惹到他们的，都可能会被贴上“红牌”，然后被全校的人欺凌。",[130,137,138],{},"明明只是得罪了4个人，却会得到全校上下的欺凌，这当然是因为这破学校上下都是势利眼和狗腿子，为了巴结F4而无所不用其极。",[130,140,141],{},"小学时看台版的《流星花园》，看到杉菜被贴了红牌而得到全校欺凌，然后获得道明寺“这个女人跟其他妖艳贱货好不一样我好喜欢”的青睐之后又被全校接受，当时不觉得有什么。",[130,143,144],{},"后来高中时看到日版的，也不觉得有什么。",[130,146,147],{},"然后上大学了，偶尔在食堂的电视里看过几集郑爽和张翰的版本，甚至还觉得他们演得很可爱。",[130,149,150],{},"可是今天看到舞台上的杉菜被言语侮辱，被殴打，被人淋湿，甚至差点被强暴，我突然觉得，这样是不对的。",[130,152,153],{},"强暴是被制止了，可是实施的人没有受到惩罚，而教唆的人（道明寺）最后甚至和受害人谈起了恋爱，exo me？？？这TM是斯德哥尔摩综合症吧？？？",[130,155,156],{},"总之用谈恋爱这种方式来给男主洗白实在是太过随意，我现在完全无法接受。",[130,158,159],{},"万一他们后来分手了呢？在一起时可以被保护，不在一起了你算什么？",[125,161,162],{"id":162},"霸道总裁的陷阱",[130,164,165],{},"故事中间有几个“妖艳贱货”陷害杉菜，给她下药、拍裸照、诬蔑她出轨，众人见道明寺态度一变，立刻又开始欺凌杉菜。可见这种廉价的“保护”是和杉菜为道明寺提供的恋爱价值相关联的，一旦恋爱关系终止，他们的保护关系也就终止了。",[130,167,168],{},"那么杉菜必须和道明寺长长久久地在一起，否则她的人身安全还是得不到保障。但是反过来想一想，最开始威胁杉菜人身安全的，正是道明寺啊。",[130,170,171],{},"不管她有没有和道明寺谈恋爱，只要道明寺想，他就可以伤害她。不在一起的时候道明寺指挥其他人欺凌杉菜，而在一起的时候他拿优待来诱惑杉菜，但这同时也会伴随着失去优待而恢复被欺凌的潜在威胁。",[130,173,174],{},"不是他的他就欺负，是他的他就保护，如果失去了就任其毁灭，这就是霸道总裁的哲学。",[130,176,177],{},"我看到的故事中他从来没有真正失去过杉菜，所以并没有机会真的毁灭她。但是从杉菜的角度出发，只有消除霸道总裁道明寺的影响，她才能正常地在校园里生活，才能真正地享受恋爱。",[125,179,181],{"id":180},"换一个霸道总裁行不行","换一个霸道总裁行不行？",[130,183,184],{},"前面说的问题归根结底是道明寺这个人不行，那么我们换一个霸道总裁花泽类如何呢？",[130,186,187],{},"没错，花泽类也可以归类到霸道总裁这一号。他高冷，他受过情伤，他偶尔显露温情，他也是耍弄别人的一把好手。",[130,189,190],{},"F4欺凌别人的时候没见他阻止过，只是到了强暴这一步他才拦了下来。自己的心上人志向远大，跟不上她的脚步而退回安全区之后又去撩杉菜，过后还美其名曰开玩笑和测试友谊。",[130,192,193],{},"杉菜为花泽类而动摇的时候，也许没有意识到自己的人身安全也是岌岌可危的，没了道明寺的庇护，其他人还不吃了她？",[130,195,196],{},"那么转到花泽类这边的话，她又能不能重新获得安全呢？怕是未必。",[130,198,199],{},"财阀跟财阀还不一样，花泽不如道明寺家大势大，他不可能脱离F4小团体，否则将无法自处。那么为了重新获得团体的接纳，他一定不会坚持和杉菜在一起，这样才能换回自己的位置。",[125,201,202],{"id":202},"谈恋爱真危险",[130,204,205],{},"F4算是霸道总裁的始祖了，以前看着很热闹，现在看了心都凉了。",[130,207,208],{},"后来的霸总多为蠢萌型，只要女主在某一瞬间让霸总折服，后面基本上也都是甜甜的恋爱，还是可以看一看的。",[130,210,211],{},"但是谈恋爱仍然很危险，还是多看看电视剧比较好。",[125,213,214],{"id":214},"几个比较印象深刻的场景",[216,217,219],"h3",{"id":218},"杉菜会功夫","杉菜会功夫？",[130,221,222],{},"Teen of Japan决赛的时候，杉菜穿着蓬蓬裙和高跟鞋，竟然能翻跟头和跳绳，我实在是五体投地了。",[216,224,226],{"id":225},"杉菜有细腰","杉菜有细腰？",[130,228,229],{},"花泽类搂着杉菜时说的台词大意是杉菜的腰很细，搂起来像没有一样。然后镜头特写杉菜的腰，emmmm，这跟“像没有一样”还是有一些区别的。但是杉菜的身材还是不错的。",[125,231,232],{"id":232},"来个总结吧",[130,234,235],{},"在这个“女权”已经被习惯性地污名化的时代，我还是得在我自己的地盘打一打拳。",[130,237,238],{},"故事总是要为思想服务的，好故事不一定有好的思想，但是不要停止思考，要继续打拳。",[130,240,241],{},"就是这样，喵~",{"title":243,"searchDepth":34,"depth":34,"links":244},"",[245,246,247,248,249,253],{"id":127,"depth":34,"text":128},{"id":162,"depth":34,"text":162},{"id":180,"depth":34,"text":181},{"id":202,"depth":34,"text":202},{"id":214,"depth":34,"text":214,"children":250},[251,252],{"id":218,"depth":19,"text":219},{"id":225,"depth":19,"text":226},{"id":232,"depth":34,"text":232},[9],"F4明明是校园霸凌团体，可是人们遗忘了霸道总裁做的那些足够进监狱的过分行为，只记住了甜甜的恋爱，这样好像哪里不太对？","md",{"date":258,"language":259,"comments":96},"2019-06-29","中文","\u002Fblog\u002F2019-06-29-boys-over-flowers",{"title":120,"description":255},"boys-over-flowers","blog\u002F2019-06-29-boys-over-flowers",[265,6,266],"宝塚","女权","X5r0ohY2z6VYEzUpaoZwoB0AcIHeLBtugdU0aOWt47w",[269,274],{"title":270,"path":271,"stem":272,"children":-1,"slug":273},"人生初の宝塚歌劇鑑賞－－藤原鎌足の話を見ました","\u002Fblog\u002F2019-05-25-takarazuka-musical-jp","blog\u002F2019-05-25-takarazuka-musical-jp","takarazuka-musical-jp",{"title":275,"path":276,"stem":277,"children":-1,"slug":278},"60天，指定幸存者","\u002Fblog\u002F2019-07-08-designated-survivor","blog\u002F2019-07-08-designated-survivor","designated-survivor",1794547929833]