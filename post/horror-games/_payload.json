[{"data":1,"prerenderedAt":368},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-horror-games":118,"surround-horror-games":357},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":337,"description":338,"extension":339,"meta":340,"navigation":96,"path":350,"seo":351,"slug":352,"stem":353,"tags":354,"__hash__":356},"blog\u002Fblog\u002F2021-04-08-horror-games.md","游戏实况推荐--渗透之C君",{"type":122,"value":123,"toc":322},"minimark",[124,128,132,135,138,149,153,156,159,162,165,168,171,174,177,193,196,199,202,207,218,221,224,227,230,233,236,240,244,247,250,254,258,261,264,267,271,275,278,281,284,287,291,294,297,300,304,307,310,313,316,319],[125,126,127],"h2",{"id":127},"恐怖游戏视频",[129,130,131],"p",{},"最近沉迷恐怖游戏视频，每天回家一边啃饭一边看博主逛鬼屋，十分酸爽。",[129,133,134],{},"恐怖游戏主要分两种：心灵恐怖 (Psychological Horror) 和突发惊吓 (Jump Scare) 。",[129,136,137],{},"前者是靠剧情推进和氛围渲染来达到的，效果是“细思恐极”，也就是“越想越觉得吓人”。而后者则是靠突然出现的恐怖元素，比如推开门突然蹦出来一个幽灵，或者走着路突然掉下来一个娃娃，这是一种人造感比较强的恐怖。",[129,139,140,141,148],{},"虽然我自己没玩过，但是看别人玩也一样有意思，我尤其喜欢 B 站的“三怂”之一， ",[142,143,147],"a",{"href":144,"rel":145},"https:\u002F\u002Fspace.bilibili.com\u002F4162287",[146],"nofollow","渗透之C君"," ，昵称“C菌”。",[125,150,152],{"id":151},"关于c菌","关于C菌",[129,154,155],{},"C 菌是在美留学的女生，游戏打得很好，但是她是以“玩恐怖游戏的恐怖玩家”而闻名，因为大家看她的视频的时候，还没被鬼吓到，就先被她的鬼叫吓到了，哈哈。",[129,157,158],{},"B 站还有两个怂怂的游戏 up 主，他们合起来被称为“ B 站三怂”。",[129,160,161],{},"此外， C 菌在打游戏时经常脱口而出的奇怪的量词也很有特色，比如：一块照片、一张字儿、一条房子。弹幕的评论从“量子破碎”中引申出了一个新词——“量词破碎”来形容这种现象，非常有意思。",[129,163,164],{},"恐怖游戏不只有恐怖元素，有时候还涉及到解谜和推理。很多时候观众还在云里雾里， C 菌已经凭借一路走来的线索很快地通关了，这时候她会兴奋地拍手，而观众则会在弹幕里戏谑地说这是“开心地拍起了肚皮”。",[129,166,167],{},"她的视频通常是经过剪辑的，我不知道这种快速解谜的场面是不是剪辑的效果，但是她的剪辑确实很用心。",[129,169,170],{},"在某些关卡失败多次之后，她会把不断尝试的部分减掉或进行加速，甚至会把一些瞬间做成鬼畜片段，让观众看的时候一点都不觉得无聊。",[125,172,173],{"id":173},"恐怖游戏规律",[129,175,176],{},"看了这么些恐怖游戏视频之后，我发现了一些弹幕里常说的游戏规律",[178,179,180,184,187,190],"ol",{},[181,182,183],"li",{},"大战之前必有补给",[181,185,186],{},"家具能躲说明有鬼怪",[181,188,189],{},"主角能跑说明有追逐战",[181,191,192],{},"即使玩家已有答案，仍需走完流程",[129,194,195],{},"有时候某些打斗、追逐、探索其实挺没意思的，但是看别人玩的时候，我可以快进，这样我的时间就节约下来了，还是挺好的。",[125,197,198],{"id":198},"我推荐的游戏实况视频",[129,200,201],{},"这里记录我比较喜欢的几个游戏，算是个人片单吧。有恐怖游戏也有剧情向游戏。",[203,204,206],"h3",{"id":205},"伊迪芬奇的秘密what-remains-of-edith-finch","伊迪芬奇的秘密(What Remains of Edith Finch)",[208,209,217],"iframe",{"className":210,"src":212,"scrolling":213,"border":214,"frameBorder":213,"framespacing":215,"allowFullScreen":216},[211],"youtube","\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=10853395&bvid=BV1Dx411Y7q1&cid=17943670&page=1","no",0,"0","true"," ",[129,219,220],{},"游戏的名字叫作“伊迪芬奇的秘密”，但我更愿意称它为“芬奇家的生与死”。",[129,222,223],{},"话说，芬奇家里某个孩子的门上画的是我最喜欢的芬奇(finch，一类雀鸟)之一：斑胸草雀(Zebra Finch)，也叫“珍珠鸟”。不过这不重要。",[129,225,226],{},"这个游戏的场景和动态效果都做得非常好，尤其是叙事字幕，和场景完美地结合在了一起，令人眼前一亮。",[129,228,229],{},"然而故事本身却很让人伤感，尤其是配上女主气若游丝的旁白之后，这华丽的画面更添了一丝悲戚的色彩。",[129,231,232],{},"这些生命的离去很难说是谁的责任，但是确实能给玩家和看实况视频的我们一些警醒。",[129,234,235],{},"珍爱生命，不要作死。",[203,237,239],{"id":238},"灵媒the-medium","灵媒(The Medium)",[208,241,217],{"className":242,"src":243,"scrolling":213,"border":214,"frameBorder":213,"framespacing":215,"allowFullScreen":216},[211],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=928983663&bvid=BV1oT4y1P7oE&cid=288917423&page=1",[129,245,246],{},"女主有异能，可以和逝者沟通，某天被奇怪的电话叫去了一个废弃的度假村，于是 C 菌用了 5 个小时通关游戏，超度了不少亡灵，最终让她解开了身世之谜。",[129,248,249],{},"开头和结尾都有不少泪点，故事中间有不少虐点，而女主和小女孩慢慢建立的联结也很牵动人心。",[203,251,253],{"id":252},"黑相集稀望镇dark-pictures-little-hope","黑相集：稀望镇(Dark Pictures: Little Hope)",[208,255,217],{"className":256,"src":257,"scrolling":213,"border":214,"frameBorder":213,"framespacing":215,"allowFullScreen":216},[211],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=287715019&bvid=BV1Lf4y1q75Z&cid=254090228&page=1",[129,259,260],{},"第一章非常有冲击力，不管你选什么操作，都无法阻止悲剧的发生。看完之后会怀疑人生，心情久久不能平静。",[129,262,263],{},"之后的剧情进展会引导你想象平行世界，最后再给一个令人唏嘘的结尾。整个故事还是挺让人难过的。",[129,265,266],{},"看这个游戏实况的时候有种在看美国 60 - 70 年代恐怖电影的感觉，妥妥的心灵恐怖。",[203,268,270],{"id":269},"底特律成为人类detroit-become-human","底特律：成为人类(Detroit: Become Human)",[208,272,217],{"className":273,"src":274,"scrolling":213,"border":214,"frameBorder":213,"framespacing":215,"allowFullScreen":216},[211],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=23947116&bvid=BV1tp411R7tB&cid=40072363&page=1",[129,276,277],{},"2018 年的神作，我为了它而买了 PS4 和外接显示屏，但是至今没有打完。明明看别人玩的时候都是丝毫不拖泥带水地过去了，可是到我自己玩的时候，每做一个选择都非常艰难，搞砸了好几处任务，心情十分复杂。可是按我自己的性格和世界观，我是无法照着剧情需要的发展进行下去的。",[129,279,280],{},"而 C 菌在玩游戏的时候总是会让人物向积极的方向选择，而且她会耐心探索场景，尽量不漏掉一个线索，这样其实很对我的胃口。",[129,282,283],{},"所以还是看别人玩吧，没有任何负担，一边吃着爆米花一边把它当看电影看也是可以的。",[203,285,286],{"id":286},"烟火",[208,288,217],{"className":289,"src":290,"scrolling":213,"border":214,"frameBorder":213,"framespacing":215,"allowFullScreen":216},[211],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=799010488&bvid=BV1Vy4y127k2&cid=292576637&page=1",[129,292,293],{},"《烟火》是今年出的国产剧情向恐怖游戏，由一个棺材着火案件引出了层层背后的故事，我们看到了一个警察的成长和一个女人的悲歌，我尤其喜欢带有隐喻意味的“装饰新家”的那一段，制作组确实下了功夫，简单的“一撕一贴”之间，我们就看到了女主的人生改变。",[129,295,296],{},"当然，前不久微博上发生的借《烟火》之名行骗的事情也是很有意思，这充分说明了游戏的成功，已经有人能拿它骗到钱了呢！",[203,298,299],{"id":299},"港诡实录",[208,301,217],{"className":302,"src":303,"scrolling":213,"border":214,"frameBorder":213,"framespacing":215,"allowFullScreen":216},[211],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=82969316&bvid=BV1jJ411p7Q3&cid=142144279&page=1",[129,305,306],{},"沉浸式香港恐怖片体验，公屋模拟器+办公室模拟器，港味十足，看完以后再也不敢来香港了。",[129,308,309],{},"2021-08-19 更新",[129,311,312],{},"据说《港诡实录》是以九龙城寨为灵感而制作的，但是从我最近对城寨了解到的情况来看，城寨在游戏设定的年代早就被拆除了，主角们去不存在的城寨采风，感觉更恐怖了呢~",[125,314,315],{"id":315},"总结",[129,317,318],{},"不管是玩游戏还是看别人玩游戏，都是为了享受短暂的远离现实的时间，紧张过后便可以松口气，庆幸原来自己的生活还没有那么糟。",[129,320,321],{},"感谢这些制作精良的团队，让我们有机会体验这些好故事。",{"title":323,"searchDepth":34,"depth":34,"links":324},"",[325,326,327,328,336],{"id":127,"depth":34,"text":127},{"id":151,"depth":34,"text":152},{"id":173,"depth":34,"text":173},{"id":198,"depth":34,"text":198,"children":329},[330,331,332,333,334,335],{"id":205,"depth":19,"text":206},{"id":238,"depth":19,"text":239},{"id":252,"depth":19,"text":253},{"id":269,"depth":19,"text":270},{"id":286,"depth":19,"text":286},{"id":299,"depth":19,"text":299},{"id":315,"depth":34,"text":315},[29],"不敢玩恐怖游戏但又心痒痒？剧情向游戏太长无暇尝试？试试云通关吧","md",{"date":341,"language":342,"keywords":343,"comments":96},"2021-04-08","中文",[344,345,346,347,348,349],"恐怖游戏","bilibili","哔哩哔哩","horror games","live streaming","C菌","\u002Fblog\u002F2021-04-08-horror-games",{"title":120,"description":338},"horror-games","blog\u002F2021-04-08-horror-games",[6,355],"游戏实况","dS_vhVAs3TTpuSJdM9zx_8q9jeBwlK1WvBI_32GvANg",[358,363],{"title":359,"path":360,"stem":361,"children":-1,"slug":362},"Create Bilingual Breadcrumbs component for Nuxt","\u002Fblog\u002F2021-04-06-nuxt-breadcrumbs-bilingual-en","blog\u002F2021-04-06-nuxt-breadcrumbs-bilingual-en","nuxt-breadcrumbs-bilingual-en",{"title":364,"path":365,"stem":366,"children":-1,"slug":367},"Vue开发的注意事项","\u002Fblog\u002F2021-04-10-points-to-notice-for-vue-development","blog\u002F2021-04-10-points-to-notice-for-vue-development","points-to-notice-for-vue-development",1794547929390]