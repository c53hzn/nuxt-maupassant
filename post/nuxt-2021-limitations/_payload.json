},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":297,"description":298,"extension":299,"meta":300,"navigation":96,"path":307,"seo":308,"slug":309,"stem":310,"tags":311,"__hash__":314},"blog\u002Fblog\u002F2021-02-08-nuxt-2021-limitations.md","2021年Nuxt新版本的一些限制",{"type":122,"value":123,"toc":289},"minimark",[124,129,142,155,165,186,192,196,202,259,262,265,268,272,275,279,286],[125,126,128],"h2",{"id":127},"升级nuxt和使用content","升级Nuxt和使用content",[130,131,132,133,137,138,141],"p",{},"为了试用 Nuxt 的新模块 ",[134,135,136],"code",{},"content"," ，我升级了 Nuxt 到最新版本 ",[134,139,140],{},"2.14.12"," ，不过其实不用升级也能用这个模块，这是后话了。",[130,143,144,146,147,154],{},[134,145,136],{}," 的官方页面在 ",[148,149,153],"a",{"href":150,"rel":151},"https:\u002F\u002Fcontent.nuxtjs.org",[152],"nofollow","这里","。",[130,156,157,158,161,162,164],{},"我把那些原本使用本机自建 api 获取内容的 ",[134,159,160],{},"pages\u002F"," 的模板文件全都改成使用 ",[134,163,136],{}," 了，也终于把那些因为改起来太麻烦而保留的嵌套 3 层的回调改成了更一目了然的简洁写法。",[130,166,167,169,170,173,174,177,178,181,182,185],{},[134,168,136],{}," 不光可以解析 ",[134,171,172],{},".md"," 的文件，还可以解析 ",[134,175,176],{},".txt"," 、 ",[134,179,180],{},".csv"," 和 ",[134,183,184],{},".yml"," 等格式的文本文件，可以实现比我的 api 要更丰富的功能。",[130,187,188,189,191],{},"对于 ",[134,190,136],{}," 我是非常满意的。",[125,193,195],{"id":194},"nuxt新版本的问题","Nuxt新版本的问题",[130,197,198,199,201],{},"虽然 ",[134,200,136],{}," 十分给力，但是新版本的 Nuxt 不是很给力，我发现有 3 个问题：",[203,204,205,224,243],"ol",{},[206,207,208,209,212,213,215,216,219,220,223],"li",{},"新版本会为静态页面的各个路径都生成 ",[134,210,211],{},"payload","，用来为页面提供内容，但是 Nuxt 会对保存的路径进行 url 编码，此时如果路径含有非英语字符，那么最后的页面将无法正确访问 ",[134,214,211],{}," 资源，因为访问路径需要再次进行 url 编码。 我在 GitHub 上提了 issue ，貌似被接受了，但是得等下次 release 才能用到了。而且不知道为什么，这个问题会影响手机版的导航栏，只要是路径含有非英语字符的页面，手机导航栏就打不开，我尝试自己在 ",[134,217,218],{},"node_modules"," 里面找到了和生成静态网站时的 url 编码有关的代码，手动改成了不编码。这样很有效，在本机生成静态文件时，路径就正常了，但是如果想用 ",[134,221,222],{},"GitHub Actions"," 自动部署的话，那就又不行了。",[206,225,226,227,230,231,234,235,238,239,242],{},"文章 ",[134,228,229],{},"slug"," 或 ",[134,232,233],{},"tag"," 如果是以 ",[134,236,237],{},".js"," 结尾的，那么 Nuxt 就无法正常渲染，这个我也提了 issue ，Nuxt 团队人员说有对这个做 fallback，让我改 ",[134,240,241],{},"nuxt.config.js"," 的设置，然后关闭了我的 issue。（这个其实不关新版本的事，我后来发现了）",[206,244,245,246,248,249,252,253,255,256,258],{},"新版本内建了爬虫，这样就不需要在 ",[134,247,241],{}," 里面为 ",[134,250,251],{},"generate"," 列出所有动态生成的路径了。但是问题来了，爬虫没有爬取 ",[134,254,237],{}," 结尾的路径，导致有的页面无法生成，还需要我手动在 ",[134,257,241],{}," 里面列出相关路径才行。还有就是如果我在一些页面里引用了不存在的路径，这个爬虫不会验证路径有效性，还是会尝试生成这个不存在的页面。结果就是明明需要生成的，没有生成；明明不需要生成的，却去尝试生成了。",[125,260,261],{"id":261},"感想",[130,263,264],{},"网络应用框架的开发和迭代不可能一蹴而就，这个我明白，但是旧版本里没有的问题，新版本却反而出现了，这不得不让人感到有点失望。",[130,266,267],{},"希望 Nuxt 以后能再发展壮大，让我这个非专业程序媛也能继续受益吧！",[125,269,271],{"id":270},"_2021-03-13更新","2021-03-13更新",[130,273,274],{},"最新的 Nuxt 版本 v2.15.2 解决了有非英语字符的路径的 payload 保存路径的问题，但是不知道为什么这些页面还是无法读取正确的 payload，导致 data 都是空的。",[125,276,278],{"id":277},"_2021-03-29更新","2021-03-29更新",[130,280,281,282,285],{},"已回滚到 Nuxt v2.12.2，不过仍然在用 ",[134,283,284],{},"Nuxt content"," ,然后在 nuxt.config.js 里面的 generate 部分列明了所有要生成的 routes，不用它的 crawler ，网站至少能正常用了。",[130,287,288],{},"以后不敢随便升级了。",{"title":290,"searchDepth":34,"depth":34,"links":291},"",[292,293,294,295,296],{"id":127,"depth":34,"text":128},{"id":194,"depth":34,"text":195},{"id":261,"depth":34,"text":261},{"id":270,"depth":34,"text":271},{"id":277,"depth":34,"text":278},[12],"升级Nuxt到2.14.12之后，遇到了3个问题，这个新版本用起来有点不太顺手。","md",{"date":301,"language":302,"keywords":303,"comments":96},"2021-02-08","中文",[304,305,306],"Github","bug report","issue report","\u002Fblog\u002F2021-02-08-nuxt-2021-limitations",{"title":120,"description":298},"nuxt-2021-limitations","blog\u002F2021-02-08-nuxt-2021-limitations",[312,313],"Nuxt.js","Nuxt Content","yyeRQOv_bZY5MKgX-xZwtv0l3gNp_od2gafL40gqEHc",[316,321],{"title":317,"path":318,"stem":319,"children":-1,"slug":320},"使用Github Actions把Nuxt静态网站push到其他repository","\u002Fblog\u002F2021-02-07-nuxt-blog-generate-files-n-push-to-another-repo","blog\u002F2021-02-07-nuxt-blog-generate-files-n-push-to-another-repo","nuxt-blog-generate-files-n-push-to-another-repo",{"title":322,"path":323,"stem":324,"children":-1,"slug":325},"Limitations of latest version Nuxt in 2021","\u002Fblog\u002F2021-02-08-nuxt-2021-limitations-en","blog\u002F2021-02-08-nuxt-2021-limitations-en","nuxt-2021-limitations-en",1794501663930]