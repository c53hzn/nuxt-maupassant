24",[161,881,882],{},"福尔康",[161,884,748],{},[161,886,837],{},[161,888,683],{},[161,890,484],{},[130,892,893],{},"平常用VLOOKUP查找的时候，只能查找一个参数，但是这里有三个参数，而且既有数字又有文本，那么怎样才能同时查找这么多参数呢？",[130,895,896],{},"其实无法一次做到的哈，但我们可以把它分解一下，从年龄、工龄的数字变成相应的等级文本，再组合起来，变成只查找一个文本参数，这样就行了。",[125,898,899],{"id":899},"在给定的数值范围内查找数字",[130,901,902],{},"我们先来查找年龄和工龄，此时需要手工做2个等级对照表",[134,904,905,915],{},[137,906,907],{},[140,908,909,912],{},[143,910,911],{},"G",[143,913,914],{},"H",[156,916,917,924,930,936,943],{},[140,918,919,921],{},[161,920,145],{},[161,922,923],{},"年龄等级",[140,925,926,928],{},[161,927,552],{},[161,929,163],{},[140,931,932,934],{},[161,933,784],{},[161,935,235],{},[140,937,938,941],{},[161,939,940],{},"41",[161,942,298],{},[140,944,945,948],{},[161,946,947],{},"51",[161,949,361],{},[134,951,952,962],{},[137,953,954],{},[140,955,956,959],{},[143,957,958],{},"I",[143,960,961],{},"J",[156,963,964,970,976],{},[140,965,966,968],{},[161,967,555],{},[161,969,166],{},[140,971,972,974],{},[161,973,751],{},[161,975,191],{},[140,977,978,981],{},[161,979,980],{},"11",[161,982,214],{},[130,984,985,989,990,994],{},[986,987,988],"strong",{},"小贴士"," : VOOKUP里面查找数值范围的时候，公式里的第四个参数要为 ",[991,992,993],"code",{},"TRUE","。",[130,996,997,998],{},"查找年龄等级的公式 ",[991,999,1000],{},"=VLOOKUP(C2,G:H,2,TRUE)",[130,1002,1003,1004],{},"查找工龄等级的公式 ",[991,1005,1006],{},"=VLOOKUP(D2,I:J,2,TRUE)",[125,1008,1009],{"id":1009},"查找文本",[130,1011,1012],{},"现在需要查找学历等级，我们手工做一个等级对照表",[134,1014,1015,1025],{},[137,1016,1017],{},[140,1018,1019,1022],{},[143,1020,1021],{},"K",[143,1023,1024],{},"L",[156,1026,1027,1034,1040,1046,1052,1058,1064,1070],{},[140,1028,1029,1031],{},[161,1030,151],{},[161,1032,1033],{},"学历等级",[140,1035,1036,1038],{},[161,1037,501],{},[161,1039,169],{},[140,1041,1042,1044],{},[161,1043,520],{},[161,1045,169],{},[140,1047,1048,1050],{},[161,1049,539],{},[161,1051,169],{},[140,1053,1054,1056],{},[161,1055,683],{},[161,1057,169],{},[140,1059,1060,1062],{},[161,1061,481],{},[161,1063,181],{},[140,1065,1066,1068]