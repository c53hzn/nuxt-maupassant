[{"data":1,"prerenderedAt":237},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-sherlock-holmes-and-h-h-holmes":118,"surround-sherlock-holmes-and-h-h-holmes":230},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":113,"body":120,"categories":215,"description":216,"extension":217,"meta":218,"navigation":96,"path":223,"seo":224,"slug":114,"stem":225,"tags":226,"__hash__":229},"blog\u002Fblog\u002F2023-03-16-sherlock-holmes-and-h-h-holmes.md",{"type":121,"value":122,"toc":207},"minimark",[123,127,131,134,137,145,148,151,154,157,161,164,167,170,173,176,179,182,189,192,195,198,201,204],[124,125,126],"h2",{"id":126},"重温神探夏洛克",[128,129,130],"p",{},"之前看到消息说柯南第六部剧场版《贝克街的亡灵》将在中国内地重映，突然又对福尔摩斯产生了兴趣，于是把BBC的《神探夏洛克》又找出来看了一遍。",[128,132,133],{},"2017年第四季出来的时候看过一遍，然后再也没有碰过了，只记得讲了福尔摩斯家小妹，其他的全都忘记了。这次再看的时候，真的有不少惊喜。",[124,135,136],{"id":136},"vinyl怎么念",[128,138,139,140,144],{},"401这一集，夏洛克根据汽车坐垫灰烬的成分来分析案情，灰烬里有两种乙烯基，英文是 ",[141,142,143],"code",{},"vinyl"," ，我听完头就炸了。",[128,146,147],{},"日语的“塑料”有两个词「プラスチック」（音: 普拉斯奇酷）和「ビニール」（音: 比逆鲁），分别对应 plastic 和 vinyl 。",[128,149,150],{},"由于没学过 vinyl ，我一直按日语发音规律反推，以为它念“维逆尔”，听到夏洛克念“歪诺”的时候，我下巴都要掉下来了。",[128,152,153],{},"我一直以为“学了日语就不会英语”这事不会发生在我身上的，没想到竟然真的是这样。",[128,155,156],{},"真是震惊我一整年。",[124,158,160],{"id":159},"hh福尔摩斯是谁","H·H·福尔摩斯是谁",[128,162,163],{},"402这一集，夏洛克去单挑一个连环杀手，俩人单独对峙的时候互相套情报，杀手提到了一个名字“H·H·福尔摩斯”，夏洛克说自己跟他不是亲戚。",[128,165,166],{},"我听完头又炸了，因为这个名字我不久前才研究过。",[128,168,169],{},"去年年底的时候看了一个游戏实况，游戏名叫《黑相集：心中魔》，说的是有人复刻了H·H·福尔摩斯的“谋杀城堡”，邀请一个节目组去做纪录片，结果一行人真的遭遇各种密室、机关，需要大家一起努力逃出生天的故事。",[128,171,172],{},"这个H·H·福尔摩斯是19世纪末的有名连环杀手，他在芝加哥造了一座旅馆，专门杀害入住的游客。",[128,174,175],{},"这个杀手原姓玛吉特（Mudgett），是1886年改姓成福尔摩斯的。而且他活跃的时间，正好是柯南·道尔开始创作福尔摩斯系列小说，到我们的大侦探成名的时间。",[128,177,178],{},"这不能不说是一个巧合。",[128,180,181],{},"话说，看了H·H·福尔摩斯的照片，以及游戏里还原的形象，我以为他应该至少50多岁了，可是他被处以绞刑的时候也才34岁，这也太显老了。",[128,183,184],{},[185,186],"img",{"alt":187,"src":188},"image","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F225510868-3322cb5a-8f45-45d9-b6f0-f59a6b226059.png",[124,190,191],{"id":191},"神秘博士",[128,193,194],{},"403这一集里，夏洛克和约翰在麦考夫家里装神弄鬼，空荡的房子里出没着阴森的小丑，我立刻就想到了《神秘博士》找妈妈的那一集，小朋友稚嫩的童声回荡在电话里。",[128,196,197],{},"“Coming to get you，”记忆中的小朋友幽幽地说道。",[128,199,200],{},"然后夏洛克这边下一句竟然就是“Coming to get you~”，让我大为震惊。",[124,202,203],{"id":203},"尾声",[128,205,206],{},"以上就是一些我在重温神探夏洛克时的思想碎片，时不时地拿出来看看，也是挺有意思的。",{"title":208,"searchDepth":34,"depth":34,"links":209},"",[210,211,212,213,214],{"id":126,"depth":34,"text":126},{"id":136,"depth":34,"text":136},{"id":159,"depth":34,"text":160},{"id":191,"depth":34,"text":191},{"id":203,"depth":34,"text":203},[6],"重温神探夏洛克的时候，遇到了很多惊喜，果然经典就是应该拿出来反复观看的。","md",{"date":219,"language":220,"keywords":221,"comments":96},"2023-03-16","中文",[222],"连环杀手","\u002Fblog\u002F2023-03-16-sherlock-holmes-and-h-h-holmes",{"title":113,"description":216},"blog\u002F2023-03-16-sherlock-holmes-and-h-h-holmes",[227,228],"神探夏洛克","HH福尔摩斯","Dktg4eI10WHZxy9bEwGleFGNgjVRpiynSMxEoY3VZWg",[231,234],{"title":116,"path":232,"stem":233,"children":-1,"slug":117},"\u002Fblog\u002F2023-03-14-oshin-and-yaohan","blog\u002F2023-03-14-oshin-and-yaohan",{"title":110,"path":235,"stem":236,"children":-1,"slug":111},"\u002Fblog\u002F2023-03-24-chatgpt-teaches-russian","blog\u002F2023-03-24-chatgpt-teaches-russian",1794550655079]