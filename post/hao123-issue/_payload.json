[{"data":1,"prerenderedAt":359},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-hao123-issue":118,"surround-hao123-issue":352},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":334,"description":335,"extension":336,"meta":337,"navigation":96,"path":344,"seo":345,"slug":346,"stem":347,"tags":348,"__hash__":351},"blog\u002Fblog\u002F2017-05-28-hao123-issue.md","记录一下解决Chrome主页被hao123劫持的过程",{"type":122,"value":123,"toc":328},"minimark",[124,128,132,135,147,182,198,201,213,216,225,235,240,243,250,256,261,267,277,282,285,290,299,302,309,316,322,325],[125,126,127],"h2",{"id":127},"浏览器首页被劫持了",[129,130,131],"p",{},"这一个多月以来，我一直饱受 Chrome 主页被 hao123 劫持之苦，虽然我自己之前也是把百度设为主页，但是我不喜欢百度旗下的 hao123。",[129,133,134],{},"发现主页被劫持之后，我在网上搜了解决方法。",[129,136,137,138,142,143,146],{},"第一个尝试的是查看桌面快捷方式的属性，但发现快捷方式只是指向 ",[139,140,141],"code",{},"chrome.exe","，并没有被添加 ",[139,144,145],{},"hao123.com","，所以没法修改。",[129,148,149,150,152,153,155,156,158,159,162,163,165,166,169,170,172,173,175,176,178,179,181],{},"第二个尝试的是在程序安装文件夹里查看 ",[139,151,141],{}," 的属性，发现它也没有被添加任何 ",[139,154,145],{}," 的链接，但是直接点击 ",[139,157,141],{}," 也还是会被劫持到 ",[139,160,161],{},"hao123"," 。于是我又试了下网上的建议，把 ",[139,164,141],{}," 重命名为 ",[139,167,168],{},"chrome2.exe"," ，然后再发送快捷方式到桌面，竟然成功了。然而高兴没两天，主页又被劫持了，打开安装文件夹，发现竟然多了一个 ",[139,171,141],{}," ，和 ",[139,174,168],{}," 并存，而且不管是桌面快捷方式还是 ",[139,177,141],{}," 都是直接被导向去了 ",[139,180,161],{},"。",[129,183,184,185,188,189,191,192,194,195,197],{},"第三个尝试的是修改 ",[139,186,187],{},"hosts"," 文件，让我的电脑访问不了 ",[139,190,161],{}," 。这样很有效，当我打开浏览器的时候，确实访问不了 ",[139,193,161],{}," 了，但是我的浏览器没法停止自动跳转 ",[139,196,161],{}," 这个动作，只是会在访问不成功后报错“无法访问此网站”。",[129,199,200],{},"第四个想尝试的是注册表，无奈不会改，就作罢了。",[129,202,203,204,206,207,209,210,212],{},"然后我就放弃了，从 ",[139,205,187],{}," 里面把 ",[139,208,161],{}," 解放出来，不再阻止浏览器访问 ",[139,211,161],{}," 。",[125,214,215],{"id":215},"找到劫持主页的罪魁祸首",[129,217,218,219,221,222,181],{},"这个时候我发现，每当打开浏览器的时候，地址栏出现的网址并不是 ",[139,220,145],{}," 本身 ，而是一个很长的网址，几秒后会跳转到 ",[139,223,224],{},"http:\u002F\u002Fwww.hao123.com\u002Ftn=96363290_hao_pg",[129,226,227,228,231,232,234],{},"看到 ",[139,229,230],{},"tn=96363290_hao_pg"," 这个部分，我意识到这肯定是负责为 ",[139,233,161],{}," 做这个推广的人的账号，而跳转前的那个网址肯定是关键，于是我把浏览器关掉再重新打开，趁机记录下最开始出现的那个很长的网址，它是这样的：",[129,236,237],{},[139,238,239],{},"https:\u002F\u002Fvasapi.rdtuijian.com\u002Fjumber\u002Fv1?code=002_1000",[129,241,242],{},"不过直接转到这个地址的话会变404。",[129,244,245,246,249],{},"我在 google 上搜索了 ",[139,247,248],{},"rdtuijian.com"," 这个域名的注册信息，查到它是2016年2月在 goddady 上注册的，注册地在美国，不过这些信息没什么用。",[129,251,252,253,255],{},"继续在 google 上搜 ",[139,254,248],{}," ，有个好玩的网址出现了：",[129,257,258],{},[139,259,260],{},"http:\u002F\u002Fbook.rdtuijian.com\u002Fweb\u002Findex.html",[129,262,263,264,266],{},"它跟 ",[139,265,239],{}," 会有什么关系呢？",[129,268,269,270,272,273,276],{},"点开 ",[139,271,260],{}," 看发现是个 wap 版的书城，这个信息本身也没什么用，但是再搜索 ",[139,274,275],{},"book.rdtuijian.com\u002Fweb\u002Findex.html"," 就会发现一个有趣的网页",[129,278,279],{},[139,280,281],{},"http:\u002F\u002Fbbs.mo.wps.cn\u002Fforum.php?mod=viewthread&tid=16210&extra=page=1",[129,283,284],{},"3楼的回帖里是这么说的：",[129,286,287,288,181],{},"\"如果您是WPS会员，现在是无法看到读书入口，您可以暂时退出WPS账号，或者直接浏览器访问—— ",[139,289,260],{},[129,291,292,295,296,298],{},[139,293,294],{},"http:\u002F\u002Fbbs.mo.wps.cn\u002Fforum.php"," 这个网站貌似是WPS的官方论坛，而发表这个回帖的是一个 admin 账号，从这个语气上看，感觉 ",[139,297,260],{}," 应该是WPS下属的书城，那么这次的浏览器主页劫持应该就是 WPS 的锅没跑了。",[125,300,301],{"id":301},"解决问题",[129,303,304,305,308],{},"我的电脑上装了 WPS 也有好几年了，但是直到这两个月才出现浏览器主页劫持的问题，这很可能跟最近安装的插件有关，于是我打开控制面板的添加和删除程序，找到最近一次安装 WPS 插件的时间，果然让我发现，2017年3月18日我装了一个 PDF 转 WORD 的 WPS 插件，但是同一时间被安装的软件还有一个叫 ",[139,306,307],{},"Yuike Cloud"," 的东西。",[129,310,311,312,315],{},"PDF 转 WORD 的功能我还是需要的，如果真要尝试删除什么东西的话，就从 ",[139,313,314],{},"Yuike cloud"," 开始着手吧。",[129,317,318,319,321],{},"删掉 ",[139,320,314],{}," 之后再打开 Chrome 浏览器，终于直接跳转了我设置的主页，我简直要喜极而泣了。",[129,323,324],{},"这次解决浏览器主页被劫持的过程大概就是这样，希望大家看了之后也能有启发。",[129,326,327],{},"以上~",{"title":329,"searchDepth":34,"depth":34,"links":330},"",[331,332,333],{"id":127,"depth":34,"text":127},{"id":215,"depth":34,"text":215},{"id":301,"depth":34,"text":301},[12],"Chrome主页被hao123劫持了，该怎么办？","md",{"date":338,"language":339,"keywords":340,"comments":96},"2017-05-28","中文",[341,342,72,343],"浏览器","主页","劫持","\u002Fblog\u002F2017-05-28-hao123-issue",{"title":120,"description":335},"hao123-issue","blog\u002F2017-05-28-hao123-issue",[349,350],"Chrome","首页劫持","4otX8gCa5g_yZglOhmQDySi1xIquwr9n1YIHZqYGtfM",[353,354],null,{"title":355,"path":356,"stem":357,"children":-1,"slug":358},"如何搭建静态个人博客","\u002Fblog\u002F2018-03-28-jekyll-blog-static-website","blog\u002F2018-03-28-jekyll-blog-static-website","jekyll-blog-static-website",1794547928369]