[{"data":1,"prerenderedAt":216},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-little-animal-issue":118,"surround-little-animal-issue":205},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":193,"description":194,"extension":195,"meta":196,"navigation":96,"path":199,"seo":200,"slug":201,"stem":202,"tags":203,"__hash__":204},"blog\u002Fblog\u002F2020-09-08-little-animal-issue.md","小动物",{"type":122,"value":123,"toc":187},"minimark",[124,128,132,135,138,141,144,147,150,153,156,159,162,165,172,175,178,181,184],[125,126,127],"h2",{"id":127},"节肢动物",[129,130,131],"p",{},"来这里第一年，我就知道了美洲大蠊的厉害。",[129,133,134],{},"校园里面时不时地会碰到，走在路上也时不时会碰到，至于家里那就更是会碰到了。",[129,136,137],{},"大的有人类大拇指般的大小，小的也比苍蝇个头大。室外碰到了，可以绕道走，可是室内碰到了，既希望它赶紧走掉，又希望它别动，待我拿个什么工具消灭它，省得下次再见到。",[129,139,140],{},"话说室内，厨房自不必说，就连客厅、卧室也常见它们的身影，尤其是书桌的抽屉，不知为什么它们很喜欢往里面钻。",[129,142,143],{},"有时候目击这小东西进了抽屉，便感觉自己全身的汗毛都竖了起来。要不要打开抽屉呢？打开了万一它扑出来怎么办？如果它不见了，抽屉里的东西怎么办？要不要消毒？还是当做没看见？全都是天问。",[125,145,146],{"id":146},"爬行动物",[129,148,149],{},"最近不知从哪来了一只壁虎，我离它最近的时候距离应该不足一米。",[129,151,152],{},"虽然它很快就爬走了，但这惊鸿一瞥，也足够时间让我发现它竟然是浅粉棕色的！浅！粉！棕！色！为什么跟书上的图片不一样！？我并不想发现新的物种好吗！",[129,154,155],{},"我上一次见到壁虎应该至少是十几年前了，但那时我的房间比较大，壁虎的活动空间也大，想走也随时能走。现在嘛，可能它随便爬一爬，又会爬到我前面，就很无奈。",[129,157,158],{},"前几天又见着它两次，现在不知道还在不在。",[129,160,161],{},"更新：",[129,163,164],{},"2021年了，壁虎还没走。",[129,166,167],{},[168,169],"img",{"alt":170,"src":171},"gecko","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F130173211-ca8889f1-01ee-4a12-9a0c-9fde961161e1.jpeg",[129,173,174],{},"(摄于2021年6月26日)",[125,176,177],{"id":177},"不知道是啥的东西",[129,179,180],{},"还有一些奇奇怪怪的东西，由于个头比较小，无法判断是什么。一旦拍死了，也不过是黑黑的一团，我不是昆虫专家，也看不出来什么，只有作罢。",[129,182,183],{},"话说今年以来发现的最好用的消灭小动物的道具是空的纸巾盒，它形状稳定，拿取方便，攻击面积够大，适合目标本身移动速度快，但是短暂停留在平整的物体表面的时候用。打完就直接扔掉，非常环保。",[129,185,186],{},"这也算是一点生活小智慧吧，你学到了吗？",{"title":188,"searchDepth":34,"depth":34,"links":189},"",[190,191,192],{"id":127,"depth":34,"text":127},{"id":146,"depth":34,"text":146},{"id":177,"depth":34,"text":177},[26],"站在食物链顶端的人类，还是无法与不请自来的“小动物”们和平相处啊。","md",{"date":197,"language":198,"comments":96},"2020-09-08","中文","\u002Fblog\u002F2020-09-08-little-animal-issue",{"title":120,"description":194},"little-animal-issue","blog\u002F2020-09-08-little-animal-issue",[6],"VWosZDkyie8w7Fmfd2qWTbTlvi4pDc4ynsjQ8UE1w0w",[206,211],{"title":207,"path":208,"stem":209,"children":-1,"slug":210},"最近在追的电视剧","\u002Fblog\u002F2020-08-15-tv-review-2020-1","blog\u002F2020-08-15-tv-review-2020-1","tv-review-2020-1",{"title":212,"path":213,"stem":214,"children":-1,"slug":215},"高级社畜也不好过啊——《琉璃》和《秘密森林2》的观后感","\u002Fblog\u002F2020-09-19-destiny-of-shachiku","blog\u002F2020-09-19-destiny-of-shachiku","destiny-of-shachiku",1794501664035]