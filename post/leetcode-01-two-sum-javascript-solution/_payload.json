OHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":491,"description":492,"extension":493,"meta":494,"navigation":96,"path":499,"seo":500,"slug":501,"stem":502,"tags":503,"__hash__":506},"blog\u002Fblog\u002F2022-06-24-leetcode-01-two-sum-javascript-solution.md","leetCode第1题Two Sum的JS解法",{"type":122,"value":123,"toc":485},"minimark",[124,129,133,136,139,145,156,161,167,172,178,181,202,205,208,211,214,217,226,241,244,472,475,478,481],[125,126,128],"h2",{"id":127},"two-sum题目","Two Sum题目",[130,131,132],"p",{},"Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target.",[130,134,135],{},"You may assume that each input would have exactly one solution, and you may not use the same element twice.",[130,137,138],{},"You can return the answer in any order.",[130,140,141],{},[142,143,144],"strong",{},"Example 1:",[146,147,152],"pre",{"className":148,"code":150,"language":151},[149],"language-text","Input: nums = [2,7,11,15], target = 9\nOutput: [0,1]\nExplanation: Because nums[0] + nums[1] == 9, we return [0, 1].\n","text",[153,154,150],"code",{"__ignoreMap":155},"",[130,157,158],{},[142,159,160],{},"Example 2:",[146,162,165],{"className":163,"code":164,"language":151},[149],"Input: nums = [3,2,4], target = 6\nOutput: [1,2]\n",[153,166,164],{"__ignoreMap":155},[130,168,169],{},[142,170,171],{},"Example 3:",[146,173,176],{"className":174,"code":175,"language":151},[149],"Input: nums = [3,3], target = 6\nOutput: [0,1]\n",[153,177,175],{"__ignoreMap":155},[130,179,180],{},"Constraints:",[182,183,184,188,196,199],"ul",{},[185,186,187],"li",{},"2 \u003C= nums.length \u003C= 104",[185,189,190,191,195],{},"-109 \u003C= nums",[192,193,194],"span",{},"i"," \u003C= 109",[185,197,198],{},"-109 \u003C= target \u003C= 109",[185,200,201],{},"Only one valid answer exists.",[125,203,204],{"id":204},"分析",[130,206,207],{},"题目给出了一个整数的数列和一个整数，要求在数列中找到加起来正好是那个整数的两个数字，然后返回两个数字元素的下标。",[130,209,210],{},"其实不需要把数列里面的数字两两组合，全都加一遍。",[130,212,213],{},"我们已经知道两数之和是多少，那么从数列里拿出一个数，减一下就知道另一个数是多少了，然后再往后遍历，看看有没有这个数。",[130,215,216],{},"所以我们遍历的时候要做两件事：",[218,219,220,223],"ol",{},[185,221,222],{},"记录已经遍历过的数字及其下标",[185,224,225],{},"找到和它对应的数字",[130,227,228,229,232,233,236,237,240],{},"我们可以用一个 ",[153,230,231],{},"object"," 来记录遍历过的数字，由于查询是否存在时可能会遇到下标 ",[153,234,235],{},"0"," ，所以我们统一给所有下标 ",[153,238,239],{},"+1"," ，在输出的时候再减去即可。",[125,242,243],{"id":243},"解法",[146,245,249],{"className":246,"code":247,"language":248,"meta":155,"style":155},"language-js shiki shiki-themes github-light github-dark","\u002F**\n * @param {number[]} nums\n * @param {number} target\n * @return {number[]}\n *\u002F\nvar twoSum = function(nums, target) {\n    var obj = {};\n    for (let i = 0; i \u003C nums.length; i++) {\n        if (obj[target-nums[i]]) {\n            return [i,obj[target-nums[i]]-1];\n        } else {\n            obj[nums[i]] = i+1;\n        }\n    }\n};\n","js",[153,250,251,258,275,287,297,303,333,347,388,403,424,436,455,461,466],{"__ignoreMap":155},[192,252,254],{"class":253,"line":16},"line",[192,255,257],{"class":256},"sJ8bj","\u002F**\n",[192,259,260,263,267,271],{"class":253,"line":34},[192,261,262],{"class":256}," * ",[192,264,266],{"class":265},"szBVR","@param",[192,268,270],{"class":269},"sScJk"," {number[]}",[192,272,274],{"class":273},"sVt8B"," nums\n",[192,276,277,279,281,284],{"class":253,"line":19},[192,278,262],{"class":256},[192,280,266],{"class":265},[192,282,283],{"class":269}," {number}",[192,285,286],{"class":273}," target\n",[192,288,289,291,294],{"class":253,"line":7},[192,290,262],{"class":256},[192,292,293],{"class":265},"@return",[192,295,296],{"class":269}," {number[]}\n",[192,298,300],{"class":253,"line":299},5,[192,301,302],{"class":256}," *\u002F\n",[192,304,305,308,311,314,317,320,324,327,330],{"class":253,"line":24},[192,306,307],{"class":265},"var",[192,309,310],{"class":269}," twoSum",[192,312,313],{"class":265}," =",[192,315,316],{"class":265}," function",[192,318,319],{"class":273},"(",[192,321,323],{"class":322},"s4XuR","nums",[192,325,326],{"class":273},", ",[192,328,329],{"class":322},"target",[192,331,332],{"class":273},") {\n",[192,334,335,338,341,344],{"class":253,"line":39},[192,336,337],{"class":265},"    var",[192,339,340],{"class":273}," obj ",[192,342,343],{"class":265},"=",[192,345,346],{"class":273}," {};\n",[192,348,350,353,356,359,362,364,368,371,374,377,380,383,386],{"class":253,"line":349},8,[192,351,352],{"class":265},"    for",[192,354,355],{"class":273}," (",[192,357,358],{"class":265},"let",[192,360,361],{"class":273}," i ",[192,363,343],{"class":265},[192,365,367],{"class":366},"sj4cs"," 0",[192,369,370],{"class":273},"; i ",[192,372,373],{"class":265},"\u003C",[192,375,376],{"class":273}," nums.",[192,378,379],{"class":366},"length",[192,381,382],{"class":273},"; i",[192,384,385],{"class":265},"++",[192,387,332],{"class":273},[192,389,391,394,397,400],{"class":253,"line":390},9,[192,392,393],{"class":265},"        if",[192,395,396],{"class":273}," (obj[target",[192,398,399],{"class":265},"-",[192,401,402],{"class":273},"nums[i]]) {\n",[192,404,405,408,411,413,416,418,421],{"class":253,"line":95},[192,406,407],{"class":265},"            return",[192,409,410],{"class":273}," [i,obj[target",[192,412,399],{"class":265},[192,414,415],{"class":273},"nums[i]]",[192,417,399],{"class":265},[192,419,420],{"class":366},"1",[192,422,423],{"class":273},"];\n",[192,425,427,430,433],{"class":253,"line":426},11,[192,428,429],{"class":273},"        } ",[192,431,432],{"class":265},"else",[192,434,435],{"class":273}," {\n",[192,437,439,442,444,447,450,452],{"class"