[{"data":1,"prerenderedAt":551},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-notion":118,"surround-notion":540},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":522,"description":523,"extension":524,"meta":525,"navigation":96,"path":531,"seo":532,"slug":533,"stem":534,"tags":535,"__hash__":539},"blog\u002Fblog\u002F2023-02-22-notion.md","Notion的使用心得和遇到的问题",{"type":122,"value":123,"toc":502},"minimark",[124,129,136,139,157,160,163,166,169,172,176,179,182,185,191,194,197,212,215,220,236,239,242,249,259,274,284,289,304,307,313,317,328,335,339,341,343,356,360,362,365,368,372,374,377,380,384,387,404,410,413,417,428,435,439,445,449,460,463,466,475,479,482,493,496,499],[125,126,128],"h2",{"id":127},"notion是什么","Notion是什么",[130,131,132],"blockquote",{},[133,134,135],"p",{},"Notion是一款集成了笔记、知识库、数据表格、看板、日历等多种能力于一体的应用程序，它支持个人使用者单独使用，也可以与他人进行跨平台协作。",[133,137,138],{},"你可以在你的workspace里面建立页面，然后无限嵌套子页面，就像电脑的文件夹和子文件夹一样，这样就可以形成一个有体系的存档系统了。",[133,140,141,142,146,147,149,150,152,153,156],{},"Notion存档的最小单位是 ",[143,144,145],"code",{},"Page","， ",[143,148,145],{}," 有不同的属性以及主体内容，一系列的 ",[143,151,145],{},"就可以集成一个 ",[143,154,155],{},"Database","。",[133,158,159],{},"Database的每一条记录都是一个Page，Page的不同属性在Database上显示为不同的字段，展开Page即可输入页面主体内容。",[133,161,162],{},"每一个Page又可以嵌套Page或者Database，你可以建立不同的Database，给Database设置不同的视图，自由设置显示的字段，就可以获得不同层次的资讯。",[133,164,165],{},"目前Notion有网页版、桌面版、手机版，但是UI语言只有英文、日文、韩文，而且iOS版的UI语言默认是日文，还无法修改。如果我不是刚巧会日语，恐怕还没法用了呢。",[133,167,168],{},"免费个人版没有建立页面的数量限制，但上传附件时单个限制5Mb，如果超出就会提示套餐升级，但是你把附件再压缩一下，只要小于5Mb就能上传了。",[133,170,171],{},"如果你有教育邮箱，还可以享受免费升级到 Education Plus 套餐，就没有这个5Mb的限制了。",[125,173,175],{"id":174},"我的notion笔记","我的Notion笔记",[133,177,178],{},"目前我拿Notion来写私人日记，写博客草稿，做歌词本，做单词本，记录日常支出。",[133,180,181],{},"Notion的编辑器可以识别Markdown语法，输入Markdown的代码，直接显示结果。而从Notion页面复制内容的时候，又会还原成Markdown代码，这让我非常惊喜。因为我的博客文章需要用Markdown书写，在此之前我一直都找不到好用的网页端编辑器，现在终于找到了。",[133,183,184],{},"后来发现别人用Notion来记账，我甚至参考别人的版本，自己设计了一个记账本模板，可以自动汇总流水账到不同视图。",[133,186,187],{},[188,189],"img",{"alt":190,"src":190},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F220255355-13fb640b-3977-40b5-b461-94dcbc056621.jpg",[133,192,193],{},"以前我也用过一些记账软件，甚至也回归过Excel，但是软件或者Excel都有各自的缺陷，比如无法多端查看，汇总记录时无法屏蔽账户间转账，汇总时没有多层次视图等等。",[133,195,196],{},"我在建立这个模板的时候把这些问题都考虑在内，算是都解决了。",[133,198,199,200,207,208,211],{},"如果你有兴趣的话，可以在 ",[201,202,206],"a",{"href":203,"rel":204},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F11595164\u002Ff8f2\u002F",[205],"nofollow","这里"," 填写联系表单，我把模板链接发给你，你按 ",[143,209,210],{},"Duplicate","即可导入自己的Notion账号进行使用。",[125,213,214],{"id":214},"遇到的问题",[216,217,219],"h3",{"id":218},"board-view或gallery-view的卡片中不显示property-name","Board View或Gallery View的卡片中不显示property name",[133,221,222,223,226,227,230,231,233,234,156],{},"假设字段名为 ",[143,224,225],{},"Currency"," ，字段值为 ",[143,228,229],{},"USD","，如果设置 ",[143,232,225],{},"为显示字段，则只显示一个 ",[143,235,229],{},[133,237,238],{},"原因: 如题。",[133,240,241],{},"解决办法:",[243,244,245],"ol",{},[246,247,248],"li",{},"用新字段显示属性名",[133,250,251,252,255,256,258],{},"新增文本字段 ",[143,253,254],{},"Currency2","，字段值填写 ",[143,257,229],{},"。如果行数较少，可以手动暴力填写，如果行数较多，建议用Formula字段，用公式自动输出字符。",[133,260,261,262,264,265,267,268,270,271,273],{},"在Board View或Gallery View中添加 ",[143,263,225],{}," 和 ",[143,266,254],{}," 为显示的字段，并将 ",[143,269,254],{}," 拖到 ",[143,272,225],{}," 的前面。\n显示效果为两行",[275,276,281],"pre",{"className":277,"code":279,"language":280},[278],"language-text","Currency\nUSD\n","text",[143,282,279],{"__ignoreMap":283},"",[243,285,286],{"start":34},[246,287,288],{},"用公式字段输出属性名和属性值",[133,290,291,292,294,295,298,299,267,301,303],{},"新增Formula字段 ",[143,293,254],{},"，Formula内容填写 ",[143,296,297],{},"\"Currency: \"+prop(\"Currency\")","，在Board View或Gallery View中添加 ",[143,300,254],{},[143,302,225],{}," 设置为不显示。",[133,305,306],{},"显示效果为一行",[275,308,311],{"className":309,"code":310,"language":280},[278],"Currency: USD\n",[143,312,310],{"__ignoreMap":283},[216,314,316],{"id":315},"board-view无法拖动分组无法修改组的背景颜色","Board View无法拖动分组，无法修改组的背景颜色",[133,318,319,320,323,324,327],{},"原因: 如果分组的字段类型不是 ",[143,321,322],{},"Select","或 ",[143,325,326],{},"Multi Select","，则无法拖动组以及修改组的背景颜色",[133,329,330,331,323,333,156],{},"解决办法: 把字段类型改成 ",[143,332,322],{},[143,334,326],{},[216,336,338],{"id":337},"rollup不能引用类型为select或multi-select的字段","Rollup不能引用类型为Select或Multi Select的字段",[133,340,238],{},[133,342,241],{},[243,344,345,348],{},[246,346,347],{},"在当前表格中新增一个Formula辅助字段，设置条件来输出需要的值，如果当前表格无法满足条件，可以参考第二种办法。",[246,349,350,351,323,353,355],{},"在关联表格中新增一个Formula辅助字段，直接等于 ",[143,352,322],{},[143,354,326],{},"的值，在当前表格中用Rollup引用辅助字段",[216,357,359],{"id":358},"rollup不能引用类型为rollup的字段间接引用第三张表","Rollup不能引用类型为Rollup的字段(间接引用第三张表)",[133,361,238],{},[133,363,364],{},"解决办法: 在关联表格中新增一个Formula辅助字段，直接等于该Rollup字段的值。",[133,366,367],{},"回到当前表格，用Rollup引用相关辅助字段。",[216,369,371],{"id":370},"rollup不能按条件计算从关联表格中引用回来的值","Rollup不能按条件计算从关联表格中引用回来的值",[133,373,238],{},[133,375,376],{},"解决办法: 在关联表格中新增Formula辅助字段，按条件计算出结果，一个字段不够就再加几个辅助字段。",[133,378,379],{},"回到当前表格中，用Rollup汇总辅助字段的结果。",[125,381,383],{"id":382},"formula的使用","Formula的使用",[216,385,386],{"id":386},"数字加减和字符连接",[133,388,389,390,264,393,396,397,264,400,403],{},"基本的加减可以使用系统提供的 ",[143,391,392],{},"add()",[143,394,395],{},"subtract()"," 公式，但是显然还是 ",[143,398,399],{},"+",[143,401,402],{},"-"," 运算符更方便一些。",[133,405,406,407,409],{},"此时要注意， ",[143,408,399],{}," 除了可以用来加数字，还可以用来连接字符，如果运算符左右两边都是数字，那么会计算结果；如果两边都是字符，那么会输出连接后的字符；如果一个是数字，一个是文本，那么会报错Type mismatch xxx is not a Text。",[133,411,412],{},"然后我发现，如果Formula报错，那么十有八九还是数字或者文本格式的问题，以下总结5种公式结果不正确的解决办法，不过来来回回都是那2个问题，数字转文本，文本转数字。",[216,414,416],{"id":415},"formula报错type-mismatch-xxx-is-not-a-text","Formula报错Type mismatch xxx is not a Text",[133,418,419,420,423,424,427],{},"如果你要做数学运算，那么参与运算的元素都必须是数字格式，可以通过  ",[143,421,422],{},"+0"," 或者 ",[143,425,426],{},"*1"," 把有问题的元素转换成数字格式，就不会报错了。",[133,429,430,431,434],{},"如果你要连接字符串，那么要连接的所有元素都必须是文本格式，可以通过 ",[143,432,433],{},"format()"," 公式把有问题的元素转换成文本格式，就不会报错了。",[216,436,438],{"id":437},"formula报错type-mismatch-xxx-is-not-a-number","Formula报错Type mismatch xxx is not a Number",[133,440,419,441,423,443,427],{},[143,442,422],{},[143,444,426],{},[216,446,448],{"id":447},"formula报错syntax-error-in-part-xxx","Formula报错Syntax error in part xxx",[133,450,451,452,423,454,456,457,459],{},"还是把所有元素都改一改，需要是数字格式的都加零或者乘以一， ",[143,453,422],{},[143,455,426],{}," ，需要是文本格式的都用 ",[143,458,433],{}," 公式包裹一下，应该就可以了。",[216,461,462],{"id":462},"嵌套的if不出结果",[133,464,465],{},"原因: 可能还是数字和文本格式的问题",[133,467,468,469,423,471,456,473,459],{},"解决办法: 还是把所有元素都改一改，需要是数字格式的都加零或者乘以一， ",[143,470,422],{},[143,472,426],{},[143,474,433],{},[216,476,478],{"id":477},"formula结果出现长小数","Formula结果出现长小数",[133,480,481],{},"原因: 可能是网页上的JavaScript的问题。",[133,483,484,485,488,489,492],{},"解决办法: 假设我们需要保留2位小数，那就用 ",[143,486,487],{},"round( xxx * 100 ) \u002F100","，如果不需要小数，那就直接 ",[143,490,491],{},"round()"," 就行了。",[125,494,495],{"id":495},"总结",[133,497,498],{},"作为一个 All-in-one 的应用，Notion真的非常强大，虽然前期的学习成本比较高，但是一旦学会，就可以搭建自己的知识体系，管理日程，记录一切想记录的东西。",[133,500,501],{},"全文完~",{"title":283,"searchDepth":34,"depth":34,"links":503},[504,505,506,513,521],{"id":127,"depth":34,"text":128},{"id":174,"depth":34,"text":175},{"id":214,"depth":34,"text":214,"children":507},[508,509,510,511,512],{"id":218,"depth":19,"text":219},{"id":315,"depth":19,"text":316},{"id":337,"depth":19,"text":338},{"id":358,"depth":19,"text":359},{"id":370,"depth":19,"text":371},{"id":382,"depth":34,"text":383,"children":514},[515,516,517,518,519,520],{"id":386,"depth":19,"text":386},{"id":415,"depth":19,"text":416},{"id":437,"depth":19,"text":438},{"id":447,"depth":19,"text":448},{"id":462,"depth":19,"text":462},{"id":477,"depth":19,"text":478},{"id":495,"depth":34,"text":495},[23],"终于遇到了喜欢的多端适用笔记软件，做文章草稿库和账本简直太香了。","md",{"date":526,"language":527,"keywords":528,"comments":96},"2023-02-22","中文",[529,530],"记笔记","记账","\u002Fblog\u002F2023-02-22-notion",{"title":120,"description":523},"notion","blog\u002F2023-02-22-notion",[536,537,538],"Notion","笔记软件","账本应用","5srHEmAwsjMMzJrswVi2SQD7GJasG88oxxdGVPdc_EY",[541,546],{"title":542,"path":543,"stem":544,"children":-1,"slug":545},"如何优化谷歌和必应的识图搜索结果","\u002Fblog\u002F2023-02-15-search-with-img-on-google-bing","blog\u002F2023-02-15-search-with-img-on-google-bing","search-with-img-on-google-bing",{"title":547,"path":548,"stem":549,"children":-1,"slug":550},"关于“全职主妇”","\u002Fblog\u002F2023-03-06-house-wife","blog\u002F2023-03-06-house-wife","house-wife",1794550655393]