[{"data":1,"prerenderedAt":227},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-jojo-music":118,"surround-jojo-music":216},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":201,"description":132,"extension":202,"meta":203,"navigation":96,"path":208,"seo":209,"slug":210,"stem":211,"tags":212,"__hash__":215},"blog\u002Fblog\u002F2021-12-22-jojo-music.md","JoJo主题曲：从家族命运到个人抗争",{"type":122,"value":123,"toc":194},"minimark",[124,129,133,136,139,142,145,148,151,154,157,160,163,166,169,172,176,179,182,185,188,191],[125,126,128],"h2",{"id":127},"jojo的主题曲","JoJo的主题曲",[130,131,132],"p",{},"《JoJo的奇妙冒险》真的是超棒的系列作品，画风虽然奇特，但是看习惯了还觉得挺有意思的。剧情就不必说了，连音乐也都是杰作。",[130,134,135],{},"从第一部到第六部，总共有11个片头主题曲，1-3部的4首歌里全都有「運命（さだめ）」（命运），第四部没有，第五、六部又开始有了，1-4部的片头曲没有出现过「神」，而第五、六部则开始有了。",[130,137,138],{},"这也不难理解，1-3部是乔斯达家和Dio及其团体的对抗，是人类和永生的邪神之间的战斗，对乔家人和Dio来说都是被命运捉弄的100年。",[130,140,141],{},"从“天上降下两颗星”开始，到“End of THE WORLD，血脉的记忆”为止，乔家人和Dio本人的斗争终于结束了。",[130,143,144],{},"第四部的剧情是围绕东方仗助的小镇生活，与Dio的直接联系并不多。",[130,146,147],{},"第五部是乔鲁诺·乔巴纳的个人奋斗历程，而第六部则是空条徐伦的个人救赎之路，这两部感觉是在解决Dio遗留下来的历史问题，所有人又回到了命运的手掌心，甚至开始与神明斗争起来。",[130,149,150],{},"话说，我很不喜欢在歌词里看到汉字词念做不常用的读音，打出假名「さだめ」的时候，输入法根本不会提示汉字「運命」，如果歌词里只写了汉字而没有注音的话，唱歌的时候可能一不小心就唱错了。当然这个不重要。",[125,152,153],{"id":153},"杜王町杀人狂落网记",[130,155,156],{},"我觉得第四部《钻石不灭》应该改名叫“杜王町杀人狂落网记”，三首片头曲刚好表达了三个不同的阶段。",[130,158,159],{},"第一个主题曲是热闹的《Crazy Noisy Bizarre Town》，在这几集里我们开始认识这个小镇的各种奇奇怪怪的人。第二首是《Chase》，大家知道小镇上有一个杀人狂，为了自己无辜死去的亲友，就算走遍天涯海角也要“chase you”。第三首是《Great Days》，消灭了杀人狂，他们终于可以拿回自己的“great days”。",[130,161,162],{},"我以前看过的日本动漫里还没有出现过像吉良吉影这么纯粹的变态杀人狂，他没有不幸的童年，没有令人扼腕的遭遇，没有任何值得同情的点，他就是一个变态。",[130,164,165],{},"当他被倒行的救护车碾过的时候，相信观众都和主角们一样松了口气，并且暗暗觉得活该。",[130,167,168],{},"吉良吉影出场的时候会有一个奇怪的背景音乐《Killer》，平稳而有节奏感，曲调诙谐怪诞，听起来像是一个人蹑手蹑脚地在暗处活动，这和他做的大胆而残忍的事形成了对比，让他整个人显得特别滑稽。",[130,170,171],{},"编曲菅野祐悟老师果然“有一手”啊。",[125,173,175],{"id":174},"i-have-a-dream","I have a dream",[130,177,178],{},"第五部《黄金之风》的主角是Dio用乔纳森的身体和别人生下的乔鲁诺，他的生长环境和Dio相似，可是成长的方向却和Dio相反，因为他“有一个梦想”，那就是成为意大利的“黑帮巨星”，让堕落而不讲道义的意大利黑帮走上健康、光明的道路。",[130,180,181],{},"真是拥有金子般心灵的好孩子。",[130,183,184],{},"这部的第一个片头曲《Fighting Gold》一下子就抓住了我的心，尤其是「瓦礫」「世界を変えるために」「Fighting Gold」「輝ける」这四处，咬牙唱出的一个个音节和破音的地方简直就像是主角在呐喊：虽然是从瓦砾中诞生，但他拥有想要改变世界的黄金精神，未来一定会闪耀光辉。",[130,186,187],{},"实在不能不感动啊！",[125,189,190],{"id":190},"石之海",[130,192,193],{},"动画还没更完，未完待续。",{"title":195,"searchDepth":34,"depth":34,"links":196},"",[197,198,199,200],{"id":127,"depth":34,"text":128},{"id":153,"depth":34,"text":153},{"id":174,"depth":34,"text":175},{"id":190,"depth":34,"text":190},[9],"md",{"date":204,"language":205,"keywords":206,"comments":96},"2021-12-22","中文",[207],"Fighting Gold","\u002Fblog\u002F2021-12-22-jojo-music",{"title":120,"description":132},"jojo-music","blog\u002F2021-12-22-jojo-music",[213,214],"JoJo","音乐","TBjNgtRMMjbJ89Ed-FaEiD1gAkN3O17RR8ZyR0MfF-Y",[217,222],{"title":218,"path":219,"stem":220,"children":-1,"slug":221},"记录一下港康码系统的智障表现","\u002Fblog\u002F2021-12-17-hongkong-health-code","blog\u002F2021-12-17-hongkong-health-code","hongkong-health-code",{"title":223,"path":224,"stem":225,"children":-1,"slug":226},"JoJo的奇妙冒险之星尘远征军:一边发刀一边整活","\u002Fblog\u002F2021-12-23-jojo-startdust-crusaders","blog\u002F2021-12-23-jojo-startdust-crusaders","jojo-startdust-crusaders",1794547929221]