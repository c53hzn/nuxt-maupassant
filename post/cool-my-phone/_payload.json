[{"data":1,"prerenderedAt":192},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-cool-my-phone":118,"surround-cool-my-phone":181},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":164,"description":165,"extension":166,"meta":167,"navigation":96,"path":173,"seo":174,"slug":175,"stem":176,"tags":177,"__hash__":180},"blog\u002Fblog\u002F2021-08-03-cool-my-phone.md","给发烫的手机快速降温",{"type":122,"value":123,"toc":161},"minimark",[124,128,131,134,137,140,143,146,149,152,155,158],[125,126,127],"p",{},"手机已经用了 4 年了，两年前换过一次电池，最近这电池也是越来越显出老化的迹象了。",[125,129,130],{},"才不过切换了两三个 APP ，手机就开始发烫，每次要着急做点什么的时候，越是着急它就越慢。",[125,132,133],{},"影视 APP 倒还算能用，而微博视频要是看久了，机身也会发烫。至于抖音则更厉害，才不过刷了两三个短视频，机身温度就已经是我受不了的程度了。",[125,135,136],{},"于是只好卸载了抖音。",[125,138,139],{},"还有一个 APP 在用的时候手机也会发烫，但是这个就不能这么轻易卸载了，因为它是微信。语音通话 5 分钟左右，又是烫得不行了。",[125,141,142],{},"没办法，只好赶紧说完，把手机放冰箱。",[125,144,145],{},"冰箱可是个好东西，在冷藏格里放上 2 分钟，手机已经恢复到正常温度，如果再久一点，拿出来的时候手机就会凝结水珠了。",[125,147,148],{},"但是这样很影响微信通话体验，而且手机在冰箱里的时候，我也不能做其他事。",[125,150,151],{},"不如试试擦酒精布吧？",[125,153,154],{},"于是我一边和我妈通话，一边用酒精布擦拭机身背面，果然很有效，虽然不能做到直接降到室温，但是能感觉出来明显是加快了散热。反正我之前买了三大包酒精布，终于有机会可以用掉它们了。",[125,156,157],{},"其实还有个更好的办法，那就是换新手机。我想买个 iPhone 12 Mini ，但总是下不了决心，毕竟现在这个还能用，而且手机是真的不便宜啊。",[125,159,160],{},"我啥时候才能发财呢？",{"title":162,"searchDepth":34,"depth":34,"links":163},"",[],[26],"用了4年的手机总是发烫，我的处理是这样的。","md",{"date":168,"language":169,"keywords":170,"comments":96},"2021-08-03","中文",[171,172],"夏天","防暑降温","\u002Fblog\u002F2021-08-03-cool-my-phone",{"title":120,"description":165},"cool-my-phone","blog\u002F2021-08-03-cool-my-phone",[178,179],"手机","降温","_jUhIaQXihyPC_05DUsCJ0C2H4qU2Uhh6v7LZNGyv7o",[182,187],{"title":183,"path":184,"stem":185,"children":-1,"slug":186},"如何在Excel内将一对多的两列分离成每行都是一对一的两列","\u002Fblog\u002F2021-06-26-split-one-to-many-rows-to-one-to-one-rows","blog\u002F2021-06-26-split-one-to-many-rows-to-one-to-one-rows","split-one-to-many-rows-to-one-to-one-rows",{"title":188,"path":189,"stem":190,"children":-1,"slug":191},"疯狂的蜗牛","\u002Fblog\u002F2021-08-18-crazy-snails","blog\u002F2021-08-18-crazy-snails","crazy-snails",1794550657038]