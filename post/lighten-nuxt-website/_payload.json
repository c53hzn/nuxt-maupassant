 (qTag) {\u002F\u002F with tag query\n    ...\n  } else {\u002F\u002Fwithout requirement, returns list of all blogs\n    ...\n  }\n  res.send(json);\n});\n\napp.listen(4000, () => {\n  console.log(\"express server running at http:\u002F\u002F127.0.0.1:4000\")\n});\n",[134,417,418,423,428,433,438,443,448,453,458,463,468,473,478,483,488,493,498,503,508,513,518,523,527,533,537,543,549,555,561,567,572,578,583,589,594,599,605,611,617,623,629,634,640,645,651,657,663,669,675,681,687,693,698,704,709,714,720,726,731,737,743],{"__ignoreMap":147},[151,419,420],{"class":153,"line":16},[151,421,422],{},"var express = require(\"express\");\n",[151,424,425],{"class":153,"line":34},[151,426,427],{},"var fs = require(\"fs\");\n",[151,429,430],{"class":153,"line":19},[151,431,432],{},"var fm = require('front-matter');\n",[151,434,435],{"class":153,"line":7},[151,436,437],{},"var app = express();\n",[151,439,440],{"class":153,"line":174},[151,441,442],{},"var marked = require('marked');\n",[151,444,445],{"class":153,"line":24},[151,446,447],{},"var hljs = require('highlight.js');\n",[151,449,450],{"class":153,"line":39},[151,451,452],{"emptyLinePlaceholder":96},"\n",[151,454,455],{"class":153,"line":190},[151,456,457],{},"var rendererMD = new marked.Renderer();\n",[151,459,460],{"class":153,"line":196},[151,461,462],{},"var htmlResult = function(contentBody) {\n",[151,464,465],{"class":153,"line":95},[151,466,467],{},"  return marked(contentBody, {\n",[151,469,470],{"class":153,"line":207},[151,471,472],{},"    renderer: rendererMD,\n",[151,474,475],{"class":153,"line":213},[151,476,477],{},"    gfm: true,\n",[151,479,480],{"class":153,"line":291},[151,481,482],{},"    tables: true,\n",[151,484,485],{"class":153,"line":27},[151,486,487],{},"    breaks: false,\n",[151,489,490],{"class":153,"line":302},[151,491,492],{},"    pedantic: false,\n",[151,494,495],{"class":153,"line":308},[151,496,497],{},"    sanitize: false,\n",[151,499,500],{"class":153,"line":314},[151,501,502],{},"    sma