[{"data":1,"prerenderedAt":214},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-movie-death-notice":118,"surround-movie-death-notice":203},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":188,"description":130,"extension":189,"meta":190,"navigation":96,"path":196,"seo":197,"slug":198,"stem":199,"tags":200,"__hash__":202},"blog\u002Fblog\u002F2021-11-16-movie-death-notice.md","《暗杀风暴》定档12月10日，影版暗黑者又将带来什么新故事？",{"type":122,"value":123,"toc":185},"minimark",[124,128,131,138,141,144,149,152,155,158,161,164,167,170,173,176,179,182],[125,126,127],"p",{},"以下不含剧透，请放心食用。",[125,129,130],{},"周浩晖的小说《死亡通知单》电影版将于12月10日上映，这次是由香港导演、香港演员一起创作的港版电影，到时候肯定能带来和内地剧版不一样的新体验。",[125,132,133],{},[134,135],"img",{"alt":136,"src":137},"image","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F141979662-0ad85848-ccf0-4227-b710-19726e114e29.png",[125,139,140],{},"话说2014年的剧版改名为《暗黑者》，主角的对手也从Eumenides变成了Darker，这次的港版电影延续了“Darker”这个名称，让人一时分不清是从小说改编的，还是从电视剧改编的。",[125,142,143],{},"原著小说的文笔简练、不造作，但我觉得有时候人物塑造不够立体，有的人物的性格和行为没有铺垫，不过这不影响大局。",[125,145,146],{},[134,147],{"alt":136,"src":148},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F141980026-9d7c43f8-c108-41e0-bc5b-5b8d089ae543.png",[125,150,151],{},"对于剧版给反派改名这事，我一直有点意见。",[125,153,154],{},"Eumenides意为“复仇女神”，当年我看小说的时候专门查了字典，记下了它的读音 \u002Fjuˈmɛnɪdiːz\u002F，后来听有声书的时候，发现朗读者直接就念作“复仇女神”，这也算是尊重原著，照顾听众吧。",[125,156,157],{},"剧版把需要查字典才能记住的Eumenides改成了Darker，这种“通俗化处理”让我觉得自己被导演小看了。",[125,159,160],{},"至于剧版导演给原创人物加戏，魔改主要人物命运，让男主罗飞因为“月球表面”而出圈，这些仿佛都是小事了。",[125,162,163],{},"针对这次的电影版，我研究了一下演员表。",[125,165,166],{},"张智霖演罗飞，胡杏儿演孟芸，这是一对神探和早逝的白月光，感觉对他们来说应该没有难度。相比于郭京飞胡闹式的演技，张智霖应该能演出一个更沉稳、内敛的专业人员。",[125,168,169],{},"吴镇宇演韩灏，而演员表上没有尹剑，我觉得港版的导演可能是有些想法的。",[125,171,172],{},"剧版导演原创了很多剧情，其中让观众最能接受的是韩灏和同袍周浩，这么多年来我也一直对他们念念不忘，只可惜电影版恐怕没有了。",[125,174,175],{},"韩灏是一个复杂的、需要多层次演绎的角色，但吴镇宇自带一种痞气，不像是韩灏会有的气质，也许吴镇宇会有什么创新的演法？",[125,177,178],{},"这次的电影版完全是改成了香港背景，剧情和人物肯定会有很大改动，也不知道会不会水土不服。",[125,180,181],{},"记得几年前周浩晖曾经和同为推理作家的雷米（《心理罪》）、秦明（《法医秦明》）一起宣布会合作一个作品，可是等了这么多年承诺都没有兑现。",[125,183,184],{},"虽说好作品不怕等，但还是希望大神们快快出新作品吧！",{"title":186,"searchDepth":34,"depth":34,"links":187},"",[],[9],"md",{"date":191,"language":192,"keywords":193,"comments":96},"2021-11-16","中文",[194,195],"死亡通知单","电影","\u002Fblog\u002F2021-11-16-movie-death-notice",{"title":120,"description":130},"movie-death-notice","blog\u002F2021-11-16-movie-death-notice",[201],"暗黑者","OD-M48P6Ku9JMxJgLqTXfym2n4UZVlxfxciEzNYJk5s",[204,209],{"title":205,"path":206,"stem":207,"children":-1,"slug":208},"如何评价李云迪","\u002Fblog\u002F2021-10-30-li-yundi","blog\u002F2021-10-30-li-yundi","li-yundi",{"title":210,"path":211,"stem":212,"children":-1,"slug":213},"用Nuxt自建一个微博","\u002Fblog\u002F2021-11-18-self-hosted-weibo","blog\u002F2021-11-18-self-hosted-weibo","self-hosted-weibo",1794501663662]