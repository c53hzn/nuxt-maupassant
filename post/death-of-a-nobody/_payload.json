[{"data":1,"prerenderedAt":209},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-death-of-a-nobody":118,"surround-death-of-a-nobody":198},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":182,"description":183,"extension":184,"meta":185,"navigation":96,"path":191,"seo":192,"slug":193,"stem":194,"tags":195,"__hash__":197},"blog\u002Fblog\u002F2018-07-15-death-of-a-nobody.md","社畜烛九之死——看《镇魂》有感",{"type":122,"value":123,"toc":179},"minimark",[124,128,131,134,137,140,143,146,149,152,155,158,161,164,167,170,173,176],[125,126,127],"p",{},"从7月头开始追镇魂，先看了半集，觉得不行，要看明白世界观设置还是得先看小说，于是去把小说啃完了再来看剧版。",[125,129,130],{},"原著里没有给面面配置烛九这么个手下，面面自己单干也能成事，当然最后失败了。但是剧里先把他困住，再让他给自己发展小弟，这就有意思了。",[125,132,133],{},"他诱惑的都是普通的、不得志的青年，而现实中的青年大多都是普通的、不得志的，忽悠起来一抓一个准。烛九是这样，后来的混混男女也是这样。",[125,135,136],{},"面面声称看到了他们的潜力，然后将自己的商业计划包装一下推销出来，并对他们许以光明的未来，真真是一个合格的老板了。",[125,138,139],{},"光明的未来是需要拿命换的，烛九怎么会不知道。",[125,141,142],{},"有的人撑到了光明到来之时，有的人的生命（职业生命）终结于光明到来之前，有的人即使是在光明中却仍然仿佛置身黑暗。",[125,144,145],{},"当然了，他们要的“光明的未来”应该是没有实现的，谁让他们是反派呢。",[125,147,148],{},"烛九的遗言里说，他希望面面帮他毁灭这个无趣的世界，但是他明明就很羡慕海星的光明，羡慕黑袍使的能力，他眼中的世界一点也不无趣，甚至可以说是丰富多彩的。",[125,150,151],{},"可是这和他又有什么关系呢？",[125,153,154],{},"他只是一个没了老板加持就连瞬间移动都做不到的普通人，在这个有趣的世界里，唯一无趣的就只有自己了。",[125,156,157],{},"烛九燃烧自己，奉献自己，真的是为了一个光明的未来吗？",[125,159,160],{},"我觉得可以这么理解，这个所谓的“光明的未来”是夜尊许给他的，至于这个未来到底是光明还是不光明，他自己其实并不清楚，也并不关心，但是这是第一次有人“看出”他的潜力，愿意在他身上投资，虽然仅仅是投资了几句夸奖，但对烛九来说已经很难得了。",[125,162,163],{},"于是他愿意奉献出自己的生命，不是为光明的未来，而是为夜尊。",[125,165,166],{},"而鸦青就更伟大了，她真的是为了全族的未来，简直是妖界的李涯啊！",[125,168,169],{},"当然了，鸦青并不是我讨论的重点，我想说的只是一个邪恶的老板对普通的、不得志的青年的影响有多大。",[125,171,172],{},"同为老板，你看到赵云澜教唆特调处的人为他奉献生命了吗？",[125,174,175],{},"夜尊用有趣的世界诱惑无趣的青年，而青年也甘愿上钩，何其让人痛心！",[125,177,178],{},"写于2018年7月15日交完房租后。",{"title":180,"searchDepth":34,"depth":34,"links":181},"",[],[9],"你们在《镇魂》里看的都是甜甜的爱情，我却看到了社畜的悲哀。。。","md",{"date":186,"language":187,"keywords":188,"comments":96},"2018-07-15","中文",[189,190],"镇魂","耽美剧","\u002Fblog\u002F2018-07-15-death-of-a-nobody",{"title":120,"description":183},"death-of-a-nobody","blog\u002F2018-07-15-death-of-a-nobody",[196],"国产剧","ZZ4DR1E7inZJgNQAi-GmcKFQDfoMPkx2xlJe4xXXSe8",[199,204],{"title":200,"path":201,"stem":202,"children":-1,"slug":203},"如何搭建静态个人博客","\u002Fblog\u002F2018-03-28-jekyll-blog-static-website","blog\u002F2018-03-28-jekyll-blog-static-website","jekyll-blog-static-website",{"title":205,"path":206,"stem":207,"children":-1,"slug":208},"添加元素平移效果的产品页面","\u002Fblog\u002F2018-11-08-product-landing-page-with-scroll-effects","blog\u002F2018-11-08-product-landing-page-with-scroll-effects","product-landing-page-with-scroll-effects",1794501664280]