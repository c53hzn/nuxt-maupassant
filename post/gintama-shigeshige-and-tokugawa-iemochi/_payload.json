[{"data":1,"prerenderedAt":267},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-gintama-shigeshige-and-tokugawa-iemochi":118,"surround-gintama-shigeshige-and-tokugawa-iemochi":256},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":238,"description":239,"extension":240,"meta":241,"navigation":96,"path":248,"seo":249,"slug":250,"stem":251,"tags":252,"__hash__":255},"blog\u002Fblog\u002F2022-01-25-gintama-shigeshige-and-tokugawa-iemochi.md","研究了一下《银魂》的茂茂将军，感叹一下无常的人生",{"type":122,"value":123,"toc":230},"minimark",[124,132,137,140,143,146,149,155,159,162,168,171,174,177,181,184,187,190,193,196,199,202,205,208,211,214,218,221,224,227],[125,126,127],"p",{},[128,129],"img",{"alt":130,"src":131,"title":130},"银魂 德川茂茂","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F150955043-4c098ab2-966e-420a-96b1-fb23c1be9900.png",[133,134,136],"h2",{"id":135},"银魂和日本历史","《银魂》和日本历史",[125,138,139],{},"最近在看《银魂》，再次研究了一下日本近代史。",[125,141,142],{},"《银魂》乍一看是架空科幻的题材，但很多角色都是源自真实历史人物，从时间上看应该是跟《浪客剑心》比较接近。",[125,144,145],{},"《浪客剑心》是明治维新之后，新选组已经没了，原成员也没几个活的了，而《银魂》的时间要往前一些，新选组的人都在，幕府也没倒台。",[125,147,148],{},"《银魂》的茂茂将军名字的念法是「しげしげ」(Shigeshige)，但是在我稀薄的日本历史记忆里，茂茂的历史原型德川家茂的名字好像是念「いえもち」(Iemochi)。",[125,150,151],{},[128,152],{"alt":153,"src":154,"title":153},"银魂真人版 德川茂茂","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F150955199-e589465e-72f7-497a-b1dc-888805034e7c.png",[133,156,158],{"id":157},"大河剧笃姬","大河剧《笃姬》",[125,160,161],{},"记忆回到2009年，当时因为喜欢松田翔太而看了他参演的大河剧《笃姬》，历史上的家茂早逝，所以松田翔太的戏份并不多，但我还是认认真真看完了整个50集，对日本的近代史多了一些了解。",[125,163,164],{},[128,165],{"alt":166,"src":167},"笃姬 德川家茂","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F150955290-7ea04542-bcb4-4bca-95bf-94d2bda68c0b.png",[125,169,170],{},"幕府末年，笃姬嫁给时任将军德川家定，虽然夫妻恩爱，但是家定身体虚弱，结婚2年后就病逝了。笃姬没有子嗣，于是从德川家的旁系里选了家茂做继承人。家茂少年继位，过了8年也病逝了。于是又从族内选了一个继承人，就是德川幕府的最后一任将军德川庆喜，他继位一年后就到大政奉还，德川幕府就没了。",[125,172,173],{},"笃姬见证了一个旧时代的离去和新时代的开始，她自己是政治联姻的棋子，同时也是政治变革历程的参与者。",[125,175,176],{},"看了这部剧之后，有几个震惊的地方。",[133,178,180],{"id":179},"到底是谁的孩子","到底是谁的孩子？",[125,182,183],{},"日本人过继孩子、收养子、招女婿简直跟玩儿似的。",[125,185,186],{},"前面已经说了德川家过继孩子的过程，其他家也都差不多。",[125,188,189],{},"将军要选妃，于是笃姬所在的萨摩藩岛津家要找女孩子去应选，家主没有女儿，于是从族内找了笃姬收为养女，当作本家的女儿去应选。",[125,191,192],{},"萨摩藩在九州岛的西南部，而德川幕府在江户，位于本州岛的东南部，相距十万八千里。萨摩藩不富裕，和幕府也很疏远。",[125,194,195],{},"笃姬被选为御台所（将军的正室）之后，德川家嫌弃岛津家地位低微，让笃姬去近卫忠熙家做养女，以近卫家的女儿的身份出嫁。",[125,197,198],{},"到这里我已经看呆了。",[125,200,201],{},"笃姬的青梅竹马肝付尚五郎，因为不是长子，无法继承家业，于是去了小松家做上门女婿，改名小松带刀，后来成为倒幕派的中坚力量。",[133,203,204],{"id":204},"大奥里面寡妇多",[125,206,207],{},"其次震惊的是，大奥里面寡妇多。",[125,209,210],{},"笃姬嫁入德川家，进了大奥，即将军的后宫所在。2年之后笃姬就成了寡妇，后来天皇的妹妹和宫作为家茂的御台所进入大奥，4年之后也成了寡妇。",[125,212,213],{},"和宫也是个可怜人，在一年之内连续失去了母亲、丈夫、哥哥，自己没有孩子，跟名义上的婆婆笃姬关系也不好，真是太惨了。",[133,215,217],{"id":216},"管厨房的地位高吗","管厨房的地位高吗？",[125,219,220],{},"“御台所”是将军的正妻，“台所”是厨房，“御台所”就是管厨房的人，所以就是说，将军的老婆还要管厨房呢？",[125,222,223],{},"于是又想起来在《闯关东》里看到的一个词“中馈乏人”，字面意思是厨房没人，引申含义是没娶老婆。《闯关东》的男主替大儿子向王府格格提亲的时候被问到为什么儿子这么大了还“中馈乏人”，男主没文化，没有听懂。但是电视机前的我也很汗颜，因为我也没听懂。",[125,225,226],{},"不过中日两国竟然在这种地方达成了共识，真是让人大跌眼镜。",[125,228,229],{},"全文完。",{"title":231,"searchDepth":34,"depth":34,"links":232},"",[233,234,235,236,237],{"id":135,"depth":34,"text":136},{"id":157,"depth":34,"text":158},{"id":179,"depth":34,"text":180},{"id":204,"depth":34,"text":204},{"id":216,"depth":34,"text":217},[9],"戏说不是胡说，茂茂不是家茂，真实的人生没有那么搞笑。","md",{"date":242,"language":243,"keywords":244,"comments":96},"2022-01-25","中文",[245,246,247],"德川家茂","德川茂茂","天璋院笃姬","\u002Fblog\u002F2022-01-25-gintama-shigeshige-and-tokugawa-iemochi",{"title":120,"description":239},"gintama-shigeshige-and-tokugawa-iemochi","blog\u002F2022-01-25-gintama-shigeshige-and-tokugawa-iemochi",[253,254],"银魂","笃姬","tXNZOBpVRUEqNs4DpzcuAwCpjuXQrKRKW5uqqfAzlc4",[257,262],{"title":258,"path":259,"stem":260,"children":-1,"slug":261},"培养一个不要钱的爱好吧","\u002Fblog\u002F2022-01-21-expensive-hobbies","blog\u002F2022-01-21-expensive-hobbies","expensive-hobbies",{"title":263,"path":264,"stem":265,"children":-1,"slug":266},"2022香港疫情又起","\u002Fblog\u002F2022-02-20-hong-kong-covid-2022","blog\u002F2022-02-20-hong-kong-covid-2022","hong-kong-covid-2022",1794547929188]