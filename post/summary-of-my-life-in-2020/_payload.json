[{"data":1,"prerenderedAt":251},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-summary-of-my-life-in-2020":118,"surround-summary-of-my-life-in-2020":240},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":221,"description":222,"extension":223,"meta":224,"navigation":96,"path":233,"seo":234,"slug":235,"stem":236,"tags":237,"__hash__":239},"blog\u002Fblog\u002F2021-02-10-summary-of-my-life-in-2020.md","我的2020年",{"type":122,"value":123,"toc":208},"minimark",[124,128,132,135,138,142,145,148,151,154,157,160,163,166,169,172,175,178,181,184,187,190,193,196,199,202,205],[125,126,127],"h2",{"id":127},"人生剧变",[129,130,131],"p",{},"2020年的一场新冠疫情，极大地改变了我的人生。虽然我本来也没有什么特别的规划，但是也没想到竟然能因为一场疫情而改变我固有的行为习惯和生活方式。",[129,133,134],{},"不管有没有做好准备，变化就是突然降临了。我从一开始的惊慌失措到现在的平静接受，逐渐在新的生活和工作流程中稳定下来，甚至好像已经对疫情习以为常了。",[125,136,137],{"id":137},"疫情改变生活",[139,140,141],"h3",{"id":141},"口罩",[129,143,144],{},"在2020年以前，我没有戴过口罩。",[129,146,147],{},"我从来不知道原来我们每天呼吸的空气也可以成为危险的源头，而每次出门戴的口罩，虽然只是薄薄一片，但却可以帮大家隔开这危险的媒介。",[129,149,150],{},"而我以前也从来不知道，原来一片口罩要 2 块钱。记得小学的时候，我的早餐限额就是 2 块钱，那时候能买到鸡蛋和粥，所以在我心里 2 块钱的购买力一直是很强的。可是现在只能买到 1 片口罩了。",[139,152,153],{"id":153},"洗手",[129,155,156],{},"洗手这个其实我一直都有重视，每天进门第一件事就是洗手，只不过以前我只是用清水洗，而现在加了一个除菌洗手液。",[129,158,159],{},"由于不习惯戴手套，我有时候会用纸巾垫着按电梯或者拿什么东西，但更多的时候还是得用手直接接触物品。",[129,161,162],{},"这时候就会胡思乱想了，万一有病毒怎么办？然后四处找免洗的洗手液或者洗手间，彻彻底底洗一次。",[129,164,165],{},"手啊，打工人就靠你了，你可不能有事啊！",[125,167,168],{"id":168},"疫情改变工作",[139,170,171],{"id":171},"在家办公",[129,173,174],{},"由于工作特性，我的工作可以在家办公，于是我的工作竟然神奇地在疫情当中没有受影响。",[129,176,177],{},"只要有了电话转接、内网VPN等设置，大家可以随时随地办公，于是工作地点再也不是限制大家好好工作的因素了。",[129,179,180],{},"可是在公司上班和在家里上班的感觉还是不太一样，在家里好像总是容易分心，而且因为吃的喝的比公司提供的更对我的胃口（因为是我自己买的），于是吃喝的次数都变多了。",[129,182,183],{},"但是我好像没有长胖，我觉得是因为焦虑造成的，总归不是太好。",[139,185,186],{"id":186},"薪水缩水",[129,188,189],{},"2020年走掉了好几个同事，于是我连别人的工作也要带回来做，可是我的工资并没有上涨，总体来说，薪水的性价比是缩水了。",[129,191,192],{},"再加上年终奖减半了，这个年让人很难过，甚至明天就过年了，而我还得上班，更难过了。",[129,194,195],{},"虽然可以安慰自己说“好歹还有份工作”，但是工作如果不能带来足够的收益，那就只能带来痛苦了。",[125,197,198],{"id":198},"疫情改变思想",[129,200,201],{},"虽然有很多难过的事，但还是那句话，“好歹还有份工作”，我每个月交完房租之后，还是可以应付生活，我也不像刚工作那几年总是精神紧张了。",[129,203,204],{},"我想去深圳，想吃椰子鸡，想吃烤鱼，想吃酸菜鱼，想喝一点点。",[129,206,207],{},"我就靠这些念想支撑着我继续往下走了，这疫情还是赶紧过去吧！",{"title":209,"searchDepth":34,"depth":34,"links":210},"",[211,212,216,220],{"id":127,"depth":34,"text":127},{"id":137,"depth":34,"text":137,"children":213},[214,215],{"id":141,"depth":19,"text":141},{"id":153,"depth":19,"text":153},{"id":168,"depth":34,"text":168,"children":217},[218,219],{"id":171,"depth":19,"text":171},{"id":186,"depth":19,"text":186},{"id":198,"depth":34,"text":198},[26],"2020年真的是“被偷走的一年”，我好像除了年龄，什么都没有收获。","md",{"date":225,"language":226,"keywords":227,"comments":96},"2021-02-10","中文",[228,229,230,231,232],"Corona Virus","新冠疫情","抗疫","减薪","年终奖","\u002Fblog\u002F2021-02-10-summary-of-my-life-in-2020",{"title":120,"description":222},"summary-of-my-life-in-2020","blog\u002F2021-02-10-summary-of-my-life-in-2020",[6,238],"COVID-19","eayhbJ_pYfrv-huMaZfgA6LF5TI9lhEHczt-nGJ2u14",[241,246],{"title":242,"path":243,"stem":244,"children":-1,"slug":245},"Limitations of latest version Nuxt in 2021","\u002Fblog\u002F2021-02-08-nuxt-2021-limitations-en","blog\u002F2021-02-08-nuxt-2021-limitations-en","nuxt-2021-limitations-en",{"title":247,"path":248,"stem":249,"children":-1,"slug":250},"ASMR视频推荐","\u002Fblog\u002F2021-02-11-asmr-recommendations","blog\u002F2021-02-11-asmr-recommendations","asmr-recommendations",1794547929560]