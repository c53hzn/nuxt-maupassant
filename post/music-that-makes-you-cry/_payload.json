[{"data":1,"prerenderedAt":446},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-music-that-makes-you-cry":118,"surround-music-that-makes-you-cry":435},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":419,"description":420,"extension":421,"meta":422,"navigation":96,"path":428,"seo":429,"slug":430,"stem":431,"tags":432,"__hash__":434},"blog\u002Fblog\u002F2021-03-28-music-that-makes-you-cry.md","那些一听到就会泪流满面的音乐",{"type":122,"value":123,"toc":406},"minimark",[124,128,132,135,138,141,144,147,150,155,165,168,179,182,188,191,194,197,200,203,206,209,213,221,225,228,231,234,237,241,249,253,256,259,262,265,268,271,274,277,280,284,291,302,305,309,312,315,319,322,325,329,337,340,343,347,350,353,356,359,362,365,369,372,375,379,387,391,394,397,400,403],[125,126,127],"h2",{"id":127},"前言",[129,130,131],"p",{},"我有一个纯音乐的歌单，每到想平静心绪的时候就拿出来听一听。",[129,133,134],{},"这些曲子都是从看过的影视作品里知道的，每次听的时候都会回想起相应的片段。",[129,136,137],{},"在这里，我想分享一下这些让人难忘、让人心碎的音乐。",[125,139,140],{"id":140},"我的音乐收藏",[129,142,143],{},"主要是钢琴曲，少量为电子音乐及传统乐器音乐。",[129,145,146],{},"我尤其喜欢《你好，我的银色海豚》和《胜利！善的主题曲》这两首曲子的琶音部分。",[129,148,149],{},"以及由于拉威尔生得晚，科技进步得快，我们竟然有幸能听到他亲自弹奏和指挥的曲子。",[151,152,154],"h3",{"id":153},"你好我的银色海豚搞笑一家人","你好，我的银色海豚（搞笑一家人）",[156,157,158,162],"ul",{},[159,160,161],"li",{},"曲子原名: 안녕,나의 은빛 돌고래",[159,163,164],{},"作者: 全秀妍（南朝鲜）",[129,166,167],{},"《搞笑一家人》第 166 集节选：第 11 分 47 秒开始",[169,170,178],"iframe",{"className":171,"src":173,"scrolling":174,"border":175,"frameBorder":174,"framespacing":176,"allowFullScreen":177},[172],"youtube","\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=5381090&bvid=BV1Fs41117xU&cid=9817616&page=89","no",0,"0","true"," ",[129,180,181],{},"完整版《你好，我的银色海豚》",[169,183],{"className":184,"src":185,"title":186,"frameBorder":176,"allow":187,"allowFullScreen":96},[172],"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002Ft5HDseardQs","YouTube video player","accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture",[129,189,190],{},"为什么一个一百多集的喜剧，结局竟然是悲剧呢？",[129,192,193],{},"敏静已经和民勇走过那么多坎坷，就要步入婚姻殿堂了，民勇却因为收到关于申智的求助电话而离敏静而去。",[129,195,196],{},"允浩按照敏静希望的那样完成了考试，可是敏静却微笑着一个人离开了。",[129,198,199],{},"金范是敏浩密不可分的好友，可是他走的那天，敏浩却追不上他的车子，连句再见也没说。",[129,201,202],{},"这首曲子是敏静最后一次给同学们点名的时候的背景音乐，曲子表达的感情并不浓烈，有一种沉静、安宁的感觉，像是在回想一个平常的日子，生活的点点滴滴化成音符萦绕在大家耳边。",[129,204,205],{},"可是我拿出来听的时候，总是想到前面那些“意难平”。",[129,207,208],{},"好故事，配上好音乐，即使时间过去了十几年，我仍然会记得。",[151,210,212],{"id":211},"悼念公主的帕凡舞曲mr-brain脑神探","悼念公主的帕凡舞曲（Mr Brain脑神探）",[156,214,215,218],{},[159,216,217],{},"曲子原名: Pavane pour une infante défunte",[159,219,220],{},"作者: 拉威尔（法）",[169,222,178],{"className":223,"src":224,"scrolling":174,"border":175,"frameBorder":174,"framespacing":176,"allowFullScreen":177},[172],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=286059051&bvid=BV1yf4y1y7N4&cid=202832345&page=1",[129,226,227],{},"日剧《Mr Brain》（港译“脑神探”）第四集，事件中心的姐弟俩都互相为对方承担了很多可怕的事，而大脑受过伤的弟弟只能依靠不断弹奏《悼念公主的帕凡舞曲》来表达自己对姐姐的感情。",[129,229,230],{},"我一直都记得饰演弟弟的佐藤健双手沾满鲜血却浑然不觉，仍然如痴如醉地弹琴的场面。音乐在这一集里是弟弟的记忆承载体，也是引发真生罪犯的贪欲的源泉，还提供了解决案件的关键信息。",[129,232,233],{},"然而最令我震撼的是前两天搜《Mr Brain》资料的时候发现有人给这部 2009 年的日剧标记了“怀旧”的标签。",[129,235,236],{},"2009 年的剧有什么好怀旧的！",[151,238,240],{"id":239},"给哥哥的钢琴曲爱的迫降","给哥哥的钢琴曲（爱的迫降）",[156,242,243,246],{},[159,244,245],{},"曲子原名: 형을 위한 노래",[159,247,248],{},"作者: 南惠胜（南朝鲜）",[169,250,178],{"className":251,"src":252,"scrolling":174,"border":175,"frameBorder":174,"framespacing":176,"allowFullScreen":177},[172],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=97759298&bvid=BV1iE411N7yT&cid=166882708&page=1",[129,254,255],{},"男主是北朝鲜的高干子弟，因而有机会学钢琴、出国留学。",[129,257,258],{},"他在留学期间为哥哥写了一首钢琴曲，临回国前在一片湖边演奏时，非常偶然地拯救了女主的心灵。",[129,260,261],{},"此时他还不知道哥哥已经遇害，只是带着对哥哥的思念弹奏了这首曲子。弹琴的男主和湖光山色互相映衬，这场面确实能拯救很多心灵。",[129,263,264],{},"而这部剧的整个故事可以说是围绕着“家人”展开的。",[129,266,267],{},"男主为哥哥创作钢琴曲，因为哥哥的去世而参军，为了爱人而甘冒各种风险。",[129,269,270],{},"女主为了不让父亲和哥哥们看扁而一直努力自强，但家人给她造成的伤害竟至于让她产生轻生的念头。",[129,272,273],{},"而男女主角的相遇和分别，则是因为他们的国家被一分为二，他们明明是一家人，却要说两家话。",[129,275,276],{},"离别让爱情更美丽，撕心裂肺的离别最凄美。",[129,278,279],{},"故事就只是故事，而现实却还是不可动摇，哀叹也没有用。",[151,281,283],{"id":282},"波莱罗舞曲数码宝贝","波莱罗舞曲（数码宝贝）",[156,285,286,289],{},[159,287,288],{},"曲子原名: Bolero",[159,290,220],{},[129,292,293,294,301],{},"《数码宝贝》第21集“滚球兽在东京”里面出现过的音乐。爱奇艺买了版权，点击 ",[295,296,300],"a",{"href":297,"rel":298},"https:\u002F\u002Fwww.iqiyi.com\u002Fv_19rro8bn40.html",[299],"nofollow","这里"," 观看。我反正是看不了。",[129,303,304],{},"Youtube 节选片段，“波莱罗”大概在 1 分 10 秒 到 50 秒之间，总共也就 40 秒的时间。",[169,306],{"className":307,"src":308,"title":186,"frameBorder":176,"allow":187,"allowFullScreen":96},[172],"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002Ff3O4YtlRvNY",[129,310,311],{},"数不清的数码宝贝出现在东京街头，它们四处破坏，在高楼林立的城市里显得格格不入。这画面荒诞又离奇，就像一场梦一样。",[129,313,314],{},"《波莱罗舞曲》完整版",[169,316,178],{"className":317,"src":318,"scrolling":174,"border":175,"frameBorder":174,"framespacing":176,"allowFullScreen":177},[172],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=68756643&bvid=BV1YJ411M7K1&cid=119159846&page=1",[129,320,321],{},"除了《数码宝贝》之外，我还在一个 TVB 的电视剧里听到过《波莱罗》，也是一个想表达梦境的场面。主人公看到一个个自己熟悉的人，可是他们却仿佛不认识自己，主人公随即醒来，我们知道这不过是一场梦。",[129,323,324],{},"“波莱罗”的原曲一般有 8 分多钟，我通常用来睡前听，确实很催眠。",[151,326,328],{"id":327},"胜利善的主题曲数码宝贝","胜利！善的主题曲（数码宝贝）",[156,330,331,334],{},[159,332,333],{},"曲子原名: 勝利！善のテーマ",[159,335,336],{},"作者: 有泽孝纪（日）",[129,338,339],{},"这是波莱罗舞曲结束后，太一被带回数码宝贝世界，要和嘉儿分别时放的背景音乐。前面的 Youtube 动画节选视频也包含了这一段。",[129,341,342],{},"完整版见此",[169,344,178],{"className":345,"src":346,"scrolling":174,"border":175,"frameBorder":174,"framespacing":176,"allowFullScreen":177},[172],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=73039381&bvid=BV1EE41127r5&cid=124923150&page=1",[129,348,349],{},"太一被异世界的力量缓缓带离地面，年幼的妹妹死死抓住哥哥的手不放，可是哥哥越升越高，妹妹的手终于支持不住，慢慢松开。",[129,351,352],{},"妹妹落回了地面，而哥哥消失在天空。",[129,354,355],{},"幽幽的的电子乐声配上离别的画面，让人心灵备受震撼。",[129,357,358],{},"曲子的原名是『勝利！善のテーマ』，直译就是“胜利！善的主题曲”，但是不知道为什么中文圈广为流传的名称叫《光芒与希望》，我用日文在日本雅虎上找了半天也找不到任何资料，唯一有提到这个曲名的帖子是分享从中文网站抄来的乐谱，可见这个中文名称应该是讹传。",[129,360,361],{},"但是这个名字格外地贴合兄妹离别的场景，太一是消失在一片光芒中的，而嘉儿是尚未进入数码宝贝世界的另一个“被选召的孩子”，她是两个世界的另一个希望。",[129,363,364],{},"这里有个钢琴版，标题用的是讹传的曲名。",[169,366,178],{"className":367,"src":368,"scrolling":174,"border":175,"frameBorder":174,"framespacing":176,"allowFullScreen":177},[172],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=49200709&bvid=BV1cb411T7er&cid=86157231&page=1",[129,370,371],{},"钢琴版别有一番风味。",[129,373,374],{},"弹琴的妹子手势轻柔，指法坚定，琴声饱含了对亲人的依恋和对世界的爱，弹出了“光芒与希望”的主题。",[151,376,378],{"id":377},"月光水岸南航飞机降落音乐","月光水岸（南航飞机降落音乐）",[156,380,381,384],{},[159,382,383],{},"曲子原名: Moonglow",[159,385,386],{},"作者: Bandari",[169,388,178],{"className":389,"src":390,"scrolling":174,"border":175,"frameBorder":174,"framespacing":176,"allowFullScreen":177},[172],"\u002F\u002Fplayer.bilibili.com\u002Fplayer.html?aid=667749311&bvid=BV16a4y1x7Aw&cid=177521788&page=34",[129,392,393],{},"这个不是影视剧的插曲，是南航飞机降落之后放的音乐。之所以放在这里，是因为它很贴近本篇文章的主题——离别。",[129,395,396],{},"我已经一年零两个月没有坐过飞机了，有天在梦里听到这个音乐，醒来之后想了很久这是什么音乐，然后脑海里浮现出飞机在跑道上缓缓滑行的画面，我可能是潜意识里想坐飞机了。",[125,398,399],{"id":399},"结语",[129,401,402],{},"我可能对于“离别”这个主题有着特别的偏爱，因为“离别”之后才有“重逢”，“离别”时的每一分痛楚都会让“重逢”时的喜悦更加强烈。",[129,404,405],{},"但还是希望世上不要有离别吧。",{"title":407,"searchDepth":34,"depth":34,"links":408},"",[409,410,418],{"id":127,"depth":34,"text":127},{"id":140,"depth":34,"text":140,"children":411},[412,413,414,415,416,417],{"id":153,"depth":19,"text":154},{"id":211,"depth":19,"text":212},{"id":239,"depth":19,"text":240},{"id":282,"depth":19,"text":283},{"id":327,"depth":19,"text":328},{"id":377,"depth":19,"text":378},{"id":399,"depth":34,"text":399},[29],"记录一下这些年在影视剧和各种地方听到过的会让人瞬间被带回那个情境的纯音乐和歌曲。","md",{"date":423,"language":424,"keywords":425,"comments":96},"2021-03-28","中文",[426,427],"Music","heart-breaking","\u002Fblog\u002F2021-03-28-music-that-makes-you-cry",{"title":120,"description":420},"music-that-makes-you-cry","blog\u002F2021-03-28-music-that-makes-you-cry",[6,433],"音乐","YFY2QQAQBq9HfrW0EIu0VZ8EIC9Ff7L4kwZCY7Gyzf4",[436,441],{"title":437,"path":438,"stem":439,"children":-1,"slug":440},"新冠疫苗测评","\u002Fblog\u002F2021-03-28-covid19-vaccine-review","blog\u002F2021-03-28-covid19-vaccine-review","covid19-vaccine-review",{"title":442,"path":443,"stem":444,"children":-1,"slug":445},"Create Bilingual Breadcrumbs component for Nuxt","\u002Fblog\u002F2021-04-06-nuxt-breadcrumbs-bilingual-en","blog\u002F2021-04-06-nuxt-breadcrumbs-bilingual-en","nuxt-breadcrumbs-bilingual-en",1794501663841]