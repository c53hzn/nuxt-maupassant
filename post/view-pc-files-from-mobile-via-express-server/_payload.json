93},"node脚本","Node脚本",[129,196,197,198,201,202],{},"为了搭建这样的服务器，我们需要安装两个 NPM package： ",[152,199,200],{},"express"," 和 ",[152,203,204],{},"serve-index",[129,206,207,208],{},"全局安装 ",[152,209,200],{},[211,212,217],"pre",{"className":213,"code":214,"language":215,"meta":216,"style":216},"language-js shiki shiki-themes github-light github-dark","npm install -g express\n","js","",[152,218,219],{"__ignoreMap":216},[220,221,223,227,231],"span",{"class":222,"line":16},"line",[220,224,226],{"class":225},"sVt8B","npm install ",[220,228,230],{"class":229},"szBVR","-",[220,232,233],{"class":225},"g express\n",[129,235,207,236],{},[152,237,204],{},[211,239,241],{"className":213,"code":240,"language":215,"meta":216,"style":216},"npm install -g serve-index\n",[152,242,243],{"__ignoreMap":216},[220,244,245,247,249,252,254],{"class":222,"line":16},[220,246,226],{"class":225},[220,248,230],{"class":229},[220,250,251],{"class":225},"g serve",[220,253,230],{"class":229},[220,255,256],{"class":225},"index\n",[129,258,259],{},"然后就可以写服务器脚本啦！",[211,261,263],{"className":213,"code":262,"language":215,"meta":216,"style":216},"var express = require(\"express\");\nvar serveIndex = require('serve-index');\n\nvar app = express();\nvar localIp = \"1xx.1xx.1.1xx\";\u002F\u002F 这里输入你的内网IP\n\napp.use(express.static(__dirname));\napp.use('\u002F', serveIndex(__dirname + '\u002F'));\napp.listen(4000,localIp, () => {\n  console.log(\"express server running at \" + localIp + \":4000\")\n});\u002F\u002F你要是不想用4000这个端口，也可以用别的数字\n",[152,264,265,290,308,313,328,348,352,369,399,422,448],{"__ignoreMap":216},[220,266,267,270,273,276,280,283,287],{"class":222,"line":16},[220,268,269],{"class":229},"var",[220,271,272],{"class":225}," express ",[220,274,275],{"class":229},"=",[220,277,279],{"class":278},"sScJk"," require",[220,281,282],{"class":225},"(",[220,284,286],{"class":285},"sZZnC","\"express\"",[220,288,289],{"class":225},");\n",[220,291,292,294,297,299,301,303,306],{"class":222,"line":34},[220,293,269],{"c