[{"data":1,"prerenderedAt":226},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-hongkong-health-code":118,"surround-hongkong-health-code":215},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":199,"description":200,"extension":201,"meta":202,"navigation":96,"path":208,"seo":209,"slug":210,"stem":211,"tags":212,"__hash__":214},"blog\u002Fblog\u002F2021-12-17-hongkong-health-code.md","记录一下港康码系统的智障表现",{"type":122,"value":123,"toc":192},"minimark",[124,128,140,143,146,149,152,155,158,161,165,168,171,174,177,180,183,186,189],[125,126,127],"h2",{"id":127},"注册账号",[129,130,131,132,139],"p",{},"进入官网 ",[133,134,138],"a",{"href":135,"rel":136},"https:\u002F\u002Fwww.healthcode.gov.hk\u002F",[137],"nofollow","https:\u002F\u002Fwww.healthcode.gov.hk"," 进行注册。",[129,141,142],{},"注册账号时需要提交身份证和住址证明的图片，这些倒没什么。",[129,144,145],{},"提交注册申请3天之后会收到审核成功的短信，然后要用短信里的验证码来登入并启用账号，这时候问题来了。",[125,147,148],{"id":148},"登录密码的问题",[129,150,151],{},"注册账号的时候，密码要求必须含有大写字母、小写字母、数字和特殊符号，由于平时根本不会用这么复杂的密码，注册的时候虽然设置了，但是根本记不住。",[129,153,154],{},"登入时输入了香港身份证号和我常用的密码之后，页面报错说证件号或者密码有误，由于坚信自己没有输错密码，我以为是证件号有误，但是再三检查之后发现证件号没有错误，此时我以为系统有误。",[129,156,157],{},"但其实系统也没有问题，只是我输错密码而已，点击忘记密码，然后收取改密码的短信验证码，再进入重置密码的页面，我就突然想起注册时设置的密码了，于是又设置了一个跟初始密码一样的密码。",[129,159,160],{},"这纯粹是浪费时间啊！",[125,162,164],{"id":163},"上传安心出行记录","上传“安心出行”记录",[129,166,167],{},"登入成功之后要先申领健康码，申领时需要从“安心出行APP”上传出行记录。",[129,169,170],{},"于是手机打开“安心出行”，找来找去都找不到上传出行记录到港康码网站的地方。",[129,172,173],{},"此时我有点怀疑是不是APP的版本问题，也许应该更新一下APP？但是APP的更新记录是今天，难道我需要卸载再重装吗？",[129,175,176],{},"幸好我没有重装，否则之前累积的出行记录都会消失的。",[129,178,179],{},"看了一个微信公众号的评论，我终于知道，原来要进入“设定”，找到“欢迎使用安心出行”，点完所有的下一页，在港康码那里点“启用”，然后再回到APP的首页，就能看到港康码了。",[129,181,182],{},"在APP里面连接港康码账号，然后上传安心出行的记录。",[129,184,185],{},"这个记录必须手动上传，而港康码网站只能记录最后一次上传的数据，隔一天就没用了。",[125,187,188],{"id":188},"结论",[129,190,191],{},"整个流程设计非常地反人类，到现在为止我还没成功申领到健康码，之后再研究吧。",{"title":193,"searchDepth":34,"depth":34,"links":194},"",[195,196,197,198],{"id":127,"depth":34,"text":127},{"id":148,"depth":34,"text":148},{"id":163,"depth":34,"text":164},{"id":188,"depth":34,"text":188},[26],"港康码系统上线，终于有了通关的迹象，我注册了港康码账号，然后发现这个系统实在是太智障了。","md",{"date":203,"language":204,"keywords":205,"comments":96},"2021-12-17","中文",[206,207],"健康码","通关","\u002Fblog\u002F2021-12-17-hongkong-health-code",{"title":120,"description":200},"hongkong-health-code","blog\u002F2021-12-17-hongkong-health-code",[213],"港康码","0JPuAF5q04BrJAJWGzG9iDhzsJd1oodsE1F47Y4Q9bg",[216,221],{"title":217,"path":218,"stem":219,"children":-1,"slug":220},"用Nuxt自建一个微博","\u002Fblog\u002F2021-11-18-self-hosted-weibo","blog\u002F2021-11-18-self-hosted-weibo","self-hosted-weibo",{"title":222,"path":223,"stem":224,"children":-1,"slug":225},"JoJo主题曲：从家族命运到个人抗争","\u002Fblog\u002F2021-12-22-jojo-music","blog\u002F2021-12-22-jojo-music","jojo-music",1794550656944]