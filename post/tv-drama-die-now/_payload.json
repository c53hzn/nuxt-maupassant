[{"data":1,"prerenderedAt":233},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-tv-drama-die-now":118,"surround-tv-drama-die-now":222},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":209,"description":210,"extension":211,"meta":212,"navigation":96,"path":215,"seo":216,"slug":217,"stem":218,"tags":219,"__hash__":221},"blog\u002Fblog\u002F2020-02-13-tv-drama-die-now.md","专门安利一下《端脑》",{"type":122,"value":123,"toc":201},"minimark",[124,128,132,135,138,141,144,147,150,153,156,159,162,165,168,171,174,177,180,183,186,189,192,195,198],[125,126,127],"h2",{"id":127},"契机",[129,130,131],"p",{},"看《端脑》是冲着灵剑山的男二朱元冰去的，他古装扮相不错，于是我想看看他的现代装怎么样。",[129,133,134],{},"电视剧披着科幻、闯关的皮，又带一点推理的元素，很对我的胃口，于是就看了。",[125,136,137],{"id":137},"主线剧情",[129,139,140],{},"整部剧采用单元剧的形式，让男主在几个不同的场景下完成个人的成长，和同伴建立联盟，同时慢慢展示故事的世界观。",[129,142,143],{},"开头以悬案线索埋伏笔，引出男女主角，当你以为这是甜甜的校园恋爱主题的时候，女主突然消失了！",[129,145,146],{},"男主为了寻找女主，和小伙伴四处寻访女主可能去过的地方，终于通过开篇的悬案线索找到了隐藏入口，进入了一个虚拟世界。",[129,148,149],{},"进入虚拟世界的人被称为玩家，他们可以在不同的虚拟场景下完成游戏对战，胜者可以获得丰厚的奖励，在虚拟世界中享受生活，而败者则要回到现实世界，如果输得太惨，还会在现实中丢掉性命。",[129,151,152],{},"原来女主被困在了这个虚拟世界的游戏里，男主只有不停地赢得游戏，才能找到女主并解救她。",[129,154,155],{},"在这些游戏局当中，有的涉及到数学问题，开了金手指的主角们自然不在话下；有的类似于杀人游戏或是阿婆的《无人生还》，悬念在于下一个出局的人；有的则用的是《恐怖游轮》的逻辑，主角们要努力避免自己被另一个自己打败。但即使是相同性质的游戏局，游戏内容也能有多角度的变化，而男主在各个游戏局当中的身份转换也是一大亮点，可看性还是挺强的。",[129,157,158],{},"我最喜欢的单元是“阿加莎的晚宴”，作者创造了一个类似阿加莎克里斯蒂常用的“与世隔绝的大宅”的环境，又设置了类似“每次‘死’（离开）一个人”的规矩，用“下一个死（离开）者”作为悬念，让人忍不住期待后面的剧情。",[129,160,161],{},"然而我们的男主在这里并不是侦探的角色，而是“凶手”的“帮手”，他一边要帮“凶手”完成“杀人”的任务，一边又不能让大家怀疑“凶手”和自己。他周旋于各个NPC之间，利用他们自身的弱点来打败他们。",[129,163,164],{},"这里不得不佩服作者的塑造能力，首先要有12个人物，每个人要有不同的性格、不同的行为，并且弱点也要从这不同的性格和行为中诞生，再由男主逐个击破。",[129,166,167],{},"话说那个“凶手”的演员实在很脸熟，看了两集才想起来是《少年江湖物语》的顾亦峰，这不是巧了嘛。",[129,169,170],{},"不过剧情到救出女主就结束了，第二季怕是遥遥无期，不知道男主什么时候才能挖出背后的阴谋。",[125,172,173],{"id":173},"感情戏",[129,175,176],{},"我们的男主宝宝人见人爱，花见花开。",[129,178,179],{},"女主初见男主就对英雄救美的他情根深种，好基友男二和神秘AI每每见到男主都要调戏他，而女二和男三则都与男主相爱相杀，连虚拟世界的虚拟人（也许算是女三？）都愿意为男主牺牲自我。但是我们的男主一心只爱女主，用了20集的时间终于救出了女主，所以说这部剧果然还是甜甜的校园恋爱剧嘛！",[125,181,182],{"id":182},"男主的表演",[129,184,185],{},"男主宝宝对角色的演绎十分有层次，在不同的身份条件下有不同的表现方式，非常精彩，毕竟他可是得到张静初盖章过的“眼神纯净，有信念感”的演技派男演员呢！",[129,187,188],{},"在面对女主的时候，他是保护欲爆棚的满分男友，满心满眼都只有她一个人。他努力创造机会和女主亲近，却又怕唐突了心上人。每当两人有机会相处时，他看向女主的眼神温柔又羞怯，当女主不着痕迹地避开他的接触时，他失落的小眼神简直令人心碎。",[129,190,191],{},"在面对其他角色时，如果是需要团结的对象，他会展现出友好的领导气质，带领大家走出困境；而如果面对的是竞争对手，即使对方是柔弱的女孩子，他也会用强硬的态度让对方知难而退；而如果面对的是明面上需要团结但实际上需要打击的对象时，他显露出的狡黠的气质也很让人惊喜。",[125,193,194],{"id":194},"女主的塑造",[129,196,197],{},"《端脑》非常具有传统热血少年漫画的特点，女主存在的意义就是和男主创造美好回忆，给男主提供心灵的救赎，然后自己又被男主所拯救。",[129,199,200],{},"一切的一切都是为男主服务，她本人则成为剧情进展的线索，隐藏在剧情之中，不努力回想都想不起来女主做了什么，完全沦为工具人。相比之下，连女二的戏份都比她有意思，性格特征也比女主鲜明许多，实在是让人惋惜。",{"title":202,"searchDepth":34,"depth":34,"links":203},"",[204,205,206,207,208],{"id":127,"depth":34,"text":127},{"id":137,"depth":34,"text":137},{"id":173,"depth":34,"text":173},{"id":182,"depth":34,"text":182},{"id":194,"depth":34,"text":194},[9],"安利一个朱元冰主演的科幻悬疑剧《端脑》","md",{"date":213,"language":214,"comments":96},"2020-02-13","中文","\u002Fblog\u002F2020-02-13-tv-drama-die-now",{"title":120,"description":210},"tv-drama-die-now","blog\u002F2020-02-13-tv-drama-die-now",[220],"国产剧","mEegICbV8-aHwgvgLBwx1S0njoQG5GCkKQPxlMhfQ_g",[223,228],{"title":224,"path":225,"stem":226,"children":-1,"slug":227},"关于疫病的记忆","\u002Fblog\u002F2020-02-01-memories-about-pandemics","blog\u002F2020-02-01-memories-about-pandemics","memories-about-pandemics",{"title":229,"path":230,"stem":231,"children":-1,"slug":232},"How to build up a static blog website with Nuxt","\u002Fblog\u002F2020-04-05-nuxt-blog-static-website-en","blog\u002F2020-04-05-nuxt-blog-static-website-en","nuxt-blog-static-website-en",1794547929726]