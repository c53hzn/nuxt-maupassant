[{"data":1,"prerenderedAt":258},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-panda-remit-review":118,"surround-panda-remit-review":247},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":231,"description":232,"extension":233,"meta":234,"navigation":96,"path":240,"seo":241,"slug":242,"stem":243,"tags":244,"__hash__":246},"blog\u002Fblog\u002F2021-01-07-panda-remit-review.md","熊猫速汇(Panda Remit)测评",{"type":122,"value":123,"toc":224},"minimark",[124,128,132,135,138,141,144,147,158,161,164,167,170,173,176,179,182,200,206,212,215,218,221],[125,126,127],"h2",{"id":127},"契机",[129,130,131],"p",{},"工作也有几年了，一直都有想法要把工资换成人民币，再存到大陆的银行卡里，但是这一步好像还挺困难的。",[129,133,134],{},"跨境汇款吗？手续费可不便宜，如果买了理财，收益能抵消吗？",[129,136,137],{},"在香港取现，到大陆存款？法律风险且不说，安全也是个问题。",[129,139,140],{},"还可以到大陆取现，直接在大陆存款。这样倒是没有法律风险，但还是不安全。",[129,142,143],{},"于是就一直犹豫，再加上疫情期间又去不了深圳，想试也没得试，就一直耽搁到了现在。",[125,145,146],{"id":146},"熊猫速汇",[129,148,149,150,153,154,157],{},"之前某天听同事介绍了一个APP，叫 ",[151,152,146],"code",{}," ，英文是 ",[151,155,156],{},"Panda Remit"," ，貌似汇率比较合理，手续费才30HKD，听了之后有点动心了。",[129,159,160],{},"然后我专门上网查了一个小时，APP的开发者貌似是正规注册的公司，如果经过它来汇款，好像确实可以减少损失。",[129,162,163],{},"但是我还是没有下定决心，于是理财计划又搁置了。",[125,165,166],{"id":166},"实际尝试",[129,168,169],{},"最近在微博上看到别人分享理财经验，觉得可以参考。于是又回到了那个问题：如何把钱换成人民币？",[129,171,172],{},"昨天在支付宝上看到了跨境汇款的服务，于是点开看了一下，就是这么巧合，支付宝推荐的合作商里有熊猫速汇，我对它的信心突然上升了，于是迅速下载了 APP ，注册账号，实名认证，然后就可以汇款了。",[129,174,175],{},"这里要注意的是，不知道为什么上传香港身份证去认证，过一会就会收到认证失败的消息，改成用大陆身份证就秒过了。",[129,177,178],{},"认证完身份之后就是添加收款人，可以是银行账号，也可以是支付宝账号。支付宝里面介绍熊猫速汇的教学里说，添加支付宝账号作为收款人时要用姓名的拼音，但其实 APP 要求填写中文姓名，不能输入英文字母。",[129,180,181],{},"接下来就是在APP里选择收款人，生成包含汇款金额和手续费在内的汇款订单，然后APP会提供银行转账信息，同时也提供转数快转账的信息，汇款人选择一种方式往这个账号里打钱就行了。",[129,183,184,187,188,191,192,195,196,199],{},[151,185,186],{},"转数快"," 是香港金融系统于 2018 年推出的本港银行之间小额转账的系统，也叫 ",[151,189,190],{},"快速支付系统"," 或 ",[151,193,194],{},"FPS"," ( ",[151,197,198],{},"Fast Payment System"," )，可以进行免手续费的跨行转账，但是金额上限是 1 万港币。",[129,201,202,203,205],{},"到这里问题又来了，我的汇款金额填了 1 万港币，加上手续费 30HKD 刚好超过 1 万，不能用 ",[151,204,194],{}," 了，可是用网上银行转账肯定会被收手续费，可要是不转的话，首单汇款选择的汇率优惠就浪费了。但是没办法，只能浪费了。",[129,207,208,209,211],{},"于是回到熊猫速汇，生成第二个订单，这次还有一个手续费 30HKD 的优惠，但我也不敢再让金额超过 1 万，于是只填了九千九百，这次成功用 ",[151,210,194],{}," 转了钱，而支付宝这边半小时就收到钱了，确实很快。",[125,213,214],{"id":214},"感想",[129,216,217],{},"如果不是看到支付宝推荐的话，我可能到现在也下不了决心用这个 APP ，从这个意义上来说，支付宝真的已经形成了一个独特的信用体系，我真的没法想象没有支付宝的生活。",[129,219,220],{},"最近蚂蚁金服和马云的负面新闻让人有点小担心，但我又觉得是好事，因为现在国家很显然是在打击垄断，而这个做法从根本上说是对我们普通人有利的。",[129,222,223],{},"活在历史夹缝中的我，只希望大家都好好地挺过疫情，别出幺蛾子了。",{"title":225,"searchDepth":34,"depth":34,"links":226},"",[227,228,229,230],{"id":127,"depth":34,"text":127},{"id":146,"depth":34,"text":146},{"id":166,"depth":34,"text":166},{"id":214,"depth":34,"text":214},[23],"试用了一下用熊猫速汇从我的香港银行卡汇款到大陆银行卡，感觉还行。","md",{"date":235,"language":236,"keywords":237,"comments":96},"2021-01-07","中文",[194,186,238,239],"跨行转账","香港","\u002Fblog\u002F2021-01-07-panda-remit-review",{"title":120,"description":232},"panda-remit-review","blog\u002F2021-01-07-panda-remit-review",[156,245,6],"汇款","Wx74-4YjjTzA0fhgr7ew-_4VQd0ckEGeX9pJr_7WZ4o",[248,253],{"title":249,"path":250,"stem":251,"children":-1,"slug":252},"如何找到明星同款背包","\u002Fblog\u002F2020-10-08-bag-research","blog\u002F2020-10-08-bag-research","bag-research",{"title":254,"path":255,"stem":256,"children":-1,"slug":257},"如何用手机查看局域网内Express主机上的文件","\u002Fblog\u002F2021-01-09-view-pc-files-from-mobile-via-express-server","blog\u002F2021-01-09-view-pc-files-from-mobile-via-express-server","view-pc-files-from-mobile-via-express-server",1794547929591]