[{"data":1,"prerenderedAt":283},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-the-birth-of-the-drama-king":118,"surround-the-birth-of-the-drama-king":272},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":257,"description":258,"extension":259,"meta":260,"navigation":96,"path":265,"seo":266,"slug":267,"stem":268,"tags":269,"__hash__":271},"blog\u002Fblog\u002F2019-08-17-the-birth-of-the-drama-king.md","沙雕小说沙雕剧，拆我CP虐我心——《少年江湖物语》观后感",{"type":122,"value":123,"toc":246},"minimark",[124,128,132,135,138,141,144,147,150,153,156,159,163,166,169,172,175,178,181,185,188,191,194,197,200,203,206,209,212,215,218,221,224,228,231,234,237,240,243],[125,126,127],"h2",{"id":127},"在暑期档夹缝中求生的低成本网剧",[129,130,131],"p",{},"话说早年我沉迷九州系列，看过江南、今何在等人的书及其改编的影视作品，也算是冒学的初级学者了（手动滑稽）。",[129,133,134],{},"然而我在微博上关注的九州系列作者只有唐缺一个人，因为他的微博很有意思，而且从他的博文里也能找到很多其他有意思的人。",[129,136,137],{},"某天看到唐缺推荐了一部沙雕网剧，叫“少年江湖物语”，说是里面一对腻歪的男女CP是以他和他老婆为蓝本而写的，这可勾起了我的好奇心，想看看这剧里的唐缺是什么样。",[129,139,140],{},"在6月7月这种暑期档的关键时刻，微博上铺天盖地都是《陈情令》、《九州缥缈录》、《宸汐缘》、《长安十二时辰》等大制作的电视剧，在全都不熟的情况下，我想优先选择这个可能会很有趣的来看。",[129,142,143],{},"看剧之前先补小说，于是我找来了原著《如何错误地套路一个魔教教主》，一看之下果然非常沙雕，差不多每隔几百字就有一个笑点，如果真的能原封不动地拍出来，想必一定是部好的喜剧。",[125,145,146],{"id":146},"为了过审竟然可以这样改编",[129,148,149],{},"原著是耽美小说，当然不可能原封不动地拍出来。",[129,151,152],{},"在剧里，教主和大侠从谈恋爱变成认兄弟，而腻歪CP竟然从堂主和男花魁变成了堂主和女花魁！",[129,154,155],{},"好吧，原来唐缺和牙晓的腻歪CP只不过是导演用来过审的道具。",[129,157,158],{},"吃过《镇魂》的亏之后，我觉得我对改编的容忍程度提高了很多。",[125,160,162],{"id":161},"精彩演绎确实真香","精彩演绎确实“真香”",[129,164,165],{},"那么改编之后是不是真的面目全非呢？倒也不是。",[129,167,168],{},"原著的沙雕搞笑台词被充分地保留了下来，编剧也在新的设定之下让主角各种特质都尽量靠近原著，最后出来的结果竟然莫名地和谐，感觉还不错。",[129,170,171],{},"几位主角和配角都尽心尽力去诠释角色，台词、表情和身段都有下功夫，在一片以配音为主的电视剧当中，像这样敢于用现场原音的可真是不多了。",[129,173,174],{},"而且剧组在人物的造型和道具、背景上颇下功夫，很多画面截个图就能做桌面。",[129,176,177],{},"虽然是“低成本”，但看得出来花费的心思可不低，确实是值得一看的好剧。",[125,179,180],{"id":180},"关于几位主要角色",[182,183,184],"h3",{"id":184},"教主季川",[129,186,187],{},"按照谷阿莫的套路，他应该算是“女猪脚男”，本来原著中与大侠相爱相杀的戏份变成了“找弟弟”，不仅要容忍弟弟呆萌的试探，还要保护他周全，最后还要孤身一人默默看着弟弟谈恋爱去了。",[129,189,190],{},"原著的主CP拆成这样，实在是让人有点懵。",[129,192,193],{},"导演给季川和赵青峰安排的兄弟失散的原因是，老教主殷不或爱慕兄弟俩的母亲如烟，设计杀害了他们的父亲，不料母亲也跟着自尽，而殷不或刚好碰到季川，于是将其带回魔教培养，以便等兄弟俩长大了让他们来个兄弟相残。",[129,195,196],{},"可是兄弟俩并没有失忆的情节，怎么会连对方的名字都不记得，重遇时完全像是初见？导演在采访时说的话也实在不能让人信服。我猜测是导演写剧本的时候忘记了。",[129,198,199],{},"而原著中季川和养父的亲生子殷剑并无太多交集，但是剧中却用大段大段的闪回来告诉大家，他们两个在小时候关系有多好，然后再用长大后的季川对殷剑（闫大夫）的悉心关照和殷剑对季川的口硬心软来推动剧情发展。",[129,201,202],{},"好像哪里不太对，导演是不是有点私心呀？不过如果当是原著的同人剧来看的话，也不是不能接受。",[129,204,205],{},"演季川的周彦辰在表现自己作为魔教的教主、魏旗和阿扶的上司、赵青峰的兄长、老教主的义子、殷剑的义弟这些身份的时候都有不同的演绎，非常有吸引力。",[129,207,208],{},"这个娃我喜欢。",[182,210,211],{"id":211},"大侠赵青峰",[129,213,214],{},"大侠的搞笑台词基本上来自于那本《黄冈套路王》，用最呆萌的表情讲出最土味的情话，让人实在忍俊不禁。",[129,216,217],{},"而这个角色主要的戏剧冲突点在于他身为浩然盟的卧底，却对魔教教主生出了亲近感，而与季川相认之后又被告知季川杀了盟主，所以在情感上应该是变化非常强烈的。",[129,219,220],{},"但是不知道是不是因为角色设定是“呆萌”，所以演员骆明劼在处理这些感情的时候也表演出了一种“呆萌”的感觉。",[129,222,223],{},"这个娃还行8。",[182,225,227],{"id":226},"殷剑闫大夫","殷剑（闫大夫）",[129,229,230],{},"闫大夫这个角色本来在原著里没有这么多戏份，可是在剧中却多了很多与其他角色的关系，整个形象更立体了。",[129,232,233],{},"他身为前任教主的独子，却武艺不精；有心向善，却受父亲的逼迫而违心地做了坏事；心系季川，却总是恶言相向；不善谋划，却总要在跟班和温彬面前逞威风。",[129,235,236],{},"然而最终他还是跟随了自己的心意，提前给季川准备毒箭的解药，甚至还药倒父亲一帮人，只为让季川逃出生天，最后自己被抓走时还希望季川能来接他出来。",[129,238,239],{},"其实我觉得，如果他也是如烟的孩子，那作为这个故事来说就圆满（完整）了，就变成了我最喜欢的狗血苦情大戏，但是作为沙雕剧来说这样又太沉重了。大概是因为这样，导演才否认他是如烟的孩子吧？",[129,241,242],{},"（导演：我不要你觉得，我要我觉得）",[129,244,245],{},"总之，宋继扬小可爱演出了闫大夫的骄傲、纠结、懊悔和关怀，让人看了就想给他摸摸头。以后也要继续出演好看的电视剧哦~",{"title":247,"searchDepth":34,"depth":34,"links":248},"",[249,250,251,252],{"id":127,"depth":34,"text":127},{"id":146,"depth":34,"text":146},{"id":161,"depth":34,"text":162},{"id":180,"depth":34,"text":180,"children":253},[254,255,256],{"id":184,"depth":19,"text":184},{"id":211,"depth":19,"text":211},{"id":226,"depth":19,"text":227},[9],"最近配套看完了另一部剧《少年江湖物语》和它的原著《如何错误地套路一个魔教教主》，导演为了过审竟然拆CP？Exo me？","md",{"date":261,"language":262,"keywords":263,"comments":96},"2019-08-17","中文",[264],"耽美剧","\u002Fblog\u002F2019-08-17-the-birth-of-the-drama-king",{"title":120,"description":258},"the-birth-of-the-drama-king","blog\u002F2019-08-17-the-birth-of-the-drama-king",[270],"国产剧","yj-jIQRKYC7Axoa4doogFDjQeid0PWLq2wvxGReaybo",[273,278],{"title":274,"path":275,"stem":276,"children":-1,"slug":277},"记忆中的食堂菜","\u002Fblog\u002F2019-08-13-campus-canteen-memories","blog\u002F2019-08-13-campus-canteen-memories","campus-canteen-memories",{"title":279,"path":280,"stem":281,"children":-1,"slug":282},"在Excel中用vlookup公式灵活查找数字或文本类型关键字","\u002Fblog\u002F2019-12-28-why-vlookup-cannot-return-value","blog\u002F2019-12-28-why-vlookup-cannot-return-value","why-vlookup-cannot-return-value",1794550657536]