[{"data":1,"prerenderedAt":385},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-jojo-startdust-crusaders":118,"surround-jojo-startdust-crusaders":374},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":357,"description":358,"extension":359,"meta":360,"navigation":96,"path":367,"seo":368,"slug":369,"stem":370,"tags":371,"__hash__":373},"blog\u002Fblog\u002F2021-12-23-jojo-startdust-crusaders.md","JoJo的奇妙冒险之星尘远征军:一边发刀一边整活",{"type":122,"value":123,"toc":334},"minimark",[124,128,135,140,145,148,152,155,159,162,165,168,172,175,178,182,185,188,192,195,198,201,204,207,211,214,218,221,224,228,231,234,237,240,243,247,250,253,257,260,263,266,270,273,276,279,282,286,289,292,296,299,302,305,309,312,316,319,322,325,328,331],[125,126,127],"p",{},"JoJo第三部的分集剧情梗概，剧透慎入。本文仅记录我个人感兴趣的集数，没有包含所有内容。",[125,129,130],{},[131,132],"img",{"alt":133,"src":134},"五人一狗去，只有三人回","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F147227790-b528db59-ebd9-45a4-a790-cfb3c3cc27d4.png",[136,137,139],"h2",{"id":138},"上部走向埃及的战斗之旅","上部：走向埃及的战斗之旅",[141,142,144],"h3",{"id":143},"第1集-被恶灵附身的男人","第1集 被恶灵附身的男人",[125,146,147],{},"承太郎的替身“白金之星”的第一次出场。承太郎拥有祖传的195cm的身高，他的替身白金之星的外观实在像极了乔纳森，不知道荒木老师画的时候是不是特意这样设计的。",[141,149,151],{"id":150},"第8集-恶魔devil","第8集 恶魔(Devil)",[125,153,154],{},"这集其实没什么，只是他们在新加坡用酒店的房间电话通话，还因为无法实时通讯而被能变身的反派钻了空子，这简直太落后了，让人瞬间穿越回了1987年。",[141,156,158],{"id":157},"_10-11集-皇帝与倒吊男emperor-and-the-hanged-man","10-11集 皇帝与倒吊男(Emperor and the Hanged Man)",[125,160,161],{},"乔斯达旅行团在印度，波鲁那雷夫与厕所的第一次邂逅。",[125,163,164],{},"阿布德尔为了保护波波而被刀刺、被枪打，花京院摇晃着阿布的身躯那一段真是太让人难过了。",[125,166,167],{},"荒木老师还是那个荒木老师，主角团也是说刀就刀。",[141,169,171],{"id":170},"_14-15集-正义justice","14-15集 正义(Justice)",[125,173,174],{},"恩雅婆婆为了给儿子报仇，把乔斯达一行人引进了自己的旅店，很辛苦地装作不认识他们，但是却破绽百出，最终竟然因为没发现承太郎把自己的名字写作“Q太郎”而露出马脚，实在让人大跌眼镜。",[125,176,177],{},"波鲁那雷夫再次与厕所结下不解之缘。",[141,179,181],{"id":180},"_19-20集-死神13death-13","19-20集 死神13(Death 13)",[125,183,184],{},"“典明粥”的出处。看完这集，相信大家喝粥的时候都会停下来先看一看里面到底有什么。",[125,186,187],{},"所以说JOJO真的是很“下饭”的作品啊。",[141,189,191],{"id":190},"_21-22集-审判judgement","21-22集 审判(Judgement)",[125,193,194],{},"这集的替身竟然是阿拉丁神灯的精灵？！",[125,196,197],{},"而波鲁那雷夫终于替我们所有人说出了那句话：“我要许4个愿望！”",[125,199,200],{},"不过精灵没有理会他胡闹的说法，而是实现了他许下的3个正常的愿望：金银财宝，复活妹妹，复活阿布德尔。",[125,202,203],{},"后面我们知道这个“复活”只是制造出了可以攻击许愿者的假人，但是我不禁要问了，那金银财宝是真的吗？因为波波是法国人，精灵还特意给了他拿破仑时期的金币，这如果是真的该多好呀~",[125,205,206],{},"这一集里穿插的回忆杀实在是太催人泪下了，波波没了妹妹，又以为自己害死了好友，平日里不正经的暴躁大汉突然变成了感情丰富的温柔大汉，着实让人爱怜不已。",[136,208,210],{"id":209},"下部埃及篇","下部：埃及篇",[125,212,213],{},"《埃及篇》的整活和发刀指数陡然上升，要不然就是笑到打嗝，要不然就是哭成泪人，可恶啊，被荒木老师拿捏了。",[141,215,217],{"id":216},"_1-2集-伊奇和恩多尔iggy-and-ndoul","1-2集 伊奇和恩多尔(Iggy and N'Doul)",[125,219,220],{},"小狗伊奇的第一次正式出场，开始了它和波鲁那雷夫不得不说的故事。",[125,222,223],{},"这集的盲人刺客恩多尔很值得注意，当他意识到承太郎在他背后，心知已无胜算，便放开了手中的盲杖，因为盲杖是“回去的时候才需要”。之后更是为了防止自己泄露迪奥的情报而自裁，这份决绝也很让人动容。",[141,225,227],{"id":226},"第3集-欧因哥和波因哥oingo-and-boingo","第3集 欧因哥和波因哥(Oingo and Boingo)",[125,229,230],{},"搞笑兄弟的第一次出场。",[125,232,233],{},"哥哥欧因哥拥有变身成其他人的能力，弟弟波因哥拥有一本预言漫画，看起来好像很强，可是两人屡战屡败，屡败屡战，而主角团队根本没有发现自己受到攻击，兄弟俩就负伤退场了。",[125,235,236],{},"这集的看点是，欧因哥变身成了承太郎，波鲁那雷夫对他的身份起了疑心，花样百出地试探了好几次，其中包括要他表演把五根点燃的香烟吞进嘴里的绝活，欧因哥满头大汗地照做了，通过了考验。",[125,238,239],{},"这个意思是，承太郎真的做过这种事？！",[125,241,242],{},"这集的片尾，兄弟俩成为了第一个拥有自己的片尾曲的反派，跟正经的片尾曲《Last Train Home》的忧伤情绪形成了鲜明的对比。",[141,244,246],{"id":245},"_6-7集-巴斯迪女神bastet","6-7集 巴斯迪女神(Bastet)",[125,248,249],{},"这集的反派可以把人磁化，二乔和阿布德尔各种表现实在让人捧腹。",[125,251,252],{},"不过也有一些属于恶趣味。",[141,254,256],{"id":255},"_8-9集-赛特神sethan","8-9集 赛特神(Sethan)",[125,258,259],{},"这集的反派只要踩了别人的影子，就能把人变小。为什么要把人变小呢？因为这个人只会欺负弱小，除了小孩子谁都打不过。",[125,261,262],{},"但是他最后还是栽在了承太郎的手里，因为就算承太郎变成7岁小孩，也一样能一拳把人打趴下。虽然只是小孩子，但是谁都打不过~",[125,264,265],{},"这两集的波鲁那雷夫很可爱，不过有些剧情实在是恶趣味了。",[141,267,269],{"id":268},"_10-11集-赌徒达比darby-the-gambler","10-11集 赌徒达比(D'arby the Gambler)",[125,271,272],{},"达比兄弟拥有摄取别人灵魂的能力，这集出场的是达比哥哥，他可以通过赌局来赢得别人的灵魂，这集貌似也是第一次出现“灵魂”的概念。",[125,274,275],{},"本集的高潮出现在承太郎在赌桌上加注的时候，连自己远在日本的母亲的灵魂也加进去了，弹幕里直呼“孝子”，这实在是太“好孝”了。",[125,277,278],{},"话说，达比哥哥的声优叫银河万丈，这名字也太好听了吧！但是查了一下原来这只是艺名，声优的原名叫田中崇，瞬间就没那么吸引人了。",[125,280,281],{},"看了银河万丈的照片，我以为达比哥哥是照着他画的，不过考虑到时间问题，应该不是，但是声优本人的气质和动画里面简直一模一样，真的很神奇。",[141,283,285],{"id":284},"_12-13集-荷尔荷斯hol-horse和波因哥boingo","12-13集 荷尔·荷斯(Hol Horse)和波因哥(Boingo)",[125,287,288],{},"搞笑哥哥进了医院，搞笑弟弟就和荷尔·荷斯联手来阻击承太郎他们。",[125,290,291],{},"这两集就没有一秒是不搞笑的，片尾也第二次用上了他们专用的搞笑反派主题曲。",[141,293,295],{"id":294},"_16-17集-玩家达比darby-the-player","16-17集 玩家达比(D'arby the Player)",[125,297,298],{},"承太郎和达比弟弟用棒球的主机游戏来对战，最后承太郎赢了。",[125,300,301],{},"这集我看不明白的点在于，为什么他们击球之后不跑呢？既然都没有跑，那哪来的安打和全垒打呢？",[125,303,304],{},"实在不明白为什么要省略这里。",[141,306,308],{"id":307},"_18-20集-瓦尼拉艾斯vanilla-ice","18-20集 瓦尼拉·艾斯Vanilla Ice",[125,310,311],{},"“爱狗人士”荒木先杀阿布德尔，然后又把狗给杀了，波尔纳雷夫则是酝酿了半天又让他活了。",[141,313,315],{"id":314},"第21-24集-决战dios-world","第21-24集 决战(DIO's WORLD)",[125,317,318],{},"这4集又杀了好几个，先杀花京院，再杀二乔，最后杀迪奥。",[125,320,321],{},"然后二乔又复活了？！荒木老师，这不科学啊，我明明看到他的灵魂都升天了！",[136,323,324],{"id":324},"总结",[125,326,327],{},"第三部看完了，后面第四部又看到了二乔，他连接起了第2-4部。",[125,329,330],{},"话说二乔好像也是乔斯达家最近100年内唯一活到老年的，看来荒木老师对二乔是真爱了。",[125,332,333],{},"全文完。",{"title":335,"searchDepth":34,"depth":34,"links":336},"",[337,345,356],{"id":138,"depth":34,"text":139,"children":338},[339,340,341,342,343,344],{"id":143,"depth":19,"text":144},{"id":150,"depth":19,"text":151},{"id":157,"depth":19,"text":158},{"id":170,"depth":19,"text":171},{"id":180,"depth":19,"text":181},{"id":190,"depth":19,"text":191},{"id":209,"depth":34,"text":210,"children":346},[347,348,349,350,351,352,353,354,355],{"id":216,"depth":19,"text":217},{"id":226,"depth":19,"text":227},{"id":245,"depth":19,"text":246},{"id":255,"depth":19,"text":256},{"id":268,"depth":19,"text":269},{"id":284,"depth":19,"text":285},{"id":294,"depth":19,"text":295},{"id":307,"depth":19,"text":308},{"id":314,"depth":19,"text":315},{"id":324,"depth":34,"text":324},[9],"整个星尘斗士基本上不是在发刀就是在整活，埃及篇尤其如此。","md",{"date":361,"language":362,"keywords":363,"comments":96},"2021-12-23","中文",[364,365,366],"星尘斗士","星辰十字军","分集剧情","\u002Fblog\u002F2021-12-23-jojo-startdust-crusaders",{"title":120,"description":358},"jojo-startdust-crusaders","blog\u002F2021-12-23-jojo-startdust-crusaders",[372],"JoJo","is8S98idTczpr4dS1F6Jp6133C8v1YPUTGbyLD6HX4c",[375,380],{"title":376,"path":377,"stem":378,"children":-1,"slug":379},"JoJo主题曲：从家族命运到个人抗争","\u002Fblog\u002F2021-12-22-jojo-music","blog\u002F2021-12-22-jojo-music","jojo-music",{"title":381,"path":382,"stem":383,"children":-1,"slug":384},"如何在Nuxt组件里使用async data","\u002Fblog\u002F2022-01-02-async-data-in-component","blog\u002F2022-01-02-async-data-in-component","async-data-in-component",1794547929216]