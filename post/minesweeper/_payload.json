[{"data":1,"prerenderedAt":267},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-minesweeper":118,"surround-minesweeper":256},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":241,"description":242,"extension":243,"meta":244,"navigation":96,"path":247,"seo":248,"slug":249,"stem":250,"tags":251,"__hash__":255},"blog\u002Fblog\u002F2018-11-18-minesweeper.md","我最喜欢的PC游戏——扫雷",{"type":122,"value":123,"toc":234},"minimark",[124,128,132,135,138,141,144,147,150,153,156,159,162,165,168,171,174,178,181,184,187,190,193,196,206,209,216,219,222,225,228,231],[125,126,127],"h2",{"id":127},"我和扫雷",[129,130,131],"p",{},"我其实不是一个爱玩游戏的人，不管是PC、iPad、手机还是PS4上的游戏，我都是浅尝辄止，过了一段时间之后甚至记不起自己装过什么游戏。",[129,133,134],{},"小学大概三、四年级时家里开始有台式机了，然而我一个半文盲并不怎么会操作电脑，只是观察我爸爸玩电脑自带的游戏，后来我就学会玩了，并且一直持续到大学。",[129,136,137],{},"大二的时候爸爸给我买了个苹果壳子的无牌笔记本电脑，由于里面装的是盗版精简Windows系统，小游戏和日语输入法这种一般人用不到的东西就没有装，于是我用优盘从学校的机房把它们拷出来，装进了自己的电脑。",[129,139,140],{},"当然了，这也证明了小游戏和日语都是一般人不需要的东西。",[125,142,143],{"id":143},"我写扫雷",[129,145,146],{},"好了，现在说说我做的这个扫雷。",[129,148,149],{},"首先写一个雷区的算法，获得一个地雷的矩阵，然后把它渲染到画面上。",[129,151,152],{},"这个雷区的算法是我在codefights上刷题的时候想到的，也是因为做了这道题，我才兴起了做这个游戏的念头。",[129,154,155],{},"一开始想挑战下用原生JavaScript，可仅仅是写document.getElementsByTagName就已经累个半死了，点击事件也都写得很长，还只完成了基本的翻开单个方块、标记地雷、确认输赢、开始新一局等功能，远没有达到我想要的复刻经典版功能的目标。",[129,157,158],{},"后来第二版用了jQuery，在DOM操作上确实简单了一些，但是仍然免不了在看不见摸不着的数据和眼见着要操作的DOM之间纠缠，而且由于各种限制，游戏在功能上并没有增多。",[129,160,161],{},"再来是第三版，尝试用微信小程序的wxml、wxss、JS来写。",[129,163,164],{},"学习微信小程序的文档和各类经验贴的时候确实有不少收获，由于它和Vue的相似性，顺带还学了点Vue，而游戏的功能上则新增了计时、计数、保存成绩等功能。",[129,166,167],{},"然而由于微信小程序限制了开发游戏的时候不可以使用wxml、wxss、JS，它就这么死掉了。",[129,169,170],{},"它死掉之后，我因为过于伤心，直到11月之前都没有再碰过。",[129,172,173],{},"上个星期五晚上，我突发奇想，要用Vue来重写一遍，于是我重新设计了CSS，再结合Vue的文档，终于用了一个周末的时间写出了这个最新的VueJS版本的扫雷游戏。",[125,175,177],{"id":176},"vue版扫雷","Vue版扫雷",[129,179,180],{},"这个Vue版本的最大特点是实现了根据窗口大小调整雷区和地雷数，而且可以做到点开周围没有雷的方块时可以一连翻开一大片。",[129,182,183],{},"之前的三个版本中，我一直想做成片翻开方块的功能，但是写着写着就报错call stack limit exceeded，自查又查不出bug在哪，简直令人头秃。",[129,185,186],{},"这次我着重在这个功能上花了心思，每写一步都去console输出一下，一旦报错就立刻调整。",[129,188,189],{},"最终结果是，大概报错3、4次之后就完成了这个功能，开心~",[129,191,192],{},"除了成片翻开的功能之外，我还在设置按钮和它的弹出窗口上下了功夫。",[129,194,195],{},"设置按钮的图标是我以前用CSS画的八齿空心齿轮，而它的弹出窗口本身是一个轮播图的形式，以后也可以直接复用。",[129,197,198,199],{},"轮播图在 ",[200,201,205],"a",{"href":202,"rel":203},"https:\u002F\u002Fwww.houzhenni.com\u002Fmyapp\u002Fcarousel-vue.html",[204],"nofollow","这里",[129,207,208],{},"我想做的功能都实现了，这个版本基本上算是圆满了。",[129,210,211,212],{},"扫雷游戏完整版在 ",[200,213,205],{"href":214,"rel":215},"https:\u002F\u002Fwww.houzhenni.com\u002Fmyapp\u002Fminesweeper-vue.html",[204],[125,217,218],{"id":218},"其他人的扫雷",[129,220,221],{},"在查找各种用法资料的时候，我顺便还看了一些关于扫雷的帖子，才发现原来世界上还有比我更沉迷于扫雷的人。",[129,223,224],{},"他们专门建立了扫雷的论坛，按照各人的扫雷成绩进行排名，甚至还拿到世界上参与排名。",[129,226,227],{},"跟他们比起来，我的扫雷成绩可能只能算新手入门，但我对扫雷这个游戏的热爱跟他们是一样的。",[129,229,230],{},"有那么点爱好，真的挺好。",[129,232,233],{},"完~",{"title":235,"searchDepth":34,"depth":34,"links":236},"",[237,238,239,240],{"id":127,"depth":34,"text":127},{"id":143,"depth":34,"text":143},{"id":176,"depth":34,"text":177},{"id":218,"depth":34,"text":218},[12],"我之前用原生JavaScript、jQuery、微信小程序写过3个版本的扫雷游戏，当我体验过类似Vue的微信小程序之后，学习Vue好像是自然而然的事，于是我终于用Vue写出了最让我满意的一个版本的扫雷~","md",{"date":245,"language":246,"comments":96},"2018-11-18","中文","\u002Fblog\u002F2018-11-18-minesweeper",{"title":120,"description":242},"minesweeper","blog\u002F2018-11-18-minesweeper",[252,253,254],"我的项目","JavaScript","Vue.js","V4aPM-9VmLp2BQ_VkDIPhRE4CwSVUn5W04rJI9I0Jrk",[257,262],{"title":258,"path":259,"stem":260,"children":-1,"slug":261},"添加元素平移效果的产品页面","\u002Fblog\u002F2018-11-08-product-landing-page-with-scroll-effects","blog\u002F2018-11-08-product-landing-page-with-scroll-effects","product-landing-page-with-scroll-effects",{"title":263,"path":264,"stem":265,"children":-1,"slug":266},"阿尔罕布拉宫的回忆","\u002Fblog\u002F2018-12-10-memories-of-the-alhambra","blog\u002F2018-12-10-memories-of-the-alhambra","memories-of-the-alhambra",1794501664263]