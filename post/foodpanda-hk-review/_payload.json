[{"data":1,"prerenderedAt":316},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-foodpanda-hk-review":118,"surround-foodpanda-hk-review":305},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":289,"description":290,"extension":291,"meta":292,"navigation":96,"path":297,"seo":298,"slug":299,"stem":300,"tags":301,"__hash__":304},"blog\u002Fblog\u002F2022-04-21-foodpanda-hk-review.md","FoodPanda测评——能用，但不好用",{"type":122,"value":123,"toc":278},"minimark",[124,128,132,135,138,141,145,149,152,155,162,165,168,171,174,177,180,183,186,190,193,196,199,202,205,208,211,214,217,220,223,226,229,232,235,238,241,244,247,250,254,257,260,263,266,269,272,275],[125,126,127],"h2",{"id":127},"居家办公和黑暗料理",[129,130,131],"p",{},"自从2月初疫情爆发以来，我们又开始了居家办公，为了减少外出，我又准备自己做饭吃了。",[129,133,134],{},"但是我做的黑暗料理对健康十分不友好，后来在医生的建议下，我决定开始叫外卖。",[129,136,137],{},"当然了，医生并没有让我叫外卖，只是嘱咐我吃一些正经的饭和菜，可是这玩意我不会做啊。",[129,139,140],{},"于是下载了FoodPanda，甚至还买了它的月费会员。",[125,142,144],{"id":143},"foodpanda手机app测评","FoodPanda手机APP测评",[146,147,148],"h3",{"id":148},"如何使用",[129,150,151],{},"下载之后注册账号，登入之后首页就可以进入“美食外送”专区，然后系统会自动根据你的位置推荐餐厅。",[129,153,154],{},"选择餐厅的时候，如果觉得运费太贵，有可能是系统识别的位置不对，你到自己的地址那里重新选一下，再去看餐厅，可能运费就变便宜了，大部分餐厅都是十几二十块，远的可能要二十多。",[129,156,157,161],{},[158,159,160],"strong",{},"小贴士","：购买FoodPanda的会员之后，120港币以上的订单就可以免运费了。",[129,163,164],{},"点进去餐厅，就可以选餐，然后进入购物车，结算过程中会需要再次确认地址，接着付款，订单就下成功了。",[129,166,167],{},"此时订单状态是“商家正在准备你的食物”，等骑手拿到餐，手机会弹窗提示“骑手已提取订单”，等骑手接近你的小区的时候，手机会弹窗提示“可以收拾餐桌等骑手上门”，然后没一会骑手就到门口了，感觉还是很顺利的。",[129,169,170],{},"下次点餐时，如果想点和之前一样的，可以打开APP，点左上角菜单按钮，找到历史订单，然后直接重新订购。",[146,172,173],{"id":173},"优点",[129,175,176],{},"如果非要说的话，就是“有总比没有好”，或者“又不是不能用”。",[129,178,179],{},"如果要跟美团、饿了么相比，那我真是不知道怎么比。",[129,181,182],{},"有一个算是优点吧：如果送餐迟了，系统会自动送一个优惠券，大概能买一份饭。",[146,184,185],{"id":185},"缺点",[187,188,189],"h4",{"id":189},"地址问题",[129,191,192],{},"我不知道骑手那边显示的地址是什么格式的，反正10次订单中大概会有1次需要骑手打电话问我具体地址。",[129,194,195],{},"一开始是印度小哥打电话问，我猜可能是他看不懂中文地址，挂了电话之后我就把地址和订单备注改成了英文。",[129,197,198],{},"我以为这样应该能兼容所有人了，但是下次又有本地人骑手打电话来问，所以这回是看不懂英文吗？",[187,200,201],{"id":201},"骑手位置显示",[129,203,204],{},"之前我有几次无意中点开过显示骑手实时位置的页面，但是后来当我有意识地想找的时候，却怎么也找不到了。于是当骑手还没送到，但是又不算是特别久的时候，我的心情就会特别焦虑。",[129,206,207],{},"2022-05-13更新: 好像是订餐超过1小时之后，点进去订单详情才能看到骑手位置，这么“贴心”的功能到底是谁设计的？",[187,209,210],{"id":210},"订单评价",[129,212,213],{},"还有关于订单评价，APP会在下单后几小时的时候弹窗提示，让你评价本次订单，如果你划走了，就没有机会评价订单了。",[129,215,216],{},"查看历史订单的时候，无法给出评价，也无法查看历史评价。",[129,218,219],{},"进入餐厅主页，只有一个总评分，无法查看其他食客的评论。",[187,221,222],{"id":222},"收藏功能",[129,224,225],{},"如果有心仪的餐厅，详情页无法点收藏，必须回到餐厅列表页，或者搜索结果页才能点收藏。",[187,227,228],{"id":228},"回购功能",[129,230,231],{},"关于“重新订购”这个功能，那个按钮叫“选择想要重新订购的项目”，点了之后可以直接将该订单内的食物重新加入购物车，但是无法直接进入这个订单的餐厅页面。",[129,233,234],{},"我刚刚才发现原来食物项目底下还有个“添加项目”的按钮，按了之后就能进入餐厅页面，但是正常人能想到这一层吗？",[129,236,237],{},"而且这样还是无法直接收藏这个餐厅，要退出之后，去餐厅列表页搜索这家餐厅，在搜索结果里才能收藏，太费工夫了。",[129,239,240],{},"2022-05-03更新:",[129,242,243],{},"今天发现这个按钮变成“go to vendor”了，可以直接进入餐厅页面，难道是APP的开发人员看到我的吐槽了吗？",[129,245,246],{},"2022-05-06更新:\n今天发现这个按钮变成中文的“进入商店”了。看来他们开发还是挺注重速度的，i18n放一边，先把新功能发布出去，然后再更新汉化。",[129,248,249],{},"2022-05-18更新:\n今天这个按钮又变回“选择想要重新订购的项目”了，这是roll back回4月的版本了吗？开发是不是有那个大病？",[125,251,253],{"id":252},"foodpanda餐馆测评","FoodPanda餐馆测评",[129,255,256],{},"某家餐馆主打东南亚菜，招牌自然是海南鸡饭，但是这家的厨师非常与众不同。",[129,258,259],{},"通常号称“无骨海南鸡”的，会把鸡肉切成条状，而如果不是无骨的，也会在有骨头的地方按关节来切，尽量保留完整的部位。",[129,261,262],{},"这家的厨师则不同，他\u002F她不会剔骨，也不会切关节，而是所有部分都细细地切作条状，你能想象切成几条的翅尖和翅根吗？",[129,264,265],{},"而且大厨刀工了得，下刀都是斜刀，切出来的骨头全都是锐角，吃起来特别考验唇齿和筷子的配合，稍有不注意，也许未必见血，但是短暂地刺痛一下还是免不了的。",[129,267,268],{},"我正在考虑要不要把这家拉黑，但是他家的味道还是不错的，如果下次能别给我切成条的翅尖就好了。",[125,270,271],{"id":271},"总结",[129,273,274],{},"以上就是一个无聊的测评，大家看看就好。",[129,276,277],{},"全文完。",{"title":279,"searchDepth":34,"depth":34,"links":280},"",[281,282,287,288],{"id":127,"depth":34,"text":127},{"id":143,"depth":34,"text":144,"children":283},[284,285,286],{"id":148,"depth":19,"text":148},{"id":173,"depth":19,"text":173},{"id":185,"depth":19,"text":185},{"id":252,"depth":34,"text":253},{"id":271,"depth":34,"text":271},[23],"FoodPanda把我从自己做的黑暗料理中解救出来，这一点值得肯定，但是它需要改进的地方也不少。","md",{"date":293,"language":294,"keywords":295,"comments":96},"2022-04-21","中文",[296],"hong kong food delivery","\u002Fblog\u002F2022-04-21-foodpanda-hk-review",{"title":120,"description":290},"foodpanda-hk-review","blog\u002F2022-04-21-foodpanda-hk-review",[302,303],"FoodPanda","外卖","gvN0y8UfCv13BI8YeJ5fsEbv099t__i54m0Cq48qa-Y",[306,311],{"title":307,"path":308,"stem":309,"children":-1,"slug":310},"在vlookup中用数字和文本参数混合查找数据项","\u002Fblog\u002F2022-04-03-vlookup-number-text-multi-parameter","blog\u002F2022-04-03-vlookup-number-text-multi-parameter","vlookup-number-text-multi-parameter",{"title":312,"path":313,"stem":314,"children":-1,"slug":315},"在一台电脑上用两个GitHub账号","\u002Fblog\u002F2022-05-14-use-2-github-acc-on-pc","blog\u002F2022-05-14-use-2-github-acc-on-pc","use-2-github-acc-on-pc",1794550656854]