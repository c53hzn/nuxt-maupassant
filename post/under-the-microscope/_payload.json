[{"data":1,"prerenderedAt":260},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-under-the-microscope":118,"surround-under-the-microscope":253},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":107,"body":120,"categories":238,"description":239,"extension":240,"meta":241,"navigation":96,"path":246,"seo":247,"slug":108,"stem":248,"tags":249,"__hash__":252},"blog\u002Fblog\u002F2023-04-13-under-the-microscope.md",{"type":121,"value":122,"toc":226},"minimark",[123,127,131,134,137,140,143,146,149,152,155,158,161,164,167,172,175,178,181,184,187,190,193,196,199,202,205,208,211,214,217,220,223],[124,125,126],"h2",{"id":126},"历史原型",[128,129,130],"p",{},"话说明朝末年，徽州府的歙县有人上告，说是本县有笔“丝绢税”来源有疑，不应当由本县独担，而应当由徽州府下辖的六县分担。",[128,132,133],{},"歙县的官司持续了几十年，历经两代提告人。解决的过程非常曲折，因为别的五县不愿意付这个钱，所以四处阻挠。",[128,135,136],{},"朝廷出了均平的解决方案后，五县还煽动自己的县民作乱，追杀提告的歙县军官。",[128,138,139],{},"最后朝廷又出了折中的方案，才算是平息了整件事。",[128,141,142],{},"以上是历史故事，电视剧里对其进行了改编。",[124,144,145],{"id":145},"电视剧改编",[128,147,148],{},"上来就改了地点。",[128,150,151],{},"剧里的故事发生在金安府，下辖八个县，府衙在仁华县，但是剧里每次提到“金安”或者“仁华”的时候口型都不对。",[128,153,154],{},"丰家卖火腿，巡抚视察去了八卦村，这都是在金华吧？",[128,156,157],{},"仔细看他们的口型，说的就是“金华”。",[128,159,160],{},"每次提到“奉行”，口型都是“浙江”，提到“省城”，口型都是“杭州”。",[128,162,163],{},"真是奇了怪了，先是从徽州府改到金华府，从皖南赣北改成浙江，改完之后还要再改成完全虚构的地方，真是令人费解。",[124,165,166],{"id":166},"引人深思的剧情",[168,169,171],"h3",{"id":170},"老实人吃亏枪打出头鸟","老实人吃亏，枪打出头鸟",[128,173,174],{},"这么重的赋税，一县独担自是吃力，而且各种情况证明仁华不光缴了自己的这份，连别的七个县的部分也出了，可是想把这部分归还其他的县，他们却都找理由不接受。",[128,176,177],{},"这几个知县，也不过就是损人利己罢了。",[128,179,180],{},"男主几人向上提告，打破了原来的格局，想正本清源却屡屡受挫，别的县还把责任推到仁华县头上，真是不做就不错，做了反而错。",[168,182,183],{"id":183},"关心你的不一定是好人",[128,185,186],{},"剧里有个和男主同县的官员，以前是男主父亲的同僚，看起来对男主关爱有加。",[128,188,189],{},"男主被打板子，他加以阻拦，男主独自吃饭，他还给加菜。",[128,191,192],{},"可是后来我们才知道，原来这就是杀害男主父母的凶手之一，那他之前的每一点关心，都显得恶毒又讽刺了。",[168,194,195],{"id":195},"声音大不一定有道理",[128,197,198],{},"待有人做主分担赋税时，需要按各县田地面积进行加权处理，于是要重新丈量土地，是为“清丈”。",[128,200,201],{},"地主土豪为了少交赋税，想方设法隐匿田产。他们勾结官吏，给自己少登记，给底层农民多登记，引发农民不满。又散布谣言，说是仁华县想给大家增加负担，以此挑唆农民闹事，趁机铲除主张分担赋税的人。",[128,203,204],{},"真是好一出转移矛盾，借刀杀人的戏码。",[168,206,207],{"id":207},"群众工作很重要",[128,209,210],{},"男主他们向农民解释，清丈一事，意在清查土地，不该少报，也不会多报，大家按田产多寡来纳税，这样能让田多的豪绅多交税，而田少的农民就可以少交。国家增加了收入，农民减轻了负担，实在是利国利民的好事。",[128,212,213],{},"早这么说不就好了嘛！",[124,215,216],{"id":216},"一些思考",[128,218,219],{},"这部剧主打的就是一个剧情流，揭露阴谋，解决矛盾，里面的男男女女都不谈恋爱，点到即止，非常专业。",[128,221,222],{},"而我看的时候，总是忍不住代入自己，感叹主角几人左右为难，真不容易啊！",[128,224,225],{},"全文完。",{"title":227,"searchDepth":34,"depth":34,"links":228},"",[229,230,231,237],{"id":126,"depth":34,"text":126},{"id":145,"depth":34,"text":145},{"id":166,"depth":34,"text":166,"children":232},[233,234,235,236],{"id":170,"depth":19,"text":171},{"id":183,"depth":19,"text":183},{"id":195,"depth":19,"text":195},{"id":207,"depth":19,"text":207},{"id":216,"depth":34,"text":216},[9],"《显微镜下的大明之丝绢案》看完了，感触颇深。这不光是一个案子，这是几代人的心血。","md",{"date":242,"language":243,"keywords":244,"comments":96},"2023-04-13","中文",[245],"张若昀","\u002Fblog\u002F2023-04-13-under-the-microscope",{"title":107,"description":239},"blog\u002F2023-04-13-under-the-microscope",[250,251],"历史小说","明朝电视剧","51NddUh0FLoqSBAEEPGhc5R9j7BvBvgZtTBOvef-9eI",[254,257],{"title":110,"path":255,"stem":256,"children":-1,"slug":111},"\u002Fblog\u002F2023-03-24-chatgpt-teaches-russian","blog\u002F2023-03-24-chatgpt-teaches-russian",{"title":104,"path":258,"stem":259,"children":-1,"slug":105},"\u002Fblog\u002F2023-06-15-hongkong-english-accent","blog\u002F2023-06-15-hongkong-english-accent",1794550655078]