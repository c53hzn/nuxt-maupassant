\u002F\");\n    var paths_en = [];\n    var paths_zh = [];\n    var tempPath = \"\";\n    for (let i = 0; i \u003C paths.length; i++) {\n      if (i == 0) {\n        tempPath = \"\u002F\";\n      } else if (i == 1) {\n        tempPath = \"\u002F\" + paths[i];\n      } else {\n        tempPath += \"\u002F\" + paths[i];\n      }\n      let obj_en = {\n        href: tempPath,\n        text: map_en[tempPath]?map_en[tempPath]:decodeURI(paths[i]),\n        isMapped: !!map_en[tempPath]\n      };\n      let obj_zh = {\n        href: tempPath,\n        text: map_zh[tempPath]?map_zh[tempPath]:decodeURI(paths[i]),\n        isMapped: !!map_zh[tempPath]\n      };\n      paths_en.push(obj_en);\n      paths_zh.push(obj_zh);\n    }\n    return{\n      paths_en,\n      paths_zh\n    }\n  },\n  computed: {\n    thisPage() {\n      return this.$store.state.lang.val==\"Chi\"?\"本页\":\"This page\";\n    },\n    paths() {\n      return this.$store.state.lang.val==\"Chi\"?this.paths_zh:this.paths_en;\n    }\n  }\n}\n","js",[136,380,381,393,404,412,429,440,453,465,477,489,501,513,524,530,541,553,565,577,589,601,613,623,629,654,666,678,693,733,749,762,782,797,806,820,826,839,845,866,878,884,896,901,918,928,933,945,956,961,970,976,982,987,993,999,1008,1036,1042,1050,1078,1083,1089],{"__ignoreMap":153},[157,382,383,387,390],{"class":159,"line":16},[157,384,386],{"class":385},"szBVR","export",[157,388,389],{"class":385}," default",[157,391,392],{"class":162}," {\n",[157,394,395,398,401],{"class":159,"line":34},[157,396,397],{"class":162},"  name:",[157,399,400],{"class":177},"'breadcrumbs'",[157,402,403],{"class":162},",\n",[157,405,406,409],{"class":159,"line":19},[157,407,408],{"class":170},"  data",[157,410,411],{"class":162},"(){\n",[157,413,414,417,420,422,426],{"class":159,"line":7},[157,415,416],{"class":385},"    var",[157,418,419],{"class":162}," that ",[157,421,174],{"class":385},[157,423,425],{"class":424},"sj4cs"," this",[157,427,428],{"class":162},";\n",[157,430,431,433,436,438],{"