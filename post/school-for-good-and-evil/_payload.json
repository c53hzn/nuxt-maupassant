[{"data":1,"prerenderedAt":272},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-school-for-good-and-evil":118,"surround-school-for-good-and-evil":261},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":244,"description":245,"extension":246,"meta":247,"navigation":96,"path":252,"seo":253,"slug":254,"stem":255,"tags":256,"__hash__":260},"blog\u002Fblog\u002F2023-01-16-school-for-good-and-evil.md","《善恶魔法学院》：美丑可以用来辨善恶吗？",{"type":122,"value":123,"toc":235},"minimark",[124,128,150,153,157,160,163,166,169,172,175,178,181,184,187,190,193,196,199,202,205,208,211,214,217,220,223,226,229,232],[125,126,127],"h2",{"id":127},"故事梗概",[129,130,131,135,138,141,144,147],"ul",{},[132,133,134],"li",{},"苏菲和阿加莎住在一个叫嘉沃顿的小村庄，有一天，一只大鸟抓走了两人，带她们来到了善恶魔法学院。",[132,136,137],{},"大鸟把苏菲扔进恶院，把阿加莎扔进了善院，苏菲想换去善院，而阿加莎想回家。",[132,139,140],{},"她们相信如果让苏菲得到王子的真爱之吻，就可以实现愿望，但是越努力就越失败。",[132,142,143],{},"阿加莎表现出的善迹越来越多，而苏菲则越来越显露出邪恶，王子看清后立刻抛弃了她，苏菲怪罪于阿加莎，两人决裂。",[132,145,146],{},"然而这一切都是学院校长搞的鬼。很久以前，邪恶的弟弟杀死了善良的哥哥，用哥哥的身份成为校长，谋划了多年之后，想利用苏菲达成毁灭一切的目的。",[132,148,149],{},"苏菲和阿加莎破除了校长的阴谋，救下了学院，恢复了友谊，一起回了家。",[125,151,152],{"id":152},"裙子和裤子",[154,155,156],"p",{},"善院的女老师穿着华丽的裙子，梳着优雅的发型，恶院的女老师穿着干练的衬衫和裤子，留着蓬松的短发。",[154,158,159],{},"其实两个女老师的造型已经是很典型了，穿裙子的是公主，穿裤子的是女巫。",[154,161,162],{},"有一种观点认为，留短发、穿裤子、不化妆的女人，是想成为男人。",[154,164,165],{},"而想获得跟男人一样的待遇，则是“不安分的”，是“僭越的”，是“极端女权”。",[154,167,168],{},"挺有意思的。",[125,170,171],{"id":171},"化妆还是不化妆",[154,173,174],{},"阿加莎进入善院，学到的第一件事是穿漂亮裙子，上的第一门课是如何化妆和微笑。",[154,176,177],{},"而苏菲进入恶院，遇到的第一件事是被迫穿得像黑衣女巫，上的第一门课是如何在变丑中获得自由和力量。",[154,179,180],{},"善院的课程中，如果你不能获得一个王子的舞会邀请，你就会不及格， 如果你三次不及格，就会被变成非人类的事物，比如茶壶和小鱼，永远得不到解脱。",[154,182,183],{},"于是每个人都努力化妆，努力微笑，努力变美，因为“美丽就是力量”。但是深层思考一下，这么努力变美，难道不是因为害怕被惩罚吗？",[154,185,186],{},"她们时刻强调老师说的“美丽就是力量”，却只敢小声提醒大家“不美”的后果，在不断的反复强化中把对“美”的追求内化为自己的需要。",[154,188,189],{},"恶院的变丑课程虽然看起来很胡闹，但是老师说的话非常值得深思。",[154,191,192],{},"他说：“丑陋就是自由，因为当你丑陋时，你就会被逼着开始用脑子了。”",[154,194,195],{},"这让我想到了现在网上辩论的一个热点“服美役”。女人到底有没有“不美”的自由，以及符合“美”的要求的女人，到底是为谁而美？",[125,197,198],{"id":198},"得到王子的青睐又如何",[154,200,201],{},"王子本来已经有了一位女伴，然后被阿加莎吸引，接着又被苏菲用计迷惑，和苏菲吹了之后又想继续追求阿加莎。",[154,203,204],{},"我不知道该说什么好。",[154,206,207],{},"王子的吻帮不了任何人，甚至他的剑也斩不了奸邪，反而是互帮互助的两位女主升华了吻和剑的意义。",[154,209,210],{},"她们本来就不需要王子。",[125,212,213],{"id":213},"善恶可以颠倒",[154,215,216],{},"善院看起来好像是连续赢了一百年，可是这都在校长的计划之中，他以善的名义对学生提出超高的要求，达不到的学生都被毁灭了。",[154,218,219],{},"他还奖励学生们的恶行，比如把年老的女士放进炉子焚烧，让美人鱼剪掉自己的舌头，让女人穿着烧红的铁鞋跳舞（这不就是高跟鞋？）。",[154,221,222],{},"当一切恶事都是在善的名义下发生，善的可信度就会受损。",[154,224,225],{},"再回想一下，一定要穿华美的裙子，一定要化精致的妆容，一定要露出甜美的微笑，这真的是善的要求吗？",[125,227,228],{"id":228},"不要让美束缚自己",[154,230,231],{},"除了“美”之外，还有很多可以追求的东西，不要被“美”蒙住了双眼，看不到别的。",[154,233,234],{},"大家还可以追求学历，追求事业，追求爱好，世界这么大，赶快去看看。",{"title":236,"searchDepth":34,"depth":34,"links":237},"",[238,239,240,241,242,243],{"id":127,"depth":34,"text":127},{"id":152,"depth":34,"text":152},{"id":171,"depth":34,"text":171},{"id":198,"depth":34,"text":198},{"id":213,"depth":34,"text":213},{"id":228,"depth":34,"text":228},[9],"把你送进童话世界的魔法学院，你会成为善良的主人公，还是邪恶的反派？","md",{"date":248,"language":249,"keywords":250,"comments":96},"2023-01-16","中文",[251],"化妆","\u002Fblog\u002F2023-01-16-school-for-good-and-evil",{"title":120,"description":245},"school-for-good-and-evil","blog\u002F2023-01-16-school-for-good-and-evil",[257,258,259],"电影","Netflix","服美役","cDtP-XKp4YhbQHsuLS7bfSjhtA9u4fbNR2GJCHdjc0g",[262,267],{"title":263,"path":264,"stem":265,"children":-1,"slug":266},"2022年过去了","\u002Fblog\u002F2023-01-06-life-in-2022","blog\u002F2023-01-06-life-in-2022","life-in-2022",{"title":268,"path":269,"stem":270,"children":-1,"slug":271},"The school for good and evil--Is it possible to tell good and evil by beauty and ugliness?","\u002Fblog\u002F2023-01-18-school-for-good-and-evil-en","blog\u002F2023-01-18-school-for-good-and-evil-en","school-for-good-and-evil-en",1794501663474]