[{"data":1,"prerenderedAt":367},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-why-vlookup-cannot-return-value":118,"surround-why-vlookup-cannot-return-value":356},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":342,"description":343,"extension":344,"meta":345,"navigation":96,"path":348,"seo":349,"slug":350,"stem":351,"tags":352,"__hash__":355},"blog\u002Fblog\u002F2019-12-28-why-vlookup-cannot-return-value.md","在Excel中用vlookup公式灵活查找数字或文本类型关键字",{"type":122,"value":123,"toc":336},"minimark",[124,129,137,148,154,195,201,213,225,231,235,238,247,256,259,262,265,268,276,279,287,291,294,303,312,319,326,333],[125,126,128],"h2",{"id":127},"想用关键字在多列数据的excel表里找对应数据公式怎么写","想用关键字在多列数据的Excel表里找对应数据，公式怎么写？",[130,131,132,133],"p",{},"假设你在A1到B6范围内有一个姓名和性别的对应列表，你想在D2单元格输入姓名，在E2单元格得到性别，那么E2的公式可以按下图这样写。在E2输入 ",[134,135,136],"code",{},"=VLOOKUP(D2,A1:B6,2,FALSE)",[130,138,139,144,147],{},[140,141],"img",{"alt":142,"src":143},"vlookup01","\u002Fimg\u002Fblog\u002F2019-12-28\u002Fvlookup01.png",[145,146],"br",{},"\n图1",[130,149,150,151,153],{},"解析：",[145,152],{},"\nVLOOKUP公式一共需要4个参数，前3个是必填的，第4个是选填的。",[155,156,157,164,173,186],"ol",{},[158,159,160,161,163],"li",{},"第一个参数是“查找值”",[145,162],{},"\n它也就是你想用来查找的关键字，在查找的时候要用这个关键字去匹配被查找的数据区域的第一列，从中找到匹配的那一项。假如你的关键字是姓名，那么你要确保被查找的数据区域内“姓名”是在左边第一列，而如果性别在左，姓名在右，那么用普通的VLOOKUP写法就找不到它了。这时可以搜一下“VLOOKUP反向查找”，太长不说。",[158,165,166,167,169,170,172],{},"第二个参数是被查找的数据区域",[145,168],{},"\n本次被查找的数据处在A1到B6单元格范围内，其实你输入“A1:B6”或者“A2:B6”效果都是一样的，因为第一行是标题行，可以不要。",[145,171],{},"\n如果不想精确到哪一行，可以用“A:B”，那么被查找的数据范围就会扩大到整个两列，而不只是这12个单元格。",[158,174,175,176,178,179,181,182,185],{},"第三个参数是用户想显示的数据在被查找的数据区的第几列",[145,177],{},"\n本次我们的数据区域只有两列，“性别”在第2列，如果我们想显示“性别”，那么就输入2，而如果我们想显示被查找的关键字自己，输入1就可以了。",[145,180],{},"\n此处要注意，这个 ",[134,183,184],{},"2"," 是返回值相对于整个数据区域的第几列，如果数据区域在C1到D6，仍然是2列，“性别”仍然在第2列，那么虽然D是整个Excel的第4列，我们还是要输入2。",[158,187,188,189,191,192,194],{},"第四个参数是布尔值，是问用户要不要模糊查找",[145,190],{},"\n“布尔值”就是TRUE和FALSE，如果这里不填，默认为TRUE，那么就会进行模糊查找匹配，可能你要找张涵予，而列表里没有张涵予，但是有张馨予，那就给你匹配到张馨予那里了，这样就不太对了。",[145,193],{},"\n总之建议你写上FALSE就行了。",[130,196,197,198,200],{},"* 如果有两个张涵予，一个是男的，一个是女的，那么返回哪个人的性别呢？",[145,199],{},"\n答：返回第一个出现的张涵予的性别，如果是女的在前面，那就返回女的。",[130,202,203,204,206,207,209,210,212],{},"* 如何让单元格直接显示 ",[134,205,136],{}," ？",[145,208],{},"\n答：可能会有人想知道怎样让单元格直接显示 ",[134,211,136],{}," 而不是计算结果，其实有两种办法。",[155,214,215,218],{},[158,216,217],{},"把单元格格式改成“文本”，然后双击单元格再回车即可。",[158,219,220,221,224],{},"在单元格内输入",[134,222,223],{},"=\"=VLOOKUP(D2,A1:B6,2,FALSE)\"","即可。",[130,226,227,228,230],{},"* 那么反过来，如果单元格内输入了公式却不显示计算结果只显示公式本身，那怎么办？",[145,229],{},"\n答：把单元格格式改成“数字”，然后双击单元格再回车即可。",[125,232,234],{"id":233},"vlookup公式明明是对的为什么返回了na","VLOOKUP公式明明是对的，为什么返回了“#N\u002FA”？",[130,236,237],{},"假如我们现在不用汉字而是用纯数字做查找值，那么会怎么样呢？看看下面的2个例子吧！",[130,239,240,244,246],{},[140,241],{"alt":242,"src":243},"vlookup02","\u002Fimg\u002Fblog\u002F2019-12-28\u002Fvlookup02.png",[145,245],{},"\n图2",[130,248,249,253,255],{},[140,250],{"alt":251,"src":252},"vlookup03","\u002Fimg\u002Fblog\u002F2019-12-28\u002Fvlookup03.png",[145,254],{},"\n图3",[130,257,258],{},"数据区域范围、查找值单元格位置、公式什么的全都跟之前是一样的，为什么都会返回一个错误呢？",[130,260,261],{},"这里要注意了，图2里面的数据区域的“学号”的单元格左上角有绿色小三角，且Excel默认给它们居左了，这说明从A2到A6的单元格格式为“文本”。我们再看用来查找的关键字D2，它左上角没有绿色小三角，且Excel默认给它居右了，这说明它的单元格格式为“数字”，两边的数据格式不一致。当我们用“数字”作为关键字去匹配“文本”格式的数据时，是找不到结果的，所以公式计算的结果就报错了。",[130,263,264],{},"再看图3，数据区域的“学号”的单元格左上角没有绿色小三角，且Excel默认给它居右了，这说明从A2到A6的单元格格式为“数字”。我们再看用来查找的关键字D2，它左上角有绿色小三角，且Excel默认给它们居左了，这说明它的单元格格式为“文本”，又是出现了数据格式不一致的情况，所以也是找不到的。",[130,266,267],{},"例1有两种解决办法：",[155,269,270,273],{},[158,271,272],{},"选中A2到A6，Excel会提示一个黄色的感叹号按钮，点击感叹号可以批量将文本格式的数字改成数字格式。",[158,274,275],{},"给D2的数字前面加个英文的单引号",[130,277,278],{},"例2也有两种解决办法：",[155,280,281,284],{},[158,282,283],{},"选中A2到A6，右击选中区域，点“单元格格式”，改成“文本”，但是还需要一个一个双击单元格再回车来确认输入，所以不推荐",[158,285,286],{},"把D2单元格里数字前面的英文单引号删掉",[125,288,290],{"id":289},"数据区域和查找值不能修改如何让vlookup正确返回数据","数据区域和查找值不能修改，如何让VLOOKUP正确返回数据？",[130,292,293],{},"想要解决上面的问题，但又不能直接改数据区域和查找值，那么我们可以对公式作如下的修改",[130,295,296,300,302],{},[140,297],{"alt":298,"src":299},"vlookup04","\u002Fimg\u002Fblog\u002F2019-12-28\u002Fvlookup04.png",[145,301],{},"\n图4",[130,304,305,309,311],{},[140,306],{"alt":307,"src":308},"vlookup05","\u002Fimg\u002Fblog\u002F2019-12-28\u002Fvlookup05.png",[145,310],{},"\n图5",[130,313,314,315,318],{},"在VLOOKUP公式当中，如果我们希望查找值D2从数字转为“文本”，可以在查找值的位置输入 ",[134,316,317],{},"D2&\"\"","，这样就能在不更改D2的情况下，强行把VLOOKUP公式内的查找值变成“文本”类型。",[130,320,321,322,325],{},"而如果我们希望查找值D2从文本转为“数字”，可以在查找值的位置输入 ",[134,323,324],{},"D2+0","，这样就能在不更改D2的情况下，强行把VLOOKUP公式内的查找值变成“数字”类型。",[130,327,328,329,332],{},"* 使用 ",[134,330,331],{},"+0"," 时必须确认原数据是纯数字，否则会报错",[130,334,335],{},"以上~",{"title":337,"searchDepth":34,"depth":34,"links":338},"",[339,340,341],{"id":127,"depth":34,"text":128},{"id":233,"depth":34,"text":234},{"id":289,"depth":34,"text":290},[12],"VLOOKUP公式里的查找值必须和被查找区域的首列关键字为相同类型，否则会返回“#N\u002FA”，如果查找值是引用过来的，类型不同，此时可以强行转换类型，即可使VLOOKUP公式生效","md",{"date":346,"language":347,"comments":96},"2019-12-28","中文","\u002Fblog\u002F2019-12-28-why-vlookup-cannot-return-value",{"title":120,"description":343},"why-vlookup-cannot-return-value","blog\u002F2019-12-28-why-vlookup-cannot-return-value",[353,354],"Excel","vlookup","M5mWuh4cNmPu8iYzG_ByILCjPVKhKC_WmVIQybsxRlk",[357,362],{"title":358,"path":359,"stem":360,"children":-1,"slug":361},"沙雕小说沙雕剧，拆我CP虐我心——《少年江湖物语》观后感","\u002Fblog\u002F2019-08-17-the-birth-of-the-drama-king","blog\u002F2019-08-17-the-birth-of-the-drama-king","the-birth-of-the-drama-king",{"title":363,"path":364,"stem":365,"children":-1,"slug":366},"2019年的小总结","\u002Fblog\u002F2020-01-31-summary-of-my-life-in-2019","blog\u002F2020-01-31-summary-of-my-life-in-2019","summary-of-my-life-in-2019",1794501664172]