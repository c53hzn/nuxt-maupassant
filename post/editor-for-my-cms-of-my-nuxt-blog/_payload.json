194],"blockquote",{},[130,192,193],{},"可是人类就是喜欢自找麻烦。",[130,195,196],{},"by 我",[130,198,199,200,202,203,205],{},"我想要一个有界面的 ",[143,201,160],{},"，能新建，能修改，能读取，能保存，能删除。但是我只要操作 ",[143,204,179],{}," 文件，而不要任何数据库。",[130,207,208],{},"我觉得我能做到。",[130,210,211,212,216],{},"写了个英文版 ",[134,213,215],{"href":214},"\u002Fpost\u002Feditor-for-my-cms-of-my-nuxt-blog-en","Write a control panel for my API-based CMS for Nuxt","，大家随便看看就好。",[125,218,219],{"id":219},"后端需要实现的效果",[130,221,222,223,225,226,161,229,232,233,235],{},"由于我原本的 ",[143,224,164],{}," 是用 ",[143,227,228],{},"Node",[143,230,231],{},"express"," 写的，所以还是想在此基础上继续精进，那么就需要掌握 ",[143,234,228],{}," 服务器的一些用法，比如：",[237,238,239,249,255,260],"ol",{},[240,241,242,243,245,246,248],"li",{},"让 ",[143,244,164],{}," 读取静态 HTML 页面，使浏览器能显示 ",[143,247,160],{}," 的 UI 界面。",[240,250,251,252,254],{},"开启 ",[143,253,164],{}," 的时候自动打开浏览器访问入口，也就是前一项的 UI 界面。",[240,256,242,257,259],{},[143,258,164],{}," 能接受浏览器（客户端）传回来的数据，并保存到本地。",[240,261,242,262,264],{},[143,263,164],{}," 接受浏览器传回来的数据，然后删除相关文件。",[125,266,267],{"id":267},"前端需要实现的效果",[130,269,270,271,276,277,282],{},"我之前还有一个在 ",[134,272,275],{"href":273,"rel":274},"https:\u002F\u002Fwww.codepen.io",[138],"CodePen"," 上的 ",[134,278,281],{"href":279,"rel":280},"https:\u002F\u002Fcodepen.io\u002Fc53hzn\u002Ffull\u002FYzzRzxR",[138],"Markdown Previewer"," 的项目，半年来浏览量一只手就能数得清，就这么放着也挺可惜，不如拿来这里用一用。",[130,284,285,286,289,290,292,293,296,297,170],{},"CodePen 项目的渲染效果是用 ",[143,287,288],{},"marked"," 来实现的的，而我的 ",[143,291,164],{}," 里面是用 ",[143,294,295],{},"markdown-it"," 来做渲染的，为了统一写法，得把渲染的方式改成 ",[143,298,299],{},"Markdown-it",[130,301,302,303,306,307,309],{},"这个项目主体是用 ",[143,304,305],{},"jQuery"," 写的，我最终决定继续用 ",[143,308,305],{}," 来写前端的页面交互。",[130,311,312],{},"那么我们就需要解决以下的问题：",[237,314,315,321,329,335,353,369,378,387],{},[240,316,317,318,320],{},"读取 ",[143,319,164],{}," 传来的文章列表并渲染到文章列表区",[240,322,317,323,325,326,328],{},[143,324,164],{}," 传来的文章内容并渲染文章的标题、标签、描述、关联文章、正文到各个输入框，以及最重要的 ",[143,327,179],{}," 编辑器",[240,330,331,332,334],{},"每当 ",[143,333,179],{}," 编辑器有更新时，预览区也要跟着更新，预览区还应该有代码高亮和一般样式渲染",[240,336,337,338,341,342,345,346,349,350,352],{},"点击 ",[143,339,340],{},"Save post"," 的时候，页面要检查各个输入框是否都有内容，没有则 ",[143,343,344],{},"alert"," 让填写内容，有的话再检查文章是否已存在，存在则 ",[143,347,348],{},"confirm"," 要不要更新，不存在则 ",[143,351,348],{}," 要不要创建。",[240,354,337,355,358,359,362,363,365,366,368],{},[143,356,357],{},"Delete post"," 的时候，页面要检查 ",[143,360,361],{},"slug"," 在文章列表里是否存在，不存在则 ",[143,364,344],{}," 说没东西可删，如果存在则要 ",[143,367,348],{}," 是否真的删除。",[240,370,371,372,375,376,170],{},"键盘按下 ",[143,373,374],{},"ctrl+enter"," 触发保存，效果等同于点击 ",[143,377,340],{},[240,379,380,381,161,383,386],{},"当确认要更新或创建的时候，浏览器使用 ",[143,382,305],{},[143,384,385],{},"post"," 方法提交内容到服务器，并获取提交结果，反映到浏览器",[240,388,389,390,161,392,394,395,397],{},"当确认要删除的时候，浏览器使用 ",[143,391,305],{},[143,393,385],{}," 方法提交要删除的 ",[143,396,361],{}," 到服务器，并获取删除结果，反映到浏览器。",[130,399,400],{},"并且这些要在一个页面里完成。",[125,402,403],{"id":403},"后端的实际写法",[405,406,408],"h3",{"id":407},"api-使用的依赖包","API 使用的依赖包",[130,410,411,412,415],{},"先 ",[143,413,414],{},"require"," 一下各个依赖。",[417,418,423],"pre",{"className":419,"code":420,"language":421,"meta":422,"style":422},"language-javascript shiki shiki-themes github-light github-dark","var express = require(\"express\");\nvar fs = require(\"fs\");\nvar fm = require('front-matter');\nvar hljs = require('highlight.js');\nvar markdownIt = require('markdown-it');\nvar markdownItToc = require('markdown-it-toc');\nvar open = require(\"open\");\nvar config = require(__dirname+\"\\\\config.js\");\nvar app = express();\nvar md = markdownIt({\n  html:         false,        \u002F\u002F 在源码中启用 HTML 标签\n  xhtmlOut:     false,        \u002F\u002F 使用 '\u002F' 来闭合单标签 （比如 \u003Cbr \u002F>）。\n  breaks:       false,        \u002F\u002F 转换段落里的 '\\n' 到 \u003Cbr>。\n  langPrefix:   'language-',  \u002F\u002F 给围栏代码块的 CSS 语言前缀。对于额外的高亮代码非常有用。\n  linkify:      false,        \u002F\u002F 将类似 URL 的文本自动转换为链接。\n  typographer:  false,\n  quotes: '“”‘’',\n  highlight: func