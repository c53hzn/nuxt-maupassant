      var href = aTags[i].href;\n        var hashPos = href.indexOf(\"#\");\n        var id = href.substring(hashPos+1, href.length);\n        d.querySelector(\"a[id='\"+String(id)+\"']\").scrollIntoView({behavior: \"smooth\"});\n      }\n    }\n  }\n}\n",[143,1901,1902,1907,1912,1917,1922,1927,1932,1937,1942,1947,1952,1957,1962,1967,1972,1977,1982,1987,1991,1995,1999],{"__ignoreMap":422},[426,1903,1904],{"class":428,"line":16},[426,1905,1906],{},"function updatePreview(){\n",[426,1908,1909],{"class":428,"line":34},[426,1910,1911],{},"  var d = document;\n",[426,1913,1914],{"class":428,"line":19},[426,1915,1916],{},"  var source = $(\"#editor\").val();\n",[426,1918,1919],{"class":428,"line":7},[426,1920,1921],{},"  var html = \"\\t\" + md.render('[toc]\\n' + source);\n",[426,1923,1924],{"class":428,"line":449},[426,1925,1926],{},"  html = html.replace(\u002F\\\u003Ca\u002Fg,\"\u003Ca target='_blank'\");\n",[426,1928,1929],{"class":428,"line":24},[426,1930,1931],{},"  $(\"#preview\").html(html);\n",[426,1933,1934],{"class":428,"line":39},[426,1935,1936],{},"  \u002F\u002Fadd scrollIntoView to anchor link\n",[426,1938,1939],{"class":428,"line":465},[426,1940,1941],{},"  var aTags = d.querySelectorAll(\"a[href]\");\n",[426,1943,1944],{"class":428,"line":471},[426,1945,1946],{},"  for (let i = 0; i \u003C aTags.length; i++) {\n",[426,1948,1949],{"class":428,"line":95},[426,1950,1951],{},"    if (aTags[i].href.indexOf(\"#\") !== -1) {\n",[426,1953,1954],{"class":428,"line":482},[426,1955,1956],{},"      aTags[i].onclick = function(e) {\n",[426,1958,1959],{"class":428,"line":488},[426,1960,1961],{},"        var c = e || event;\n",[426,1963,1964],{"class":428,"line":494},[426,1965,1966],{},"        c.preventDefault();\n",[426,1968,1969],{"class":428,"line":27},[426,1970,1971],{},"        var href = aTags[i].href;\n",[426,1973,1974],{"class":428,"line":505},[426,1975,1976],{},"        var hashPos = href.indexOf(\"#\");\n",[426,1978,1979],{"class":428,"line":511},[426,1980,1