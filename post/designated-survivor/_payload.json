[{"data":1,"prerenderedAt":273},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-designated-survivor":118,"surround-designated-survivor":262},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":248,"description":249,"extension":250,"meta":251,"navigation":96,"path":254,"seo":255,"slug":256,"stem":257,"tags":258,"__hash__":261},"blog\u002Fblog\u002F2019-07-08-designated-survivor.md","60天，指定幸存者",{"type":122,"value":123,"toc":238},"minimark",[124,128,132,135,138,141,144,147,150,153,156,159,163,166,169,172,175,178,181,184,187,190,193,196,206,209,212,215,218,221,224,226,229,232,235],[125,126,127],"h2",{"id":127},"韩剧翻拍美剧",[129,130,131],"p",{},"这两天看了个新的韩剧《60天，指定幸存者》，才出了两集，但是感觉信息量已经等于一部电影。",[129,133,134],{},"这部剧是翻拍自美剧《指定幸存者》，故事基本设定是一样的，但是在故事发展、人物关系安排上略有不同。",[129,136,137],{},"什么是“指定幸存者”呢？以韩国的情况来说的话，就是当出了一个什么不得了的事情，导致以总统、副总统为首的内阁大部分成员全都丧生的时候，可以代行总统职务的那个部长级官员。美版设定的是住房部长官，而韩版的是环境部长官。",[129,139,140],{},"在这里，我有一个大不敬的疑问，算了还是不问了。",[125,142,143],{"id":143},"关于演员",[129,145,146],{},"话说男主演池珍熙曾在《大长今》里演男主闵政浩，我也是佩服自己，那时候能看得下去五六十集的韩国古装剧，而且一直能记得角色的名字。",[129,148,149],{},"但其实我是在搜另一个演员李俊赫的时候偶然发现的这部剧，因为我对政治题材不是特别感冒，宫斗、宅斗、政斗对我来说都差不多，所以不会主动找这种类型的剧来看。",[129,151,152],{},"李俊赫在前两集里没有出现，稍微有点让人失望。但是看了设定之后知道，他的角色是男主的主要对手，想来戏份应该不至于太少吧？还是可以期待下。",[125,154,155],{"id":155},"关于角色",[129,157,158],{},"2020-09-27 更新",[160,161,162],"h3",{"id":162},"男主朴武镇",[129,164,165],{},"男主是传统的高大全人格，每个方面都完美无缺。",[129,167,168],{},"他对工作尽心尽力、一丝不苟，不管是原来作为研究员、环境部长官，还是后来作为代总统，都是敬业到让人肃然起敬。",[129,170,171],{},"能够用到自己专业知识的，他就费心费力找出证据来证明自己的看法，让别人接受。而需要用到别人专业的，他则是虚心向别人请教。对于舍命保护自己、保护国家的人，他也非常尊重他们。甚至在反派还没被公开揭露身份的时候，仍然给予表面上的尊重。真的瑞斯拜。",[129,173,174],{},"他对待下属也从来不摆架子，继承了遇难的前总统的优良传统，到后来的代代总统上任的时候形成了鲜明的对比。",[129,176,177],{},"男主对待家人则是一片赤诚，力求无愧于老婆孩子，甚至连不是亲生的孩子也一样。",[129,179,180],{},"因为公开家庭关系会伤害到妻子带来的孩子，所以他宁愿自己承受莫须有的罪名，被世人指责。最后也为了家人而放弃以代总统身份参选，堪称韩国第一好男人。",[129,182,183],{},"这么好的男人是真实存在的吗？",[160,185,186],{"id":186},"反派吴英硕",[129,188,189],{},"我本身是为了李浚赫演的角色，也就是反派吴英硕才看的剧，而且已经知道他是反派了，看的时候一点心理负担也没有。",[129,191,192],{},"吴英硕所在的恐怖组织的成员都是因为各种事情而对现政府不满的人，他们的目标是颠覆当前的政治架构，创建新的政治体系。他们想要的是一个人以群分、国际对立的新时代。",[129,194,195],{},"用大结局时女主的评价来说，就是想创造一个新的冷战体制。",[197,198,199],"blockquote",{},[129,200,201,202,205],{},"「결국 태러 세력이 원한 건 남북한의 긴장과 신 냉전 체제 였어. 어쩌면 VIP 는 한반도의 평화를 원하지 않는 모두 세력인지도 몰라」",[203,204],"br",{},"\n「恐怖分子想要的是南北朝鲜的关系紧张和新的冷战体制。看来这个所谓VIP可能就是不希望朝鲜半岛获得和平的所有势力了。」",[129,207,208],{},"这个事情本身是很可怕的，而且这就是特朗普正在做的事。。。",[129,210,211],{},"好吧，这些可怕的事先放一边，说回演员，吴英硕的扮相是真不错。",[129,213,214],{},"李浚赫特别适合穿西装，再加上他“剧抛脸”的演技，这次演的代代总统也是非常吸引人。",[129,216,217],{},"明明长了一张公检法的脸，却可以演这样漂亮又恐怖的角色。和油腻的徐东宰相比，吴英硕多了一种残忍又高傲的信念感，这让他在用鼻孔看人的时候散发出别样的魅力。",[129,219,220],{},"最后这个角色的命运是以死亡告终了，花絮里面同在现场的女主评价他说“死的时候也如此凄美”，实在让人忍俊不禁。",[125,222,223],{"id":223},"关于剧情",[129,225,158],{},[129,227,228],{},"剧情上实在不好说，反恐演习时的图纸泄露导致恐怖分子真的按演习来部署恐袭，这个故事听上去像是在搞笑。",[129,230,231],{},"但是电视剧的节奏还是不错的，演员也都演得很用心，所以虽然主线剧情匪夷所思，但竟然还能自圆其说。",[129,233,234],{},"政治上的东西我不会说，也说不好，就不说了。",[129,236,237],{},"就酱紫。",{"title":239,"searchDepth":34,"depth":34,"links":240},"",[241,242,243,247],{"id":127,"depth":34,"text":127},{"id":143,"depth":34,"text":143},{"id":155,"depth":34,"text":155,"children":244},[245,246],{"id":162,"depth":19,"text":162},{"id":186,"depth":19,"text":186},{"id":223,"depth":34,"text":223},[9],"学者当上内阁长官，不谙官场的他惨被革职，却因此幸存成为代理总统。在重重的危机之下，他能带领国家走出困境吗？","md",{"date":252,"language":253,"comments":96},"2019-07-08","中文","\u002Fblog\u002F2019-07-08-designated-survivor",{"title":120,"description":249},"designated-survivor","blog\u002F2019-07-08-designated-survivor",[259,260],"政治剧","韩剧","CtJ7VQD0oBQhpUn7o3MDiFEsKbE9idYB3Ls4Pj0wX6g",[263,268],{"title":264,"path":265,"stem":266,"children":-1,"slug":267},"校园霸凌团体F4的纯情恋爱物语——宝冢《流星花园》观后感","\u002Fblog\u002F2019-06-29-boys-over-flowers","blog\u002F2019-06-29-boys-over-flowers","boys-over-flowers",{"title":269,"path":270,"stem":271,"children":-1,"slug":272},"记忆中的食堂菜","\u002Fblog\u002F2019-08-13-campus-canteen-memories","blog\u002F2019-08-13-campus-canteen-memories","campus-canteen-memories",1794547929830]