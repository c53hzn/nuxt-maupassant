[{"data":1,"prerenderedAt":266},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-search-with-img-on-google-bing":118,"surround-search-with-img-on-google-bing":255},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":239,"description":240,"extension":241,"meta":242,"navigation":96,"path":247,"seo":248,"slug":249,"stem":250,"tags":251,"__hash__":254},"blog\u002Fblog\u002F2023-02-15-search-with-img-on-google-bing.md","如何优化谷歌和必应的识图搜索结果",{"type":122,"value":123,"toc":232},"minimark",[124,129,133,136,139,146,149,152,155,158,164,167,170,173,177,180,183,189,192,198,202,205,208,214,217,220,226,229],[125,126,128],"h2",{"id":127},"识图搜索不出结果怎么办","识图搜索不出结果怎么办？",[130,131,132],"p",{},"一般来说，如果要给网图找大图，只要你自己用来查找的素材图不是太糊，使用谷歌或必应的图片搜索功能应该都能出结果，只要上传上去，就能找到不同尺寸、不同清晰度的原图。",[130,134,135],{},"但是如果没有图片文件能上传，怎么搜呢？",[130,137,138],{},"我看到有网友发帖求助，她把一张图片作为音乐app的背景图，不小心删除了手机里的图片存档，现在找不回来了，于是把音乐app截图发上来，希望能找到原图。",[130,140,141],{},[142,143],"img",{"alt":144,"src":145},"9DA97510-3330-4204-89AD-EC4A1AA3C73C","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F219008686-b5eeece1-0445-4fd5-bb97-6ec5974fb635.jpeg",[130,147,148],{},"这个图其实还挺清晰的，唯一的不足就是app本身的UI遮盖了图片的很多地方，所以她自己用谷歌识图或者必应识图都搜不出来。",[130,150,151],{},"如果能把盖住图片的文字和图标p走，然后再去用识图功能，相信成功率一定会大大提高。",[125,153,154],{"id":154},"只用脸部以及使用关键字搜索",[130,156,157],{},"我一开始想得比较简单，把脸上的字和图标p掉，只用脸部这一块去搜。",[130,159,160],{},[142,161],{"alt":162,"src":163},"ABEC6D5E-3E7D-42DD-B242-C1DC36EBD897","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F219009138-a1a6efd8-417e-4e61-acdf-a25e8bbe010a.jpeg",[130,165,166],{},"必应好歹能识别出来这是Matthew Gray Gubler，但是找不到对应的图片。但是谷歌就太垃圾了，不光找不到原图，甚至连这是谁都认不出来。",[130,168,169],{},"我想着要不然加一些文字描述再去搜，于是加了关键字“Matthew Gray Gubler puppet”再搜，也还是两边都没有结果。",[130,171,172],{},"如果只搜文字“Matthew Gray Gubler puppet”，倒是可以找到他和同款玩偶一起出现的图片，但都不是这张图，可见关键字搜索也是不行的。",[125,174,176],{"id":175},"整张图都处理了怎么还是不行","整张图都处理了，怎么还是不行？",[130,178,179],{},"刚才处理脸部的时候比较精细，用了仿制图章、污点修复画笔、吸色手绘等方式。",[130,181,182],{},"为了能提高识图成功的可能，现在必须整张图都处理，那么处理方式就不能这么多样化了，于是简单粗暴地圈出轮廓后直接填色，有了第二版。",[130,184,185],{},[142,186],{"alt":187,"src":188},"8FB1A6CE-97BC-488E-88AB-D1B8EED3768A","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F219009396-07790986-5986-4b2b-a0c5-fc7c1f1f787d.jpeg",[130,190,191],{},"网友的截图尺寸是1080×2244px，我处理完之后储存为1079×1656px，再拿去搜，还是找不到。",[130,193,194],{},[142,195],{"alt":196,"src":197},"F1106480-B4B3-4CC1-AEA0-8794FCD5BA23","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F219010536-0a1d1ce5-36bb-4fd0-9d4b-5df9b597621e.png",[125,199,201],{"id":200},"大图无结果糊图反而能搜到","大图无结果，糊图反而能搜到？",[130,203,204],{},"我思考了一会，猜测会不会是我保存的图太大了，p过的地方都是色块，与原图差别过大，影响了近似图片的推荐。如果把图片缩小，则图片整体性就会增强，相当于摘下眼镜看马赛克画面的效果。",[130,206,207],{},"于是把p过的图片保存了一个417×640px的版本，再拿去搜，这次竟然有惊喜！",[130,209,210],{},[142,211],{"alt":212,"src":213},"66709DC8-318D-41E6-B72D-581D3F0D318D","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F219009651-6ce62d57-5702-4871-90d7-6767c4c17e47.jpeg",[130,215,216],{},"谷歌还是一样没结果，乱给我推荐一些无关的人和物。",[130,218,219],{},"而必应的第一个近似图片推荐就是我要的图！",[130,221,222],{},[142,223],{"alt":224,"src":225},"65A63573-C076-46B0-BC51-AD103BDDE605","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F219010374-5fd01131-f868-4ab1-8d07-97b8f327b19e.png",[130,227,228],{},"在这个网页找到了600×399px的原图，但是我还想要再大一点的，于是用这个600×399px的版本再去搜，于是找到了1118×745px的，发给网友，她很开心，而我又满足一次了自己奇怪的搜索欲。",[130,230,231],{},"全文完~",{"title":233,"searchDepth":34,"depth":34,"links":234},"",[235,236,237,238],{"id":127,"depth":34,"text":128},{"id":154,"depth":34,"text":154},{"id":175,"depth":34,"text":176},{"id":200,"depth":34,"text":201},[12],"想以图搜图，最好先优化你自己的图，然后再拿去搜。","md",{"date":243,"language":244,"keywords":245,"comments":96},"2023-02-15","中文",[246],"识图","\u002Fblog\u002F2023-02-15-search-with-img-on-google-bing",{"title":120,"description":240},"search-with-img-on-google-bing","blog\u002F2023-02-15-search-with-img-on-google-bing",[61,64,252,253],"以图搜图","搜索","9k-OzSRxnUAwJS39eQ8Zc6anpe0KzjOaJAJCciHeFAI",[256,261],{"title":257,"path":258,"stem":259,"children":-1,"slug":260},"刘慈欣的世界是男女平等的吗？——看流浪地球和三体有感","\u002Fblog\u002F2023-01-30-gender-equality-in-liu-cixin-world","blog\u002F2023-01-30-gender-equality-in-liu-cixin-world","gender-equality-in-liu-cixin-world",{"title":262,"path":263,"stem":264,"children":-1,"slug":265},"Notion的使用心得和遇到的问题","\u002Fblog\u002F2023-02-22-notion","blog\u002F2023-02-22-notion","notion",1794550655397]