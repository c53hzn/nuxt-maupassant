[{"data":1,"prerenderedAt":432},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-kowloon-walled-city":118,"surround-kowloon-walled-city":421},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":404,"description":405,"extension":406,"meta":407,"navigation":96,"path":413,"seo":414,"slug":415,"stem":416,"tags":417,"__hash__":420},"blog\u002Fblog\u002F2021-05-29-kowloon-walled-city.md","我去了九龙寨城遗址",{"type":122,"value":123,"toc":392},"minimark",[124,128,132,138,141,144,147,151,158,161,164,167,170,173,176,179,182,185,188,191,196,199,202,205,208,211,216,219,222,227,230,233,236,241,244,249,252,257,260,263,266,269,272,276,279,282,287,290,295,300,305,308,313,318,321,324,328,331,336,339,342,347,350,355,358,360,364,366,371,374,377,380,383,386,389],[125,126,127],"h2",{"id":127},"关于九龙寨城",[129,130,131],"p",{},"来香港之后，我在很多地方读到过关于九龙寨城的介绍文章，知道它是香港以前的一个贫民窟，早就拆除了。我也看过一些讨论“应不应该拆除”的观点，当时并没有什么特别的感觉，甚至觉得也许可以留着？",[133,134,135],"blockquote",{},[129,136,137],{},"九龙寨城，或九龙砦城，位于九龙城区的一座古城。占地面积6英亩，约2.7公顷。曾是英国割占而中国行使领土主权的“界中之界”，全世界人口密度最高的地区，于1993年拆除。\n——百度百科",[129,139,140],{},"直到上周，我看了一部 1982 年的电影《城寨出来者》，看完之后心情久久不能平静，我心想，这样的地方拆就拆了吧！",[129,142,143],{},"不仅如此，有形的城寨要拆，无形的城寨也需要拆。",[129,145,146],{},"从城寨出来的人，好像出来了，但又没有完全出来。只有将心中无形的城寨也拆掉，才能真正地走出来。",[125,148,150],{"id":149},"电影城寨出来者","电影《城寨出来者》",[129,152,153],{},[154,155],"img",{"alt":156,"src":157},"image","https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098877-f2da0280-c16a-11eb-911b-45dde769cbf1.png",[129,159,160],{},"电影的主角是一对幼年在鱼龙混杂的城寨中生活过的兄弟，相依为命的二人稍稍长大了，去了城寨外围生活，哥哥成了很懂江湖规矩的黑社会，而弟弟还在上中学。",[129,162,163],{},"幼时弟弟犯错，哥哥受罚，于是弟弟总也感觉不到犯错是有代价的，到他长大了，犯下更多、更大的错误，哥哥也无法帮他兜底。",[129,165,166],{},"无心向学又喜欢惹是生非的弟弟，这边搞大了女朋友的肚子，那边又去挑衅黑社会，真是有 10 条命也不够他作的。",[129,168,169],{},"哥哥没法调和黑社会和弟弟的矛盾，也无法让因为女儿被搞大了肚子而怀恨在心的坏警察收手。坏警察让黑社会去教训小弟，却害死了同在现场的女儿。",[129,171,172],{},"全片最无辜最可怜的是小玲，如果她不和狐朋狗友一起鬼混，也许还有条命在。",[129,174,175],{},"没了女儿的坏警察掳走小弟，逼他堕落，又带哥哥来目睹小弟的丑态，羞愧难当的小弟当场自尽，悲愤的哥哥要找坏警察决斗，此时之前从来没出现过的好警察出现了，把哥哥和坏警察一起抓走，电影就结束了。",[129,177,178],{},"这算是个什么结局呢？",[129,180,181],{},"如果我是导演，就让哥哥和坏警察一起从窗户跳出去，同归于尽算了。",[125,183,184],{"id":184},"二刷电影",[129,186,187],{},"星期五的时候拿到了公司发的端午福利：2 个粽子。我查了一下价格，2 个这么小的粽子竟然要 74 港币。",[129,189,190],{},"拿到手之后我就想起电影里兄弟俩最后一次笑脸相对的场景，他们各自买了一个大粽子，要和对方分着吃。不知道那时候的粽子是多少钱一个呢？",[129,192,193],{},[154,194],{"alt":156,"src":195},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120096789-00d65600-c160-11eb-9dda-c8b36ddee736.png",[129,197,198],{},"于是我又把电影翻出来看了一遍，大哥买粽子那段没有说粽子是多少钱，不过这不重要，我在重温电影的时候突然生出了要探访电影拍摄地的想法。",[125,200,201],{"id":201},"寻找拍摄地",[129,203,204],{},"我知道城寨早就没有了，现在那里是“九龙寨城公园”，搜了下路线，决定周六坐地铁，从乐富站出来，走路去公园。",[129,206,207],{},"至于其他地方，由于电影的主要取景地是在城寨及其周边，我只要注意看有没有其他标志性建筑就好了。",[129,209,210],{},"买粽子之前，大哥和张sir发现有人打劫的那里，镜头从上到下特写了一个灯牌，上面写着“基督是世界的光”。",[129,212,213],{},[154,214],{"alt":156,"src":215},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120096665-637b2200-c15f-11eb-8fdb-526ba218ac4a.png",[129,217,218],{},"于是我开始谷歌搜索“基督是世界的光”，但是这句话貌似是很多香港的基督教组织传教的宣传用语，没有特别的指向性。",[129,220,221],{},"于是换了个关键词“九龙城 基督教”来搜索图片，一下就找到了。",[129,223,224],{},[154,225],{"alt":156,"src":226},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120096700-8f96a300-c15f-11eb-8535-d6119adb25c5.png",[129,228,229],{},"这里是“九龙城基督徒会”，“基督是世界的光”就在这个建筑的外墙上。",[129,231,232],{},"再搜索地址，原来它就在寨城公园的南边，那也可以顺便去瞅一眼。",[129,234,235],{},"后面小弟被抓进警局，画面出现了警局的外部，我总觉得在哪见过，但是又想不起来。",[129,237,238],{},[154,239],{"alt":156,"src":240},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120096743-ca98d680-c15f-11eb-9e8a-e7ae845b41af.png",[129,242,243],{},"搜索了半天“九龙城 警署”也找不到它。于是继续播放电影，在兄弟俩从警署出来的地方发现了线索。",[129,245,246],{},[154,247],{"alt":156,"src":248},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120096643-3dee1880-c15f-11eb-80f9-6718115ec48a.png",[129,250,251],{},"兄弟俩后面的第一块牌子上写了“尖沙咀警署”，于是搜这个，但是找出来的建筑看起来毫不相干。再看回这个截图，第二块牌子上写了“水警区总部”，再搜这个就找到了。",[129,253,254],{},[154,255],{"alt":156,"src":256},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120096997-d6d16380-c160-11eb-9c94-c472d26971a2.png",[129,258,259],{},"等会，这不是 1881 Heritage 吗？之前在尖沙咀上班的时候天天从这旁边经过，却从来没进去看过。我知道它以前是警署，但是原来 1982 年的时候还在使用中吗？",[129,261,262],{},"这时候我的心情突然有点复杂，感觉自己错过了很多历史文化，错过了很多香港的记忆，我来得太晚了。",[129,264,265],{},"之后电影里就没有什么特别明显的建筑了，大哥带小弟去坏警察家，出来的时候能看到那里是“广东道警察宿舍”，谷歌了一下发现这里也早就不是警察宿舍，而是商业住宅了。好像没什么看头，那就不去了。",[129,267,268],{},"最终决定，周六去九龙寨城公园和 1881 Heritage。",[125,270,271],{"id":271},"探访城寨遗址和旧水警总部遗址",[273,274,275],"h3",{"id":275},"九龙寨城公园",[129,277,278],{},"周六起来做了一番思想斗争，早上 10 点钟气温已经达到了 32 度，这要是去公园，下午还能活？但是如果今天不去，之后只会更热，所以还是出门了。我带了一把伞和一瓶水，事实证明这个决定是正确的。",[129,280,281],{},"先坐地铁到乐富站，从B出口出，沿联合道向南走10分钟至东头村道，就看到了“九龙寨城公园”的入口。",[129,283,284],{},[154,285],{"alt":156,"src":286},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098334-e607df80-c167-11eb-81e9-3072ea2d7938.png",[129,288,289],{},"但这里进去之后其实还不是寨城，只是这个大的公园区域里的“贾炳达道公园”，再往东边走，矮城墙围起来的部分才是真正的寨城遗址所在地。",[129,291,292],{},[154,293],{"alt":156,"src":294},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098356-020b8100-c168-11eb-8fc3-9b6bc0b510c8.png",[129,296,297],{},[154,298],{"alt":156,"src":299},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098366-0e8fd980-c168-11eb-8de9-5355b49bbe1f.png",[129,301,302],{},[154,303],{"alt":156,"src":304},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098369-164f7e00-c168-11eb-8b25-2e589134c068.png",[129,306,307],{},"寨城公园只是很小的一块地方，从南门走到北门只需要10分钟，但是里面十分幽静，很难想象就这么一块地方，以前住了3万人。",[129,309,310],{},[154,311],{"alt":156,"src":312},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098380-210a1300-c168-11eb-883a-3f8200d5d12d.png",[129,314,315],{},[154,316],{"alt":156,"src":317},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098386-2e270200-c168-11eb-9bc1-026e9d064f54.png",[129,319,320],{},"往南出了公园，沿贾炳达道往东，从龙岗道转右，就到了“九龙城基督徒会”，不过从南向北看的时候才能看到“基督是世界的光”的灯牌，白天也不亮。",[129,322,323],{},"1982年",[129,325,326],{},[154,327],{"alt":156,"src":215},[129,329,330],{},"2021年5月29日",[129,332,333],{},[154,334],{"alt":156,"src":335},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098441-8f4ed580-c168-11eb-9e89-a9384c8a732d.png",[273,337,338],{"id":338},"尖沙咀1881公馆",[129,340,341],{},"要去尖沙咀旧水警总部，也就是现在的1881公馆，可以坐地铁到尖东或尖沙咀站，出闸后走地下通道，从L6出口出去就是了。",[129,343,344],{},[154,345],{"alt":156,"src":346},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098500-e05ec980-c168-11eb-8e76-ecec999e682d.png",[129,348,349],{},"广场这里曾经办过一些奇怪的展出，某年曾经布置了一个梵高的麦田，长这样",[129,351,352],{},[154,353],{"alt":156,"src":354},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098602-72ff6880-c169-11eb-844d-b227af65860a.png",[129,356,357],{},"而《城寨出来者》里面那个镜头，是在高台上的那个建筑，我拍了一张跟电影里差不多角度的。",[129,359,323],{},[129,361,362],{},[154,363],{"alt":156,"src":240},[129,365,330],{},[129,367,368],{},[154,369],{"alt":156,"src":370},"https:\u002F\u002Fuser-images.githubusercontent.com\u002F30020736\u002F120098639-a93ce800-c169-11eb-9dc8-480f4f63e0f9.png",[129,372,373],{},"高台上能站的地方不大，我甚至无法让整个建筑都入镜，很难相信这里以前可以有车辆通行。",[129,375,376],{},"由于以前从来没有进去过，我完全不知道这里面是做什么的，今天去了才发现，里面竟然是个高级餐厅。警署变餐厅，这你敢信？",[129,378,379],{},"感受完历史的气息之后我就赶紧回了地下通道，因为外面真的热死了。",[125,381,382],{"id":382},"总结",[129,384,385],{},"感谢蓝乃才导演拍的好电影，感谢钱小豪演出了这么一个作死的小弟。",[129,387,388],{},"同时也要感谢一下香港政府对各种历史遗迹的保护吧，毕竟过了这么久，我竟然还能找到这些地方。",[129,390,391],{},"40 年过去了，物非人也非啊。",{"title":393,"searchDepth":34,"depth":34,"links":394},"",[395,396,397,398,399,403],{"id":127,"depth":34,"text":127},{"id":149,"depth":34,"text":150},{"id":184,"depth":34,"text":184},{"id":201,"depth":34,"text":201},{"id":271,"depth":34,"text":271,"children":400},[401,402],{"id":275,"depth":19,"text":275},{"id":338,"depth":19,"text":338},{"id":382,"depth":34,"text":382},[9,33,36],"看了《城寨出来者》之后心里一直放不下，于是找到了2个我能去的拍摄地，一个是九龙寨城，一个是尖沙咀水警总部，探访了这两个已经没有了的地方。","md",{"date":408,"language":409,"keywords":410,"comments":96},"2021-05-29","中文",[411,412],"香港","贫民窟","\u002Fblog\u002F2021-05-29-kowloon-walled-city",{"title":120,"description":405},"kowloon-walled-city","blog\u002F2021-05-29-kowloon-walled-city",[418,419],"城寨出来者","钱小豪","trDpXdktgF_TY_dd7ZlRTx4vTHskaTOnMTtgywCdWi8",[422,427],{"title":423,"path":424,"stem":425,"children":-1,"slug":426},"我用Vue仿了一个川普的个人版推特","\u002Fblog\u002F2021-05-08-from-the-desk-of-donald-j-trump","blog\u002F2021-05-08-from-the-desk-of-donald-j-trump","from-the-desk-of-donald-j-trump",{"title":428,"path":429,"stem":430,"children":-1,"slug":431},"义字如刀——《手卷烟》影评","\u002Fblog\u002F2021-06-14-hand-rolled-cigarette","blog\u002F2021-06-14-hand-rolled-cigarette","hand-rolled-cigarette",1794550657059]