[{"data":1,"prerenderedAt":508},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-asmr-recommendations":118,"surround-asmr-recommendations":497},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":472,"description":473,"extension":474,"meta":475,"navigation":96,"path":491,"seo":492,"slug":493,"stem":494,"tags":495,"__hash__":496},"blog\u002Fblog\u002F2021-02-11-asmr-recommendations.md","ASMR视频推荐",{"type":122,"value":123,"toc":460},"minimark",[124,129,133,141,147,163,166,169,173,176,184,187,190,228,232,235,238,241,267,271,274,277,280,283,321,332,335,344,348,352,359,362,366,377,383,387,390,404,407,411,414,417,424,427,445,448,451,454,457],[125,126,128],"h2",{"id":127},"初识asmr","初识ASMR",[130,131,132],"p",{},"话说某天在微博上看了一个采耳的视频，里面正在享受采耳的人放松又舒适，而进行采耳的人专业又利落，正在看视频的我仿佛也经历了一次耳朵清洁，感觉人都清爽多了。",[130,134,135,136,140],{},"后来知道这种就是 ",[137,138,139],"code",{},"ASMR"," 视频，但如果搜索它的定义，恐怕看了还是不知道说的是啥。",[142,143,144],"blockquote",{},[130,145,146],{},"ASMR（英语：Autonomous sensory meridian response，缩写ASMR），即自发性知觉经络反应，意思是指人体通过视、听、触、嗅等感知上的刺激，在颅内、头皮、背部或身体其他部位产生的令人愉悦的独特刺激感，又名耳音、颅内高潮等。",[130,148,149,150,152,153,155,156,158,159,162],{},"按我的理解， ",[137,151,139],{}," 就是通过画面和声音的刺激，让你精神放松（或者集中）的视频。有的 ",[137,154,139],{}," 在睡前听，精神放松了，很快就能睡着；有的 ",[137,157,139],{}," 在学习、工作的时候听，就能集中精神做手上的事，相当于 ",[137,160,161],{},"白噪音"," 的效果。",[130,164,165],{},"美剧《犯罪心理》有一集说罪犯用 ASMR 视频给小孩子催眠，就像格林童话里面的“哈梅林的吹笛手”一样把孩子诱拐走了，这也太夸张了。",[130,167,168],{},"不过看过真实采耳的 ASMR 之后，我主动搜索了很多其他的 ASMR 视频，这才发现原来 ASMR 有这么多种类。",[125,170,172],{"id":171},"采耳ear-cleaning或按摩massage等","采耳(Ear Cleaning)或按摩(Massage)等",[130,174,175],{},"不光是采耳，还有按摩、梳头、洗头等视频，这些都能给人以清洁、舒适的感觉，即使自己没有亲身经历，也能透过视频画面获得相应的感受。",[130,177,178,179,183],{},"除了真实的采耳、按摩之外，视频博主甚至可以用虚拟的方式给大家进行 ",[180,181,182],"strong",{},"假的"," 采耳和按摩，比如使用假的耳朵或者美发店的假人头，甚至还有的视频直接是画出来的动画画面，用声音引导大家想象真实的采耳和按摩。我不得不赞叹这些视频作者的想象力和视频制作功力。",[130,185,186],{},"他们对着那些无生命的物体还能像对真人一样认真、仔细，是真的把制作 ASMR 视频当做自己的一份专业了。",[130,188,189],{},"我喜欢的采耳、按摩类博主有这些：",[191,192,193,204,212,220],"ul",{},[194,195,196,203],"li",{},[197,198,202],"a",{"href":199,"rel":200},"https:\u002F\u002Fwww.youtube.com\u002Fc\u002FTingtingASMR",[201],"nofollow","Tingting ASMR","： 长得像林心如的华裔博主，总是用甜美的笑容给大家带来最轻柔却到位的按摩，只不过她是对着假人头",[194,205,206,211],{},[197,207,210],{"href":208,"rel":209},"https:\u002F\u002Fwww.youtube.com\u002Fc\u002F%EA%BF%80%EA%BF%80%EC%84%A0%EC%95%84",[201],"ASMR Suna 꿀꿀선아","： 这是位长相甜美的韩国博主，她的视频种类比较多，有吃播、手工、按摩、敲击物品等，但我最早看她的就是真实洗头的视频，所以姑且放到这一类。",[194,213,214,219],{},[197,215,218],{"href":216,"rel":217},"https:\u002F\u002Fwww.youtube.com\u002Fc\u002FASMRALICE_CHANNEL",[201],"ASMR Alice","： 这是位不露脸的专门按摩假耳朵的博主，她的特色是每个视频都配了和视频内容无关的无厘头的字幕。",[194,221,222,227],{},[197,223,226],{"href":224,"rel":225},"https:\u002F\u002Fwww.youtube.com\u002Fchannel\u002FUC7gDQCxC1wr955ECW6wSOoA\u002Fvideos",[201],"LULUPANG 루루팡","： 这个频道都是动画视频，有 Spa 、卸妆、化妆、采耳、梳头等。",[125,229,231],{"id":230},"敲击摩擦挤压物品tapping-rubbing-squishing类","敲击摩擦挤压物品(Tapping, rubbing, squishing)类",[130,233,234],{},"这类的博主会找很多不同的物品，比如盒子、罐子、杯子、板子等一切能敲的东西，通常是用自己的指甲去敲击来发出声音，我觉得他们可能需要给指甲上个保险。",[130,236,237],{},"或者是一些通过摩擦和挤压能发出不同的声音的物品，比如海绵、刷子、纸张，甚至也有直接使用液体或泡沫来制造声音的视频。",[130,239,240],{},"我喜欢的博主有这些：",[191,242,243,251,259],{},[194,244,245,250],{},[197,246,249],{"href":247,"rel":248},"https:\u002F\u002Fwww.youtube.com\u002Fc\u002Fasmrzeitgeist",[201],"ASMR Zeitgeist","： 说英文的青年男博主，声音深沉又有磁性。",[194,252,253,258],{},[197,254,257],{"href":255,"rel":256},"https:\u002F\u002Fwww.youtube.com\u002Fc\u002FCoromoSaraASMR",[201],"Coromo Sara. ASMR","： 指甲特别漂亮的不露脸的博主，是个声音特别温柔的日本女孩子",[194,260,261,266],{},[197,262,265],{"href":263,"rel":264},"https:\u002F\u002Fwww.youtube.com\u002Fchannel\u002FUCue0AhOm8SARARIcT-0mE1w",[201],"Hatomugi ASMR","： 跟 Coromo Sara 风格比较类似的博主",[125,268,270],{"id":269},"低语闲聊whisper类","低语闲聊(Whisper)类",[130,272,273],{},"前面两类视频里面，博主在进行按摩或敲击的时候会轻声低语，这样视频的声音也不至于太单调。",[130,275,276],{},"而有的视频则是博主专门说话给大家听，自言自语地说一些自己的生活琐事，一说就是 20 到 40 分钟，我真的惊叹于他们闲聊的功力，我自己对着自己说话肯定是说不了20分钟的。",[130,278,279],{},"如果是睡前听低语闲聊类的视频的话，最好还是外语的比较能帮助睡眠，我试过听中文博主的视频，因为全都能听懂，所以会不自觉地注意语音语调，有时候个别内容会让人瞬间清醒，这还睡什么呢？",[130,281,282],{},"我喜欢的低语闲聊类博主有这些：",[191,284,285,293,305,313],{},[194,286,287,292],{},[197,288,291],{"href":289,"rel":290},"https:\u002F\u002Fwww.youtube.com\u002Fc\u002FTiptoeTinglesASMR",[201],"Tiptoe Tingles ASMR","： 说英文的很有活力的年轻女孩，招牌是打响指的声音。",[194,294,295,304],{},[197,296,299,300],{"href":297,"rel":298},"https:\u002F\u002Fwww.youtube.com\u002Fchannel\u002FUCqTDWgTQUgYwqy6MDArHn0A",[201],"곰돌이 숭늉이 ",[301,302,303],"span",{},"Bear Soongnyoong","： 说韩语的猫猫按摩系列。博主有很多只猫，而且都很温顺乖巧。博主假装开了一家猫猫 Spa，给猫猫按摩、美容，还给猫猫推销昂贵的 Spa 套餐，整个系列都非常有意思。",[194,306,307,312],{},[197,308,311],{"href":309,"rel":310},"https:\u002F\u002Fwww.youtube.com\u002Fc\u002FVeiledASMRSJ",[201],"Veiled ASMR SJ","： 说韩语的年轻男博主。小哥哥于2021年3月宣布不做ASMR视频，有点可惜，不过他以前的视频仍然保留在频道中，大家还是可以去看。",[194,314,315,320],{},[197,316,319],{"href":317,"rel":318},"https:\u002F\u002Fwww.youtube.com\u002Fc\u002FRoseASMR0430",[201],"Rose ASMR","： 说英文和韩语的，长得像辛芷蕾的年轻女博主，视频内容以口腔音为主。",[130,322,323,324,327,328,331],{},"在 Tiptoe 的视频里面，最早吸引到我的是一个 ",[137,325,326],{},"Recipe Visualization"," 的视频，直译过来是 ",[137,329,330],{},"视觉化菜谱"," 的意思，其实就是她通过手部动作、唇齿拟音来模拟做菜的过程的视频。",[130,333,334],{},"她现在总共有 2 个这样的视频：",[336,337],"iframe",{"className":338,"src":340,"title":341,"frameBorder":342,"allow":343,"allowFullScreen":96},[339],"youtube","https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FveAOhV90XQg","YouTube video player","0","accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture",[336,345],{"className":346,"src":347,"title":341,"frameBorder":342,"allow":343,"allowFullScreen":96},[339],"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FmKDe6AAtc38",[125,349,351],{"id":350},"口腔音mouth-sounds","口腔音(Mouth Sounds)",[130,353,354,355,358],{},"这个类别其实很难介绍得好， ",[137,356,357],{},"口腔音"," 顾名思义就是用口腔发出的声音，比如舌头和上颚碰撞发出的“啧啧”声，或者是模拟亲吻一样的“啵啵”声，如果是初次接触的人可能会觉得非常不雅，有很多人因为这个而对 ASMR 有一些不好的印象。",[130,360,361],{},"但是这也不过是声音的一种，有的人确实在听到之后能得到放松，那就说明这个 ASMR 博主成功了呀。",[125,363,365],{"id":364},"无人声类no-talking","无人声类(No Talking)",[130,367,368,369,372,373,376],{},"有时候大家不想听博主闲聊或者发出口腔音，于是就有了专门的 ",[137,370,371],{},"无人声","(",[137,374,375],{},"No talking",") 的视频，博主专心给大家带来非人声的声音，不跟大家唠嗑。",[130,378,379,380,382],{},"前面推荐的博主都有专门的无人声的视频，只要在搜索的时候加上 ",[137,381,375],{}," 就能搜到了。",[125,384,386],{"id":385},"自然声音natural-sounds","自然声音(Natural Sounds)",[130,388,389],{},"还有的视频全程没有人的参与，纯粹是自然声音，比如风吹、鸟鸣、水流、雪落，然后配上相应的画面，创造足够的想象空间，这些也是很能放松心情的视频内容。",[130,391,392,393,398,399,403],{},"我最近很喜欢的是火炉的声音，比如西式房间的壁炉，看 ",[197,394,397],{"href":395,"rel":396},"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=UgHKb_7884o",[201],"这个视频","，或者日式房间的下沉式地炉，看 ",[197,400,397],{"href":401,"rel":402},"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=B3nDOb8Ej5w",[201],"。整个视频只包含了火苗跳动的画面和柴火噼里啪啦燃烧的声音，重复几个小时。火堆燃烧的声音把火苗的温暖传导了过来，我仿佛看到了热腾腾、香喷喷的烤鹅向我走来。。。",[130,405,406],{},"说岔了，恩，总之火炉的视频确实挺好的，推荐大家在学习、工作的时候可以开着当白噪音。",[125,408,410],{"id":409},"擦边球类erotic-or-explicit","擦边球类(Erotic or Explicit)",[130,412,413],{},"ASMR 视频主要是为了给大家带来精神上的愉悦，那还有什么比色情内容更能给人带来愉悦呢？",[130,415,416],{},"有的人会露一些引人遐想的部位，做一些有含义的动作，以此来吸引目光，增加订阅。",[130,418,419,420,423],{},"但只要平台不把她\u002F他的视频下架，那就算还够不上 ",[137,421,422],{},"违反公序良俗"," 吧。",[130,425,426],{},"这一类的视频博主里我比较喜欢两个博主：",[191,428,429,437],{},[194,430,431,436],{},[197,432,435],{"href":433,"rel":434},"https:\u002F\u002Fwww.youtube.com\u002Fc\u002FHeatheredEffect",[201],"HeatheredEffect ASMR",": 说英语的成熟大姐姐",[194,438,439,444],{},[197,440,443],{"href":441,"rel":442},"https:\u002F\u002Fyoutube.com\u002Fc\u002FASMRMOOD",[201],"ASMR MOOD",": 说俄语的俏皮妹子",[130,446,447],{},"她们的共同点是都有一种攻击性的美，不过看她们的视频的时候总是不知道自己应该看哪里。",[130,449,450],{},"另外还有个白幼瘦的大胸韩国妹子，大家的评语是“建议静音观看”，就不在这里推荐了。",[125,452,453],{"id":453},"总结",[130,455,456],{},"ASMR 的种类非常丰富，博主们也都是用心为大家创造了视频内容，前面推荐的博主常常会出多种类型的视频，所以我定的分类不一定精准。不过大家还是可以多尝试，找到适合自己的分类，甚至一天换一个分类，都不是什么问题。",[130,458,459],{},"以及，火炉是真的温暖啊~",{"title":461,"searchDepth":34,"depth":34,"links":462},"",[463,464,465,466,467,468,469,470,471],{"id":127,"depth":34,"text":128},{"id":171,"depth":34,"text":172},{"id":230,"depth":34,"text":231},{"id":269,"depth":34,"text":270},{"id":350,"depth":34,"text":351},{"id":364,"depth":34,"text":365},{"id":385,"depth":34,"text":386},{"id":409,"depth":34,"text":410},{"id":453,"depth":34,"text":453},[29],"自从喜欢上看ASMR视频，感觉仿佛新世界的大门打开了。","md",{"date":476,"language":477,"keywords":478,"comments":96},"2021-02-11","中文",[161,479,480,481,482,483,484,485,486,487,488,357,489,490,371],"white noise","采耳","按摩","梳头","洗头","化妆","卸妆","spa","敲击","摩擦","耳语","低语","\u002Fblog\u002F2021-02-11-asmr-recommendations",{"title":120,"description":473},"asmr-recommendations","blog\u002F2021-02-11-asmr-recommendations",[6,139],"PiOmZ5gRBm7WrTtSJfywCvYpUCfAUcylzgffolnyi4Y",[498,503],{"title":499,"path":500,"stem":501,"children":-1,"slug":502},"我的2020年","\u002Fblog\u002F2021-02-10-summary-of-my-life-in-2020","blog\u002F2021-02-10-summary-of-my-life-in-2020","summary-of-my-life-in-2020",{"title":504,"path":505,"stem":506,"children":-1,"slug":507},"ASMR Video Recommendations","\u002Fblog\u002F2021-02-13-asmr-recommendations-en","blog\u002F2021-02-13-asmr-recommendations-en","asmr-recommendations-en",1794501663919]