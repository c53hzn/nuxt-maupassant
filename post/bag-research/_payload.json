[{"data":1,"prerenderedAt":312},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-bag-research":118,"surround-bag-research":301},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":285,"description":286,"extension":287,"meta":288,"navigation":96,"path":294,"seo":295,"slug":296,"stem":297,"tags":298,"__hash__":300},"blog\u002Fblog\u002F2020-10-08-bag-research.md","如何找到明星同款背包",{"type":122,"value":123,"toc":278},"minimark",[124,128,137,144,147,150,161,168,181,200,207,214,229,232,239,249,252,255,258,261,264,269,275],[125,126,127],"h2",{"id":127},"发现背包",[129,130,131,132,136],"p",{},"刘学义同学收了工坐飞机回家，有网友发现他背的包是2019年1月1日微博九宫格配图的其中一张，又有网友认出这是 ",[133,134,135],"code",{},"LV"," 的包，但没有说出具体的型号。",[129,138,139],{},[140,141],"img",{"alt":142,"src":143,"title":142},"刘学义","\u002Fimg\u002Fblog\u002F2020-10-08\u002F001.jpg",[129,145,146],{},"我看到这里，突然对这个包包产生了兴趣，想知道这个包包具体叫什么名字（然而并不会买）。",[125,148,149],{"id":149},"搜索款型",[129,151,152,153,156,157,160],{},"放大这张图片，我们发现这款包使用了两种材质，一个是树枝纹，或者也叫水波纹压花皮革，英文名称叫 ",[133,154,155],{},"Epi Leather"," ，另一个材质是深蓝棋盘格帆布，英文名称是 ",[133,158,159],{},"Damier Graphite Canvas","。",[129,162,163,164,167],{},"搜索的时候可以用这两个关键字再加上背包的英文 ",[133,165,166],{},"backpack"," 进行搜索，那么我们就开始吧！",[129,169,170,171,174,175],{},"谷歌搜索 ",[133,172,173],{},"LV Epi Leather Damier Graphite backpack"," ，出来的第一个结果是 LV 的香港官网产品页\n",[176,177,178],"a",{"href":178,"rel":179},"https:\u002F\u002Fhk.louisvuitton.com\u002Feng-hk\u002Fproducts\u002Fchristopher-backpack-pm-epi-010108",[180],"nofollow",[129,182,183,184,187,188,191,192,195,196,199],{},"页面标题是 ",[133,185,186],{},"Christopher Backpack PM Epi Leather"," ，点开发现大约是和刘同学的背包差不多大小和形状设计的背包，货号为 ",[133,189,190],{},"M58868","，但是它的材质为全树枝纹皮革，没有拼接深蓝色棋盘格，那么我们可以确定，我们要找的应该是同名但不同款的背包，接下来只要把背包的名字 ",[133,193,194],{},"Christopher"," 和表示尺寸的 ",[133,197,198],{},"PM"," 带上，继续搜索应该就能找到了。",[129,201,202,203,206],{},"在 LV 的官网搜索 ",[133,204,205],{},"Christopher PM"," ，可以找到不同材质的同名背包，但是没有小刘同款的，可能是由于这一款不是当季主打，或者缺货等原因，当前不在展示中，所以还是要转战谷歌。",[129,208,209,210,213],{},"这次我们搜索 ",[133,211,212],{},"lv christopher pm epi leather damier graphite backpack"," ，在图片结果里看到了我们想找的同款包，虽然很多图片结果的来源网站的网址看起来像外国拼多多，但是我们要的只是里面的产品信息而已，并不一定要点开看。",[129,215,216,217,220,221,224,225,228],{},"图片搜索结果的第一个写了半截标题 ",[133,218,219],{},"Louis Vuitton M51457 LV Christopher..."," ，这里的 ",[133,222,223],{},"M51457"," 看起来像是货号，那么我们反向搜索，只用 ",[133,226,227],{},"LV M51457"," 去搜，不带材质和背包名称，果然也搜到了，那么确实就是这个货号了。",[125,230,231],{"id":231},"估算价格",[129,233,234,235,238],{},"但是在谷歌上使用关键词 ",[133,236,237],{},"LV M51457 site:louisvuitton.com"," 对 LV 的官网进行进一步搜索，发现完全没有这款包，那么恭喜小刘同学，他的这个背包可能已经绝版了。",[129,240,241,242,244,245,248],{},"在价格方面，LV 香港官网显示，不同材质的 ",[133,243,205],{}," 背包的价格由 25.1k 至 41.5k 港币不等， ",[133,246,247],{},"Epi"," 的属于中间偏上，也要 3w 多港币，但是他这个有不同材质的拼接，所以应该向上看齐，怎么也要 4w 港币左右，那也就是 3w 多人民币。",[129,250,251],{},"继续在全网搜索，某东显示代购这款包要 4w 多人民币，看来代购真的赚钱啊。而某二手奢侈品网站显示二手未使用的品相要 3w 多人民币，要价也是挺狠的。",[129,253,254],{},"综上，这款背包是大牌名品，款型又时尚，非常符合小刘的时尚达人身份（一定是团队的小姐姐给他选的）。",[125,256,257],{"id":257},"修图的重要性",[129,259,260],{},"在搜图的过程中，我发现刘学义微博配图里背包的颜色和网上的产品图有色差，这个问题可大可小，他这是艺人写真，所以没有关系，但如果是零售商放了这个图恐怕是要被投诉的。",[129,262,263],{},"为了还原背包颜色，我给他的图片重新调了个色。",[129,265,266],{},[140,267],{"alt":268,"src":143,"title":268},"调色前",[129,270,271],{},[140,272],{"alt":273,"src":274,"title":273},"调色后","\u002Fimg\u002Fblog\u002F2020-10-08\u002F002.jpg",[129,276,277],{},"以上就是我找到刘学义同款背包的过程，仅供大家参考~",{"title":279,"searchDepth":34,"depth":34,"links":280},"",[281,282,283,284],{"id":127,"depth":34,"text":127},{"id":149,"depth":34,"text":149},{"id":231,"depth":34,"text":231},{"id":257,"depth":34,"text":257},[12],"最近很喜欢刘学义，所以尝试搜索了一下他背的同款背包，也算是用上了一些以往的工作经验。","md",{"date":289,"language":290,"keywords":291,"comments":96},"2020-10-08","中文",[142,135,292,293],"Louis Vuitton","Christopher Backpack","\u002Fblog\u002F2020-10-08-bag-research",{"title":120,"description":286},"bag-research","blog\u002F2020-10-08-bag-research",[299],"搜索","k5Ov5TsM9qTQ85KQlShedm73zOTy2a_xpBIjRhLb-ug",[302,307],{"title":303,"path":304,"stem":305,"children":-1,"slug":306},"低配电脑能用什么视频剪辑软件","\u002Fblog\u002F2020-10-04-filmora","blog\u002F2020-10-04-filmora","filmora",{"title":308,"path":309,"stem":310,"children":-1,"slug":311},"熊猫速汇(Panda Remit)测评","\u002Fblog\u002F2021-01-07-panda-remit-review","blog\u002F2021-01-07-panda-remit-review","panda-remit-review",1794547929612]