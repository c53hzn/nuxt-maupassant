  var requests = [];\n",[446,842,844],{"class":448,"line":843},18,[446,845,846],{},"    for (let i = 0; i \u003C related.length; i++) {\n",[446,848,850],{"class":448,"line":849},19,[446,851,852],{},"      if (related[i]) {\n",[446,854,856],{"class":448,"line":855},20,[446,857,858],{},"        if (!config.isSlugUseDate) {\n",[446,860,862],{"class":448,"line":861},21,[446,863,864],{},"          related[i] = related[i].substring(11,related[i].length);\n",[446,866,868],{"class":448,"line":867},22,[446,869,870],{},"          let req = axios.get('http:\u002F\u002F127.0.0.1:4000\u002Fblog?slug='+related[i])\n",[446,872,874],{"class":448,"line":873},23,[446,875,876],{},"          .then((res) => {\u002F\u002F res.data is json\n",[446,878,879],{"class":448,"line":10},[446,880,881],{},"            let temp = res.data;\n",[446,883,885],{"class":448,"line":884},25,[446,886,887],{},"            if (temp) {\n",[446,889,891],{"class":448,"line":890},26,[446,892,893],{},"              delete res.data.content;\n",[446,895,897],{"class":448,"line":896},27,[446,898,899],{},"              return res.data;\n",[446,901,903],{"class":448,"line":902},28,[446,904,905],{},"            } else {\n",[446,907,909],{"class":448,"line":908},29,[446,910,911],{},"              return {};\n",[446,913,914],{"class":448,"line":13},[446,915,916],{},"            }\n",[446,918,920],{"class":448,"line":919},31,[446,921,922],{},"          });\n",[446,924,926],{"class":448,"line":925},32,[446,927,928],{},"          requests.push(req);\n",[446,930,932],{"class":448,"line":931},33,[446,933,934],{},"        }\n",[446,936,938],{"class":448,"line":937},34,[446,939,940],{},"      }\n",[446,942,944],{"class":448,"line":943},35,[446,945,946],{},"    }\n",[446,948,950],{"class":448,"line":949},36,[446,951,952],{},"    return Promise.all(requests);\n",[446,954,956],{"class":448,"line":955},37,[446,957,813],{},[446,959,961],{"class":448,"line":960},38,[446,962,963],{},"    for (let i = 0; i \u003C res.length; i++) {\n",[446,965,967],{"class":448,"line":966},39,[446,968,969],{},"      if (JSON.stringify(res[i])!=\"{}\") {\n",[446,971,973],{"class":448,"line":972},40,[446,974,975],{},"        result.relatedBlog.push(res[i]);\n",[446,977,979],{"class":448,"line":978},41,[446,980,940],{},[446,982,984],{"class":448,"line":983},42,[446,985,946],{},[446,987,989],{"class":448,"line":988},43,[446,990,991],{},"    return result;\n",[446,993,995],{"class":448,"line":994},44,[446,996,997],{},"  });\n",[446,999,1001],{"class":448,"line":1000},45,[446,1002,1003],{},"}\n",[129,1005,1006],{},"标签页等等就不赘述了。",[125,1008,1009],{"id":1009},"生成静态页面",[129,1011,1012,1013,1016],{},"生成静态页面的命令是 ",[184,1014,1015],{},"npm run generate","，记得要在生成过程中一直保持 API 处于开启状态，否则 Nuxt 这边会获取不到数据。",[129,1018,1019,1020,1023,1024,1026,1027,229,1029,1032,1033,1036,1037,163],{},"如果不做特殊设置的话，系统只会为 ",[184,1021,1022],{},"pages"," 文件夹及子文件夹里所有不是以下划线开头的 ",[184,1025,260],{}," 文件生成页面，也就是说，那些用 ",[184,1028,639],{},[184,1030,1031],{},"_tag.vue"," 来动态获取的页面不会生成相应的静态页面，而如果想生成的话，就需要在 ",[184,1034,1035],{},"nuxt.config.js"," 这个文件里面设置要动态生成的 ",[184,1038,1039],{},"routes",[129,1041,1042,1043,1046,1047,1050,1051,1054],{},"并且 Nuxt 默认是为每个页面生成各自的文件夹，在文件夹里生成 ",[184,1044,1045],{},"index.html"," 文件来访问，也就是说，本篇文章可以用 ",[184,1048,1049],{},"\u002Fblog\u002Fnuxt-blog-static-website\u002F"," 来访问，也可以用 ",[184,1052,1053],{},"\u002Fblog\u002Fnuxt-blog-static-website\u002Findex.html"," 来访问。但是想象一下这个文件夹的数量，还是取消吧！",[129,1056,1057,1058,1060,1061,1064],{},"以下是 ",[184,1059,1035],{}," 文件当中 ",[184,1062,1063],{},"generate"," 部分的配置：",[408,1066,1068],{"className":686,"code":1067,"language":688,"meta":416,"style":416},"generate: {\n  subFolders: false, \u002F\u002Fif true, each page or post will have their own folder\n  routes: function () {\n    let blogs = axios.get('http:\u002F\u002F127.0.0.1:4000')\n    .then((res) => {\u002F\u002F res.data is array\n      return res.data.blogs.map((blog) => {\n        return {\n          route: '\u002Fblog\u002F' + blog.slug,\n          payload: blog\n        }\n      })\n    })\n    let tags = axios.get('http:\u002F\u002F127.0.0.1:4000?tag=all_tags')\n    .then((res) => {\u002F\u002F res.data is object\n      let tags = Object.keys(res.data.tags);\n      return tags.map((tag) => {\n        return {\n          route: '\u002Fblog\u002Ftag\u002F' + tag,\n          payload: tag\n        };\n      });\n    })\n    return Promise.all([blogs, tags]).then(values => {\n      return [...values[0], ...values[1]]\n    })\n  },\n  ...\n}\n",[184,1069,1070,1075,1080,1085,1090,1095,1100,1105,1110,1115,1119,1124,1128,1133,1138,1143,1148,1152,1157,1162,1167,1172,1176,1181,1186,1190,1195,1200],{"__ignoreMap":416},[446,1071,1072],{"class":448,"line":16},[446,1073,1074],{},"generate: {\n",[446,1076,1077],{"class":448,"line":34},[446,1078,1079],{},"  subFolders: false, \u002F\u002Fif true, each page or post will have their own folder\n",[446,1081,1082],{"class":448,"line":19},[446,1083,1084],{},"  routes: function () {\n",[446,1086,1087],{"class":448,"line":7},[446,1088,1089],{},"    let blogs = axios.get('http:\u002F\u002F127.0.0.1:4000')\n",[446,1091,1092],{"class":448,"line":489},[446,1093,1094],{},"    .then((res) => {\u002F\u002F res.data is array\n",[446,1096,1097],{"class":448,"line":24},[446,1098,1099],{},"      return res.data.blogs.map((blog) => {\n",[446,1101,1102],{"class":448,"line":39},[446,1103,1104],{},"        return {\n",[446,1106,1107],{"class":448,"line":542},[446,1108,1109],{},"          route: '\u002Fblog\u002F' + blog.slug,\n",[446,1111,1112],{"class":448,"line":547},[446,1113,1114],{},"          payload: blog\n",[446,1116,1117],{"class":448,"line":95},[446,1118,934],{},[446,1120,1121],{"class":448,"line":559},[446,1122,1123],{},"      })\n",[446,1125,1126],{"class":448,"line":565},[446,1127,735],{},[446,1129,1130],{"class":448,"line":570},[446,1131,1132],{},"    let tags = axios.get('http:\u002F\u002F127.0.0.1:4000?tag=all_tags')\n",[446,1134,1135],{"class":448,"line":27},[446,1136,1137],{},"    .then((res) => {\u002F\u002F res.data is object\n",[446,1139,1140],{"class":448,"line":580},[446,1141,1142],{},"      let tags = Object.keys(res.data.tags);\n",[446,1144,1145],{"class":448,"line":831},[446,1146,1147],{},"      return tags.map((tag) => {\n",[446,1149,1150],{"class":448,"line":837},[446,1151,1104],{},[446,1153,1154],{"class":448,"line":843},[446,1155,1156],{},"          route: '\u002Fblog\u002Ftag\u002F' + tag,\n",[446,1158,1159],{"class":448,"line":849},[446,1160,1161],{},"          payload: tag\n",[446,1163,1164],{"class":448,"line":855},[446,1165,1166],{},"        };\n",[446,1168,1169],{"class":448,"line":861},[446,1170,1171],{},"      });\n",[446,1173,1174],{"class":448,"line":867},[446,1175,735],{},[446,1177,1178],{"class":448,"line":873},[446,1179,1180],{},"    return Promise.all([blogs, tags]).then(values => {\n",[446,1182,1183],{"class":448,"line":10},[446,1184,1185],{},"      return [...values[0], ...values[1]]\n",[446,1187,1188],{"class":448,"line":884},[446,1189,735],{},[446,1191,1192],{"class":448,"line":890},[446,1193,1194],{},"  },\n",[446,1196,1197],{"class":448,"line":896},[446,1198,1199],{},"  ...\n",[446,1201,1202],{"class":448,"line":902},[446,1203,1003],{},[125,1205,1206],{"id":1206},"小插曲",[235,1208,1209],{"id":1209},"路由和内部链接",[129,1211,1212,1213,1216],{},"本来页面导航栏和各种链接应该要使用 ",[184,1214,1215],{},"\u003Cnuxt-link\u002F>"," 标签的，这样就可以用Nuxt的路由机制，加快访问速度。",[129,1218,1219,1220,1223],{},"但是它有一个问题是，在最终生成的静态网站上使用路由访问的时候，页面仍然会去请求 ",[184,1221,1222],{},"127.0.0.1:4000"," 上的内容，可是这时候 api 已经关闭了，请求失败之后页面就会来个“Network error”，可是如果使用URL去访问，又是可以加载出内容的。",[129,1225,1226,1227,1229,1230,1233],{},"所以我不得不忍痛割爱，把所有 ",[184,1228,1215],{}," 的链接都换成了普通的 ",[184,1231,1232],{},"\u003Ca>\u003C\u002Fa>"," 标签的链接，这样静态网站就可以正常使用了。",[235,1235,1236],{"id":1236},"根目录",[129,1238,1239,1240,1243,1244,1246],{},"如果你的网站不在服务器的根目录里，而是像 ",[184,1241,1242],{},"xxx.github.io\u002Fmyproject"," 这样的路径的话，如果你在网站里使用了相对链接，有时候最后出来的效果可能不太对。这个时候需要在 ",[184,1245,1035],{}," 里面设置",[408,1248,1250],{"className":686,"code":1249,"language":688,"meta":416,"style":416},"router: {\n  base: \u002Fmyproject\u002F\n}\n",[184,1251,1252,1257,1262],{"__ignoreMap":416},[446,1253,1254],{"class":448,"line":16},[446,1255,1256],{},"router: {\n",[446,1258,1259],{"class":448,"line":34},[446,1260,1261],{},"  base: \u002Fmyproject\u002F\n",[446,1263,1264],{"class":448,"line":19},[446,1265,1003],{},[129,1267,1268],{},"然后不管是动态还是静态的网站应该都是正确的链接了。",[125,1270,1271],{"id":1271},"心得体会",[129,1273,1274],{},"前前后后花了两个多星期，我的博客终于有了新面貌，然而在这个过程中最惊喜的还是 Youtube，想找什么样的教学视频都有。",[129,1276,1277],{},"而且它自动生成的字幕非常有用，各个国家千奇百怪的口音竟然都能识别出来，即使不是100%匹配，也能让我这个非英语母语的人跟上视频博主的思路。",[129,1279,1280],{},"在这里给 Youtube 点个赞！",[1282,1283,1284],"style",{},"html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .s9eBZ, html code.shiki .s9eBZ{--shiki-default:#22863A;--shiki-dark:#85E89D}html pre.shiki code .sVt8B, html code.shiki .sVt8B{--shiki-default:#24292E;--shiki-dark:#E1E4E8}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html pre.shiki code .sj4cs, html code.shiki .sj4cs{--shiki-default:#005CC5;--shiki-dark:#79B8FF}html pre.shiki code .sJ8bj, html code.shiki .sJ8bj{--shiki-default:#6A737D;--shiki-dark:#6A737D}",{"title":416,"searchDepth":34,"depth":34,"links":1286},[1287,1288,1289,1290,1294,1295,1299,1300,1301,1305],{"id":127,"depth":34,"text":127},{"id":152,"depth":34,"text":153},{"id":178,"depth":34,"text":179},{"id":219,"depth":34,"text":220,"children":1291},[1292,1293],{"id":237,"depth":19,"text":238},{"id":338,"depth":19,"text":339},{"id":406,"depth":34,"text":406},{"id":419,"depth":34,"text":420,"children":1296},[1297,1298],{"id":430,"depth":19,"text":431},{"id":585,"depth":19,"text":585},{"id":605,"depth":34,"text":606},{"id":1009,"depth":34,"text":1009},{"id":1206,"depth":34,"text":1206,"children":1302},[1303,1304],{"id":1209,"depth":19,"text":1209},{"id":1236,"depth":19,"text":1236},{"id":1271,"depth":34,"text":1271},[12],"重构了一下博客，从Jekyll迁移到了Nuxt。方法是先用Node API 来解析 Markdown 文件，然后 Nuxt+Axios 获取 API 返回的文章内容并生成静态页面。","md",{"date":1310,"language":1311,"keywords":1312,"comments":96},"2019-05-05","中文",[504],"\u002Fblog\u002F2019-05-05-nuxt-blog-static-website",{"title":120,"description":1307},"nuxt-blog-static-website","blog\u002F2019-05-05-nuxt-blog-static-website",[1318,1319,1320,514],"我的项目","Node.js","Nuxt.js","kY7rR8NazWKyJ8-IgI3OfUYywflZ6YI7Cx0OSulEbcs",[1323,1328],{"title":1324,"path":1325,"stem":1326,"children":-1,"slug":1327},"韩剧观后感之《阿尔罕布拉宫的回忆》和《死也很好》","\u002Fblog\u002F2018-12-21-memories-of-the-alhambra-n-feel-good-to-die","blog\u002F2018-12-21-memories-of-the-alhambra-n-feel-good-to-die","memories-of-the-alhambra-n-feel-good-to-die",{"title":592,"path":1329,"stem":1330,"children":-1,"slug":1331},"\u002Fblog\u002F2019-05-18-lighten-nuxt-website","blog\u002F2019-05-18-lighten-nuxt-website","lighten-nuxt-website",1794501664218]