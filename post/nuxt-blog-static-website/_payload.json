[{"data":1,"prerenderedAt":1332},["ShallowReactive",2],{"aside-categories":3,"settings":42,"aside-latestBlog":101,"blog-post-slug-nuxt-blog-static-website":118,"surround-nuxt-blog-static-website":1322},{"categories":4},[5,8,11,14,17,20,22,25,28,30,32,35,37,40],{"name":6,"len":7},"生活",4,{"name":9,"len":10},"剧评",24,{"name":12,"len":13},"技术",30,{"name":15,"len":16},"Thoughts",1,{"name":18,"len":19},"Review",3,{"name":21,"len":7},"时评",{"name":23,"len":24},"测评",6,{"name":26,"len":27},"日常",14,{"name":29,"len":7},"推荐",{"name":31,"len":16},"Lifestyle",{"name":33,"len":34},"相册",2,{"name":36,"len":34},"游记",{"name":38,"len":39},"Tech",7,{"name":41,"len":16},"Commentary",{"id":43,"author_name":44,"extension":45,"footer":46,"friendSites":55,"meta":68,"navLinks":69,"perPage":95,"prevNextIsExcludeDate":96,"site_description":97,"site_name":98,"stem":99,"__hash__":100},"settings\u002Fsettings.yml","Jenny","yml",[47,49],{"text":48},"Powered by Nuxt.js | Theme Maupassant",{"text":50,"link":51},"Adapted by",{"href":52,"text":53,"fa_class":54},"https:\u002F\u002Fgithub.com\u002Fc53hzn","Jenny HOU","fa-github",[56,59,62,65],{"href":57,"text":58},"https:\u002F\u002Fwww.baidu.com","百度",{"href":60,"text":61},"https:\u002F\u002Fwww.google.com","谷歌",{"href":63,"text":64},"https:\u002F\u002Fwww.bing.com","必应",{"href":66,"text":67},"https:\u002F\u002Fwww.qq.com","腾讯",{},[70,75,79,83,87,90],{"path":71,"title":72,"target":73,"fa_class":74},"\u002F","首页","internal","fa-home",{"path":76,"title":77,"target":73,"fa_class":78},"\u002Fabout","关于","fa-user",{"path":80,"title":81,"target":73,"fa_class":82},"\u002Fhistory","历史","fa-book",{"path":84,"title":85,"target":73,"fa_class":86},"\u002Fpost","博客","fa-archive",{"path":88,"title":33,"target":73,"fa_class":89},"\u002Fgallery","fa-image",{"path":91,"title":92,"target":93,"fa_class":94},"https:\u002F\u002Fwww.houzhenni.com","主站","external","fa-external-link",10,true,"多学多想","Jenny's Blog","settings","mrq5f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":1306,"description":1307,"extension":1308,"meta":1309,"navigation":96,"path":1313,"seo":1314,"slug":1315,"stem":1316,"tags":1317,"__hash__":1321},"blog\u002Fblog\u002F2019-05-05-nuxt-blog-static-website.md","如何使用Nuxt建立个人博客",{"type":122,"value":123,"toc":1285},"minimark",[124,128,132,135,138,141,150,154,164,170,173,176,180,195,198,214,217,221,234,239,242,247,255,265,275,279,283,287,291,298,315,318,322,326,333,336,340,343,352,375,384,404,407,417,421,428,432,439,583,586,593,603,607,631,634,666,677,684,741,749,1004,1007,1010,1017,1040,1055,1065,1204,1207,1210,1217,1224,1234,1237,1247,1266,1269,1272,1275,1278,1281],[125,126,127],"h2",{"id":127},"前言",[129,130,131],"p",{},"更新日期：2020-03-18",[129,133,134],{},"之前写的版本有点乱，想到哪写到哪，如果是路人从 Google 点进来，也许看不明白我写了些啥，所以我把文章重构了一下。",[129,136,137],{},"我的网站从2018年3月17日至2019年5月5日期间用的是 Jekyll，主题叫 Hydejack，由 Github 自带的 Ruby 后台驱动。从2019年5月6日开始转为使用 Nuxt 生成的纯静态页面，主题是我自己设计的，没名字，本篇文章会讲述使用 Nuxt 设计博客网站的过程和要点。",[129,139,140],{},"更新日期：2020-04-05",[129,142,143,144,149],{},"新增 ",[145,146,148],"a",{"href":147},"\u002Fpost\u002Fnuxt-blog-static-website-en","英文翻译","，大家随便看看就可以了。",[125,151,153],{"id":152},"关于-nuxt","关于 Nuxt",[129,155,156,157,163],{},"官网在 ",[145,158,162],{"href":159,"rel":160},"https:\u002F\u002Fzh.nuxtjs.org\u002Fguide\u002F",[161],"nofollow","这里","。",[165,166,167],"blockquote",{},[129,168,169],{},"Nuxt.js 是一个基于Vue.js 的轻量级应用框架，可用来创建服务端渲染( SSR ) 应用，也可充当静态站点引擎生成静态站点应用，具有优雅的代码结构分层和热加载等优势。",[129,171,172],{},"也就是说，如果你想做一个有后台的动态网站，可以用 Nuxt 直接部署到 Node 服务器上。",[129,174,175],{},"如果你只是想做一个静态网站，则可以用 Nuxt 生成静态页面，然后把静态页面上传到 Github 或者任何支持静态页面托管服务的网站，本站就是这样做的。",[125,177,179],{"id":178},"我的个人网站需要实现什么功能","我的个人网站需要实现什么功能？",[129,181,182,183,187,188,187,191,194],{},"我参考了 ",[184,185,186],"code",{},"Jekyll","、",[184,189,190],{},"Hexo",[184,192,193],{},"Hugo"," 等静态网站生成工具，它们能够做到的，我希望我的网站也能做到。",[129,196,197],{},"作为个人网站来说，能够写日志是最基本的，那么它就需要有以下的功能：",[199,200,201,205,208,211],"ul",{},[202,203,204],"li",{},"文章列表页",[202,206,207],{},"文章详情页（要能显示文章详情，有上一篇、下一篇按钮，并推荐相关文章）",[202,209,210],{},"标签列表页",[202,212,213],{},"标签下文章列表页",[129,215,216],{},"然后再来几个独立页面，最好能有简历页、联络页，首页最好能推送最新文章，推送内容需包括文章标题、日期、标签、内容简介。",[125,218,220],{"id":219},"我需要学会哪些技能有什么好的教学资源","我需要学会哪些技能？有什么好的教学资源？",[129,222,223,187,226,229,230,233],{},[184,224,225],{},"Node",[184,227,228],{},"Vue"," 和 ",[184,231,232],{},"NPM"," 是最基本的，而设计网站 UI 就比较随缘了，除了渲染 Markdown 用的 CSS 是从外部导入的之外，其他的主要设计都是我自己完成的。本篇文章不会讲任何 Vue 模板的基础知识，包括渲染数据和页面交互等。而 Nuxt 方面的教学，我主要参考了以下的一些资源。",[235,236,238],"h3",{"id":237},"youtube-教学视频","Youtube 教学视频",[129,240,241],{},"我在 Youtube 上搜了很多，最后完整地看了的，并且觉得有用的大概是以下这些",[243,244,246],"h4",{"id":245},"_1-使用-nuxt-生成静态网站","1. 使用 Nuxt 生成静态网站",[248,249],"iframe",{"className":250,"src":252,"frameBorder":253,"allow":254,"allowFullScreen":96},[251],"youtube","https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FpI2qHPI0ZpU","0","accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture",[129,256,257,258,261,262,264],{},"这一个视频的主要内容是不使用外部资源，所有页面都用 ",[184,259,260],{},".vue"," 的文件书写，最后生成静态网站。这样比较适合那种做好之后不会做什么大变动的网站，比如企业官网之类的。但博客文章不可能都用 ",[184,263,260],{}," 文件来写，网站也不可能长久不更新，所以很显然不能直接用这个办法来做。",[243,266,268,269,274],{"id":267},"_2-使用-nuxt-框架和-storyblok-基于-api-提供内容的-cms-建立个人博客","2. 使用 Nuxt (框架)和 ",[145,270,273],{"href":271,"rel":272},"https:\u002F\u002Fwww.storyblok.com\u002F",[161],"storyblok"," (基于 api 提供内容的 CMS )建立个人博客",[248,276],{"className":277,"src":278,"frameBorder":253,"allow":254,"allowFullScreen":96},[251],"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FDc_5BpIB4X4",[248,280],{"className":281,"src":282,"frameBorder":253,"allow":254,"allowFullScreen":96},[251],"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FUIh4P5rNjac",[248,284],{"className":285,"src":286,"frameBorder":253,"allow":254,"allowFullScreen":96},[251],"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FYq6Ddu_QAiY",[248,288],{"className":289,"src":290,"frameBorder":253,"allow":254,"allowFullScreen":96},[251],"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FJHCKab2oS4s",[129,292,293,294,297],{},"这个系列的视频主要内容是使用 Nuxt 建立博客首页（文章列表页）、附属页面，建立页面导航路由，然后在博客详情页用 ",[184,295,296],{},"Axios"," 加载 api 传来的文章内容，最后生成静态网站。",[129,299,300,301,304,305,308,309,314],{},"这里有一点很重要的是，up 主的博客内容是托管在 ",[145,302,273],{"href":271,"rel":303},[161]," 这个 CMS 上，不在电脑本地，也不是用 Markdown 来书写。除了 ",[145,306,273],{"href":271,"rel":307},[161]," 之外还有 ",[145,310,313],{"href":311,"rel":312},"https:\u002F\u002Fwww.contentful.com\u002F",[161],"contentful"," 等提供内容管理的网站，也能达到相同的效果。",[129,316,317],{},"但是对于像我这样从 Jekyll 转过来的人来说，还是想找找能继续用 Markdown 写文章的办法。这里的“使用 CMS 的 api 来提供博客内容”的思路值得我参考。如果不使用外部商业 CMS 服务，我自己能不能在本地搭建一个类似的服务呢？只要有提供内容的 api，我就可以跟 up 主一样成功生成静态网站了。",[243,319,321],{"id":320},"_3-手把手教你在-nuxt-项目中使用-servermiddleware","3. 手把手教你在 Nuxt 项目中使用 serverMiddleware",[248,323],{"className":324,"src":325,"frameBorder":253,"allow":254,"allowFullScreen":96},[251],"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002Fj-3RwvWZoaU",[129,327,328,329,332],{},"这个视频教了一下作为服务端渲染的 Nuxt 里面配置 ",[184,330,331],{},"serverMiddleware"," 的 api 的简单过程，以及 api 的服务端代码怎么写。如果我是做动态网站，那么使用这个 api 来解析我的 Markdown 文件来提供文章内容，网站就可以直接上线了。",[129,334,335],{},"由于我是要做纯静态网站，所以用不到 serverMiddleware，但是它这里配置后台 api 的代码对我来说很有用，我们可以不用 serverMiddleware，而是单独开一个 api 的服务出来，解析 Markdown 文件，返回 json，这样就等于有了一个自己的 CMS 啦！",[235,337,339],{"id":338},"网络文章教程日英","网络文章教程（日、英）",[129,341,342],{},"中文世界里的文字教程也是有的，但是英文和日文的更能学到东西。",[243,344,346,347],{"id":345},"_1-使用nuxtmarkdown创建个人博客英文","1. ",[145,348,351],{"href":349,"rel":350},"https:\u002F\u002Fmarinaaisa.com\u002Fblog\u002Fblog-using-vue-nuxt-markdown",[161],"使用Nuxt+Markdown创建个人博客(英文)",[129,353,354,355,359,360,363,364,367,368,163,372,374],{},"作者成功实现了在 Nuxt 单一服务下解析 Markdown 文件的效果，但是她的做法竟然需要事先准备好一个 js 文件作为文章列表，每新增一个 Markdown 文件，就在 js 文件里面 ",[356,357,358],"strong",{},"手动"," 添加一篇文章的标题和链接，这样才能做到更新。而我这边希望网站可以 ",[356,361,362],{},"自动"," 识别新增的文章，所以她的这个办法可能不适合我。",[365,366],"br",{},"\n作者也很大方地把网站源码发出来了，她的 repo 在 ",[145,369,162],{"href":370,"rel":371},"https:\u002F\u002Fgithub.com\u002Fmarinaaisa\u002Fnuxt-markdown-blog-starter",[161],[365,373],{},"\n作者的页面设计和排版很符合国外网站的审美，简洁、大气、好看，不过博客文章没有标签系统，算是一个小的缺憾吧。",[243,376,378,379],{"id":377},"_2-使用nuxt重构网站日文","2. ",[145,380,383],{"href":381,"rel":382},"https:\u002F\u002Fblog.nakamu.me\u002Fposts\u002Freplace-tech-blog",[161],"使用Nuxt重构网站(日文)",[129,385,386,387,390,391,393,394,398,399,403],{},"找教程居然找到日文的，我也是很佩服我自己。作者的文字不难懂，搭建流程和技术要点解释得也很清楚。作者是用 ",[145,388,313],{"href":311,"rel":389},[161]," 来提供内容的，这样就和前面的 Youtube 教程重复了。但是他的 UI 设计得很好，完全不像一般日本人的风格，非常值得参考。",[365,392],{},"\n作者自己的技术博客用的是 Nuxt 搭建的，链接在 ",[145,395,162],{"href":396,"rel":397},"https:\u002F\u002Fblog.nakamu.me",[161]," 。此外还有一个用 Gatsby(React) 设计的生活博客，链接在 ",[145,400,162],{"href":401,"rel":402},"https:\u002F\u002Fenjoyhk.nakamu.me\u002F",[161]," ，页面设计得也很好看，不过最近几个月没有更新过文章了。",[125,405,406],{"id":406},"我的网站项目结构",[408,409,414],"pre",{"className":410,"code":412,"language":413},[411],"language-text","myblog\n├─ api\u002F    ☆手动建立这个文件夹☆\n│   ├─ blog\u002F    需要api解析的Markdown文件夹\n│   │   ├─ 2019-05-05-set-up-static-blog-using-nuxt.md\n│   │   ├─ 2017-05-28-hao123-issue.md\n│   │   └─ ...\n│   ├─ config.js 配置文件\n│   ├─ app.html 管理后台UI界面的入口\n│   └─ app.js api的入口，默认路径http:\u002F\u002F127.0.0.1:4000\n├─ components\u002F\n│   ├─ Footer.vue\n│   └─ Navigation.vue\n├─ dist\u002F        ☆最后生成的静态文件在这里，上传到 GitHub 就行啦☆\n├─ layouts\u002F\n│   ├─ default.vue\n│   ├─ error.vue 动态部署网站时如果页面出错会显示这个，但静态网站找不到时会去服务器（GitHub）的404页\n│   ├─ home.vue 首页排版布局\n│   └─ page.vue 其他页面排版布局\n├─ pages\u002F\n│   ├─ blog\u002F\n│   │   ├─ tag\u002F\n│   │   │   ├─ _tag.vue  动态渲染标签下的文章列表\n│   │   │   │            eg => \u002Fblog\u002Ftag\u002Faaa.html\n│   │   │   └─ index.vue 文章标签列表页 => \u002Fblog\u002Ftag.html\n│   │   ├─ _slug.vue 动态渲染文章详情页\n│   │   │                 eg => \u002Fblog\u002Fnuxt-blog-static-website.html\n│   │   └─ index.vue 文章列表页 => \u002Fblog.html\n│   ├─ resume.vue\n│   └─ index.vue     网站入口 => \u002Findex.html\n├─ static\u002F\n│   ├─ img\u002F  引用路径 \u002Fimg\u002Fhome\u002Fbg.jpg\n│   │   └─ home\n│   │       └─ bg.jpg\n│   ├─ js\u002F  引用路径 \u002Fjs\u002Fjquery.js\n│   │   └─ jquery.js\n│   ├─ favicon.ico  网站图标 => \u002Ffavicon.ico\n│   └─ styles.css   公用css => \u002Fstyles.css\n├─ nuxt.config.js  nuxt网站整体设置\n└─ ...\n","text",[184,415,412],{"__ignoreMap":416},"",[125,418,420],{"id":419},"作为-cms-作用的-api","作为 CMS 作用的 API",[129,422,423,424,163],{},"完整代码参见 ",[145,425,426],{"href":426,"rel":427},"https:\u002F\u002Fgithub.com\u002Fc53hzn\u002Fapril-cms",[161],[235,429,431],{"id":430},"markdown文件的写法","Markdown文件的写法",[129,433,434,435,438],{},"基本上跟原先 Jekyll 里用的 Markdown 文件写法一样，但是为了能添加“相关文章”功能，我在 Markdown 里新增了一个属性 ",[184,436,437],{},"related_blog","，里面填写关联的文章的不包含扩展名的文件名即可。",[408,440,443],{"className":441,"code":442,"language":45,"meta":416,"style":416},"language-yml shiki shiki-themes github-light github-dark","---\nlayout: post\ntitle: 如何使用Nuxt建立个人博客\ndescription: 重构了一下博客，从Jekyll迁移到了Nuxt。方法是先用Node API 来解析 Markdown 文件，然后 Nuxt+Axios 获取 API 返回的文章内容并生成静态页面。\ntags: [涨知识,JavaScript,Nuxt,静态博客]\ncomments: true\nrelated_blog: [jekyll-blog-static-website]\n---\n## 标题一\n\nasdf\n\n## 标题二\n\nasdf\n",[184,444,445,453,467,477,487,518,529,540,545,552,557,563,568,574,578],{"__ignoreMap":416},[446,447,449],"span",{"class":448,"line":16},"line",[446,450,452],{"class":451},"sScJk","---\n",[446,454,455,459,463],{"class":448,"line":34},[446,456,458],{"class":457},"s9eBZ","layout",[446,460,462],{"class":461},"sVt8B",": ",[446,464,466],{"class":465},"sZZnC","post\n",[446,468,469,472,474],{"class":448,"line":19},[446,470,471],{"class":457},"title",[446,473,462],{"class":461},[446,475,476],{"class":465},"如何使用Nuxt建立个人博客\n"