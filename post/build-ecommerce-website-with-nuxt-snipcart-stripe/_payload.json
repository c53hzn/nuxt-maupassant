f673Lty9jhR4CgUzE1OzOROHJ2-xDIAjdBCP8cg",{"latestBlog":102},[103,106,109,112,115],{"title":104,"slug":105},"港式英语，勉强算英语吧","hongkong-english-accent",{"title":107,"slug":108},"显微镜下的大明之丝绢案","under-the-microscope",{"title":110,"slug":111},"用chatGPT学俄语","chatgpt-teaches-russian",{"title":113,"slug":114},"夏洛克·福尔摩斯和H·H·福尔摩斯：其实没什么关系","sherlock-holmes-and-h-h-holmes",{"title":116,"slug":117},"手疼的时候想到八佰伴","oshin-and-yaohan",{"id":119,"title":120,"body":121,"categories":994,"description":995,"extension":996,"meta":997,"navigation":96,"path":1004,"seo":1005,"slug":1006,"stem":1007,"tags":1008,"__hash__":1013},"blog\u002Fblog\u002F2021-03-13-build-ecommerce-website-with-nuxt-snipcart-stripe.md","用nuxt、snipcart和stripe建立一个电商网站",{"type":122,"value":123,"toc":974},"minimark",[124,128,140,143,146,149,152,164,167,174,181,184,198,284,295,298,301,306,312,317,320,324,327,334,338,345,356,359,362,365,373,388,408,419,426,429,435,438,446,469,475,485,546,557,669,675,745,748,751,758,765,768,771,778,781,784,799,809,815,818,821,824,827,831,852,855,861,873,877,886,890,893,900,907,911,920,958,961,964,967,970],[125,126,127],"h2",{"id":127},"前言",[129,130,131,132,139],"p",{},"之前因为想卖供人下载的虚拟产品，于是就到可以托管和销售虚拟产品的 ",[133,134,138],"a",{"href":135,"rel":136},"https:\u002F\u002Fwww.etsy.com\u002Fhk-en\u002Fshop\u002FJoyfulTemplateDesign",[137],"nofollow","Etsy"," 开了账号，上传了 8 个自己设计的日历、日程表模板和 HTML 网页模板，但是总也卖不出去。",[129,141,142],{},"根据平台资料显示，我的平台产品每日流量（\u003C3) 还不如我自己的网站每天的流量（\u003C10) 多呢。但是降价促销也做了，付费平台广告也买了，流量还是上不去，并且也还是没人买。那我不如把产品放到自己网站上，也许看的人还多一些。",[125,144,145],{"id":145},"产品页展示",[129,147,148],{},"一开始我只是想把产品在自己网站上做个展示，占个网络流量，然后把购买按钮导流回 Etsy ，这样我就还是只需要做网页，不用费劲去搞 API。",[129,150,151],{},"这部分是前两个月断断续续完成的，不在文章概要里说的 5 个小时内。",[129,153,154,155,159,160,163],{},"由于转用了 ",[156,157,158],"code",{},"Nuxt content"," 作为内容管理模块，我可以直接用 ",[156,161,162],{},"content"," 读取 csv 的功能来加载产品数据到网站上。",[129,165,166],{},"首先从 Etsy 下载我的产品数据，下载下来的 csv 是这样子的。",[129,168,169],{},[170,171],"img",{"alt":172,"src":173},"001","\u002Fimg\u002Fblog\u002F2021-03-13\u002F001.jpg",[129,175,176,177,180],{},"这个数据结构挺好的，图片托管在 Etsy 上，连图片链接都有了，放到 ",[156,178,179],{},"content\u002F"," 文件夹里就能直接用。",[129,182,183],{},"然后就是在网站的产品目录页和产品详情页加载产品信息。",[129,185,186,187,190,191,190,194,197],{},"使用 ",[156,188,189],{},"async asyncData(){}"," 、 ",[156,192,193],{},"await",[156,195,196],{},"fetch","方法来加载数据",[199,200,205],"pre",{"className":201,"code":202,"language":203,"meta":204,"style":204},"language-js shiki shiki-themes github-light github-dark","async asyncData(context) {\n    var data = await context.$content('product\u002Fetsy.csv').fetch();\n    var product_list = data.body;\n    return {product_list}\n}\n    \n","js","",[156,206,207,222,258,270,278],{"__ignoreMap":204},[208,209,211,215,219],"span",{"class":210,"line":16},"line",[208,212,214],{"class":213},"sVt8B","async ",[208,216,218],{"class":217},"sScJk","asyncData",[208,220,221],{"class":213},"(context) {\n",[208,223,224,228,231,234,237,240,243,246,250,253,255],{"class":210,"line":34},[208,225,227],{"class":226},"szBVR","    var",[208,229,230],{"class":213}," data ",[208,232,233],{"class":226},"=",[208,235,236],{"class":226}," await",[208,238,239],{"class":213}," context.",[208,241,242],{"class":217},"$content",[208,244,245],{"class":213},"(",[208,247,249],{"class":248},"sZZnC","'product\u002Fetsy.csv'",[208,251,252],{"class":213},").",[208,254,196],{"class":217},[208,256,257],{"class":213},"();\n",[208,259,260,262,265,267],{"class":210,"line":19},[208,261,227],{"class":226},[208,263,264],{"class":213}," product_list ",[208,266,233],{"class":226},[208,268,269],{"class":213}," data.body;\n",[208,271,272,275],{"class":210,"line":7},[208,273,274],{"class":226},"    return",[208,276,277],{"class":213}," {product_list}\n",[208,279,281],{"class":210,"line":280},5,[208,282,283],{"class":213},"}\n",[129,285,286,287,290,291,294],{},"然后渲染到 ",[156,288,289],{},"\u002Fstore\u002Findex.vue"," 和 ",[156,292,293],{},"\u002Fstore\u002F_sku.vue"," 上就行啦。",[129,296,297],{},"后来我就想，既然产品页面都有了，我何不把生成订单和收款功能也加上去呢？",[125,299,300],{"id":300},"收款工具",[302,303,305],"h3",{"id":304},"paypal","PayPal",[129,307,308,309,311],{},"线上收款的话，国际上用的最广的是 ",[156,310,305],{}," ，如果想要在自己网站使用 PayPal 收款的话，有两种方式：",[313,314,316],"h4",{"id":315},"paypal-payments-pro","PayPal Payments Pro",[129,318,319],{},"配置这个需要生成开发者 APP KEY，好处是付款过程中页面不用跳转到 PayPal，但是需要商业账号才能用，且每个月要额外交月费。",[313,321,323],{"id":322},"paypal-express-checkout","PayPal Express Checkout",[129,325,326],{},"配置这个不需要开发者 APP KEY，只需要填写 PayPal 账号 email 就行，个人账号就能用，还不需要额外交月费。",[129,328,329,330,333],{},"两种方式都需要在 PayPal 后台给你的网站添加授权，否则前端会报错 ",[156,331,332],{},"422 Unprocessable entity"," 。",[302,335,337],{"id":336},"stripe","Stripe",[129,339,340,341,333],{},"如果想允许买家使用信用卡付款的话，你还需要一些其他的第三方工具，比如 ",[133,342,336],{"href":343,"rel":344},"https:\u002F\u002Fstripe.com\u002F",[137],[129,346,347,348,351,352,355],{},"注册账号之后，验证邮箱，添加公司详情（经营性质选个人也行），填写收款银行账号，然后在菜单的 ",[156,349,350],{},"开发者"," 那里获取 ",[156,353,354],{},"API 秘钥"," ，这个后面会用到。",[129,357,358],{},"Stripe 里面可以集成支付宝和微信收款，但是得要商业账号，我不想弄这些认证，于是作罢。",[125,360,361],{"id":361},"结算工具",[302,363,364],{"id":364},"为什么选snipcart",[129,366,367,368,290,370,372],{},"有 ",[156,369,305],{},[156,371,336],{}," 之后，还需要有加到购物车、结算、付款的功能，我希望网站能根据产品页面信息动态生成订单。",[129,374,375,376,379,380,290,382,384,385,387],{},"根据 PayPal 和 Stripe 提供的文档和网上搜到的资料来看，这好像无法在静态网站上实现。那我们可以再绕一下，用 ",[156,377,378],{},"snipcart"," 来做这些，然后把 ",[156,381,305],{},[156,383,336],{}," 作为 ",[156,386,378],{}," 的收款工具来用。",[129,389,390,391,393,394,397,398,393,400,403,404,407],{},"这里要注意的是， ",[156,392,336],{}," 每笔交易收 ",[156,395,396],{},"3.4% + HK$2.35"," 的费用，没有月费，而 ",[156,399,378],{},[156,401,402],{},"2% + 付款渠道费"," ，每月最低收费 10 美元，这样会被收两道钱。而 Etsy 的收费是每笔 ",[156,405,406],{},"5%"," ，如果自建网店就会比 Etsy 收费贵了。但是没办法，如果要保持现在的静态网站，就只能这样做。",[129,409,410,411,414,415,418],{},"换个角度来看，就是相当于 eBay 和 PayPal 的关系，一个处理订单，一个处理收款，并且两个都要收费。但是从费用上来看， ",[156,412,413],{},"snipcart + stripe"," 比 ",[156,416,417],{},"eBay(最低10%) + PayPal(2.9%)"," 要实惠多了。",[129,420,421,422,425],{},"而如果是 ",[156,423,424],{},"snipcart + PayPal"," 的话，好像是最划算的结果，希望买家都选 PayPal 吧。",[129,427,428],{},"再说说 Snipcart 的其他优势吧。",[129,430,431,432,434],{},"之前我知道 ",[156,433,378],{}," 可以在静态网站或是单页面网站上添加结算功能，这样即使卖家没有自己的网站后台，也可以做到线上售卖的生意。这次研究了下，发现它不止可以做结算，还可以在他们的后台上传虚拟产品，并生成下载链接，当有买家成功付款之后就会发送下载链接给买家，简直太适合我了。",[302,436,437],{"id":437},"集成snipcart",[129,439,440,441,445],{},"注册 ",[133,442,378],{"href":443,"rel":444},"https:\u002F\u002Fsnipcart.com",[137]," 账号，然后按照首页提示的步骤，先填写商业信息，经营性质可以选个人，然后配置域名，接下来就可以集成代码了。",[129,447,448,449,452,453,456,457,460,461,464,465,468],{},"在页面右上角点击人头按钮，弹出主菜单，找到 ",[156,450,451],{},"ACCOUNT"," 下面的 ",[156,454,455],{},"API KEYS"," ，先用 ",[156,458,459],{},"TEST"," 模式下的 ",[156,462,463],{},"API KEY"," ，等测试没问题了，换成 ",[156,466,467],{},"LIVE KEY"," 就能上线了。",[129,470,471,472,474],{},"相关功能加到了 ",[156,473,293],{}," 这个模板里。",[129,476,477,478,481,482],{},"首先在 ",[156,479,480],{},"head"," 部分添加 ",[156,483,484],{},"link",[199,486,488],{"className":201,"code":487,"language":203,"meta":204,"style":204},"link: [\n    {rel: 'preconnect', href: 'https:\u002F\u002Fapp.snipcart.com'},\n    {rel: 'preconnect', href: 'https:\u002F\u002Fcdn.snipcart.com'},\n    {rel: 'stylesheet', href: 'https:\u002F\u002Fcdn.snipcart.com\u002Fthemes\u002Fv3.0.31\u002Fdefault\u002Fsnipcart.css'}\n]\n",[156,489,490,497,514,527,541],{"__ignoreMap":204},[208,491,492,494],{"class":210,"line":16},[208,493,484],{"class":217},[208,495,496],{"class":213},": [\n",[208,498,499,502,505,508,511],{"class":210,"line":34},[208,500,501],{"class":213},"    {rel: ",[208,503,504],{"class":248},"'preconnect'",[208,506,507],{"class":213},", href: ",[208,509,510],{"class":248},"'https:\u002F\u002Fapp.snipcart.com'",[208,512,513],{"class":213},"},\n",[208,515,516,518,520,522,525],{"class":210,"line":19},[208,517,501],{"class":213},[208,519,504],{"class":248},[208,521,507],{"class":213},[208,523,524],{"class":248},"'https:\u002F\u002Fcdn.snipcart.com'",[208,526,513],{"class":213},[208,528,529,531,534,536,539],{"class":210,"line":7},[208,530,501],{"class":213},[20