8,628,629],{"class":248},"\"title\"\n",[208,631,632,635,637],{"class":210,"line":39},[208,633,634],{"class":217},"  :data-item-image",[208,636,233],{"class":213},[208,638,639],{"class":248},"\"photos[0]\"\n",[208,641,643,646,648,651],{"class":210,"line":642},8,[208,644,645],{"class":217},"  :data-item-name",[208,647,233],{"class":213},[208,649,650],{"class":248},"\"title\"",[208,652,653],{"class":213},">\n",[208,655,657],{"class":210,"line":656},9,[208,658,659],{"class":213},"  Add to cart\n",[208,661,662,665,667],{"class":210,"line":95},[208,663,664],{"class":213},"\u003C\u002F",[208,666,571],{"class":570},[208,668,653],{"class":213},[129,670,671,672,674],{},"在 ",[156,673,551],{}," 部分的末尾加上",[199,676,678],{"className":559,"code":677,"language":551,"meta":204,"style":204},"\u003Cscript async src=\"https:\u002F\u002Fcdn.snipcart.com\u002Fthemes\u002Fv3.0.31\u002Fdefault\u002Fsnipcart.js\">\u003C\u002Fscript>\n\u003Cdiv id=\"snipcart\" data-config-modal-style=\"side\" data-api-key=\"TESTING_API_KEY\" hidden>\u003C\u002Fdiv>\n",[156,679,680,705],{"__ignoreMap":204},[208,681,682,684,687,690,693,695,698,701,703],{"class":210,"line":16},[208,683,567],{"class":213},[208,685,686],{"class":570},"script",[208,688,689],{"class":217}," async",[208,691,692],{"class":217}," src",[208,694,233],{"class":213},[208,696,697],{"class":248},"\"https:\u002F\u002Fcdn.snipcart.com\u002Fthemes\u002Fv3.0.31\u002Fdefault\u002Fsnipcart.js\"",[208,699,700],{"class":213},">\u003C\u002F",[208,702,686],{"class":570},[208,704,653],{"class":213},[208,706,707,709,712,715,717,720,723,725,728,731,733,736,739,741,743],{"class":210,"line":34},[208,708,567],{"class":213},[208,710,711],{"class":570},"div",[208,713,714],{"class":217}," id",[208,716,233],{"class":213},[208,718,719],{"class":248},"\"snipcart\"",[208,721,722],{"class":217}," data-config-modal-style",[208,724,233],{"class":213},[208,726,727],{"class":248},"\"side\"",[208,729,730],{"class":217}," data-api-key",[208,732,233],{"class":213},[208,734,735],{"class":248},"\"TESTING_API_KEY\"",[208,737,738],{"class":217}," hidden",[208,740,700],{"class":213},[208,742,711],{"class":570},[208,744,653],{"class":213},[129,746,747],{},"现在可以开始测试了。",[125,749,750],{"id":750},"本地测试",[129,752,753,754,757],{},"我先在本机 ",[156,755,756],{},"localhost:3000"," 的环境下测试，加到购物车之后很顺利地弹出了结算按钮，可是输入了收件信息和付款信息之后，页面报错说 snipcart 爬取的信息和当前结算的信息不符。",[129,759,760,761,764],{},"我一头雾水地搜了半天，才发现原来 snipcart 的安全机制不允许开发人员在 ",[156,762,763],{},"localhost"," 环境下生成订单，连测试订单都不行。",[129,766,767],{},"但是我总不能每改一处代码就部署一次网站吧？有没有什么别的办法可以绕过去呢？",[129,769,770],{},"然后就搜到了一个解决办法，用代理。",[129,772,773,777],{},[133,774,775],{"href":775,"rel":776},"https:\u002F\u002Ftunnel.staqlab.com",[137]," 提供了一个代理域名的服务，可以转发本地的请求。",[129,779,780],{},"打开网站，下载软件，解压缩，双击执行，电脑上闪过一个终端，然后又消失了。",[129,782,783],{},"我以为自己安装错了，又回到官网查看，才发现软件并不提供 UI，而是安装后使用命令行控制。",[129,785,786,787,790,791,794,795,798],{},"于是回到刚才解压缩的目录下，在此目录打开 ",[156,788,789],{},"cmd"," ，输入命令 ",[156,792,793],{},"staqlab-tunnel 3000","，这里的 ",[156,796,797],{},"3000"," 是我用的端口，如果你用了别的端口，就改成别的。",[129,800,801,802,805,806,808],{},"然后终端就会生成一个看起来像乱码的子域名: ",[156,803,804],{},"https:\u002F\u002Fxxxxxxx.staqlab-tunnel.com"," 。我们可以用它访问原来本机的 ",[156,807,756],{}," 的服务。",[129,810,811,812,814],{},"我们可以把这个域名加到 ",[156,813,378],{}," 的允许使用的域名清单里，然后就可以测试购买了。",[129,816,817],{},"进入这个网址，网站会先提醒访客此网站不安全，除非你是该网站的开发人员，不然不要点击进去，但我们是开发人员，点进去就可以了。",[129,819,820],{},"然后测试加到购物车，点击结算，输入买家信息，输入测试用的信用卡号码，付款，立刻就收到购买成功的邮件和包含下载链接的邮件了。",[129,822,823],{},"接下来就是结束测试，准备上线。",[125,825,826],{"id":826},"功能上线",[302,828,830],{"id":829},"在snipcart配置stripe和paypal","在snipcart配置stripe和PayPal",[129,832,833,834,837,838,452,841,844,845,847,848,851],{},"找到前面 ",[133,835,300],{"href":836},"#%E6%94%B6%E6%AC%BE%E5%B7%A5%E5%85%B7"," 里面说的 Stripe 的 API KEY ，回到 snipcart ，在页面右上角点击人头按钮，弹出主菜单，找到 ",[156,839,840],{},"STORE CONFIGURATIONS",[156,842,843],{},"PAYMENT GATEWAY"," ，在 ",[156,846,336],{}," 那里点击 ",[156,849,850],{},"connect"," ，把刚才从 stripe 那里获取到的 API KEY 填进去，保存即可。",[129,853,854],{},"根据 Snipcart 的要求，你只可以有一个主要收款方式，如果想用 PayPal Payments Pro 的话，就不能用 Stripe 了。但是如果想额外添加 PayPal Express Checkout 收款则不受此限制。",[129,856,857,858,860],{},"所以我们可以在 ",[156,859,843],{}," 页面下拉至底部，添加一个 PayPal Express Checkout 的账号进去。",[129,862,863,864,866,867,872],{},"另外，别忘了在 PayPal 授权给 Snipcart，否则会报错 ",[156,865,332],{},"。授权步骤看 ",[133,868,871],{"href":869,"rel":870},"https:\u002F\u002Fdocs.snipcart.com\u002Fv3\u002Fdashboard\u002Fpaypal-configuration#granting-permissions-to-your-paypal-account-to-snipcart",[137],"这里",".",[302,874,876],{"id":875},"在snipcart生成上线用的live-key","在snipcart生成上线用的LIVE KEY",[129,878,879,880,882,883,885],{},"想要使用 ",[156,881,467],{}," 的话，就要在 snipcart 添加缴付费用的信用卡，添加成功之后回到 API 页面，它还是叫我添加信用卡，这里不知道是触发了什么机制，添加了好几次，回来这个页面还是让我添加。后来不知怎的福至心灵，F5 刷新了一下页面，再回到 API KEY 那里，就可以生成 ",[156,884,467],{}," 了。",[302,887,889],{"id":888},"snipcart的其他配置","Snipcart的其他配置",[129,891,892],{},"原本在 Test 模式的时候，我已经设置过允许购买的买家国家\u002F地区了，可是转成 LIVE 模式之后还需要重新设置一次。",[129,894,895,896,899],{},"从右边的菜单找到 ",[156,897,898],{},"REGIONAL SETTINGS"," ，然后勾选你想售卖的国家\u002F地区，否则除了默认的美国和加拿大之外，所有地方的买家都无法下单。",[129,901,902,903,906],{},"然后在右边的菜单找到 ",[156,904,905],{},"DOMAINS & URLS","，把你的网站域名加进去，这样 Snipcart 才能在你的网站上使用。",[302,908,910],{"id":909},"在nuxt配置snipcart的live-key","在Nuxt配置snipcart的LIVE KEY",[129,912,913,914,916,917,919],{},"我们回到 ",[156,915,293],{}," 这里，修改 ",[156,918,551],{}," 的末尾部分",[199,921,923],{"className":559,"code":922,"language":551,"meta":204,"style":204},"\u003Cdiv id=\"snipcart\" data-config-modal-style=\"side\" data-api-key=\"LIVE_APP_API_KEY\" hidden>\u003C\u002Fdiv>\n",[156,924,925],{"__ignoreMap":204},[208,926,927,929,931,933,935,937,939,941,943,945,947,950,952,954,956],{"class":210,"line":16},[208,928,567],{"class":213},[208,930,711],{"class":570},[208,932,714],{"class":217},[208,934,233],{"class":213},[208,936,719],{"class":248},[208,938,722],{"class":217},[208,940,233],{"class":213},[208,942,727],{"class":248},[208,944,730],{"class":217},[208,946,233],{"class":213},[208,948,949],{"class":248},"\"LIVE_APP_API_KEY\"",[208,951,738],{"class":217},[208,953,700],{"class":213},[208,955,711],{"class":570},[208,957,653],{"class":213},[129,959,960],{},"save，git add，git commit，git push，等待 CI 自动部署，就完成了。",[125,962,963],{"id":963},"总结",[129,965,966],{},"虽然说终于算是有了自己的所谓“网店”，但是不管是 Etsy 还是 我的独立站，两边都一直不出单的话，还不如我发微博，一天能赚 0.1 人民币呢。",[129,968,969],{},"总而言之算是又学到了一些东西吧，2021 年，要加倍努力啊！",[971,972,973],"style",{},"html pre.shiki code .sVt8B, html code.shiki .sVt8B{--shiki-default:#24292E;--shiki-dark:#E1E4E8}html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .szBVR, html code.shiki .szBVR{--shiki-default:#D73A49;--shiki-dark:#F97583}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s9eBZ, html code.shiki .s9eBZ{--shiki-default:#22863A;--shiki-dark:#85E89D}",{"title":204,"searchDepth":34,"depth":34,"links":975},[976,977,978,982,986,987,993],{"id":127,"depth":34,"text":127},{"id":145,"depth":34,"text":145},{"id":300,"depth":34,"text":300,"children":979},[980,981],{"id":304,"depth":19,"text":305},{"id":336,"depth":19,"text":337},{"id":361,"depth":34,"text":361,"children":983},[984,985],{"id":364,"depth":19,"text":364},{"id":437,"depth":19,"text":437},{"id":750,"depth":34,"text":750},{"id":826,"depth":34,"text":826,"children":988},[989,990,991,992],{"id":829,"depth":19,"text":830},{"id":875,"depth":19,"text":876},{"id":888,"depth":19,"text":889},{"id":909,"depth":19,"text":910},{"id":963,"depth":34,"text":963},[12],"没有后台和数据库，静态网站也想做网店？完全没有问题。生成网站用nuxt，内容及产品管理用nuxt content，订单管理和结算功能用snipcart，收款用PayPal和stripe。从注册snipcart到功能上线，总共5小时搞定。","md",{"date":998,"language":999,"keywords":1000,"comments":96},"2021-03-13","中文",[1001,1002,1003],"E-Commerce","独立站","webstore","\u002Fblog\u002F2021-03-13-build-ecommerce-website-with-nuxt-snipcart-stripe",{"title":120,"description":995},"build-ecommerce-website-with-nuxt-snipcart-stripe","blog\u002F2021-03-13-build-ecommerce-website-with-nuxt-snipcart-stripe",[1009,1010,1011,1012,378,336],"电商","网店","Nuxt.js","Nuxt Content","HHzeWJZkulWF8DGXsKP-rm4Fc2Il8kB2-AEjNyN_D2o",[1015,1020],{"title":1016,"path":1017,"stem":1018,"children":-1,"slug":1019},"游戏猫国建设者的外挂脚本","\u002Fblog\u002F2021-03-07-kittens-game","blog\u002F2021-03-07-kittens-game","kittens-game",{"title":1021,"path":1022,"stem":1023,"children":-1,"slug":1024},"Build an E-Commerce website with Nuxt, Snipcart and Stripe","\u002Fblog\u002F2021-03-14-build-ecommerce-website-with-nuxt-snipcart-stripe-en","blog\u002F2021-03-14-build-ecommerce-website-with-nuxt-snipcart-stripe-en","build-ecommerce-website-with-nuxt-snipcart-stripe-en",1794501663866]